# Copie para .env.whatsapp.local (não versionado) e gere valores aleatórios próprios.
EVOLUTION_API_KEY=
EVOLUTION_POSTGRES_PASSWORD=
# Porta acessível somente no servidor/localhost. Exponha apenas o webhook do Honey via HTTPS.
EVOLUTION_BIND_PORT=8088
EVOLUTION_PUBLIC_URL=http://localhost:8088
# Variáveis do Honey/worker, além das configurações atuais preservadas:
WHATSAPP_EVOLUTION_URL=http://evolution:8080
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_BASE_URL=https://honey-homologacao.seu-dominio.com
WHATSAPP_STORAGE_SERVICE=local
# Use as chaves de criptografia já existentes no Honey. Não rotacione ao instalar.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Opcional: novo sandbox Rails, sem alterar a configuração atual.
# RAILS_ENV=whatsapp_preview
# HONEY_WHATSAPP_PREVIEW_DATABASE_URL=mysql2://usuario:senha@mysql/honey_whatsapp_preview
# HONEY_WHATSAPP_PREVIEW_HOST=honey-homologacao.seu-dominio.com
