        )
      ),
      tracking_pending AS (
        SELECT so.tiny_order_id
        FROM successful_orders so
        WHERE 1=1
        
        AND EXISTS (
          SELECT 1 FROM attempts a
          WHERE a.order_correios_id = so.order_correios_id
            AND a.kinds = 1 AND a.status = 2
        )
