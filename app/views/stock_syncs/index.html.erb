<% content_for :title, "Sincronização de Estoque (Log03)" %>
<% statuses = { 'success' => ['Concluída', 'green', 'Todos os produtos atualizados.'], 'processing' => ['Executando', 'purple', 'Ainda rodando.'],
                'fail' => ['Com erros', 'yellow', 'Terminou, mas alguns produtos falharam.'], 'error' => ['Falhou', 'red', 'Nenhum produto foi atualizado.'], 'none' => ['Sem status', 'gray', 'Não terminou.'] } %>
<% config_states = { 'on' => ['Ativa', 'green', 'Roda sozinha nos dias e horários marcados.'], 'off' => ['Desativada', 'gray', 'O saldo do site só muda com Executar agora.'] } %>
<% days = [[0, 'Domingo'], [1, 'Segunda'], [2, 'Terça'], [3, 'Quarta'], [4, 'Quinta'], [5, 'Sexta'], [6, 'Sábado']] %>
<% config_table = HoneyTable.new(params, id: 'auto', unit: 'configurações', unit1: 'configuração',
     rows: [{ id: 'cfg', st: @config.enabled? ? 'on' : 'off', dias: @config.days_of_week_names.join(', ').presence || 'Nenhum dia marcado',
              horas: @config.hours_array.sort.map { |h| format('%02d:00', h) }.join(', ').presence || 'Nenhum horário',
              ult: @stats[:last_execution] ? "#{l(@stats[:last_execution].in_time_zone, format: '%d/%m %H:%M')} · #{hc_ago(@stats[:last_execution])}" : 'Nunca rodou' }],
     cols: [
       { k: :st, label: 'Estado', t: :status, map: config_states },
       { k: :dias, label: 'Quando roda', main: true, sub: :horas },
       { k: :horas, label: 'Horários', hide: true },
       { k: :ult, label: 'Última execução', cls: 'due' }
     ]) %>
<% runs = HoneyTable.new(params, id: 'exec', unit: 'execuções', unit1: 'execução', page_size: 8, sort: { k: :dt, dir: -1 },
     rows: @recent_attempts.map { |a|
       { id: a.id, st: a.status || 'none', dt: a.created_at, tipo: a.tracking.to_s.start_with?('manual') ? 'Manual' : 'Automático',
         msg: (a.message.presence || a.error.presence || '—').to_s.truncate(160), erros: a.error.presence || '—', dur: (a.updated_at && a.status != 'processing' ? "#{((a.updated_at - a.created_at) / 60).round(1).to_s.tr('.', ',')} min" : '—') }
     },
     cols: [
       { k: :id, label: 'Execução', t: :num },
       { k: :st, label: 'Status', t: :status, map: statuses },
       { k: :dt, label: 'Data e hora', t: :dt, sort: true },
       { k: :tipo, label: 'Tipo', t: :tag },
       { k: :msg, label: 'Mensagem' },
       { k: :dur, label: 'Duração', hide: true },
       { k: :erros, label: 'Erros', hide: true }
     ],
     filters: [
       { id: :q, type: :search, label: 'Buscar', ph: 'Número ou mensagem', cols: %i[id msg erros], tip: 'Procura pelo número da execução ou pela mensagem.' },
       { id: :st, type: :select, label: 'Status', col: :st, all: 'Todos' },
       { id: :tipo, type: :select, label: 'Tipo', col: :tipo, all: 'Todos', tip: 'Automático: no horário marcado. Manual: alguém clicou em Executar agora.' },
       { id: :per, type: :period, label: 'Período', col: :dt }
     ],
     kpis: [
       { label: 'Bem-sucedidas', icon: 'fas fa-circle-check', tone: 'green', help: 'Todos os produtos atualizados.', count: @stats[:success] },
       { label: 'Com erro ou falha', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'Alguns ou todos os produtos falharam.', count: @stats[:failed] },
       { label: 'Executando agora', icon: 'fas fa-spinner', tone: 'purple', help: 'Rodadas que ainda não terminaram.', count: @stats[:processing] },
       { label: 'Taxa de sucesso', icon: 'fas fa-percent', tone: 'blue', help: 'De todas as rodadas registradas.', text: "#{@stats[:success_rate].to_s.tr('.', ',')}%" }
     ]) %>
<% can_x = screen_can?(:dashboard_correios, :execute) %>

<%= hc_page_header 'Sincronização de Estoque (Log03)', 'Copia o estoque do armazém do Correios para o Shopify.', icon: 'fas fa-sync' do %>
  <% if can_x %>
    <%= button_to execute_now_stock_syncs_path, method: :post, class: 'btn btn-export', disabled: @current_execution.present?,
                  form: { style: 'display: inline', data: { hc_confirm: (@current_execution ? nil : { title: 'Executar a sincronização agora?', text: 'O sistema copia agora o estoque do Correios para o Shopify. O saldo do site muda para todos os produtos.', ok: 'Executar agora', icon: 'fas fa-sync' }.to_json) } } do %>
      <% if @current_execution %><span class="spinner"></span>Executando…<% else %><i class="fas fa-sync"></i>Executar agora<% end %>
    <% end %>
  <% end %>
<% end %>

<% if @current_execution %>
  <div class="callout pg-banner is-info"><i class="fas fa-spinner fa-spin"></i><div><strong>Sincronização em andamento.</strong> Começou <%= hc_ago(@current_execution.created_at) %>. <%= @current_execution.message %></div></div>
<% end %>

<script type="text/html" id="syncScheduleForm">
  <div class="backdrop" data-close="drawer"></div>
  <%= form_with model: @config, url: update_config_stock_syncs_path, method: :patch, local: true, class: 'drawer is-wide', html: { role: 'dialog', 'aria-label': 'Editar dias e horários' } do %>
    <div class="drawer-head"><div class="page-icon is-area"<% if hc_area %> style="<%= nav_area_style(hc_area) %>"<% end %>><i class="fas fa-calendar-days"></i></div><div><h2>Editar dias e horários</h2><p>A sincronização automática roda só nos dias e horários marcados.</p></div><button type="button" class="icon-btn" data-close="drawer" aria-label="Fechar"><i class="fas fa-times"></i></button></div>
    <div class="drawer-body"><div class="pg-fields">
      <div class="pg-fsec">Dias da semana</div>
      <% days.each do |value, name| %>
        <div class="form-group pg-fg pg-w3"><label class="form-check"><%= check_box_tag 'stock_sync_config[days_of_week][]', value, @config.days_of_week_array.include?(value), class: 'form-check-input', id: "day_#{value}" %><span><%= name %></span></label></div>
      <% end %>
      <div class="pg-fsec">Horários (de 2 em 2 horas)</div>
      <% (0..23).step(2).each do |hour| %>
        <div class="form-group pg-fg pg-w3"><label class="form-check"><%= check_box_tag 'stock_sync_config[hours][]', hour, @config.hours_array.include?(hour), class: 'form-check-input', id: "hour_#{hour}" %><span><%= format('%02d:00', hour) %></span></label></div>
      <% end %>
    </div></div>
    <div class="drawer-foot"><button type="button" class="btn btn-ghost" data-close="drawer">Cancelar</button><button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i>Salvar</button></div>
  <% end %>
</script>

<div class="pg-blocks">
  <%= hc_pg_table(config_table, title: 'Sincronização automática', icon: 'fas fa-calendar-alt', meta: 'Roda sozinha nos dias e horários marcados.',
        actions: ->(r) {
          next ''.html_safe unless screen_can?(:dashboard_correios, :edit) || can_x

          safe_join([
            (content_tag(:button, content_tag(:i, '', class: 'fas fa-calendar-days'), type: 'button', class: 'action-btn', data: { pg_detail: 'syncScheduleForm', tip: 'Editar dias e horários' }, 'aria-label': 'Editar dias e horários') if screen_can?(:dashboard_correios, :edit)),
            (if can_x
               r[:st] == 'on' ? hc_row_action('fas fa-pause', 'Desativar automático', toggle_status_stock_syncs_path, method: :patch,
                                              confirm: { title: 'Desativar a sincronização automática?', text: 'O estoque do Shopify deixa de ser atualizado sozinho. Ele só muda quando alguém clicar em Executar agora.', ok: 'Desativar' })
                              : hc_row_action('fas fa-play', 'Ativar automático', toggle_status_stock_syncs_path, method: :patch,
                                              confirm: { title: 'Ativar a sincronização automática?', text: 'O sistema volta a copiar o estoque do Correios para o Shopify nos dias e horários marcados.', ok: 'Ativar' })
             end)
          ].compact)
        }) %>
  <%= hc_pg_kpis(runs) %>
  <%= hc_pg_table(runs, title: 'Execuções recentes', icon: 'fas fa-history', meta: 'As últimas rodadas, da mais nova para a mais antiga.',
        empty: { title: 'Nenhuma execução ainda', text: 'Quando a sincronização rodar, as execuções aparecem aqui.' },
        detail: { title: ->(r) { "Execução ##{r[:id]}" }, fields: [['Erros', :erros]] }) %>
</div>

<% if @current_execution %>
  <script>setTimeout(function () { location.reload(); }, 15000);</script>
<% end %>
