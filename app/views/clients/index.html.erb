<% content_for :title, "Clientes" %>

<div class="clients-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-users me-2"></i>Clientes
      </h1>
      <small class="page-subtitle">
        <i class="fas fa-clock me-1"></i>
        Atualizado em <%= Time.current.strftime('%d/%m/%Y às %H:%M') %>
      </small>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-user me-1"></i><%= @clients.total_count rescue @clients.size %> cliente(s)
      </span>
      <%= link_to new_client_path, class: "btn-export" do %>
        <i class="fas fa-plus me-2"></i>Novo Cliente
      <% end %>
    </div>
  </div>

  <%# ===== FILTRO / BUSCA ===== %>
  <div class="filters-panel">
    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-search me-1"></i>Buscar cliente
      </label>
      <%= form_with url: clients_path, method: :get, local: true do |f| %>
        <div class="search-row">
          <%= f.text_field :q,
              value: params[:q],
              class: "search-input",
              placeholder: "Nome, razão social ou CNPJ...",
              autofocus: !params[:q].present? %>
          <%= f.submit "Buscar", class: "btn-primary-sm" %>
          <% if params[:q].present? %>
            <%= link_to clients_path, class: "btn-clear" do %>
              <i class="fas fa-times me-1"></i>Limpar
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">
    <div class="table-card-header">
      <h5 class="table-card-title">
        <i class="fas fa-list me-2"></i>Lista de Clientes
      </h5>
      <% if params[:q].present? %>
        <div class="active-filters-row">
          <span class="filter-tag filter-tag--gray">
            <i class="fas fa-search me-1"></i>"<%= params[:q] %>"
          </span>
        </div>
      <% end %>
    </div>

    <% if @clients.any? %>
      <div class="table-responsive">
        <table class="clients-table">
          <thead>
            <tr>
              <th>Responsável</th>
              <th>Razão Social</th>
              <th>CNPJ</th>
              <th>Cidade / UF</th>
              <th>Telefone</th>
              <th>Insc. Estadual</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @clients.each do |client| %>
              <tr>
                <td class="text-main fw-semibold"><%= client.responsible_name %></td>
                <td class="text-muted-custom"><%= client.business_name.presence || "—" %></td>
                <td>
                  <span class="cnpj-badge"><%= client.cnpj_formatted.presence || "—" %></span>
                </td>
                <td class="text-muted-custom">
                  <%= [client.city, client.state].compact.join(' / ').presence || "—" %>
                </td>
                <td class="text-muted-custom"><%= client.phone.presence || "—" %></td>
                <td class="text-muted-custom"><%= client.state_registration.presence || "—" %></td>
                <td class="text-end">
                  <div class="table-actions">
                    <%= link_to edit_client_path(client), class: "action-btn action-btn--edit" do %>
                      <i class="fas fa-pencil-alt"></i>
                    <% end %>
                    <%= button_to client_path(client), method: :delete,
                        class: "action-btn action-btn--danger",
                        form: { data: { turbo_confirm: "Deseja remover #{client.display_name}?" } } do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-users fa-3x mb-3 d-block"></i>
        <% if params[:q].present? %>
          <h5>Nenhum cliente encontrado</h5>
          <p>Nenhum resultado para "<strong><%= params[:q] %></strong>"</p>
          <%= link_to clients_path, class: "btn-clear" do %>
            <i class="fas fa-times me-1"></i>Limpar busca
          <% end %>
        <% else %>
          <h5>Nenhum cliente cadastrado</h5>
          <p>Comece cadastrando o primeiro cliente</p>
          <%= link_to new_client_path, class: "btn-export" do %>
            <i class="fas fa-plus me-1"></i>Novo Cliente
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

</div>

