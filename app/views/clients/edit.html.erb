<% content_for :title, "Editar Cliente" %>

<div class="client-form-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon 'fas fa-user-edit' %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title">Editar Cliente</h1>
        <p class="page-subtitle"><%= @client.display_name %></p>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
      <%= link_to clients_path, class: "btn-back" do %>
        <i class="fas fa-arrow-left me-1"></i>Voltar
      <% end %>
    </div>
  </div>

  <%= render 'form', client: @client %>

</div>
