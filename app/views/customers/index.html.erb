<% content_for :title, "Clientes" %>
<% brl = ->(v) { number_to_currency(v || 0, unit: 'R$ ', separator: ',', delimiter: '.') } %>
<% recent_ids = Order.where(shopify_creation_date: 30.days.ago..).where.not(customer_id: nil).select(:customer_id) %>
<% map = ->(c) {
     address = [c.default_address_address1, c.default_address_address2, c.default_address_city, c.default_address_province_code, c.default_address_zip].compact_blank.join(', ')
     last = c.try(:last_order_at)
     { id: c.id, record: c, nm: c.full_name.presence || c.email || '—', email: c.email.presence || '—', phone: c.phone.presence || c.default_address_phone.presence || '—',
       cidade: [c.default_address_city, c.default_address_province_code].compact_blank.join('/').presence || '—', end: address.presence || '—',
       ordersN: c.orders_count.to_i, spent: c.total_spent.to_f, last: last && Time.zone.parse(last.to_s), since: (c.shopify_created_at || c.created_at)&.to_date,
       tags: c.tags.to_s.split(',').map(&:strip).compact_blank, verif: c.verified_email ? 'Sim' : 'Não', moeda: c.currency.presence || '—' }
   } %>
<% search = ->(scope, text) {
     term = "%#{ActiveRecord::Base.sanitize_sql_like(text.strip)}%"
     scope.where("customers.first_name LIKE :t OR customers.last_name LIKE :t OR customers.email LIKE :t OR customers.phone LIKE :t OR CONCAT_WS(' ', customers.first_name, customers.last_name) LIKE :t OR customers.default_address_city LIKE :t", t: term)
   } %>
<% totals = Customer.pick(Arel.sql('SUM(total_spent)'), Arel.sql('SUM(orders_count)')) %>
<% table = HoneyQueryTable.new(params, scope: @scope, map: map, search: search, page_size: 8, unit: 'clientes', unit1: 'cliente',
     filter_sql: { loja: ->(scope, value) { scope.where(id: Order.select(:customer_id).where(location_id: value)) } },
     sort_sql: { ordersN: 'customers.orders_count', spent: 'customers.total_spent', last: 'last_order_at', since: 'customers.shopify_created_at' },
     cols: [
       { k: :id, label: 'Id', t: :num, hide: true, nodetail: true },
       { k: :nm, label: 'Cliente', t: :person, sub: :email, main: true },
       { k: :phone, label: 'Telefone' },
       { k: :email, label: 'E-mail', hide: true },
       { k: :cidade, label: 'Cidade/UF' },
       { k: :end, label: 'Endereço padrão', hide: true },
       { k: :ordersN, label: 'Pedidos', t: :qty, sort: true },
       { k: :spent, label: 'Total gasto', t: :money, sort: true },
       { k: :last, label: 'Última compra', t: :dt, sort: true },
       { k: :since, label: 'Cliente desde', t: :d, sort: true },
       { k: :tags, label: 'Tags', t: :chips, hide: true },
       { k: :verif, label: 'E-mail verificado', hide: true },
       { k: :moeda, label: 'Moeda', hide: true }
     ],
     filters: [
       { id: :q, type: :search, label: 'Buscar cliente', ph: 'Nome, e-mail, telefone ou cidade', tip: 'Procura pelo nome, e-mail, telefone ou cidade.' },
       { id: :loja, type: :select, label: 'Já comprou em', options: @locations.map { |l| [l.id.to_s, l.name] }, all: 'Todas as lojas', tip: 'Mostra as clientes que já fizeram pedido naquela loja.' }
     ],
     kpis: [
       { label: 'Clientes', icon: 'fas fa-users', tone: 'blue', help: 'Cadastradas na loja online.', value: ->(scope) { scope.unscope(:select).count } },
       { label: 'Recorrentes', icon: 'fas fa-rotate', tone: 'purple', help: 'Já fizeram 2 pedidos ou mais.', col: :rec, val: 'sim',
         value: ->(scope) { scope.unscope(:select).where('customers.orders_count >= 2').count }, filter: ->(scope) { scope.where('customers.orders_count >= 2') } },
       { label: 'Compraram em 30 dias', icon: 'fas fa-bag-shopping', tone: 'green', help: 'Tiveram pedido nos últimos 30 dias.', col: :recent, val: 'sim',
         value: ->(scope) { scope.unscope(:select).where(id: recent_ids).count }, filter: ->(scope) { scope.where(id: recent_ids) } },
       { label: 'Ticket médio', icon: 'fas fa-receipt', tone: 'orange', help: 'Total gasto dividido pelos pedidos.', text: brl.call(totals[1].to_i.positive? ? totals[0].to_f / totals[1].to_i : 0) }
     ]) %>

<%= hc_page_header 'Clientes', 'Contato, compras e cupons de cada cliente da loja online.', icon: 'fas fa-users' %>

<div class="pg-blocks">
  <%= hc_pg_kpis(table) %>
  <%= hc_pg_table(table, title: 'Lista de clientes', icon: 'fas fa-users', meta: 'As clientes mais novas aparecem primeiro. Abra uma cliente para ver contato, endereço, pedidos e tags.',
        empty: { title: 'Nenhuma cliente encontrada', text: 'Tente ajustar os filtros ou limpar a busca.' },
        detail: { title: ->(r) { r[:nm] }, tip: 'Ver cliente', note: 'Só consulta: o cadastro da cliente vem do Shopify e não se edita por aqui.' }) %>
</div>
