<div class="orders-container">
  <% title 'Logs do Sistema' %>

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <i class="fas fa-history me-2"></i>Logs do Sistema
      </h1>
      <p class="page-subtitle">Histórico de ações realizadas em cupons de desconto</p>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-list me-1"></i><%= @total_count %> registros
      </span>
    </div>
  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">
    <div class="table-card-header">
      <h2 class="table-card-title">
        <i class="fas fa-clipboard-list me-2"></i>Histórico de Logs
      </h2>
    </div>

    <% if @logs.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th>Data/Hora</th>
              <th>Usuário</th>
              <th>Ação</th>
              <th>Recurso</th>
              <th>Nome</th>
              <th>Status</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody>
            <% @logs.each do |log| %>
              <tr>
                <td>
                  <span class="text-main">
                    <%= log.created_at.strftime('%d/%m/%Y') %>
                  </span>
                  <br>
                  <small class="text-muted-custom">
                    <%= log.created_at.strftime('%H:%M:%S') %>
                  </small>
                </td>
                <td>
                  <span class="badge bg-primary">
                    <%= log.user&.name || 'Sistema' %>
                  </span>
                </td>
                <td>
                  <%
                    action_class = case log.action_type
                      when 'activate' then 'bg-success'
                      when 'deactivate' then 'bg-danger'
                      when 'search' then 'bg-info'
                      when 'update_dates' then 'bg-warning text-dark'
                      else 'bg-secondary'
                    end

                    action_icon = case log.action_type
                      when 'activate' then 'fas fa-play'
                      when 'deactivate' then 'fas fa-stop'
                      when 'search' then 'fas fa-search'
                      when 'update_dates' then 'fas fa-calendar'
                      else 'fas fa-cog'
                    end

                    action_text = case log.action_type
                      when 'activate' then 'Ativação'
                      when 'deactivate' then 'Desativação'
                      when 'search' then 'Busca'
                      when 'update_dates' then 'Atualização'
                      else log.action_type.humanize
                    end
                  %>
                  <span class="badge <%= action_class %>">
                    <i class="<%= action_icon %> me-1"></i>
                    <%= action_text %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-dark border">
                    <%= log.resource_type.humanize %>
                  </span>
                </td>
                <td>
                  <% if log.resource_name.present? %>
                    <code class="text-warning"><%= log.resource_name %></code>
                  <% else %>
                    <span class="text-muted-custom">-</span>
                  <% end %>
                </td>
                <td>
                  <% if log.success %>
                    <span class="badge bg-success">
                      <i class="fas fa-check me-1"></i>Sucesso
                    </span>
                  <% else %>
                    <span class="badge bg-danger">
                      <i class="fas fa-times me-1"></i>Erro
                    </span>
                  <% end %>
                </td>
                <td>
                  <small class="text-muted-custom font-monospace">
                    <%= log.ip_address %>
                  </small>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
        <h5>Nenhum log encontrado</h5>
        <p>Ainda não há registros de atividade para exibir.</p>
      </div>
    <% end %>

    <%# PAGINAÇÃO %>
    <% if @total_pages > 1 %>
      <div class="pagination-footer">
        <div class="pagination-info">
          Página <strong><%= @page %></strong> de <strong><%= @total_pages %></strong>
          (mostrando <strong><%= @logs.count %></strong> de <strong><%= @total_count %></strong> registros)
        </div>

        <div class="pagination-controls">
          <% if @prev_page %>
            <%= link_to logs_path(page: @prev_page), class: "page-btn" do %>
              <i class="fas fa-chevron-left me-1"></i>Anterior
            <% end %>
          <% end %>

          <%
            start_page = [@page - 2, 1].max
            end_page = [start_page + 4, @total_pages].min
            start_page = [end_page - 4, 1].max
          %>

          <% (start_page..end_page).each do |page_num| %>
            <% if page_num == @page %>
              <span class="page-btn page-btn--active"><%= page_num %></span>
            <% else %>
              <%= link_to page_num, logs_path(page: page_num), class: "page-btn" %>
            <% end %>
          <% end %>

          <% if @next_page %>
            <%= link_to logs_path(page: @next_page), class: "page-btn" do %>
              Próxima<i class="fas fa-chevron-right ms-1"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% content_for :styles do %>
<% end %>
