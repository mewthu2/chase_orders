<div class="container-fluid py-4">
  <% title "Task ##{@task.id}" %>
  <%= render 'layouts/partials/messages' %>

  <!-- Header da Task -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <div>
            <h5 class="text-white mb-1">
              <i class="fas fa-tasks me-2"></i>Task #<%= @task.id %>
            </h5>
            <!-- Fixed campaign reference from @task.campaign to @task.marketing_campaign -->
            <small class="text-white-50"><%= @task.marketing_campaign.name %></small>
          </div>
          <%= link_to marketing_tasks_path, class: "btn btn-secondary" do %>
            <i class="fas fa-arrow-left me-1"></i>Voltar
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Informações do Cliente -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h6 class="text-white mb-0">
            <i class="fas fa-user me-2"></i>Informações do Cliente
          </h6>
        </div>
        <div class="card-body bg-black">
          <table class="table table-dark table-borderless mb-0">
            <tbody>
              <tr>
                <td class="text-white-50" style="width: 40%;">Nome:</td>
                <td class="text-white"><%= @lead_data.dig('customer', 'name') || 'N/A' %></td>
              </tr>
              <tr>
                <td class="text-white-50">Email:</td>
                <!-- Get email from customer_data or root level -->
                <td class="text-white"><%= @lead_data.dig('customer_data', 'email') || @lead_data['email'] || 'N/A' %></td>
              </tr>
              <tr>
                <td class="text-white-50">Telefone:</td>
                <!-- Get phone from billing_address, shipping_address, or root level -->
                <td class="text-white">
                  <%= @lead_data.dig('billing_address', 'phone') || @lead_data.dig('shipping_address', 'phone') || @lead_data['phone'] || 'N/A' %>
                </td>
              </tr>
              <tr>
                <td class="text-white-50">Checkout ID:</td>
                <td class="text-white"><%= @lead_data['checkout_id'] || 'N/A' %></td>
              </tr>
              <tr>
                <td class="text-white-50">Data Abandono:</td>
                <td class="text-white">
                  <%= @lead_data['created_at'] ? Time.parse(@lead_data['created_at']).strftime('%d/%m/%Y %H:%M') : 'N/A' %>
                </td>
              </tr>
            </tbody>
          </table>
          <% if @lead_data['abandoned_checkout_url'].present? %>
            <div class="mt-3">
              <%= link_to @lead_data['abandoned_checkout_url'], target: '_blank', class: 'btn btn-sm btn-outline-info w-100' do %>
                <i class="fas fa-external-link-alt me-2"></i>Ver Carrinho na Shopify
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h6 class="text-white mb-0">
            <i class="fas fa-dollar-sign me-2"></i>Resumo Financeiro
          </h6>
        </div>
        <div class="card-body bg-black">
          <table class="table table-dark table-borderless mb-0">
            <tbody>
              <tr>
                <td class="text-white-50" style="width: 40%;">Valor Total:</td>
                <td class="text-white">
                  <strong class="text-success">
                    <%= @lead_data['currency'] || 'BRL' %> <%= number_to_currency(@lead_data['total_price'].to_f, unit: '') %>
                  </strong>
                </td>
              </tr>
              <tr>
                <td class="text-white-50">Moeda:</td>
                <td class="text-white"><%= @lead_data['currency'] || 'BRL' %></td>
              </tr>
              <tr>
                <td class="text-white-50">Status:</td>
                <td>
                  <% if @task.converted? %>
                    <span class="badge bg-success">Convertida</span>
                  <% elsif @task.in_progress? %>
                    <span class="badge bg-info">Em Progresso</span>
                  <!-- Removed not_converted? method that doesn't exist, using completed && !converted logic -->
                  <% elsif @task.completed? && !@task.converted? %>
                    <span class="badge bg-danger">Não Convertida</span>
                  <% else %>
                    <span class="badge bg-warning text-dark">Pendente</span>
                  <% end %>
                </td>
              </tr>
              <% if @task.order_number.present? %>
                <tr>
                  <td class="text-white-50">Pedido:</td>
                  <td class="text-white"><strong><%= @task.order_number %></strong></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Ações -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h6 class="text-white mb-0">
            <i class="fas fa-bolt me-2"></i>Ações
          </h6>
        </div>
        <div class="card-body bg-black">
          <div class="d-flex gap-3 flex-wrap">
            <% if @task.pending? %>
              <%= button_to start_work_marketing_task_path(@task), method: :post, class: "btn btn-info" do %>
                <i class="fas fa-play me-2"></i>Iniciar Trabalho
              <% end %>
            <% end %>

            <% unless @task.converted? %>
              <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#convertModal">
                <i class="fas fa-check-circle me-2"></i>Marcar como Convertida
              </button>
              <%= button_to mark_not_converted_marketing_task_path(@task), method: :post, class: "btn btn-danger" do %>
                <i class="fas fa-times-circle me-2"></i>Não Converteu
              <% end %>
            <% end %>

            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#noteModal">
              <i class="fas fa-sticky-note me-2"></i>Adicionar Nota
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Endereços -->
  <div class="row mb-4">
    <% if @lead_data['billing_address'].present? %>
      <div class="col-md-6">
        <div class="card bg-black border border-dark shadow-lg">
          <div class="card-header bg-dark">
            <h6 class="text-white mb-0">
              <i class="fas fa-file-invoice me-2"></i>Endereço de Cobrança
            </h6>
          </div>
          <div class="card-body bg-black">
            <% billing = @lead_data['billing_address'] %>
            <p class="text-white mb-1"><%= billing['address1'] %></p>
            <% if billing['address2'].present? %>
              <p class="text-white mb-1"><%= billing['address2'] %></p>
            <% end %>
            <p class="text-white mb-1">
              <%= billing['city'] %>, <%= billing['province'] %> - <%= billing['zip'] %>
            </p>
            <p class="text-white mb-0"><%= billing['country'] %></p>
          </div>
        </div>
      </div>
    <% end %>

    <% if @lead_data['shipping_address'].present? %>
      <div class="col-md-6">
        <div class="card bg-black border border-dark shadow-lg">
          <div class="card-header bg-dark">
            <h6 class="text-white mb-0">
              <i class="fas fa-shipping-fast me-2"></i>Endereço de Entrega
            </h6>
          </div>
          <div class="card-body bg-black">
            <% shipping = @lead_data['shipping_address'] %>
            <p class="text-white mb-1"><%= shipping['address1'] %></p>
            <% if shipping['address2'].present? %>
              <p class="text-white mb-1"><%= shipping['address2'] %></p>
            <% end %>
            <p class="text-white mb-1">
              <%= shipping['city'] %>, <%= shipping['province'] %> - <%= shipping['zip'] %>
            </p>
            <p class="text-white mb-0"><%= shipping['country'] %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Itens do Carrinho -->
  <% if @lead_data['line_items'].present? %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card bg-black border border-dark shadow-lg">
          <div class="card-header bg-dark">
            <h6 class="text-white mb-0">
              <i class="fas fa-shopping-cart me-2"></i>Itens do Carrinho
            </h6>
          </div>
          <div class="card-body bg-black p-0">
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead>
                  <tr>
                    <th class="text-white-50">Produto</th>
                    <th class="text-white-50">Variante</th>
                    <th class="text-white-50 text-center">Quantidade</th>
                    <th class="text-white-50 text-end">Preço Unit.</th>
                    <th class="text-white-50 text-end">Subtotal</th>
                  </tr>
                </thead>
                <tbody>
                  <% @lead_data['line_items'].each do |item| %>
                    <tr>
                      <td class="text-white"><%= item['title'] %></td>
                      <td class="text-white-50"><%= item['variant_title'] || '-' %></td>
                      <td class="text-white text-center"><%= item['quantity'] %></td>
                      <td class="text-white text-end">
                        <%= @lead_data['currency'] || 'BRL' %> <%= number_to_currency(item['price'].to_f, unit: '') %>
                      </td>
                      <td class="text-white text-end">
                        <strong>
                          <%= @lead_data['currency'] || 'BRL' %> 
                          <%= number_to_currency((item['price'].to_f * item['quantity'].to_i), unit: '') %>
                        </strong>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot>
                  <tr class="border-top border-secondary">
                    <td colspan="4" class="text-white text-end"><strong>Total:</strong></td>
                    <td class="text-white text-end">
                      <strong class="text-success fs-5">
                        <%= @lead_data['currency'] || 'BRL' %> 
                        <%= number_to_currency(@lead_data['total_price'].to_f, unit: '') %>
                      </strong>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Notas -->
  <% if @task.notes.present? %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card bg-black border border-dark shadow-lg">
          <div class="card-header bg-dark">
            <h6 class="text-white mb-0">
              <i class="fas fa-sticky-note me-2"></i>Notas
            </h6>
          </div>
          <div class="card-body bg-black">
            <div class="text-white" style="white-space: pre-wrap;"><%= @task.notes %></div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

</div>

<!-- Modal Converter -->
<div class="modal fade" id="convertModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Marcar como Convertida</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <%= form_with url: mark_converted_marketing_task_path(@task), method: :post, local: true do |f| %>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label text-white">Número do Pedido</label>
            <%= f.text_field :order_number, class: "form-control bg-black text-white border-secondary", placeholder: "Ex: #1234" %>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <%= f.submit "Confirmar Conversão", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Modal Nota -->
<div class="modal fade" id="noteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Adicionar Nota</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <%= form_with url: add_note_marketing_task_path(@task), method: :post, local: true do |f| %>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label text-white">Nota</label>
            <%= f.text_area :note, rows: 4, class: "form-control bg-black text-white border-secondary", placeholder: "Digite sua nota..." %>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <%= f.submit "Adicionar Nota", class: "btn btn-warning" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.text-white-50 {
  color: rgba(255, 255, 255, 0.75) !important;
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-dark td {
  border-color: rgba(255, 255, 255, 0.1);
}

.badge {
  font-weight: 500;
}

.form-control:focus,
.form-select:focus {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}
</style>
<% end %>
