<% title 'Minhas Tasks' %>

<div class="orders-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <i class="fas fa-tasks me-2"></i>Marketing Tasks
      </h1>
      <p class="page-subtitle">Todas as tarefas de marketing</p>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-list me-1"></i><%= @tasks.count %> tarefa(s)
      </span>
    </div>
  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">

    <div class="table-card-header">
      <h2 class="table-card-title">
        <i class="fas fa-list me-2"></i>Lista de Tarefas
      </h2>
    </div>

    <% if @tasks.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Cliente</th>
              <th>Campanha</th>
              <th>Status</th>
              <th>Convertida</th>
              <th>Criada</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @tasks.each do |task| %>
              <tr>
                <td class="order-id">#<%= task.id %></td>
                <td class="text-main">
                  <i class="fas fa-user me-2"></i><%= task.lead_name %>
                  <!-- Get email and phone from lead_data JSON -->
                  <% if task.lead_data.present? %>
                    <% email = task.lead_data.dig('customer_data', 'email') || task.lead_data['email'] %>
                    <% phone = task.lead_data.dig('billing_address', 'phone') || task.lead_data.dig('shipping_address', 'phone') || task.lead_data['phone'] %>
                    <% if email.present? %>
                      <br><small class="text-muted-custom"><i class="fas fa-envelope me-1"></i><%= email %></small>
                    <% end %>
                    <% if phone.present? %>
                      <br><small class="text-muted-custom"><i class="fas fa-phone me-1"></i><%= phone %></small>
                    <% end %>
                  <% end %>
                </td>
                <td class="text-muted-custom"><%= task.marketing_campaign.name %></td>
                <td>
                  <span class="badge <%= case task.status
                    when 'pending' then 'bg-warning text-dark'
                    when 'in_progress' then 'bg-info'
                    when 'completed' then 'bg-success'
                    end %>">
                    <i class="fas <%= case task.status
                      when 'pending' then 'fa-clock'
                      when 'in_progress' then 'fa-spinner'
                      when 'completed' then 'fa-check'
                      end %> me-1"></i>
                    <%= task.status.humanize %>
                  </span>
                </td>
                <td>
                  <% if task.converted? %>
                    <span class="badge bg-success">
                      <i class="fas fa-check-circle me-1"></i>Sim
                    </span>
                    <% if task.order_number %>
                      <br><small class="text-muted-custom">Pedido: <%= task.order_number %></small>
                    <% end %>
                  <% else %>
                    <span class="badge bg-secondary">Não</span>
                  <% end %>
                </td>
                <td class="text-muted-custom">
                  <%= task.created_at.strftime('%d/%m/%Y') %>
                </td>
                <td>
                  <%# Removed marketing namespace from path %>
                  <%= link_to marketing_task_path(task), class: "btn-view-customer" do %>
                    <i class="fas fa-eye"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
        <h5>Nenhuma tarefa encontrada</h5>
        <p>Não há tarefas de marketing no momento</p>
      </div>
    <% end %>

  </div>

</div>

<% content_for :styles do %>
<% end %>
