<div class="orders-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div>
      <h1 class="page-title">Minhas Tarefas</h1>
      <p class="page-subtitle">Gerencie suas tarefas de marketing</p>
    </div>
  </div>

  <%# ===== STAT CARDS ===== %>
  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-icon summary-icon--blue"><i class="fas fa-tasks"></i></div>
      <div class="summary-body">
        <span class="summary-value"><%= @stats[:total_tasks] %></span>
        <span class="summary-label">Total de Tarefas</span>
      </div>
    </div>

    <div class="summary-card">
      <div class="summary-icon summary-icon--yellow"><i class="fas fa-clock"></i></div>
      <div class="summary-body">
        <span class="summary-value"><%= @stats[:pending] %></span>
        <span class="summary-label">Pendentes</span>
      </div>
    </div>

    <div class="summary-card">
      <div class="summary-icon summary-icon--orange"><i class="fas fa-spinner"></i></div>
      <div class="summary-body">
        <span class="summary-value"><%= @stats[:in_progress] %></span>
        <span class="summary-label">Em Progresso</span>
      </div>
    </div>

    <div class="summary-card">
      <div class="summary-icon summary-icon--green"><i class="fas fa-check-circle"></i></div>
      <div class="summary-body">
        <span class="summary-value"><%= @stats[:converted] %></span>
        <span class="summary-label">Convertidas</span>
      </div>
    </div>
  </div>

  <%# ===== FILTROS ===== %>
  <div class="filters-panel">
    <%= form_with url: my_tasks_marketing_tasks_path, method: :get, local: true do |f| %>
      <div class="search-row">
        <div class="filter-section">
          <label class="filter-label">Status</label>
          <%= select_tag :status,
              options_for_select([
                ['Todos', ''],
                ['Pendente', 'pending'],
                ['Em Progresso', 'in_progress'],
                ['Concluída', 'completed'],
                ['Convertida', 'converted']
              ], params[:status]),
              class: 'form-select' %>
        </div>

        <div class="filter-section">
          <label class="filter-label">Campanha</label>
          <%= select_tag :campaign_id,
              options_for_select([['Todas', '']] + @campaigns.map { |c| [c.name, c.id] }, params[:campaign_id]),
              class: 'form-select' %>
        </div>

        <%= f.submit 'Filtrar', class: 'btn-primary-sm' %>
        <%= link_to 'Limpar', my_tasks_marketing_tasks_path, class: 'btn-clear' %>
      </div>
    <% end %>
  </div>

  <%# ===== LISTA DE TASKS ===== %>
  <div class="table-card">
    <div class="table-card-header">
      <h2 class="table-card-title">Suas Tarefas (<%= @tasks.count %>)</h2>
    </div>

    <!-- Desktop table view - removed email and phone columns, added action buttons next to name -->
    <div class="d-none d-lg-block">
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Campanha</th>
              <th>Cliente</th>
              <th>Status</th>
              <th>Criada em</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if @tasks.any? %>
              <% @tasks.each do |task| %>
                <%
                  email = task.lead_data.dig('customer_data', 'email') || task.lead_data['email'] || 'N/A'
                  phone = task.lead_data.dig('billing_address', 'phone') ||
                          task.lead_data.dig('shipping_address', 'phone') ||
                          task.lead_data['phone'] || 'N/A'
                  customer_name = task.lead_data.dig('billing_address', 'name') ||
                                  task.lead_data.dig('customer_data', 'name') ||
                                  task.lead_data['customer_name'] || 'N/A'

                  whatsapp_number = phone.gsub(/\D/, '') if phone != 'N/A'
                %>
                <tr>
                  <td class="order-id">#<%= task.id %></td>
                  <td class="text-muted-custom"><%= task.marketing_campaign.name %></td>
                  <td class="text-main">
                    <%= customer_name %>
                    <% if email != 'N/A' %>
                      <a href="mailto:<%= email %>" class="btn btn-sm btn-outline-primary ms-2" title="Enviar Email">
                        <i class="fas fa-envelope"></i>
                      </a>
                    <% end %>
                    <% if phone != 'N/A' && whatsapp_number.present? %>
                      <a href="https://wa.me/<%= whatsapp_number %>" target="_blank" class="btn btn-sm btn-outline-success ms-2" title="Abrir WhatsApp">
                        <i class="fab fa-whatsapp"></i>
                      </a>
                    <% end %>
                  </td>
                  <td>
                    <% case task.status %>
                    <% when 'pending' %>
                      <span class="badge bg-warning">Pendente</span>
                    <% when 'in_progress' %>
                      <span class="badge bg-info">Em Progresso</span>
                    <% when 'completed' %>
                      <span class="badge bg-secondary">Concluída</span>
                    <% when 'converted' %>
                      <span class="badge bg-success">Convertida</span>
                    <% end %>
                  </td>
                  <td class="text-muted-custom">
                    <%= task.created_at.strftime('%d/%m/%Y %H:%M') %>
                  </td>
                  <td>
                    <%= link_to marketing_task_path(task), class: 'btn-view-customer' do %>
                      <i class="fas fa-eye"></i> Ver
                    <% end %>

                    <% if task.pending? %>
                      <%= button_to start_work_marketing_task_path(task), method: :post, class: 'btn btn-sm btn-outline-info ms-1', form: { style: 'display: inline-block;' } do %>
                        <i class="fas fa-play"></i> Iniciar
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6">
                  <div class="empty-state">
                    <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                    <h5>Nenhuma tarefa encontrada</h5>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile card view - optimized for touch and small screens -->
    <div class="d-lg-none">
      <% if @tasks.any? %>
        <div class="orders-blocks panel-body-pad">
          <% @tasks.each do |task| %>
            <%
              email = task.lead_data.dig('customer_data', 'email') || task.lead_data['email'] || 'N/A'
              phone = task.lead_data.dig('billing_address', 'phone') ||
                      task.lead_data.dig('shipping_address', 'phone') ||
                      task.lead_data['phone'] || 'N/A'
              customer_name = task.lead_data.dig('billing_address', 'name') ||
                              task.lead_data.dig('customer_data', 'name') ||
                              task.lead_data['customer_name'] || 'N/A'

              whatsapp_number = phone.gsub(/\D/, '') if phone != 'N/A'
            %>
            <div class="order-block">
              <div class="order-block-header">
                <div class="order-block-left">
                  <span class="order-block-id">#<%= task.id %></span>
                  <% case task.status %>
                  <% when 'pending' %>
                    <span class="badge bg-warning">Pendente</span>
                  <% when 'in_progress' %>
                    <span class="badge bg-info">Em Progresso</span>
                  <% when 'completed' %>
                    <span class="badge bg-secondary">Concluída</span>
                  <% when 'converted' %>
                    <span class="badge bg-success">Convertida</span>
                  <% end %>
                </div>
              </div>
              <div class="panel-body-pad">
                <h6 class="text-main mb-1"><%= customer_name %></h6>
                <p class="text-muted-custom small mb-2"><%= task.marketing_campaign.name %></p>

                <div class="d-flex gap-2 mb-2">
                  <% if email != 'N/A' %>
                    <a href="mailto:<%= email %>" class="btn btn-sm btn-outline-primary" title="Enviar Email">
                      <i class="fas fa-envelope"></i>
                    </a>
                  <% end %>
                  <% if phone != 'N/A' && whatsapp_number.present? %>
                    <a href="https://wa.me/<%= whatsapp_number %>" target="_blank" class="btn btn-sm btn-outline-success" title="Abrir WhatsApp">
                      <i class="fab fa-whatsapp"></i>
                    </a>
                  <% end %>
                </div>

                <p class="text-muted-custom small mb-3">
                  <i class="far fa-clock"></i> <%= task.created_at.strftime('%d/%m/%Y %H:%M') %>
                </p>

                <div class="d-flex gap-2">
                  <%= link_to marketing_task_path(task), class: 'btn btn-sm btn-outline-primary flex-grow-1' do %>
                    <i class="fas fa-eye"></i> Ver Detalhes
                  <% end %>

                  <% if task.pending? %>
                    <%= button_to start_work_marketing_task_path(task), method: :post, class: 'btn btn-sm btn-outline-info flex-grow-1' do %>
                      <i class="fas fa-play"></i> Iniciar
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
          <p>Nenhuma tarefa encontrada</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
