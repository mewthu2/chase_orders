<% title 'Dashboard - Marketing' %>

<div class="orders-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <i class="fas fa-bullhorn me-2"></i>Dashboard - Marketing
      </h1>
      <p class="page-subtitle">Visão geral das suas campanhas e tarefas</p>
    </div>
  </div>

  <%# ===== MINHAS CAMPANHAS ATIVAS ===== %>
  <div class="table-card mb-4">
    <div class="table-card-header">
      <h2 class="table-card-title">
        <i class="fas fa-bullhorn me-2"></i>Minhas Campanhas Ativas
      </h2>
    </div>
    <div class="table-responsive">
      <table class="orders-table">
        <thead>
          <tr>
            <th>Campanha</th>
            <th>Minhas Tasks</th>
            <th>Pendentes</th>
            <th>Convertidas</th>
            <th>Taxa</th>
          </tr>
        </thead>
        <tbody>
          <% @my_campaigns.each do |campaign| %>
            <% my_campaign_tasks = @my_tasks.where(campaign: campaign) %>
            <tr>
              <td class="text-main"><%= campaign.name %></td>
              <td class="text-main"><%= my_campaign_tasks.count %></td>
              <td class="text-muted-custom"><%= my_campaign_tasks.pending.count %></td>
              <td class="text-muted-custom"><%= my_campaign_tasks.converted.count %></td>
              <td>
                <span class="badge bg-info">
                  <%= my_campaign_tasks.any? ? (my_campaign_tasks.converted.count.to_f / my_campaign_tasks.count * 100).round(1) : 0 %>%
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ===== TASKS RECENTES ===== %>
  <div class="table-card">
    <div class="table-card-header">
      <h2 class="table-card-title">
        <i class="fas fa-tasks me-2"></i>Minhas Tasks Recentes
      </h2>
      <%# Removed marketing namespace from path %>
      <%= link_to marketing_tasks_path, class: "btn-primary-sm" do %>
        <i class="fas fa-list me-1"></i>Ver Todas
      <% end %>
    </div>
    <div class="table-responsive">
      <table class="orders-table">
        <thead>
          <tr>
            <th>Cliente</th>
            <th>Campanha</th>
            <th>Status</th>
            <th>Criada em</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_tasks.each do |task| %>
            <tr>
              <td class="text-main">
                <i class="fas fa-user me-2"></i><%= task.lead_name %>
              </td>
              <td class="text-muted-custom"><%= task.campaign.name %></td>
              <td>
                <span class="badge <%= case task.status
                  when 'pending' then 'bg-warning text-dark'
                  when 'in_progress' then 'bg-info'
                  when 'completed' then 'bg-success'
                  end %>">
                  <%= task.status.humanize %>
                </span>
              </td>
              <td class="text-muted-custom">
                <%= task.created_at.strftime('%d/%m/%Y %H:%M') %>
              </td>
              <td>
                <%# Removed marketing namespace from path %>
                <%= link_to marketing_task_path(task), class: "btn-view-customer" do %>
                  <i class="fas fa-eye me-1"></i>Ver
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% content_for :styles do %>
<% end %>
