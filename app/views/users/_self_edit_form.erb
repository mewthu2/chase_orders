<%# Meu Perfil: formulário à esquerda (foto, dados e senha) e "Seu acesso" à direita. %>
<div class="pg-blocks">
  <div class="pg-split" style="--cols: 1.55fr 1fr">
    <div class="pg-split-a">
      <%= form_with model: @user, local: true, class: 'panel pg-card pg-inline', id: 'pgForm', html: { novalidate: true } do |form| %>
        <h3><i class="fas fa-user-pen"></i>Editar meu perfil</h3>
        <p class="pg-p" style="margin-bottom: 14px">Troque sua foto, telefone e senha. Salve para confirmar.</p>
        <% if @user.errors.any? %>
          <div class="pg-fnote is-warn"><i class="fas fa-triangle-exclamation"></i><span><%= @user.errors.full_messages.to_sentence %></span></div>
        <% end %>
        <%= render 'profile_photo', form: form %>
        <div class="pg-fields">
          <div class="form-group pg-fg pg-w2"><%= form.label :name, class: 'field-label' do %>Nome <span class="required">*</span><% end %><%= form.text_field :name, class: 'field-input', required: true, maxlength: 120 %></div>
          <div class="form-group pg-fg pg-w2"><%= form.label :email, class: 'field-label' do %>E-mail <span class="required">*</span><% end %><%= form.email_field :email, class: 'field-input', required: true, maxlength: 160 %></div>
          <div class="form-group pg-fg pg-w2"><%= form.label :phone, 'Telefone', class: 'field-label' %><%= form.telephone_field :phone, class: 'field-input', placeholder: '(00) 00000-0000', maxlength: 15 %><small class="pg-hint">Com DDD. Exemplo: (31) 99999-0000.</small></div>
          <div class="pg-fsec">Alterar senha</div>
          <div class="pg-fnote"><i class="fas fa-circle-info"></i><span>Deixe em branco se não deseja alterar a senha.</span></div>
          <div class="form-group pg-fg pg-w2"><label class="field-label" for="user_password">Nova senha<span class="info-dot" tabindex="0" data-tip="Use de 6 a 128 caracteres.">i</span></label><%= form.password_field :password, class: 'field-input', autocomplete: 'new-password' %></div>
          <div class="form-group pg-fg pg-w2"><%= form.label :password_confirmation, 'Confirmar nova senha', class: 'field-label' %><%= form.password_field :password_confirmation, class: 'field-input', autocomplete: 'new-password' %></div>
        </div>
        <div class="pg-inline-foot">
          <%= link_to 'Voltar', root_path, class: 'btn btn-ghost' %>
          <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i>Salvar alterações</button>
        </div>
      <% end %>
    </div>
    <div class="pg-split-b"><%= render 'my_access' %></div>
  </div>
</div>
