<% me = @user == current_user %>
<% content_for :title, me ? 'Meu Perfil' : 'Editar Usuário' %>

<% if me %>
  <%= hc_page_header 'Meu Perfil', 'Sua foto, seus dados de contato e sua senha.', icon: 'fas fa-user-circle' %>
  <%= render 'self_edit_form' %>
<% else %>
  <div class="users-container">
    <%= hc_page_header 'Editar Usuário', @user.name, icon: 'fas fa-user-edit' do %>
      <%= link_to users_path, class: 'btn btn-secondary' do %><i class="fas fa-arrow-left"></i>Voltar<% end %>
    <% end %>
    <%= render 'form' %>
  </div>
<% end %>
