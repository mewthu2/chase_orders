<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-user me-2"></i>Detalhes do Usuário
          </h5>
        </div>
        <div class="card-body bg-black">
          <div class="row g-4">
            <div class="col-md-6">
              <label class="form-label text-white fw-bold">Nome</label>
              <p class="text-white"><%= @user.name %></p>
            </div>
            <div class="col-md-6">
              <label class="form-label text-white fw-bold">Email</label>
              <p class="text-white"><%= @user.email %></p>
            </div>
            <div class="col-md-6">
              <label class="form-label text-white fw-bold">Telefone</label>
              <p class="text-white"><%= @user.phone.present? ? @user.phone : '-' %></p>
            </div>
            <div class="col-md-6">
              <label class="form-label text-white fw-bold">Perfil</label>
              <p class="text-white">
                <span class="badge <%= case @user.profile_id
                  when 1 then 'bg-warning text-dark'
                  when 2 then 'bg-info text-white'
                  else 'bg-success text-white'
                  end %> px-3 py-2">
                  <%= @user.profile_name %>
                </span>
              </p>
            </div>
            <div class="col-md-6">
              <label class="form-label text-white fw-bold">Status</label>
              <p class="text-white">
                <span class="badge <%= @user.active? ? 'bg-success' : 'bg-danger' %> text-white px-3 py-2">
                  <%= @user.active? ? 'Ativo' : 'Inativo' %>
                </span>
              </p>
            </div>
            <div class="col-md-6">
              <label class="form-label text-white fw-bold">Locations Permitidas</label>
              <div class="d-flex flex-wrap gap-2">
                <% if @user.admin? %>
                  <span class="badge bg-warning text-dark px-2 py-1">
                    <i class="fas fa-crown me-1"></i>Todas (Admin)
                  </span>
                <% elsif @user.allowed_location_keys.any? %>
                  <% @user.allowed_location_keys.each do |key| %>
                    <span class="badge bg-primary text-white px-2 py-1">
                      <%= User.location_name(key) %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-muted">Nenhuma</span>
                <% end %>
              </div>
            </div>
          </div>

          <div class="row mt-5">
            <div class="col-12 d-flex justify-content-between">
              <%= link_to users_path, class: 'btn btn-secondary btn-lg' do %>
                <i class="fas fa-arrow-left me-2"></i> Voltar para Lista
              <% end %>
              
              <% if current_user.profile_id == 1 || @user == current_user %>
                <%= link_to edit_user_path(@user), class: 'btn btn-warning btn-lg' do %>
                  <i class="fas fa-edit me-2"></i> Editar
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.card {
  border-radius: 0.5rem;
}

.form-label {
  font-weight: 500;
  margin-bottom: 0.5rem;
}

.btn-lg {
  padding: 0.75rem 2rem;
  font-size: 1.1rem;
}
</style>
<% end %>
