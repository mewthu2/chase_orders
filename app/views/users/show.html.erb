<% content_for :title, "Detalhes do Usuário" %>

<div class="users-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-user me-2"></i>Detalhes do Usuário
      </h1>
      <p class="page-subtitle"><%= @user.name %></p>
    </div>
    <div class="header-actions">
      <% if current_user.admin? || @user == current_user %>
        <%= link_to edit_user_path(@user), class: "btn-export" do %>
          <i class="fas fa-edit me-2"></i>Editar
        <% end %>
      <% end %>
      <%= link_to users_path, class: "btn-back" do %>
        <i class="fas fa-arrow-left me-1"></i>Voltar
      <% end %>
    </div>
  </div>

  <%# ===== DETALHES ===== %>
  <div class="info-grid">
    <div class="info-section">
      <h6 class="info-section-title"><i class="fas fa-id-card me-2"></i>Dados Pessoais</h6>
      <div class="info-row">
        <span class="info-key">Nome</span>
        <span class="info-val"><%= @user.name %></span>
      </div>
      <div class="info-row">
        <span class="info-key">Email</span>
        <span class="info-val"><%= @user.email %></span>
      </div>
      <div class="info-row">
        <span class="info-key">Telefone</span>
        <span class="info-val"><%= @user.phone.present? ? @user.phone : '-' %></span>
      </div>
      <div class="info-row">
        <span class="info-key">Status</span>
        <span class="info-val">
          <span class="status-pill <%= @user.active? ? 'status-pill--active' : 'status-pill--inactive' %>">
            <%= @user.active? ? 'Ativo' : 'Inativo' %>
          </span>
        </span>
      </div>
    </div>

    <div class="info-section">
      <h6 class="info-section-title"><i class="fas fa-id-badge me-2"></i>Perfis</h6>
      <% if @user.profiles.any? %>
        <div class="location-chip-group">
          <% @user.profiles.each do |profile| %>
            <% profile_class = [1, 2, 5, 6].include?(profile.id) ? "profile-pill--#{profile.id}" : "profile-pill--default" %>
            <span class="profile-pill <%= profile_class %>">
              <%= profile.name %>
            </span>
          <% end %>
        </div>
      <% else %>
        <span class="text-muted-custom">Sem perfil atribuído</span>
      <% end %>
    </div>

    <div class="info-section info-section--full">
      <h6 class="info-section-title"><i class="fas fa-map-marker-alt me-2"></i>Locations Permitidas</h6>
      <% if @user.admin? %>
        <span class="admin-crown-pill">
          <i class="fas fa-crown me-1"></i>Todas (Admin)
        </span>
      <% elsif @user.allowed_location_keys.any? %>
        <div class="location-chip-group">
          <% @user.allowed_location_keys.each do |key| %>
            <span class="location-chip">
              <%= User.location_name(key) %>
            </span>
          <% end %>
        </div>
      <% else %>
        <span class="text-muted-custom">Nenhuma</span>
      <% end %>
    </div>
  </div>

</div>
