<% content_for :title, "Usuários" %>

<div class="users-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-users me-2"></i>Gerenciar Usuários
      </h1>
      <small class="page-subtitle">
        <i class="fas fa-clock me-1"></i>
        Atualizado em <%= Time.current.strftime('%d/%m/%Y às %H:%M') %>
      </small>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-list me-1"></i><%= @total_users %> usuário(s)
      </span>
      <%= link_to new_user_path, class: "btn-export" do %>
        <i class="fas fa-plus me-2"></i>Novo Usuário
      <% end %>
    </div>
  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">

    <div class="table-card-header">
      <h5 class="table-card-title">
        <i class="fas fa-list me-2"></i>Lista de Usuários
      </h5>
    </div>

    <% if @users.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Email</th>
              <th>Telefone</th>
              <th class="text-center">Perfis</th>
              <th class="text-center">Status</th>
              <th>Locations</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td>
                  <div class="user-name-cell">
                    <div class="user-avatar">
                      <i class="fas fa-user"></i>
                    </div>
                    <div>
                      <span class="text-main d-block"><%= user.name %></span>
                      <span class="text-muted-custom">ID: <%= user.id %></span>
                    </div>
                  </div>
                </td>
                <td class="text-main"><%= user.email %></td>
                <td class="text-muted-custom"><%= user.phone.present? ? user.phone : '-' %></td>
                <td class="text-center">
                  <% if user.profiles.any? %>
                    <div class="location-chip-group justify-content-center">
                      <% user.profiles.each do |profile| %>
                        <% profile_class = [1, 2, 5, 6].include?(profile.id) ? "profile-pill--#{profile.id}" : "profile-pill--default" %>
                        <span class="profile-pill <%= profile_class %>">
                          <%= profile.name %>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="profile-pill profile-pill--empty">Sem perfil</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <span class="status-pill <%= user.active? ? 'status-pill--active' : 'status-pill--inactive' %>">
                    <%= user.active? ? 'Ativo' : 'Inativo' %>
                  </span>
                  <% unless user.ticket_notifications_enabled? %>
                    <i class="fas fa-bell-slash ms-1 text-muted-custom" title="Sem e-mails de chamados"></i>
                  <% end %>
                </td>
                <td>
                  <% if user.admin? %>
                    <span class="admin-crown-pill">
                      <i class="fas fa-crown me-1"></i>Todas
                    </span>
                  <% elsif user.allowed_location_keys.any? %>
                    <div class="location-chip-group">
                      <% user.allowed_location_keys.first(2).each do |key| %>
                        <span class="location-chip">
                          <%= User.location_name(key) %>
                        </span>
                      <% end %>
                      <% if user.allowed_location_keys.count > 2 %>
                        <span class="location-chip location-chip--more">
                          +<%= user.allowed_location_keys.count - 2 %>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-muted-custom">Nenhuma</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="table-actions">
                    <%= link_to user, class: "action-btn action-btn--view" do %>
                      <i class="fas fa-eye"></i>
                    <% end %>
                    <%= link_to edit_user_path(user), class: "action-btn action-btn--edit" do %>
                      <i class="fas fa-pencil-alt"></i>
                    <% end %>
                    <% unless user == current_user %>
                      <%= link_to user, method: :delete,
                                  class: "action-btn action-btn--danger",
                                  data: { confirm: "Tem certeza que deseja excluir este usuário?" } do %>
                        <i class="fas fa-trash"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-users fa-3x mb-3 d-block"></i>
        <h5>Nenhum usuário encontrado</h5>
        <p>Crie o primeiro usuário do sistema</p>
        <%= link_to new_user_path, class: "btn-export" do %>
          <i class="fas fa-plus me-1"></i>Novo Usuário
        <% end %>
      </div>
    <% end %>

    <%# PAGINAÇÃO %>
    <% if @total_pages && @total_pages > 1 %>
      <div class="pagination-footer">
        <div class="pagination-info">
          Mostrando
          <strong><%= [(@page - 1) * @per_page + 1, @total_users].min %></strong>
          a
          <strong><%= [@page * @per_page, @total_users].min %></strong>
          de
          <strong><%= @total_users %></strong>
          usuários
        </div>

        <div class="pagination-controls">
          <% if @page > 1 %>
            <%= link_to users_path(request.query_parameters.merge("page" => @page - 1)),
                        class: "page-btn" do %>
              <i class="fas fa-chevron-left me-1"></i>Anterior
            <% end %>
          <% end %>

          <% window  = 2
             p_start = [@page - window, 1].max
             p_end   = [@page + window, @total_pages].min %>

          <% (p_start..p_end).each do |pnum| %>
            <% if pnum == @page %>
              <span class="page-btn page-btn--active"><%= pnum %></span>
            <% else %>
              <%= link_to pnum,
                          users_path(request.query_parameters.merge("page" => pnum)),
                          class: "page-btn" %>
            <% end %>
          <% end %>

          <% if @page < @total_pages %>
            <%= link_to users_path(request.query_parameters.merge("page" => @page + 1)),
                        class: "page-btn" do %>
              Próxima<i class="fas fa-chevron-right ms-1"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

</div>
