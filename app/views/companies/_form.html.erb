<%= form_with model: @company, local: true, multipart: true, class: 'needs-validation', novalidate: true do |form| %>
  <% if @company.errors.any? %>
    <div class="form-error-box">
      <i class="fas fa-exclamation-triangle me-2"></i>
      <ul class="mb-0 mt-1">
        <% @company.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-section">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-id-badge me-2"></i>Identificação</h5>
    </div>
    <div class="form-section-body">
      <div class="form-grid">
        <div class="form-col-6">
          <label class="field-label">Razão social <span class="required">*</span></label>
          <%= form.text_field :legal_name, class: "field-input #{'field-input--error' if @company.errors[:legal_name].any?}", required: true %>
        </div>
        <div class="form-col-6">
          <label class="field-label">Nome fantasia</label>
          <%= form.text_field :trade_name, class: "field-input" %>
        </div>
        <div class="form-col-4">
          <label class="field-label">CNPJ <span class="required">*</span></label>
          <%= form.text_field :cnpj, value: (@company.cnpj.present? ? @company.cnpj_formatted : nil), class: "field-input #{'field-input--error' if @company.errors[:cnpj].any?}", required: true, placeholder: "00.000.000/0000-00" %>
        </div>
        <div class="form-col-4">
          <label class="field-label">Inscrição Estadual</label>
          <%= form.text_field :state_registration, class: "field-input" %>
        </div>
        <div class="form-col-4">
          <label class="field-label">Inscrição Municipal</label>
          <%= form.text_field :municipal_registration, class: "field-input" %>
        </div>
        <div class="form-col-4">
          <label class="field-label">CNAE</label>
          <%= form.text_field :cnae, class: "field-input", maxlength: 7 %>
        </div>
        <div class="form-col-7">
          <label class="field-label">Regime tributário <span class="required">*</span></label>
          <%= form.select :tax_regime, Company::TAX_REGIMES.map { |code, label| ["#{code} - #{label}", code] }, {}, { class: "field-input" } %>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-map-marker-alt me-2"></i>Endereço</h5>
    </div>
    <div class="form-section-body">
      <div class="form-grid">
        <div class="form-col-6">
          <label class="field-label">Rua <span class="required">*</span></label>
          <%= form.text_field :street, class: "field-input", required: true %>
        </div>
        <div class="form-col-2">
          <label class="field-label">Número <span class="required">*</span></label>
          <%= form.text_field :number, class: "field-input", required: true %>
        </div>
        <div class="form-col-4">
          <label class="field-label">Complemento</label>
          <%= form.text_field :complement, class: "field-input" %>
        </div>
        <div class="form-col-4">
          <label class="field-label">Bairro <span class="required">*</span></label>
          <%= form.text_field :neighbourhood, class: "field-input", required: true %>
        </div>
        <div class="form-col-4">
          <label class="field-label">Cidade <span class="required">*</span></label>
          <%= form.text_field :city, class: "field-input", required: true %>
        </div>
        <div class="form-col-2">
          <label class="field-label">UF <span class="required">*</span></label>
          <%= form.text_field :state, class: "field-input", required: true, maxlength: 2 %>
        </div>
        <div class="form-col-2">
          <label class="field-label">CEP <span class="required">*</span></label>
          <%= form.text_field :zip, class: "field-input", required: true %>
        </div>
        <div class="form-col-4">
          <label class="field-label">Código IBGE do município <span class="required">*</span></label>
          <%= form.text_field :city_ibge_code, class: "field-input #{'field-input--error' if @company.errors[:city_ibge_code].any?}", required: true, maxlength: 7, placeholder: "3106200" %>
        </div>
        <div class="form-col-4">
          <label class="field-label">Telefone</label>
          <%= form.text_field :phone, class: "field-input" %>
        </div>
        <div class="form-col-4">
          <label class="field-label">E-mail</label>
          <%= form.text_field :email, class: "field-input" %>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-file-invoice me-2"></i>Emissão da NF-e</h5>
    </div>
    <div class="form-section-body">
      <div class="form-grid">
        <div class="form-col-4">
          <label class="field-label">Ambiente <span class="required">*</span></label>
          <%= form.select :environment, [['Homologação (sem valor fiscal)', 'homologacao'], ['Produção', 'producao']], {}, { class: "field-input" } %>
        </div>
        <div class="form-col-2">
          <label class="field-label">Série <span class="required">*</span></label>
          <%= form.number_field :nfe_series, class: "field-input", min: 1 %>
        </div>
        <div class="form-col-3">
          <label class="field-label">Próximo número (produção) <span class="required">*</span></label>
          <%= form.number_field :next_nfe_number, class: "field-input", min: 1 %>
        </div>
        <div class="form-col-3">
          <label class="field-label">Próximo número (homologação) <span class="required">*</span></label>
          <%= form.number_field :next_nfe_number_homologation, class: "field-input", min: 1 %>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section" id="loja">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-store me-2"></i>Loja desta empresa</h5>
    </div>
    <div class="form-section-body">
      <% company_names = Company.where.not(id: @company.id).to_h { |c| [c.id, c.selection_label] } %>
      <% options = Location.order(:name).map { |l| [company_names[l.company_id] ? "#{l.name} (hoje: #{company_names[l.company_id]})" : l.name, l.id] } %>
      <div class="field-group" style="max-width: 420px">
        <%= form.label :location_id, 'Loja', class: 'field-label' %>
        <%= form.select :location_id, options, { include_blank: 'Nenhuma loja' }, class: 'field-input' %>
      </div>
      <span class="text-muted-custom d-block mt-2"><i class="fas fa-info-circle me-1"></i>Na Transferência Interna, a empresa da loja de origem emite a NF-e de transferência para a empresa da loja de destino. Cada empresa tem uma loja e cada loja, uma empresa: escolher uma loja que está em outra empresa tira ela de lá.</span>
    </div>
  </div>

  <div class="form-section" id="naturezas">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-sliders-h me-2"></i>Naturezas de operação</h5>
    </div>
    <div class="form-section-body">
      <p class="text-muted-custom mb-3"><i class="fas fa-info-circle me-1"></i>Marque as naturezas que esta empresa usa. Na hora de emitir a nota você escolhe uma delas, e o CFOP e a tributação vêm da natureza escolhida.</p>
      <% natures = OperationNature.active.includes(:company).order(:kind, :description) %>
      <% linked = params.dig(:company, :nature_ids)&.map(&:to_i) || @company.available_nature_ids %>
      <%= hidden_field_tag 'company[nature_ids][]', '', id: nil %>
      <% if natures.any? %>
        <div class="nature-pick">
          <% natures.group_by(&:kind).each do |kind, list| %>
            <div class="nature-pick-group">
              <h6><%= OperationNature::KINDS[kind] %></h6>
              <% list.each do |n| %>
                <% ok = @company.tax_regime.blank? || n.compatible_with?(@company) %>
                <label class="nature-pick-item<%= ' is-disabled' unless ok %>">
                  <input type="checkbox" name="company[nature_ids][]" value="<%= n.id %>" <%= 'checked' if linked.include?(n.id) %> <%= 'disabled' unless ok %>>
                  <span class="nature-pick-body">
                    <strong><%= n.description %><% if n.default_for_kind? %> <em class="nature-pick-tag">padrão</em><% end %></strong>
                    <small>CFOP <%= n.cfop %><%= " / #{n.cfop_interstate_non_contributor}" if n.cfop_interstate_non_contributor.present? %> · ICMS <%= n.icms_situation %> · PIS <%= n.pis_cst %> · COFINS <%= n.cofins_cst %> · criada em <%= n.company.trade_name.presence || n.company.legal_name %></small>
                    <% unless ok %><small class="nature-pick-warn">Usa <%= n.regime_label %>: não serve para o regime desta empresa.</small><% end %>
                  </span>
                </label>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted-custom">Nenhuma natureza de operação criada ainda.</p>
      <% end %>
      <%= link_to operation_natures_path, class: 'btn-export mt-3 d-inline-flex' do %><i class="fas fa-sliders-h me-2"></i>Criar ou editar naturezas<% end %>
    </div>
  </div>

  <div class="form-section" id="certificado">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-key me-2"></i>Certificado digital A1</h5>
    </div>
    <div class="form-section-body">
      <% if @company.persisted? %>
        <p class="text-muted-custom mb-3">
          Situação atual: <%= certificate_badge(@company) %>
          <% if @company.certificate_expires_at.present? %>
            <span class="ms-2">Válido até <%= l(@company.certificate_expires_at.in_time_zone, format: '%d/%m/%Y') %></span>
          <% end %>
        </p>
      <% end %>
      <div class="form-grid">
        <div class="form-col-6">
          <label class="field-label">Arquivo do certificado (.pfx / .p12)</label>
          <%= form.file_field :certificate_file, accept: '.pfx,.p12', class: "field-input" %>
        </div>
        <div class="form-col-6">
          <label class="field-label">Senha do certificado</label>
          <%= form.password_field :certificate_password, value: nil, autocomplete: 'new-password', class: "field-input #{'field-input--error' if @company.errors[:certificate_password].any?}" %>
          <% if @company.persisted? %>
            <span class="text-muted-custom d-block mt-1"><i class="fas fa-info-circle me-1"></i>Deixe em branco para manter o certificado atual.</span>
          <% end %>
        </div>
      </div>
      <span class="text-muted-custom d-block mt-2"><i class="fas fa-lock me-1"></i>O arquivo fica em armazenamento privado e a senha é criptografada. O CNPJ do certificado precisa ser o mesmo da empresa.</span>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-toggle-on me-2"></i>Status</h5>
    </div>
    <div class="form-section-body">
      <div class="form-check form-switch">
        <%= form.check_box :active, class: 'form-check-input', role: 'switch' %>
        <label class="form-check-label text-main fw-bold">Ativa</label>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit (@company.new_record? ? 'Criar Empresa' : 'Salvar Alterações'), class: "btn-submit" %>
    <%= link_to "Cancelar", companies_path, class: "btn-cancel" %>
  </div>
<% end %>
