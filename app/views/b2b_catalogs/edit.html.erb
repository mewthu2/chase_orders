<% content_for :title, "Editar #{@catalog.title}" %>
<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon 'fas fa-book-open' %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title"><%= @catalog.title %></h1>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
<%= link_to b2b_catalog_path(@catalog), class: 'btn-back' do %><i class="fas fa-arrow-left me-1"></i>Voltar<% end %>
    </div>
  </div>
  <%= render 'form' %>
</div>
