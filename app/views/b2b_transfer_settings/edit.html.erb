<% content_for :title, copy[:title] %>
<% issuer_col, nature_col = B2bSetting::TRANSFER_KINDS.fetch(order_kind) %>
<% company = @setting.issuer(order_kind) %>
<% nature = @setting.nature_for(order_kind) %>
<% natures = OperationNature.transfer.where(active: true).order(:description).to_a %>

<%= hc_page_header copy[:title], "Como sai a nota fiscal #{copy[:what]}", icon: 'fas fa-sliders-h' do %>
  <%= link_to send(copy[:back]), class: 'btn btn-secondary' do %><i class="fas fa-arrow-left"></i>Voltar<% end %>
<% end %>

<div class="pg-blocks">
  <div class="pg-split" style="--cols: 1.3fr 1fr">
    <div class="pg-split-a">
      <%= form_with model: @setting, url: send("#{order_kind}_settings_path"), method: :patch, local: true, class: 'panel pg-card pg-inline', id: 'pgForm' do |form| %>
        <h3><i class="fas fa-file-invoice"></i>Nota fiscal</h3>
        <% if @setting.errors.any? %>
          <div class="pg-fnote is-warn"><i class="fas fa-triangle-exclamation"></i><span><%= @setting.errors.full_messages.to_sentence %></span></div>
        <% end %>
        <div class="pg-fields">
          <div class="form-group pg-fg pg-w2">
            <label class="field-label" for="b2b_setting_<%= issuer_col %>_id">Empresa emissora</label>
            <%= form.select :"#{issuer_col}_id", Company.order(:id).map { |c| ["#{c.selection_label} · #{c.environment_label.downcase}", c.id] },
                            { selected: company&.id, include_blank: 'Selecione...' }, class: 'field-input' %>
          </div>
          <div class="form-group pg-fg pg-w2">
            <label class="field-label" for="b2b_setting_<%= nature_col %>_id">Natureza da operação</label>
            <%= form.select :"#{nature_col}_id", natures.map { |n| ["#{n.description} · CFOP #{n.cfop} · #{n.regime_label}", n.id] },
                            { selected: nature&.id, include_blank: 'Selecione...' }, class: 'field-input' %>
          </div>
          <div class="pg-fnote"><i class="fas fa-circle-info"></i><span>O CFOP, os impostos e as observações da nota vêm da natureza. Ambiente, série, numeração, certificado e naturezas ficam em <%= link_to 'Empresas', companies_path %>. Ao salvar, a natureza fica vinculada à empresa.</span></div>
        </div>
        <% if order_kind == 'stock_transfer' %>
          <% remessa_company = @setting.remessa_issuer %>
          <div class="rr-section">
            <h3><i class="fas fa-warehouse"></i>Nota de remessa</h3>
            <p class="rr-intro">Uma nota a mais de cada abastecimento (ex.: <b>5905 - Remessa para depósito fechado ou armazém geral</b>, para o depósito do Correios). A nota de transferência para a loja continua sendo a que vai ao Correios.</p>
            <div class="pg-fields">
              <div class="form-group pg-fg pg-w2">
                <label class="field-label" for="b2b_setting_remessa_issuer_company_id">Empresa emissora</label>
                <%= form.select :remessa_issuer_company_id, Company.order(:id).map { |c| ["#{c.selection_label} · #{c.environment_label.downcase}", c.id] },
                                { selected: @setting.remessa_issuer_company_id, include_blank: "A do abastecimento#{" (#{company.trade_name.presence || company.legal_name})" if company}" }, class: 'field-input' %>
              </div>
              <div class="form-group pg-fg pg-w2">
                <label class="field-label" for="b2b_setting_remessa_nature_id">Natureza da operação</label>
                <%= form.select :remessa_nature_id, OperationNature.where(active: true).order(:description).map { |n| ["#{n.description} · CFOP #{n.cfop} · #{n.regime_label}", n.id] },
                                { selected: @setting.remessa_nature_id, include_blank: 'Selecione...' }, class: 'field-input' %>
                <% if @setting.remessa_nature.nil? %><span class="text-muted-custom d-block mt-1">Sem a natureza de remessa? Cadastre em <%= link_to 'Naturezas de operação', operation_natures_path %> (CFOP 5905, ICMS 41).</span><% end %>
              </div>
            </div>
            <span class="field-label rr-label">Destinatário padrão</span>
            <p class="rr-intro">Já vem em cada pedido. Para um pedido só, dá para trocar na aba Nota fiscal dele.</p>
            <%= render 'b2b_orders/remessa_recipient_fields', scope: 'b2b_setting[remessa_recipient]', data: @setting.remessa_recipient_data %>
          </div>
        <% end %>
        <div class="pg-inline-foot">
          <%= link_to 'Cancelar', send(copy[:back]), class: 'btn btn-ghost' %>
          <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i>Salvar</button>
        </div>
      <% end %>
    </div>
    <div class="pg-split-b">
      <div class="panel pg-card pg-howto">
        <h3><i class="fas fa-list-ol"></i>Como a nota sai</h3>
        <ol>
          <% ['O pedido é <b>aprovado</b> em Log02 › Pedidos p/ Aprovar e o Honey cria no <b>Correios</b>.',
              'Na etapa do XML, o Honey <b>emite a NF-e</b> com esta empresa e natureza e autoriza na <b>SEFAZ</b>.',
              'O XML autorizado vai ao <b>Correios</b>, que libera a etiqueta.',
              'Se precisar, dá para emitir antes pela letra <b>N</b> da lista (aba Nota fiscal do pedido).'].each_with_index do |text, i| %>
            <li style="--i: <%= i %>"><span class="n"><%= i + 1 %></span><span><%= text.html_safe %></span></li>
          <% end %>
        </ol>
      </div>
      <% if company %>
        <div class="callout pg-banner <%= company.producao? ? 'is-info' : 'is-warn' %>"><i class="fas fa-building"></i><div>
          <strong><%= company.trade_name.presence || company.legal_name %> está em <%= company.environment_label.downcase %>.</strong>
          <%= company.producao? ? "Próxima nota: nº #{company.current_nfe_number('producao')}, série #{company.nfe_series}." : 'Ligue a produção em Empresas para a nota valer e o Log02 mandar o XML ao Correios.' %>
        </div></div>
      <% end %>
    </div>
  </div>
</div>
