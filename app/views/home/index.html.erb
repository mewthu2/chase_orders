<% title 'Início' %>
<%# Tela inicial: a busca "O que você precisa hoje?" sobre as telas liberadas para a pessoa (a mesma lista do Ctrl + K). %>
<% search = nav_search_data %>
<% areas = search[:screens].group_by { |s| s[:area] } %>
<% first_name = current_user.name.to_s.split.first %>
<% hour = Time.current.hour %>
<% hello = hour < 12 ? 'Bom dia' : (hour < 18 ? 'Boa tarde' : 'Boa noite') %>

<section class="home-hero">
  <div class="home-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
  <p class="home-hello"><%= hello %><%= ", #{first_name}" if first_name.present? %> 👋</p>
  <h1 class="home-title">O que você precisa hoje?</h1>
  <label class="home-search">
    <i class="fas fa-search"></i>
    <input id="homeSearch" type="search" placeholder="Ex.: boleto, rastreio, nota fiscal, comissão…" autocomplete="off" spellcheck="false" autofocus>
    <kbd>Enter</kbd>
  </label>
  <p class="home-hint">Digite o que quer fazer e aperte Enter para abrir a primeira tela. Em qualquer lugar, <kbd>Ctrl</kbd> + <kbd>K</kbd> abre esta busca.</p>
</section>

<div class="home-results" id="homeResults">
  <% if search[:extras].any? %>
    <section class="home-group" data-home-group>
      <h2><i class="fas fa-bolt"></i>Ações rápidas</h2>
      <div class="home-tiles stagger">
        <% search[:extras].each_with_index do |s, i| %>
          <a class="home-tile spot" href="<%= s[:url] %>" style="--i: <%= i %>" data-hay="<%= HoneyTable.norm([s[:label], s[:desc], s[:keys], s[:path]].join(' ')) %>">
            <span class="home-tile-ic"><i class="<%= s[:icon] %>"></i></span>
            <span class="home-tile-t"><b><%= s[:label] %></b><small><%= s[:desc] %></small></span>
          </a>
        <% end %>
      </div>
    </section>
  <% end %>
  <% Screen::AREAS.each do |key, area| %>
    <% items = areas[key] or next %>
    <section class="home-group" data-home-group style="<%= nav_area_style(area) %>">
      <h2><i class="<%= area[:icon] %>"></i><%= area[:title] %><small><%= area[:desc] %></small></h2>
      <div class="home-tiles stagger">
        <% items.each_with_index do |s, i| %>
          <a class="home-tile spot" href="<%= s[:url] %>" style="--i: <%= i %>" data-hay="<%= HoneyTable.norm([s[:label], s[:desc], s[:keys], s[:path]].join(' ')) %>">
            <span class="home-tile-ic"><i class="<%= s[:icon] %>"></i></span>
            <span class="home-tile-t"><b><%= s[:label] %></b><small><%= s[:desc] %></small></span>
          </a>
        <% end %>
      </div>
    </section>
  <% end %>
  <div class="home-empty" id="homeEmpty" hidden>
    <i class="fas fa-binoculars"></i>
    <b>Nada encontrado</b>
    <span>Tente outra palavra ou abra o <a href="#" data-act="map">Mapa do sistema</a>.</span>
  </div>
</div>

<script>
  (function () {
    var input = document.getElementById('homeSearch');
    if (!input) return;
    var norm = function (t) { return (t || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); };
    var tiles = Array.prototype.slice.call(document.querySelectorAll('.home-tile'));
    var groups = document.querySelectorAll('[data-home-group]');
    var empty = document.getElementById('homeEmpty');
    function filter () {
      var words = norm(input.value.trim()).split(/\s+/).filter(Boolean);
      tiles.forEach(function (t) {
        var hay = t.dataset.hay;
        t.hidden = words.length > 0 && !words.every(function (w) { return hay.indexOf(w) >= 0; });
      });
      groups.forEach(function (g) { g.hidden = !g.querySelector('.home-tile:not([hidden])'); });
      empty.hidden = tiles.some(function (t) { return !t.hidden; });
      document.body.classList.toggle('home-searching', words.length > 0);
    }
    input.addEventListener('input', filter);
    input.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;
      var first = tiles.find(function (t) { return !t.hidden; });
      if (first) { e.preventDefault(); window.location.href = first.href; }
    });
  })();
</script>
