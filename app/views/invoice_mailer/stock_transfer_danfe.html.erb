<% location = @order.transfer_location %>
<% units = @items.sum { |item| item.quantity.to_i } %>
<% shown = @items.first(8) %>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title><%= message.subject %></title>
    <%# Animações rodam no Apple Mail / iOS Mail; Gmail e Outlook ignoram e mostram a versão estática. %>
    <style>
      @keyframes shimmer { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
      @keyframes drive { 0% { transform: translateX(-6px); } 50% { transform: translateX(6px); } 100% { transform: translateX(-6px); } }
      @keyframes bounce { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-7px); } 60% { transform: translateY(-3px); } }
      @keyframes beat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.3); } 30% { transform: scale(1); } 45% { transform: scale(1.2); } }
      @keyframes glow { 0%, 100% { box-shadow: 0 0 0 0 rgba(63,185,80,.45); } 50% { box-shadow: 0 0 0 10px rgba(63,185,80,0); } }
      @media screen {
        .shimmer { background-size: 300% 300% !important; animation: shimmer 8s ease infinite; }
        .hero-emoji { display: inline-block; animation: bounce 2.4s ease-in-out infinite; }
        .truck { display: inline-block; animation: drive 2.6s ease-in-out infinite; }
        .heart { display: inline-block; animation: beat 1.4s ease-in-out infinite; }
        .attach { animation: glow 2.2s ease-out infinite; }
      }
      @media (prefers-reduced-motion: reduce) {
        .shimmer, .hero-emoji, .truck, .heart, .attach { animation: none !important; }
      }
      @media (max-width: 480px) {
        .px { padding-left: 18px !important; padding-right: 18px !important; }
        .hero-title { font-size: 20px !important; }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background:#eef1f6;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2937;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">DANFE da nota <%= @number %> em anexo<%= " · #{units} peça(s) a caminho de #{location.name}" if location %></div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#eef1f6;">
      <tr>
        <td align="center" style="padding:28px 12px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 30px rgba(15,23,42,.08);">

            <tr>
              <td class="shimmer px" bgcolor="#0d1117" style="padding:22px 28px;background-color:#0d1117;background-image:linear-gradient(120deg,#0d1117 0%,#0f5132 40%,#1f6feb 75%,#0d1117 100%);">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td><%= image_tag attachments['chase-logo.png'].url, alt: 'Chase', height: 44, style: 'display:block;height:44px;border:0;' %></td>
                    <td align="right">
                      <span style="display:inline-block;padding:5px 12px;border-radius:999px;background:rgba(255,255,255,.12);color:#e6edf3;font-size:12px;font-weight:600;letter-spacing:.4px;">🏬 Abastecimento de Lojas</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding:30px 28px 8px;border-top:5px solid #3fb950;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="72" valign="middle">
                      <div style="width:60px;height:60px;line-height:60px;text-align:center;border-radius:18px;font-size:32px;background:#3fb9501f;">
                        <span class="hero-emoji">📦</span>
                      </div>
                    </td>
                    <td valign="middle">
                      <div class="hero-title" style="font-size:23px;font-weight:800;color:#111827;line-height:1.25;">A nota do seu abastecimento chegou!</div>
                      <div style="margin-top:4px;font-size:13px;color:#6b7280;">
                        NF-e <strong style="color:#1a7f37;">nº <%= @number %></strong><% if @order.tiny_reference_number.present? %> · Pedido Tiny nº <%= @order.tiny_reference_number %><% end %>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding:22px 28px 4px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-radius:14px;background:#f6f8fa;border:1px solid #e5e7eb;">
                  <tr>
                    <td style="padding:16px 18px;font-size:14px;line-height:1.7;color:#374151;">
                      <div style="font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px;">
                        <span class="truck">🚚</span>&nbsp; Rota do abastecimento
                      </div>
                      <div><strong>🏭 Saída:</strong> Centro de distribuição Chase</div>
                      <% if location %>
                        <div><strong>📍 Destino:</strong> <%= location.name %><% if location.city.present? %> · <%= location.city %>/<%= location.state %><% end %></div>
                      <% end %>
                      <% if @order.receiver_name.present? %>
                        <div><strong>🙋 Quem recebe:</strong> <%= @order.receiver_name %></div>
                      <% end %>
                      <% if @order.tracking_code.present? %>
                        <div><strong>🔎 Rastreio:</strong> <%= @order.tracking_code %></div>
                      <% end %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding:18px 28px 4px;">
                <div style="font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px;">
                  🧺 <%= units %> peça(s) em <%= @items.size %> item(ns)
                </div>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:13px;border-collapse:collapse;">
                  <% shown.each_with_index do |item, index| %>
                    <tr style="background:<%= index.even? ? '#ffffff' : '#f9fafb' %>;">
                      <td style="padding:8px 10px;border-bottom:1px solid #eef0f3;color:#6b7280;font-family:Menlo,Consolas,monospace;white-space:nowrap;"><%= item.sku %></td>
                      <td style="padding:8px 10px;border-bottom:1px solid #eef0f3;color:#111827;"><%= item.name %></td>
                      <td align="right" style="padding:8px 10px;border-bottom:1px solid #eef0f3;white-space:nowrap;">
                        <span style="display:inline-block;padding:2px 9px;border-radius:999px;background:#ddf4e4;color:#1a7f37;font-weight:700;">× <%= item.quantity %></span>
                      </td>
                    </tr>
                  <% end %>
                </table>
                <% if @items.size > shown.size %>
                  <div style="margin-top:8px;font-size:12px;color:#6b7280;">✨ e mais <%= @items.size - shown.size %> item(ns) — a lista completa está no DANFE.</div>
                <% end %>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding:20px 28px 28px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="attach" style="padding:16px 18px;border-radius:14px;background:#0d1117;color:#e6edf3;font-size:14px;line-height:1.6;">
                      <span style="font-size:22px;vertical-align:middle;">📎</span>&nbsp;
                      <strong>DANFE-<%= @number %>.pdf</strong> está em anexo.
                      <div style="font-size:12px;color:#8b949e;margin-top:2px;">Confira as peças na chegada e assine o canhoto do DANFE. 💪</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="shimmer" height="5" bgcolor="#3fb950" style="height:5px;line-height:5px;font-size:0;background-color:#3fb950;background-image:linear-gradient(90deg,#3fb950,#1f6feb,#8957e5,#e3b341,#3fb950);">&nbsp;</td>
            </tr>
            <tr>
              <td class="px" bgcolor="#0d1117" style="padding:24px 28px;background-color:#0d1117;text-align:center;">
                <div style="font-size:22px;letter-spacing:6px;">🏭 <span class="truck">🚚</span> 🏬</div>
                <div style="margin:12px 0 0;font-size:14px;color:#e6edf3;font-weight:600;">Feito com <span class="heart">💛</span> pelo time Chase</div>
                <div style="margin:8px 0 0;font-size:11px;line-height:1.6;color:#6e7681;">
                  Enviado pelo ChaseOrders<%= " por #{@sender}" if @sender.present? %>.<br>
                  Dúvidas sobre este abastecimento? É só responder este e-mail.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
