<div class="container-fluid py-4">
  <!-- Header com Estatísticas -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center flex-wrap">
          <div>
            <h4 class="text-white mb-1">
              <i class="fas fa-boxes me-2"></i>Inventário de Produtos
            </h4>
            <small class="text-white-50">
              <i class="fas fa-clock me-1"></i>
              Última atualização: <%= Time.current.strftime('%d/%m/%Y às %H:%M') %>
            </small>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <%= link_to new_stock_correction_path, class: "btn btn-success" do %>
              <i class="fas fa-plus me-1"></i>Nova Conferência
            <% end %>
            <%= link_to stock_corrections_path, class: "btn btn-info" do %>
              <i class="fas fa-history me-1"></i>Histórico
            <% end %>
            <%= link_to inventory_products_path, class: "btn btn-outline-light" do %>
              <i class="fas fa-sync-alt me-1"></i>Atualizar
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filtros e Busca -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body bg-black">
          <%= form_with url: inventory_products_path, method: :get, local: true, 
                        class: "row g-3 align-items-end" do |f| %>
            <div class="col-md-3">
              <label class="form-label text-white fw-bold">Location</label>
              <%= f.select :location, 
                          options_for_select(current_user.available_locations_for_user, params[:location]),
                          { include_blank: "Todas as locations" },
                          { class: "form-select bg-dark text-white border-dark" } %>
            </div>
            <div class="col-md-3">
              <label class="form-label text-white fw-bold">Buscar</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-dark text-white">
                  <i class="fas fa-search"></i>
                </span>
                <%= f.text_field :search, 
                                 placeholder: "ID, SKU, nome...", 
                                 value: params[:search],
                                 class: "form-control bg-dark text-white border-dark" %>
              </div>
            </div>
            <div class="col-md-2">
              <label class="form-label text-white fw-bold">Fonte</label>
              <%= f.select :fonte, 
                          options_for_select([
                            ['Todas', ''],
                            ['Shopify', 'shopify'],
                            ['Manual', 'manual'],
                            ['Importação', 'import']
                          ], params[:fonte]),
                          {},
                          { class: "form-select bg-dark text-white border-dark" } %>
            </div>
            <div class="col-md-2">
              <%= f.submit "Filtrar", class: "btn btn-primary w-100" %>
            </div>
            <div class="col-md-2">
              <%= link_to inventory_products_path, class: "btn btn-outline-light w-100" do %>
                <i class="fas fa-times me-1"></i>Limpar
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabela de Produtos -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-list me-2"></i>Produtos em Estoque
          </h5>
          <span class="badge bg-info text-dark px-3 py-2">
            <i class="fas fa-cube me-1"></i>
            <%= @total_products %> produto(s)
          </span>
        </div>
        
        <div class="card-body bg-black p-0">
          <% if @products.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-3 py-3">
                      <%= link_to inventory_products_path(sort: 'id', direction: next_direction('id')), 
                                  class: "text-white text-decoration-none" do %>
                        ID <i class="fas fa-sort ms-1"></i>
                      <% end %>
                    </th>
                    <th class="text-white fw-bold px-3 py-3">
                      <%= link_to inventory_products_path(sort: 'sku', direction: next_direction('sku')), 
                                  class: "text-white text-decoration-none" do %>
                        SKU <i class="fas fa-sort ms-1"></i>
                      <% end %>
                    </th>
                    <th class="text-white fw-bold px-3 py-3">Produto</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Lagoa Seca</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">BH Shopping</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Rio de Janeiro</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Fonte</th>
                  </tr>
                </thead>
                <tbody>
                  <% @products.each do |product| %>
                    <tr class="border-secondary">
                      <td class="px-3 py-3">
                        <span class="text-white font-monospace">
                          <%= product.id %>
                        </span>
                      </td>
                      <td class="px-3 py-3">
                        <span class="text-white font-monospace">
                          <%= product.sku %>
                        </span>
                      </td>
                      <td class="px-3 py-3">
                        <div>
                          <span class="text-white fw-medium d-block">
                            <%= truncate(product.title, length: 40) %>
                          </span>
                          <% if product.shopify_variant_id.present? %>
                            <small class="text-white-50">
                              <i class="fab fa-shopify me-1"></i>ID: <%= product.shopify_variant_id %>
                            </small>
                          <% end %>
                        </div>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <span class="badge <%= stock_badge_class(product.stock_lagoa_seca) %> px-2 py-1">
                          <%= extract_stock_value(product.stock_lagoa_seca) %> un.
                        </span>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <span class="badge <%= stock_badge_class(product.stock_bh_shopping) %> px-2 py-1">
                          <%= extract_stock_value(product.stock_bh_shopping) %> un.
                        </span>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <span class="badge <%= stock_badge_class(product.stock_rj) %> px-2 py-1">
                          <%= extract_stock_value(product.stock_rj) %> un.
                        </span>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <span class="badge bg-secondary text-white px-2 py-1">
                          <%= product.fonte&.humanize || 'N/A' %>
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-search fa-3x text-white-50 mb-3"></i>
              <h5 class="text-white-50">Nenhum produto encontrado</h5>
              <p class="text-white-50">Tente ajustar os filtros de busca</p>
            </div>
          <% end %>
        </div>

        <!-- Paginação -->
        <% if @total_pages > 1 %>
          <div class="card-footer bg-dark border-top border-secondary">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
              <div class="text-white-50 mb-2 mb-md-0">
                Mostrando <%= (@current_page - 1) * @per_page + 1 %> a 
                <%= [@current_page * @per_page, @total_products].min %> de 
                <%= @total_products %> produtos
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <% if @current_page > 1 %>
                  <%= link_to inventory_products_path(page: @current_page - 1, **request.query_parameters.except('page')),
                              class: "btn btn-outline-light btn-sm" do %>
                    <i class="fas fa-chevron-left"></i> Anterior
                  <% end %>
                <% end %>

                <% page_start = [[@current_page - 2, 1].max, [@total_pages - 4, 1].max].max %>
                <% page_end = [[page_start + 4, @total_pages].min, [@current_page + 2, @total_pages].min].max %>
                
                <% (page_start..page_end).each do |page_num| %>
                  <% if page_num == @current_page %>
                    <button class="btn btn-primary btn-sm"><%= page_num %></button>
                  <% else %>
                    <%= link_to page_num, 
                                inventory_products_path(page: page_num, **request.query_parameters.except('page')),
                                class: "btn btn-outline-light btn-sm" %>
                  <% end %>
                <% end %>

                <% if @current_page < @total_pages %>
                  <%= link_to inventory_products_path(page: @current_page + 1, **request.query_parameters.except('page')),
                              class: "btn btn-outline-light btn-sm" do %>
                    Próxima <i class="fas fa-chevron-right"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.form-control, .form-select {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
}

.form-control:focus, .form-select:focus {
  background-color: #495057;
  border-color: #6c757d;
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.075);
}

.font-monospace {
  font-family: 'Courier New', monospace;
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.badge {
  font-weight: 500;
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
}

/* Responsividade */
@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.875rem;
  }

  .btn-sm {
    padding: 0.2rem 0.4rem;
    font-size: 0.8rem;
  }
}
</style>
<% end %>
