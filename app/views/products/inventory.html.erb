<div id="loadingOverlay" class="loading-overlay">
  <div class="loading-content">
    <div class="loading-spinner">
      <div class="spinner-ring"></div>
      <div class="spinner-ring"></div>
      <div class="spinner-ring"></div>
      <div class="spinner-ring"></div>
    </div>
    <div class="loading-text">
      <h4 class="text-white mb-2">Processando...</h4>
      <p class="text-white-50 mb-0" id="loadingMessage">Consultando estoque em tempo real via StockService...</p>
    </div>
  </div>
</div>

<div class="container-fluid py-4">
  <% content_for :title, 'Controle de Estoque' %>
  <%= render 'layouts/partials/messages' if defined?(render) %>

  <!-- Tutorial/Ajuda -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-primary shadow-lg">
        <div class="card-header bg-primary">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="text-dark mb-0">
              <i class="fas fa-question-circle me-2"></i>Como usar o Controle de Estoque
            </h6>
            <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#helpCollapse">
              <i class="fas fa-chevron-down"></i>
            </button>
          </div>
        </div>
        <div class="collapse" id="helpCollapse">
          <div class="card-body bg-black">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="help-item">
                  <div class="help-icon bg-primary">
                    <i class="fas fa-search"></i>
                  </div>
                  <div class="help-content">
                    <h6 class="text-white mb-1">Buscar Produtos</h6>
                    <small class="text-primary">Digite ID, SKU, Inventory Item ID ou Custo para encontrar produtos específicos</small>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="help-item">
                  <div class="help-icon bg-warning">
                    <i class="fas fa-clipboard-check"></i>
                  </div>
                  <div class="help-content">
                    <h6 class="text-white mb-1">Nova Conferência</h6>
                    <small class="text-primary">Inicia uma conferência de estoque para verificar e corrigir divergências</small>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="help-item">
                  <div class="help-icon bg-info">
                    <i class="fas fa-history"></i>
                  </div>
                  <div class="help-content">
                    <h6 class="text-white mb-1">Histórico</h6>
                    <small class="text-primary">Visualiza todas as conferências realizadas e seus resultados</small>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="help-item">
                  <div class="help-icon bg-success">
                    <i class="fas fa-sync"></i>
                  </div>
                  <div class="help-content">
                    <h6 class="text-white mb-1">Atualizar</h6>
                    <small class="text-primary">Recarrega a página com dados atualizados em tempo real da Shopify</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="mt-3 pt-3 border-top border-secondary">
              <div class="d-flex align-items-center text-info">
                <i class="fas fa-lightbulb me-2"></i>
                <small><strong>Dica:</strong> O estoque é consultado em tempo real da Shopify para garantir precisão máxima!</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Busca e Filtros -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-search me-2"></i>Buscar Produtos
            <small class="text-success ms-2">
              <i class="fas fa-database me-1"></i>Busca por ID, SKU, Inventory Item ID ou Custo
            </small>
          </h5>
          <div class="d-flex gap-2">
            <%= link_to new_stock_correction_path(location: @selected_location), 
                        class: "btn btn-sm btn-warning text-dark",
                        title: "Criar nova conferência de estoque para verificar divergências" do %>
              <i class="fas fa-clipboard-check me-1"></i>Nova Conferência
            <% end %>
            <%= link_to stock_corrections_path, 
                        class: "btn btn-sm btn-info text-dark",
                        title: "Ver histórico de todas as conferências realizadas" do %>
              <i class="fas fa-history me-1"></i>Histórico
            <% end %>
            <%= link_to inventory_products_path(location: @selected_location, search_term: @search_term, page: @current_page), 
                        class: "btn btn-sm btn-primary", 
                        id: "refreshBtn",
                        title: "Atualizar dados em tempo real da Shopify" do %>
              <i class="fas fa-sync me-1"></i>Atualizar
            <% end %>
          </div>
        </div>
        <div class="card-body bg-black">
          <%= form_with url: search_inventory_products_path, method: :post, local: true, 
                        class: "row g-3 align-items-end", id: "searchForm" do |f| %>
            <div class="col-md-8">
              <label class="form-label text-white fw-bold">Buscar Produto</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-dark text-white">
                  <i class="fas fa-search"></i>
                </span>
                <%= f.text_field :search_term, 
                                 placeholder: "Digite ID, SKU, Inventory Item ID ou Custo...", 
                                 value: @search_term,
                                 class: "form-control bg-dark text-white border-dark" %>
              </div>
              <small class="text-white-50 mt-1">
                <i class="fas fa-info-circle me-1"></i>
                Busca por ID, SKU, Shopify Inventory Item ID ou Custo
              </small>
            </div>
            <div class="col-md-3">
              <label class="form-label text-white fw-bold">Location</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-dark text-white">
                  <i class="fas fa-map-marker-alt"></i>
                </span>
                <%= f.select :location, 
                             options_for_select(current_user.available_locations_for_user, @selected_location),
                             {},
                             { class: "form-select bg-dark text-white border-dark" } %>
              </div>
              <% unless current_user.admin? %>
                <small class="text-white-50 mt-1">
                  <i class="fas fa-lock me-1"></i>
                  Locations permitidas para seu usuário
                </small>
              <% end %>
            </div>
            <div class="col-md-1">
              <%= f.submit "Buscar", class: "btn btn-primary w-100", id: "searchBtn" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Lista de Produtos -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-boxes me-2"></i>Produtos - <%= User.location_name(@selected_location) %>
            <small class="text-success ms-2">
              <i class="fas fa-sync me-1"></i>Tempo Real
            </small>
          </h5>
          <div class="d-flex align-items-center gap-3">
            <% if @search_term.present? %>
              <span class="badge bg-info text-dark px-3 py-2">
                <i class="fas fa-filter me-1"></i>Filtrado: "<%= @search_term %>"
              </span>
            <% end %>
            <span class="badge bg-primary text-white px-3 py-2">
              Página <%= @current_page %> de <%= @total_pages %>
            </span>
          </div>
        </div>
        <div class="card-body bg-black p-0">
          <% if @products.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-4 py-3">ID</th>
                    <th class="text-white fw-bold px-4 py-3">SKU</th>
                    <th class="text-white fw-bold px-4 py-3">Nome do Produto</th>
                    <th class="text-white fw-bold px-4 py-3 text-center">Estoque</th>
                    <th class="text-white fw-bold px-4 py-3 text-center">Status</th>
                    <th class="text-white fw-bold px-4 py-3 text-center">Fonte</th>
                  </tr>
                </thead>
                <tbody>
                  <% @products.each do |product| %>
                    <% stock = get_stock_for_location(product, @selected_location) %>
                    <tr class="border-secondary">
                      <td class="px-4 py-3">
                        <span class="text-white-50">#<%= product.id %></span>
                      </td>
                      <td class="px-4 py-3">
                        <span class="font-monospace text-white fw-medium"><%= product.sku %></span>
                      </td>
                      <td class="px-4 py-3">
                        <div>
                          <span class="text-white fw-medium d-block"><%= format_product_name(product) %></span>
                          <% if product.shopify_inventory_item_id.present? %>
                            <small class="text-white-50">
                              <i class="fab fa-shopify me-1"></i>
                              Item ID: <%= product.shopify_inventory_item_id %>
                            </small>
                          <% end %>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <span class="badge <%= stock_badge_class(stock) %> <%= stock_badge_class(stock) == 'bg-info' ? 'text-dark' : 'text-white' %> px-3 py-2">
                          <%= stock.present? ? "#{stock} unidades" : "N/A" %>
                        </span>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <i class="<%= stock_icon_class(stock) %> fa-lg"></i>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <%= stock_source_indicator(product) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-search fa-3x text-white-50 mb-3"></i>
              <h5 class="text-white-50">Nenhum produto encontrado</h5>
              <% if @search_term.present? %>
                <p class="text-white-50">
                  Nenhum resultado para "<strong><%= @search_term %></strong>"
                </p>
                <%= link_to inventory_products_path(location: @selected_location), class: "btn btn-outline-light" do %>
                  <i class="fas fa-times me-2"></i>Limpar Filtros
                <% end %>
              <% else %>
                <p class="text-white-50">Não há produtos cadastrados no sistema</p>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Paginação -->
        <% if @total_pages > 1 %>
          <div class="card-footer bg-dark border-top border-secondary">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
              <div class="text-white-50 mb-2 mb-md-0">
                Mostrando <%= (@current_page - 1) * @per_page + 1 %> a <%= [@current_page * @per_page, @total_products].min %> de <%= @total_products %> produtos
                <% if @search_term.present? %>
                  <span class="text-info">(filtrados)</span>
                <% end %>
                <small class="text-success d-block">
                  <i class="fas fa-sync me-1"></i>Estoque atualizado em tempo real da Shopify
                </small>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <!-- Botão Anterior -->
                <% if @current_page > 1 %>
                  <%= link_to inventory_products_path(location: @selected_location, search_term: @search_term, page: @current_page - 1),
                              class: "btn btn-outline-light btn-sm pagination-btn" do %>
                    <i class="fas fa-chevron-left"></i> Anterior
                  <% end %>
                <% else %>
                  <button class="btn btn-outline-light btn-sm" disabled>
                    <i class="fas fa-chevron-left"></i> Anterior
                  </button>
                <% end %>

                <!-- Números das páginas -->
                <% page_start = [[@current_page - 2, 1].max, [@total_pages - 4, 1].max].max %>
                <% page_end = [[page_start + 4, @total_pages].min, [@current_page + 2, @total_pages].min].max %>

                <% if page_start > 1 %>
                  <%= link_to "1", inventory_products_path(location: @selected_location, search_term: @search_term, page: 1),
                              class: "btn btn-outline-light btn-sm pagination-btn" %>
                  <% if page_start > 2 %>
                    <span class="btn btn-outline-light btn-sm disabled">...</span>
                  <% end %>
                <% end %>

                <% (page_start..page_end).each do |page_num| %>
                  <% if page_num == @current_page %>
                    <button class="btn btn-primary btn-sm"><%= page_num %></button>
                  <% else %>
                    <%= link_to page_num, inventory_products_path(location: @selected_location, search_term: @search_term, page: page_num),
                                class: "btn btn-outline-light btn-sm pagination-btn" %>
                  <% end %>
                <% end %>

                <% if page_end < @total_pages %>
                  <% if page_end < @total_pages - 1 %>
                    <span class="btn btn-outline-light btn-sm disabled">...</span>
                  <% end %>
                  <%= link_to @total_pages, inventory_products_path(location: @selected_location, search_term: @search_term, page: @total_pages),
                              class: "btn btn-outline-light btn-sm pagination-btn" %>
                <% end %>

                <!-- Botão Próxima -->
                <% if @current_page < @total_pages %>
                  <%= link_to inventory_products_path(location: @selected_location, search_term: @search_term, page: @current_page + 1),
                              class: "btn btn-outline-light btn-sm pagination-btn" do %>
                    Próxima <i class="fas fa-chevron-right"></i>
                  <% end %>
                <% else %>
                  <button class="btn btn-outline-light btn-sm" disabled>
                    Próxima <i class="fas fa-chevron-right"></i>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.form-control::placeholder {
  color: #adb5bd;
  opacity: 1;
}

.form-control:focus, .form-select:focus {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.text-white-50 {
  color: rgba(255, 255, 255, 0.75) !important;
}

.badge {
  font-weight: 500;
  color: #ffffff !important;
}

.form-label {
  font-size: 0.9rem;
  margin-bottom: 0.3rem;
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.input-group-text {
  border-right: none;
}

.form-control, .form-select {
  border-left: none;
}

.form-control:focus + .input-group-text {
  border-color: #495057;
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.075);
}

.font-monospace {
  font-family: 'Courier New', monospace;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(5px);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease-in-out;
}

.loading-overlay.show {
  display: flex;
}

.loading-content {
  text-align: center;
  background: rgba(33, 37, 41, 0.95);
  padding: 3rem 2rem;
  border-radius: 15px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  animation: slideUp 0.4s ease-out;
}

.loading-spinner {
  position: relative;
  width: 80px;
  height: 80px;
  margin: 0 auto 2rem;
}

.spinner-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 3px solid transparent;
  border-top: 3px solid #007bff;
  border-radius: 50%;
  animation: spin 1.2s linear infinite;
}

.spinner-ring:nth-child(1) {
  animation-delay: 0s;
  border-top-color: #007bff;
}

.spinner-ring:nth-child(2) {
  animation-delay: -0.3s;
  border-top-color: #28a745;
  width: 90%;
  height: 90%;
  top: 5%;
  left: 5%;
}

.spinner-ring:nth-child(3) {
  animation-delay: -0.6s;
  border-top-color: #ffc107;
  width: 80%;
  height: 80%;
  top: 10%;
  left: 10%;
}

.spinner-ring:nth-child(4) {
  animation-delay: -0.9s;
  border-top-color: #dc3545;
  width: 70%;
  height: 70%;
  top: 15%;
  left: 15%;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.loading-text h4 {
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.loading-text p {
  font-size: 0.9rem;
  opacity: 0.8;
}

.pagination-btn {
  transition: all 0.3s ease;
}

.pagination-btn:hover {
  transform: translateY(-1px);
}

.help-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  border-radius: 0.5rem;
  background: rgba(45, 55, 72, 0.3);
  border: 1px solid #2d3748;
  transition: all 0.3s ease;
}

.help-item:hover {
  background: rgba(66, 153, 225, 0.1);
  border-color: #4299e1;
}

.help-icon {
  width: 40px;
  height: 40px;
  border-radius: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1.1rem;
  flex-shrink: 0;
}

.help-content h6 {
  margin: 0;
  font-weight: 600;
}

@media (max-width: 768px) {
  .card-footer .d-flex {
    flex-direction: column;
    gap: 1rem;
  }
  
  .pagination-btn {
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
  }
  
  .help-item {
    flex-direction: column;
    text-align: center;
    gap: 0.5rem;
  }
}
</style>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const loadingOverlay = document.getElementById('loadingOverlay');
  const loadingMessage = document.getElementById('loadingMessage');
  const loadingMessages = {
    search: 'Buscando produtos e consultando StockService...',
    refresh: 'Atualizando estoque via StockService...',
    pagination: 'Carregando página e consultando estoque em tempo real...'
  };

  function showLoading(action = 'search') {
    loadingMessage.textContent = loadingMessages[action] || 'Processando...';
    loadingOverlay.classList.add('show');
  }

  function hideLoading() {
    loadingOverlay.classList.remove('show');
  }

  // Form de busca
  const searchForm = document.getElementById('searchForm');
  if (searchForm) {
    searchForm.addEventListener('submit', function(e) {
      showLoading('search');
    });
  }

  // Botão de refresh
  const refreshBtn = document.getElementById('refreshBtn');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', function(e) {
      showLoading('refresh');
    });
  }

  // Botões de paginação
  const paginationBtns = document.querySelectorAll('.pagination-btn');
  paginationBtns.forEach(btn => {
    btn.addEventListener('click', function(e) {
      showLoading('pagination');
    });
  });

  // Esconder loading quando a página carregar
  window.addEventListener('load', function() {
    setTimeout(hideLoading, 500);
  });

  // Esconder loading no pageshow (volta do cache)
  window.addEventListener('pageshow', function() {
    hideLoading();
  });
});
</script>
