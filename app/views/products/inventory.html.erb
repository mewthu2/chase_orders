<div class="container-fluid py-4">
  <!-- Loading Overlay -->
  <div id="loading-overlay" class="loading-overlay" style="display: none;">
    <div class="loading-content">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Carregando...</span>
      </div>
      <p class="mt-3 text-white">Carregando produtos...</p>
    </div>
  </div>

  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center flex-wrap">
          <h4 class="text-white mb-0">
            <i class="fas fa-boxes me-2"></i>Inventário de Produtos
          </h4>
          <div class="d-flex gap-2 flex-wrap">
            <span class="badge bg-info text-dark px-3 py-2">
              <i class="fas fa-cube me-1"></i>
              <span id="total-products">0</span> produtos
            </span>
            <div class="dropdown">
              <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-plus me-1"></i>Nova Conferência
              </button>
              <ul class="dropdown-menu dropdown-menu-dark">
                <% if current_user.admin? %>
                  <li><%= link_to new_stock_correction_path(location: 'lagoa_seca'), class: "dropdown-item" do %>
                    <i class="fas fa-map-marker-alt me-2"></i>Lagoa Seca
                  <% end %></li>
                  <li><%= link_to new_stock_correction_path(location: 'bh_shopping'), class: "dropdown-item" do %>
                    <i class="fas fa-map-marker-alt me-2"></i>BH Shopping
                  <% end %></li>
                  <li><%= link_to new_stock_correction_path(location: 'rj'), class: "dropdown-item" do %>
                    <i class="fas fa-map-marker-alt me-2"></i>Rio de Janeiro
                  <% end %></li>
                <% else %>
                  <% current_user.available_locations_for_user.each do |location| %>
                    <li><%= link_to new_stock_correction_path(location: location.code), class: "dropdown-item" do %>
                      <i class="fas fa-map-marker-alt me-2"></i><%= location.name %>
                    <% end %></li>
                  <% end %>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body bg-black">
          <form id="search-form" class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label text-white fw-bold">Buscar Produto</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-dark text-white">
                  <i class="fas fa-search"></i>
                </span>
                <input type="text" 
                       id="search-input" 
                       class="form-control bg-dark text-white border-dark" 
                       placeholder="Digite SKU ou nome do produto...">
              </div>
            </div>
            
            <div class="col-md-2">
              <label class="form-label text-white fw-bold">Location</label>
              <select id="location-filter" class="form-select bg-dark text-white border-dark">
                <option value="">Todas</option>
                <% if current_user.admin? %>
                  <option value="lagoa_seca">Lagoa Seca</option>
                  <option value="bh_shopping">BH Shopping</option>
                  <option value="rj">Rio de Janeiro</option>
                <% else %>
                  <% current_user.available_locations_for_user.each do |location| %>
                    <option value="<%= location.code %>"><%= location.name %></option>
                  <% end %>
                <% end %>
              </select>
            </div>
            
            <div class="col-md-2">
              <label class="form-label text-white fw-bold">Estoque</label>
              <select id="stock-filter" class="form-select bg-dark text-white border-dark">
                <option value="">Todos</option>
                <option value="zero">Zerado</option>
                <option value="low">Baixo (1-5)</option>
                <option value="normal">Normal (6+)</option>
              </select>
            </div>
            
            <div class="col-md-2">
              <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-search me-1"></i>Buscar
              </button>
            </div>
            
            <div class="col-md-2">
              <button type="button" id="clear-filters" class="btn btn-outline-light w-100">
                <i class="fas fa-times me-1"></i>Limpar
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Resultados -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-list me-2"></i>Produtos Encontrados
          </h5>
          <div id="results-info" class="text-white-50">
            <!-- Informações dos resultados serão inseridas aqui -->
          </div>
        </div>
        
        <div class="card-body bg-black p-0">
          <div id="products-container">
            <!-- Produtos serão carregados aqui via JavaScript -->
            <div class="text-center py-5">
              <i class="fas fa-search fa-3x text-white-50 mb-3"></i>
              <h5 class="text-white-50">Use os filtros acima para buscar produtos</h5>
              <p class="text-white-50">Digite um SKU ou nome do produto para começar</p>
            </div>
          </div>
        </div>
        
        <!-- Paginação -->
        <div id="pagination-container" class="card-footer bg-dark border-top border-secondary" style="display: none;">
          <!-- Paginação será inserida aqui via JavaScript -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let currentPage = 1;
let totalPages = 1;
let currentFilters = {};

document.addEventListener('DOMContentLoaded', function() {
  const searchForm = document.getElementById('search-form');
  const searchInput = document.getElementById('search-input');
  const locationFilter = document.getElementById('location-filter');
  const stockFilter = document.getElementById('stock-filter');
  const clearFiltersBtn = document.getElementById('clear-filters');
  
  // Event listeners
  searchForm.addEventListener('submit', handleSearch);
  clearFiltersBtn.addEventListener('click', clearFilters);
  
  // Auto-search on input change (com debounce)
  let searchTimeout;
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      if (searchInput.value.length >= 2 || searchInput.value.length === 0) {
        handleSearch();
      }
    }, 500);
  });
  
  locationFilter.addEventListener('change', handleSearch);
  stockFilter.addEventListener('change', handleSearch);
});

function handleSearch(event) {
  if (event) event.preventDefault();
  
  currentPage = 1;
  currentFilters = {
    search: document.getElementById('search-input').value,
    location: document.getElementById('location-filter').value,
    stock: document.getElementById('stock-filter').value
  };
  
  loadProducts();
}

function clearFilters() {
  document.getElementById('search-input').value = '';
  document.getElementById('location-filter').value = '';
  document.getElementById('stock-filter').value = '';
  
  currentPage = 1;
  currentFilters = {};
  
  // Mostrar mensagem inicial
  document.getElementById('products-container').innerHTML = `
    <div class="text-center py-5">
      <i class="fas fa-search fa-3x text-white-50 mb-3"></i>
      <h5 class="text-white-50">Use os filtros acima para buscar produtos</h5>
      <p class="text-white-50">Digite um SKU ou nome do produto para começar</p>
    </div>
  `;
  
  document.getElementById('results-info').innerHTML = '';
  document.getElementById('pagination-container').style.display = 'none';
  document.getElementById('total-products').textContent = '0';
}

function loadProducts() {
  showLoading();
  
  const params = new URLSearchParams({
    page: currentPage,
    ...currentFilters
  });
  
  fetch(`/products/inventory?${params}`, {
    headers: {
      'Accept': 'application/json',
      'X-Requested-With': 'XMLHttpRequest'
    }
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    displayProducts(data.products);
    updatePagination(data.pagination);
    updateResultsInfo(data.pagination);
    document.getElementById('total-products').textContent = data.pagination.total_count;
  })
  .catch(error => {
    hideLoading();
    console.error('Error:', error);
    document.getElementById('products-container').innerHTML = `
      <div class="text-center py-5">
        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
        <h5 class="text-danger">Erro ao carregar produtos</h5>
        <p class="text-white-50">Tente novamente em alguns instantes</p>
      </div>
    `;
  });
}

function displayProducts(products) {
  const container = document.getElementById('products-container');
  
  if (products.length === 0) {
    container.innerHTML = `
      <div class="text-center py-5">
        <i class="fas fa-inbox fa-3x text-white-50 mb-3"></i>
        <h5 class="text-white-50">Nenhum produto encontrado</h5>
        <p class="text-white-50">Tente ajustar os filtros de busca</p>
      </div>
    `;
    return;
  }
  
  const tableHTML = `
    <div class="table-responsive">
      <table class="table table-dark table-hover mb-0">
        <thead class="bg-dark">
          <tr>
            <th class="text-white fw-bold px-3 py-3">Produto</th>
            <th class="text-white fw-bold px-3 py-3 text-center">Lagoa Seca</th>
            <th class="text-white fw-bold px-3 py-3 text-center">BH Shopping</th>
            <th class="text-white fw-bold px-3 py-3 text-center">Rio de Janeiro</th>
            <th class="text-white fw-bold px-3 py-3 text-center">Shopify ID</th>
          </tr>
        </thead>
        <tbody>
          ${products.map(product => `
            <tr class="border-secondary">
              <td class="px-3 py-3">
                <div>
                  <span class="text-white fw-medium d-block">
                    ${product.shopify_product_name || `Produto ${product.sku}`}
                  </span>
                  <small class="text-white-50">SKU: ${product.sku}</small>
                  ${product.shopify_variant_id ? `<br><small class="text-white-50"><i class="fab fa-shopify me-1"></i>ID: ${product.shopify_variant_id}</small>` : ''}
                </div>
              </td>
              <td class="px-3 py-3 text-center">
                <span class="badge ${getStockBadgeClass(product.stock_lagoa_seca)} text-dark px-2 py-1">
                  ${product.stock_lagoa_seca || 0} un.
                </span>
              </td>
              <td class="px-3 py-3 text-center">
                <span class="badge ${getStockBadgeClass(product.stock_bh_shopping)} text-dark px-2 py-1">
                  ${product.stock_bh_shopping || 0} un.
                </span>
              </td>
              <td class="px-3 py-3 text-center">
                <span class="badge ${getStockBadgeClass(product.stock_rj)} text-dark px-2 py-1">
                  ${product.stock_rj || 0} un.
                </span>
              </td>
              <td class="px-3 py-3 text-center">
                ${product.shopify_inventory_item_id ? 
                  `<small class="text-success"><i class="fab fa-shopify me-1"></i>Conectado</small>` : 
                  `<small class="text-warning"><i class="fas fa-unlink me-1"></i>Não conectado</small>`
                }
              </td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    </div>
  `;
  
  container.innerHTML = tableHTML;
}

function getStockBadgeClass(stock) {
  const stockValue = parseInt(stock) || 0;
  if (stockValue === 0) return 'bg-danger';
  if (stockValue <= 5) return 'bg-warning';
  return 'bg-success';
}

function updatePagination(pagination) {
  const container = document.getElementById('pagination-container');
  totalPages = pagination.total_pages;
  currentPage = pagination.current_page;
  
  if (totalPages <= 1) {
    container.style.display = 'none';
    return;
  }
  
  container.style.display = 'block';
  
  let paginationHTML = `
    <div class="d-flex justify-content-between align-items-center flex-wrap">
      <div class="text-white-50 mb-2 mb-md-0">
        Mostrando ${pagination.offset + 1} a ${Math.min(pagination.offset + pagination.per_page, pagination.total_count)} de ${pagination.total_count} produtos
      </div>
      <div class="d-flex gap-2 flex-wrap">
  `;
  
  // Botão Anterior
  if (currentPage > 1) {
    paginationHTML += `
      <button class="btn btn-outline-light btn-sm" onclick="changePage(${currentPage - 1})">
        <i class="fas fa-chevron-left"></i> Anterior
      </button>
    `;
  }
  
  // Números das páginas
  const startPage = Math.max(1, currentPage - 2);
  const endPage = Math.min(totalPages, currentPage + 2);
  
  for (let i = startPage; i <= endPage; i++) {
    if (i === currentPage) {
      paginationHTML += `<button class="btn btn-primary btn-sm">${i}</button>`;
    } else {
      paginationHTML += `<button class="btn btn-outline-light btn-sm" onclick="changePage(${i})">${i}</button>`;
    }
  }
  
  // Botão Próxima
  if (currentPage < totalPages) {
    paginationHTML += `
      <button class="btn btn-outline-light btn-sm" onclick="changePage(${currentPage + 1})">
        Próxima <i class="fas fa-chevron-right"></i>
      </button>
    `;
  }
  
  paginationHTML += `
      </div>
    </div>
  `;
  
  container.innerHTML = paginationHTML;
}

function updateResultsInfo(pagination) {
  const info = document.getElementById('results-info');
  if (pagination.total_count > 0) {
    info.innerHTML = `${pagination.total_count} produto(s) encontrado(s)`;
  } else {
    info.innerHTML = '';
  }
}

function changePage(page) {
  currentPage = page;
  loadProducts();
}

function showLoading() {
  document.getElementById('loading-overlay').style.display = 'flex';
}

function hideLoading() {
  document.getElementById('loading-overlay').style.display = 'none';
}
</script>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.form-control, .form-select {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
}

.form-control:focus, .form-select:focus {
  background-color: #495057;
  border-color: #6c757d;
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.075);
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.badge {
  font-weight: 500;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.loading-content {
  text-align: center;
  color: white;
}

/* Responsividade */
@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.875rem;
  }
  
  .btn-sm {
    padding: 0.2rem 0.4rem;
    font-size: 0.8rem;
  }
}
</style>
<% end %>
