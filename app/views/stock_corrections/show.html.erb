<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h4 class="text-white mb-0">
            <i class="fas fa-eye me-2"></i>
            Conferência #<%= @stock_correction.id %> - <%= location_display_name(@stock_correction.location) %>
          </h4>
          <div class="d-flex gap-2">
            <% if @stock_correction.status == 'executed' %>
              <span class="badge bg-success text-dark px-3 py-2">
                <i class="fas fa-check-circle me-1"></i>Conferência Finalizada
              </span>
            <% else %>
              <span class="badge bg-warning text-dark px-3 py-2">
                <i class="fas fa-clock me-1"></i>Em Andamento
              </span>
            <% end %>
            <%= link_to edit_stock_correction_path(@stock_correction), class: "btn btn-sm btn-primary" do %>
              <i class="fas fa-edit me-1"></i>Editar
            <% end %>
          </div>
        </div>
        <div class="card-body bg-black">
          <div class="row">
            <div class="col-md-3">
              <strong class="text-white">Data:</strong>
              <p class="text-white-50 mb-2"><%= @stock_correction.correction_date.strftime('%d/%m/%Y') %></p>
            </div>
            <div class="col-md-3">
              <strong class="text-white">Status:</strong>
              <p class="mb-2">
                <span class="badge <%= @stock_correction.status == 'executed' ? 'bg-success text-dark' : 'bg-warning text-dark' %>">
                  <%= @stock_correction.status.humanize %>
                </span>
              </p>
            </div>
            <div class="col-md-6">
              <strong class="text-white">Motivo:</strong>
              <p class="text-white-50 mb-2"><%= @stock_correction.reason %></p>
            </div>
          </div>
          <% if @stock_correction.notes.present? %>
            <div class="row">
              <div class="col-12">
                <strong class="text-white">Observações:</strong>
                <p class="text-white-50 mb-0"><%= @stock_correction.notes %></p>
              </div>
            </div>
          <% end %>
          <% if @stock_correction.executed_at.present? %>
            <div class="row">
              <div class="col-12">
                <strong class="text-white">Finalizada em:</strong>
                <p class="text-white-50 mb-0"><%= @stock_correction.executed_at.strftime('%d/%m/%Y às %H:%M') %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Estatísticas -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body bg-black">
          <div class="row text-center">
            <div class="col-md-4">
              <div class="p-3">
                <h4 class="text-info mb-1"><%= @stats[:total] %></h4>
                <small class="text-white-50">Total de Produtos</small>
              </div>
            </div>
            <div class="col-md-4">
              <div class="p-3">
                <h4 class="text-warning mb-1"><%= @stats[:corrections] %></h4>
                <small class="text-white-50">Com Correção</small>
              </div>
            </div>
            <div class="col-md-4">
              <div class="p-3">
                <h4 class="text-primary mb-1"><%= @stats[:executed] %></h4>
                <small class="text-white-50">Executados</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filtro de Busca -->
  <% 
    # Filtrar produtos corrigidos localmente - CORRIGIDO PARA MYSQL
    all_corrected_items = @stock_correction.stock_correction_items.where(needs_correction: true)
    
    if @search_term.present?
      filtered_items = all_corrected_items.joins(:product).where(
        "products.sku LIKE ? OR products.shopify_product_name LIKE ?", 
        "%#{@search_term}%", 
        "%#{@search_term}%"
      )
    else
      filtered_items = all_corrected_items
    end
    
    # Paginação
    per_page = 20
    current_page = params[:page].to_i > 0 ? params[:page].to_i : 1
    total_filtered = filtered_items.count
    total_pages = (total_filtered.to_f / per_page).ceil
    
    paginated_items = filtered_items
      .includes(:product)
      .order(:id)
      .offset((current_page - 1) * per_page)
      .limit(per_page)
  %>

  <% if all_corrected_items.any? %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card bg-black border border-dark shadow-lg">
          <div class="card-body bg-black">
            <%= form_with url: stock_correction_path(@stock_correction), method: :get, local: true, class: "row g-3 align-items-end" do |f| %>
              <div class="col-md-8">
                <label class="form-label text-white fw-bold">Filtrar Produtos Corrigidos</label>
                <div class="input-group">
                  <span class="input-group-text bg-dark border-dark text-white">
                    <i class="fas fa-filter"></i>
                  </span>
                  <%= f.text_field :search_term, placeholder: "Digite SKU ou nome do produto para filtrar...", value: @search_term,
                                   class: "form-control bg-dark text-white border-dark" %>
                </div>
              </div>
              <div class="col-md-2">
                <%= f.submit "Filtrar", class: "btn btn-primary w-100" %>
              </div>
              <div class="col-md-2">
                <%= link_to stock_correction_path(@stock_correction), class: "btn btn-outline-light w-100" do %>
                  <i class="fas fa-times me-1"></i>Limpar
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Lista de Produtos Processados -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-check-circle me-2"></i>Produtos com Correção
            <% if @search_term.present? %>
              <small class="text-white-50 ms-2">- Filtro: "<%= @search_term %>"</small>
            <% end %>
          </h5>
          <% if total_filtered > 0 %>
            <span class="badge bg-success text-dark px-3 py-2">
              <%= total_filtered %> produto(s) 
              <%= @search_term.present? ? "encontrado(s)" : "corrigido(s)" %>
            </span>
          <% end %>
        </div>
        <div class="card-body bg-black p-0">
          <% if paginated_items.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0 table-fixed">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-3 py-3" style="width: 280px;">Produto</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 100px;">Status</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 140px;">Estoque</th>
                    <th class="text-white fw-bold px-3 py-3" style="width: 220px;">Motivo</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 120px;">Data Execução</th>
                  </tr>
                </thead>
                <tbody>
                  <% paginated_items.each do |item| %>
                    <tr class="border-secondary">
                      <td class="px-3 py-3" style="width: 280px;">
                        <div>
                          <span class="text-white fw-medium d-block"><%= format_product_name_for_correction(item.product) %></span>
                          <small class="text-warning fw-bold font-monospace">
                            SKU: <%= item.product.sku %>
                          </small>
                          <% if item.product.shopify_variant_id.present? %>
                            <br><small class="text-white-50">
                              <i class="fab fa-shopify me-1"></i>ID: <%= item.product.shopify_variant_id %>
                            </small>
                          <% end %>
                        </div>
                      </td>
                      <td class="px-3 py-3 text-center" style="width: 100px;">
                        <% if item.executed? %>
                          <span class="badge bg-success text-dark px-2 py-1">
                            <i class="fas fa-check-circle me-1"></i>Executado
                          </span>
                        <% else %>
                          <span class="badge bg-warning text-dark px-2 py-1">
                            <i class="fas fa-edit me-1"></i>Pendente
                          </span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3 text-center" style="width: 140px;">
                        <% if item.stock_before.present? && item.corrected_stock.present? %>
                          <div>
                            <small class="text-white-50 d-block">Antes: <span class="text-warning"><%= item.stock_before %></span></small>
                            <small class="text-white-50 d-block">Corrigido: <span class="text-success"><%= item.corrected_stock %></span></small>
                          </div>
                        <% elsif item.corrected_stock.present? %>
                          <span class="badge bg-info text-dark px-2 py-1"><%= item.corrected_stock %> un.</span>
                        <% else %>
                          <span class="text-white-50">-</span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3" style="width: 220px;">
                        <small class="text-success">
                          <i class="fas fa-check me-1"></i><%= truncate(item.correction_reason, length: 30) %>
                        </small>
                      </td>
                      <td class="px-3 py-3 text-center" style="width: 120px;">
                        <% if item.executed_at.present? %>
                          <small class="text-white-50">
                            <%= item.executed_at.strftime('%d/%m/%Y') %><br>
                            <%= item.executed_at.strftime('%H:%M') %>
                          </small>
                        <% else %>
                          <span class="text-white-50">Pendente</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <% if @search_term.present? %>
                <i class="fas fa-search fa-3x text-white-50 mb-3"></i>
                <h5 class="text-white-50">Nenhum produto encontrado</h5>
                <p class="text-white-50">Não há produtos corrigidos que correspondam ao filtro "<strong><%= @search_term %></strong>"</p>
                <%= link_to stock_correction_path(@stock_correction), class: "btn btn-outline-light btn-sm" do %>
                  <i class="fas fa-times me-1"></i>Limpar Filtro
                <% end %>
              <% else %>
                <i class="fas fa-clipboard-list fa-3x text-white-50 mb-3"></i>
                <h5 class="text-white-50">Nenhum produto com correção ainda</h5>
                <p class="text-white-50">Os produtos com correção aparecerão aqui</p>
              <% end %>
            </div>
          <% end %>
        </div>
        <!-- Paginação dos Produtos Processados -->
        <% if total_pages > 1 %>
          <div class="card-footer bg-dark border-top border-secondary">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
              <div class="text-white-50 mb-2 mb-md-0">
                Mostrando <%= ((current_page - 1) * per_page) + 1 %> a <%= [current_page * per_page, total_filtered].min %> de <%= total_filtered %> produtos
                <%= @search_term.present? ? "encontrados" : "corrigidos" %>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <% if current_page > 1 %>
                  <%= link_to stock_correction_path(@stock_correction, page: current_page - 1, search_term: @search_term),
                              class: "btn btn-outline-light btn-sm" do %>
                    <i class="fas fa-chevron-left"></i> Anterior
                  <% end %>
                <% end %>
                <% page_start = [[current_page - 2, 1].max, [total_pages - 4, 1].max].max %>
                <% page_end = [[page_start + 4, total_pages].min, [current_page + 2, total_pages].min].max %>
                <% (page_start..page_end).each do |page_num| %>
                  <% if page_num == current_page %>
                    <button class="btn btn-primary btn-sm"><%= page_num %></button>
                  <% else %>
                    <%= link_to page_num, stock_correction_path(@stock_correction, page: page_num, search_term: @search_term),
                                class: "btn btn-outline-light btn-sm" %>
                  <% end %>
                <% end %>
                <% if current_page < total_pages %>
                  <%= link_to stock_correction_path(@stock_correction, page: current_page + 1, search_term: @search_term),
                              class: "btn btn-outline-light btn-sm" do %>
                    Próxima <i class="fas fa-chevron-right"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="row mt-4">
    <div class="col-12">
      <div class="d-flex justify-content-start">
        <%= link_to stock_corrections_path, class: "btn btn-outline-light" do %>
          <i class="fas fa-arrow-left me-2"></i>Voltar para Lista
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.form-control, .form-select {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
}

.form-control:focus, .form-select:focus {
  background-color: #495057;
  border-color: #6c757d;
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.075);
}

.table-fixed {
  table-layout: fixed;
  width: 100%;
}

.table-fixed th,
.table-fixed td {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}

.table-fixed td:nth-child(1),
.table-fixed td:nth-child(4) {
  white-space: normal;
  word-wrap: break-word;
}

.font-monospace {
  font-family: 'Courier New', monospace;
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.badge {
  font-weight: 500;
}

.form-control-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
}

/* Destaque para produto da busca */
.border-info {
  border-color: #0dcaf0 !important;
}

.bg-info {
  background-color: #0dcaf0 !important;
}

.text-warning {
  color: #ffc107 !important;
}

/* Responsividade */
@media (max-width: 1200px) {
  .table-fixed th:nth-child(1),
  .table-fixed td:nth-child(1) {
    width: 250px !important;
  }
  .table-fixed th:nth-child(4),
  .table-fixed td:nth-child(4) {
    width: 180px !important;
  }
}

@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.875rem;
  }
  .btn-sm {
    padding: 0.2rem 0.4rem;
    font-size: 0.8rem;
  }
}
</style>
