<div class="container-fluid py-4">
  <!-- Header com Estatísticas -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h4 class="text-white mb-0">
            <i class="fas fa-clipboard-list me-2"></i>
            Conferências de Estoque
          </h4>
          <%= link_to new_stock_correction_path, class: "btn btn-success" do %>
            <i class="fas fa-plus me-2"></i>Nova Conferência
          <% end %>
        </div>
        <div class="card-body bg-black">
          <div class="row text-center">
            <div class="col-md-3">
              <div class="p-3">
                <h4 class="text-info mb-1"><%= @total_corrections %></h4>
                <small class="text-white-50">Total de Conferências</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3">
                <h4 class="text-warning mb-1"><%= @pending_corrections %></h4>
                <small class="text-white-50">Pendentes</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3">
                <h4 class="text-success mb-1"><%= @completed_corrections %></h4>
                <small class="text-white-50">Finalizadas</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="p-3">
                <h4 class="text-primary mb-1"><%= @synced_corrections %></h4>
                <small class="text-white-50">Sincronizadas Hoje</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lista de Conferências -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body bg-black p-0">
          <% if @stock_corrections.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-3 py-3">ID</th>
                    <th class="text-white fw-bold px-3 py-3">Location</th>
                    <th class="text-white fw-bold px-3 py-3">Data</th>
                    <th class="text-white fw-bold px-3 py-3">Motivo</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Status</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Integração</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Itens</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% @stock_corrections.each do |correction| %>
                    <tr class="border-secondary">
                      <td class="px-3 py-3">
                        <span class="text-warning fw-bold">#<%= correction.id %></span>
                      </td>
                      <td class="px-3 py-3">
                        <span class="text-white"><%= correction.location_display_name %></span>
                      </td>
                      <td class="px-3 py-3">
                        <span class="text-white-50"><%= correction.correction_date.strftime('%d/%m/%Y') %></span>
                      </td>
                      <td class="px-3 py-3">
                        <span class="text-white-50"><%= truncate(correction.reason, length: 30) %></span>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <% if correction.status == 'executed' %>
                          <span class="badge bg-success text-dark px-2 py-1">
                            <i class="fas fa-check me-1"></i>Finalizada
                          </span>
                        <% else %>
                          <span class="badge bg-warning text-dark px-2 py-1">
                            <i class="fas fa-clock me-1"></i>Pendente
                          </span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <% case correction.integration_status %>
                        <% when 'pending' %>
                          <span class="badge bg-warning text-dark px-2 py-1">
                            <i class="fas fa-spinner fa-spin me-1"></i>Processando
                          </span>
                        <% when 'completed' %>
                          <span class="badge bg-success text-dark px-2 py-1">
                            <i class="fas fa-check me-1"></i>Concluída
                          </span>
                        <% when 'error' %>
                          <span class="badge bg-danger text-white px-2 py-1" 
                                title="<%= correction.integration_error %>" 
                                data-bs-toggle="tooltip">
                            <i class="fas fa-exclamation-triangle me-1"></i>Erro
                          </span>
                        <% else %>
                          <span class="badge bg-secondary text-white px-2 py-1">
                            <i class="fas fa-minus me-1"></i>N/A
                          </span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <% corrections_count = correction.stock_correction_items.where(needs_correction: true).count %>
                        <% if corrections_count > 0 %>
                          <span class="badge bg-info text-dark px-2 py-1">
                            <%= corrections_count %> correções
                          </span>
                        <% else %>
                          <span class="text-white-50">-</span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <div class="btn-group" role="group">
                          <!-- Visualizar -->
                          <%= link_to correction, 
                                      class: "btn btn-sm btn-outline-light",
                                      title: "Visualizar",
                                      data: { bs_toggle: "tooltip" } do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                          
                          <!-- Editar -->
                          <%= link_to edit_stock_correction_path(correction), 
                                      class: "btn btn-sm btn-outline-light",
                                      title: "Editar",
                                      data: { bs_toggle: "tooltip" } do %>
                            <i class="fas fa-edit"></i>
                          <% end %>
                          
                          <% if correction.status != 'executed' %>
                            <!-- Finalizar -->
                            <%= link_to finalize_correction_stock_correction_path(correction), 
                                        method: :patch,
                                        class: "btn btn-sm btn-outline-light",
                                        title: "Finalizar",
                                        data: { 
                                          bs_toggle: "tooltip",
                                          confirm: "Tem certeza que deseja finalizar esta conferência?" 
                                        } do %>
                              <i class="fas fa-check"></i>
                            <% end %>
                            
                            <!-- Executar Todas (apenas se não estiver processando) -->
                            <% if correction.stock_correction_items.where(needs_correction: true, executed: false).any? && !correction.integration_pending? %>
                              <%= link_to execute_all_stock_correction_path(correction), 
                                          method: :post,
                                          class: "btn btn-sm btn-outline-light",
                                          title: "Executar Todas as Correções",
                                          data: { 
                                            bs_toggle: "tooltip",
                                            confirm: "Deseja executar todas as correções pendentes?" 
                                          } do %>
                                <i class="fas fa-play"></i>
                              <% end %>
                            <% end %>
                          <% else %>
                            <!-- Reabrir (apenas admin) -->
                            <% if current_user.admin? %>
                              <%= link_to reopen_stock_correction_path(correction), 
                                          method: :patch,
                                          class: "btn btn-sm btn-outline-light",
                                          title: "Reabrir",
                                          data: { 
                                            bs_toggle: "tooltip",
                                            confirm: "Tem certeza que deseja reabrir esta conferência?" 
                                          } do %>
                                <i class="fas fa-undo"></i>
                              <% end %>
                            <% end %>
                          <% end %>
                          
                          <!-- Sincronizar Shopify (apenas admin e se não estiver processando) -->
                          <% if current_user.admin? && correction.stock_correction_items.where(needs_correction: true, executed: true).any? && !correction.integration_pending? %>
                            <%= link_to sync_with_shopify_stock_correction_path(correction), 
                                        method: :post,
                                        class: "btn btn-sm btn-outline-light",
                                        title: "Sincronizar com Shopify",
                                        data: { 
                                          bs_toggle: "tooltip",
                                          confirm: "Deseja sincronizar com a Shopify?" 
                                        } do %>
                              <i class="fab fa-shopify"></i>
                            <% end %>
                          <% end %>
                          
                          <!-- Excluir (apenas admin) -->
                          <% if current_user.admin? %>
                            <%= link_to correction, 
                                        method: :delete,
                                        class: "btn btn-sm btn-outline-danger",
                                        title: "Excluir",
                                        data: { 
                                          bs_toggle: "tooltip",
                                          confirm: "Tem certeza que deseja excluir esta conferência?" 
                                        } do %>
                              <i class="fas fa-trash"></i>
                            <% end %>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-clipboard-list fa-3x text-white-50 mb-3"></i>
              <h5 class="text-white-50">Nenhuma conferência encontrada</h5>
              <p class="text-white-50">Crie sua primeira conferência de estoque</p>
              <%= link_to new_stock_correction_path, class: "btn btn-success mt-3" do %>
                <i class="fas fa-plus me-2"></i>Nova Conferência
              <% end %>
            </div>
          <% end %>
        </div>
        
        <!-- Paginação -->
        <% if @total_pages > 1 %>
          <div class="card-footer bg-dark border-top border-secondary">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
              <div class="text-white-50 mb-2 mb-md-0">
                Mostrando <%= (@current_page - 1) * @per_page + 1 %> a <%= [@current_page * @per_page, @total_corrections].min %> de <%= @total_corrections %> conferências
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <% if @current_page > 1 %>
                  <%= link_to stock_corrections_path(page: @current_page - 1),
                              class: "btn btn-outline-light btn-sm" do %>
                    <i class="fas fa-chevron-left"></i> Anterior
                  <% end %>
                <% end %>
                <% page_start = [[@current_page - 2, 1].max, [@total_pages - 4, 1].max].max %>
                <% page_end = [[page_start + 4, @total_pages].min, [@current_page + 2, @total_pages].min].max %>
                <% (page_start..page_end).each do |page_num| %>
                  <% if page_num == @current_page %>
                    <button class="btn btn-primary btn-sm"><%= page_num %></button>
                  <% else %>
                    <%= link_to page_num, stock_corrections_path(page: page_num),
                                class: "btn btn-outline-light btn-sm" %>
                  <% end %>
                <% end %>
                <% if @current_page < @total_pages %>
                  <%= link_to stock_corrections_path(page: @current_page + 1),
                              class: "btn btn-outline-light btn-sm" do %>
                    Próxima <i class="fas fa-chevron-right"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.form-control, .form-select {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
}

.form-control:focus, .form-select:focus {
  background-color: #495057;
  border-color: #6c757d;
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.075);
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.badge {
  font-weight: 500;
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* Botões de ação padronizados */
.btn-group .btn-outline-light {
  background-color: transparent;
  border-color: rgba(255, 255, 255, 0.3);
  color: #fff;
}

.btn-group .btn-outline-light:hover {
  background-color: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.5);
  color: #fff;
  transform: scale(1.05);
}

/* Botão de excluir vermelho */
.btn-group .btn-outline-danger {
  background-color: transparent;
  border-color: rgba(220, 53, 69, 0.5);
  color: #dc3545;
}

.btn-group .btn-outline-danger:hover {
  background-color: rgba(220, 53, 69, 0.1);
  border-color: #dc3545;
  color: #dc3545;
  transform: scale(1.05);
}

/* Layout horizontal dos botões */
.btn-group {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 2px;
  flex-wrap: wrap;
}

/* Spinner animado */
.fa-spinner.fa-spin {
  animation: fa-spin 1s infinite linear;
}

@keyframes fa-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Responsividade */
@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.875rem;
  }
  .btn-sm {
    padding: 0.2rem 0.4rem;
    font-size: 0.8rem;
    width: 28px;
    height: 28px;
  }
  .btn-group {
    gap: 1px;
  }
}
</style>

<script>
// Inicializar tooltips
document.addEventListener('DOMContentLoaded', function() {
  var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });
});
</script>
