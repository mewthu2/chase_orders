<div class="container-fluid py-4">
  <% content_for :title, 'Conferências de Estoque' %>
  <%= render 'layouts/partials/messages' if defined?(render) %>

  <!-- Header com estatísticas -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h4 class="text-white mb-0">
            <i class="fas fa-clipboard-list me-2"></i>Conferências de Estoque
          </h4>
          <%= link_to new_stock_correction_path, class: "btn btn-warning text-dark" do %>
            <i class="fas fa-plus me-2"></i>Nova Conferência
          <% end %>
        </div>
        <div class="card-body bg-black">
          <div class="row g-3">
            <div class="col-md-3">
              <div class="stat-card bg-primary">
                <div class="stat-icon">
                  <i class="fas fa-clipboard-list"></i>
                </div>
                <div class="stat-content">
                  <h3 class="text-dark mb-0"><%= @total_corrections %></h3>
                  <p class="text-dark mb-0">Total de Conferências</p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="stat-card bg-warning">
                <div class="stat-icon">
                  <i class="fas fa-clock"></i>
                </div>
                <div class="stat-content">
                  <h3 class="text-dark mb-0"><%= @pending_corrections %></h3>
                  <p class="text-dark mb-0">Pendentes</p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="stat-card bg-success">
                <div class="stat-icon">
                  <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-content">
                  <h3 class="text-white mb-0"><%= @completed_corrections %></h3>
                  <p class="text-white mb-0">Finalizadas</p>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="stat-card bg-info">
                <div class="stat-icon">
                  <i class="fas fa-sync"></i>
                </div>
                <div class="stat-content">
                  <h3 class="text-dark mb-0"><%= @synced_corrections %></h3>
                  <p class="text-dark mb-0">Sincronizadas Hoje</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lista de Conferências -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-list me-2"></i>Histórico de Conferências
          </h5>
        </div>
        <div class="card-body bg-black p-0">
          <% if @stock_corrections.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-4 py-3">ID</th>
                    <th class="text-white fw-bold px-4 py-3">Data</th>
                    <th class="text-white fw-bold px-4 py-3">Motivo</th>
                    <th class="text-white fw-bold px-4 py-3">Location</th>
                    <th class="text-white fw-bold px-4 py-3 text-center">Status</th>
                    <th class="text-white fw-bold px-4 py-3 text-center">Itens</th>
                    <th class="text-white fw-bold px-4 py-3 text-center">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% @stock_corrections.each do |correction| %>
                    <tr class="border-secondary">
                      <td class="px-4 py-3">
                        <span class="text-white-50">#<%= correction.id %></span>
                      </td>
                      <td class="px-4 py-3">
                        <span class="text-white"><%= correction.correction_date.strftime('%d/%m/%Y') %></span>
                        <small class="text-white-50 d-block">
                          Criada: <%= correction.created_at.strftime('%d/%m/%Y %H:%M') %>
                        </small>
                      </td>
                      <td class="px-4 py-3">
                        <span class="text-white"><%= correction.reason %></span>
                        <% if correction.notes.present? %>
                          <small class="text-white-50 d-block">
                            <i class="fas fa-sticky-note me-1"></i><%= correction.notes %>
                          </small>
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <span class="badge bg-secondary text-white px-2 py-1">
                          <i class="fas fa-map-marker-alt me-1"></i>
                          <%= User.location_name(correction.location) %>
                        </span>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <% case correction.status %>
                        <% when 'executed' %>
                          <span class="badge bg-success text-white px-3 py-2">
                            <i class="fas fa-check-circle me-1"></i>Finalizada
                          </span>
                          <% if correction.executed_at %>
                            <small class="text-success d-block">
                              <%= correction.executed_at.strftime('%d/%m/%Y %H:%M') %>
                            </small>
                          <% end %>
                        <% else %>
                          <span class="badge bg-warning text-dark px-3 py-2">
                            <i class="fas fa-clock me-1"></i>Pendente
                          </span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <span class="badge bg-info text-dark px-2 py-1">
                          <%= correction.stock_correction_items.count %> itens
                        </span>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <div class="btn-group" role="group">
                          <%= link_to correction, class: "btn btn-sm btn-outline-light", title: "Visualizar" do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                          <% if correction.status != 'executed' || current_user.admin? %>
                            <%= link_to edit_stock_correction_path(correction), class: "btn btn-sm btn-outline-primary", title: "Editar" do %>
                              <i class="fas fa-edit"></i>
                            <% end %>
                          <% end %>
                          <% if current_user.admin? %>
                            <%= link_to correction, method: :delete, 
                                class: "btn btn-sm btn-outline-danger", 
                                title: "Excluir",
                                confirm: "Tem certeza que deseja excluir esta conferência?" do %>
                              <i class="fas fa-trash"></i>
                            <% end %>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-clipboard-list fa-3x text-white-50 mb-3"></i>
              <h5 class="text-white-50">Nenhuma conferência encontrada</h5>
              <p class="text-white-50">Crie sua primeira conferência de estoque</p>
              <%= link_to new_stock_correction_path, class: "btn btn-warning text-dark" do %>
                <i class="fas fa-plus me-2"></i>Nova Conferência
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Paginação -->
        <% if @total_pages > 1 %>
          <div class="card-footer bg-dark border-top border-secondary">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
              <div class="text-white-50 mb-2 mb-md-0">
                Mostrando <%= (@current_page - 1) * @per_page + 1 %> a <%= [@current_page * @per_page, @total_corrections].min %> de <%= @total_corrections %> conferências
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <!-- Botão Anterior -->
                <% if @current_page > 1 %>
                  <%= link_to stock_corrections_path(page: @current_page - 1),
                      class: "btn btn-outline-light btn-sm" do %>
                    <i class="fas fa-chevron-left"></i> Anterior
                  <% end %>
                <% else %>
                  <button class="btn btn-outline-light btn-sm" disabled>
                    <i class="fas fa-chevron-left"></i> Anterior
                  </button>
                <% end %>

                <!-- Números das páginas -->
                <% page_start = [[@current_page - 2, 1].max, [@total_pages - 4, 1].max].max %>
                <% page_end = [[page_start + 4, @total_pages].min, [@current_page + 2, @total_pages].min].max %>

                <% if page_start > 1 %>
                  <%= link_to "1", stock_corrections_path(page: 1),
                      class: "btn btn-outline-light btn-sm" %>
                  <% if page_start > 2 %>
                    <span class="btn btn-outline-light btn-sm disabled">...</span>
                  <% end %>
                <% end %>

                <% (page_start..page_end).each do |page_num| %>
                  <% if page_num == @current_page %>
                    <button class="btn btn-primary btn-sm"><%= page_num %></button>
                  <% else %>
                    <%= link_to page_num, stock_corrections_path(page: page_num),
                        class: "btn btn-outline-light btn-sm" %>
                  <% end %>
                <% end %>

                <% if page_end < @total_pages %>
                  <% if page_end < @total_pages - 1 %>
                    <span class="btn btn-outline-light btn-sm disabled">...</span>
                  <% end %>
                  <%= link_to @total_pages, stock_corrections_path(page: @total_pages),
                      class: "btn btn-outline-light btn-sm" %>
                <% end %>

                <!-- Botão Próxima -->
                <% if @current_page < @total_pages %>
                  <%= link_to stock_corrections_path(page: @current_page + 1),
                      class: "btn btn-outline-light btn-sm" do %>
                    Próxima <i class="fas fa-chevron-right"></i>
                  <% end %>
                <% else %>
                  <button class="btn btn-outline-light btn-sm" disabled>
                    Próxima <i class="fas fa-chevron-right"></i>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.text-white-50 {
  color: rgba(255, 255, 255, 0.75) !important;
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.075);
}

.stat-card {
  display: flex;
  align-items: center;
  padding: 1.5rem;
  border-radius: 0.5rem;
  gap: 1rem;
  transition: transform 0.2s ease;
}

.stat-card:hover {
  transform: translateY(-2px);
}

.stat-icon {
  width: 60px;
  height: 60px;
  border-radius: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.stat-content h3 {
  font-size: 2rem;
  font-weight: 700;
  line-height: 1;
}

.stat-content p {
  font-size: 0.9rem;
  font-weight: 500;
  opacity: 0.9;
}

.badge {
  font-weight: 500;
}

@media (max-width: 768px) {
  .stat-card {
    flex-direction: column;
    text-align: center;
    gap: 0.5rem;
  }
  
  .stat-content h3 {
    font-size: 1.5rem;
  }
  
  .btn-group {
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .card-footer .d-flex {
    flex-direction: column;
    gap: 1rem;
  }
}
</style>
<% end %>
