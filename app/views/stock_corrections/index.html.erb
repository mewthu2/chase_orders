<div class="container-fluid py-4">
  <!-- Tutorial -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-dark border border-warning shadow-lg">
        <div class="card-header bg-warning text-dark">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">
              <i class="fas fa-book-open me-2"></i>Tutorial - Histórico de Conferências
            </h6>
            <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#correctionsTutorial">
              <i class="fas fa-chevron-down"></i>
            </button>
          </div>
        </div>
        <div class="collapse" id="correctionsTutorial">
          <div class="card-body bg-dark text-white">
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <div class="text-center p-3 border border-secondary rounded">
                  <i class="fas fa-plus-circle fa-2x text-success mb-2"></i>
                  <h6>1. Nova Conferência</h6>
                  <small class="text-white-50">Clique em "Nova Conferência" para iniciar uma verificação de estoque</small>
                </div>
              </div>
              <div class="col-md-4">
                <div class="text-center p-3 border border-secondary rounded">
                  <i class="fas fa-list-alt fa-2x text-info mb-2"></i>
                  <h6>2. Acompanhar Status</h6>
                  <small class="text-white-50">Veja o progresso de cada conferência: pendente, em andamento ou concluída</small>
                </div>
              </div>
              <div class="col-md-4">
                <div class="text-center p-3 border border-secondary rounded">
                  <i class="fas fa-chart-line fa-2x text-warning mb-2"></i>
                  <h6>3. Analisar Resultados</h6>
                  <small class="text-white-50">Visualize estatísticas e relatórios de cada conferência realizada</small>
                </div>
              </div>
            </div>
            
            <h6 class="text-white border-bottom border-secondary pb-2 mb-3">
              <i class="fas fa-info-circle me-2"></i>Status das Conferências
            </h6>
            
            <div class="row g-3">
              <div class="col-md-3">
                <div class="text-center p-3 border border-secondary rounded">
                  <span class="badge bg-secondary mb-2">Pendente</span>
                  <h6 class="text-secondary">Não Iniciada</h6>
                  <small class="text-white-50">Conferência criada mas ainda não foi iniciada</small>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center p-3 border border-secondary rounded">
                  <span class="badge bg-warning mb-2">Em Andamento</span>
                  <h6 class="text-warning">Processando</h6>
                  <small class="text-white-50">Produtos sendo conferidos e corrigidos</small>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center p-3 border border-secondary rounded">
                  <span class="badge bg-info text-dark mb-2">Executada</span>
                  <h6 class="text-info">Finalizada</h6>
                  <small class="text-white-50">Correções aplicadas no sistema local</small>
                </div>
              </div>
              <div class="col-md-3">
                <div class="text-center p-3 border border-secondary rounded">
                  <span class="badge bg-success mb-2">Sincronizada</span>
                  <h6 class="text-success">Completa</h6>
                  <small class="text-white-50">Dados sincronizados com a Shopify</small>
                </div>
              </div>
            </div>
            
            <div class="alert alert-warning bg-dark border-warning text-white mt-3" role="alert">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <strong>Importante:</strong> Sempre finalize as conferências executando as correções e sincronizando com a Shopify.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h4 class="text-white mb-0">
            <i class="fas fa-clipboard-list me-2"></i>
            Histórico de Conferências
            <% unless current_user.admin? %>
              <small class="text-warning ms-2">
                <i class="fas fa-lock me-1"></i>Suas locations permitidas
              </small>
            <% end %>
          </h4>
          <%= link_to new_stock_correction_path, class: "btn btn-success" do %>
            <i class="fas fa-plus me-2"></i>Nova Conferência
          <% end %>
        </div>
        <div class="card-body bg-black">
          <div class="row">
            <div class="col-md-3">
              <div class="text-center p-3">
                <h4 class="text-info mb-1"><%= @stock_corrections.count %></h4>
                <small class="text-white">Total de Conferências</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="text-center p-3">
                <h4 class="text-warning mb-1"><%= @stock_corrections.where(status: 'pending').count %></h4>
                <small class="text-white">Em Andamento</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="text-center p-3">
                <h4 class="text-success mb-1"><%= @stock_corrections.where(status: 'completed').count %></h4>
                <small class="text-white">Concluídas</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="text-center p-3">
                <h4 class="text-primary mb-1"><%= @stock_corrections.joins(:stock_correction_items).where(stock_correction_items: { executed: true }).distinct.count %></h4>
                <small class="text-white">Sincronizadas</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lista de Conferências -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-history me-2"></i>Conferências Realizadas
          </h5>
        </div>
        <div class="card-body bg-black p-0">
          <% if @stock_corrections.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-3 py-3">#</th>
                    <th class="text-white fw-bold px-3 py-3">Data</th>
                    <th class="text-white fw-bold px-3 py-3">Localização</th>
                    <th class="text-white fw-bold px-3 py-3">Motivo</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Produtos</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Correções</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Status</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% @stock_corrections.each do |correction| %>
                    <tr class="border-secondary">
                      <td class="px-3 py-3">
                        <span class="font-monospace text-white fw-medium">
                          #<%= correction.id %>
                        </span>
                      </td>
                      
                      <td class="px-3 py-3">
                        <span class="text-white d-block">
                          <%= correction.correction_date.strftime('%d/%m/%Y') %>
                        </span>
                        <small class="text-white-50">
                          <%= correction.created_at.strftime('%H:%M') %>
                        </small>
                      </td>
                      
                      <td class="px-3 py-3">
                        <span class="badge bg-info text-dark px-2 py-1">
                          <i class="fas fa-map-marker-alt me-1"></i>
                          <%= correction.location_name %>
                        </span>
                      </td>
                      
                      <td class="px-3 py-3">
                        <span class="text-white">
                          <%= truncate(correction.reason || 'Conferência de rotina', length: 30) %>
                        </span>
                      </td>
                      
                      <td class="px-3 py-3 text-center">
                        <span class="badge bg-primary text-white px-2 py-1">
                          <%= correction.stock_correction_items.count %> itens
                        </span>
                      </td>
                      
                      <td class="px-3 py-3 text-center">
                        <% corrections_count = correction.items_to_correct.count %>
                        <span class="badge <%= corrections_count > 0 ? 'bg-warning' : 'bg-success' %> text-white px-2 py-1">
                          <%= corrections_count %> correções
                        </span>
                      </td>
                      
                      <td class="px-3 py-3 text-center">
                        <% if correction.items_to_correct.where(executed: true).count == correction.items_to_correct.count && correction.items_to_correct.any? %>
                          <span class="badge bg-success text-white px-2 py-1">
                            <i class="fas fa-check me-1"></i>Concluída
                          </span>
                        <% elsif correction.items_to_correct.where(executed: true).any? %>
                          <span class="badge bg-info text-dark px-2 py-1">
                            <i class="fas fa-clock me-1"></i>Parcial
                          </span>
                        <% elsif correction.items_to_correct.any? %>
                          <span class="badge bg-warning text-white px-2 py-1">
                            <i class="fas fa-hourglass-half me-1"></i>Pendente
                          </span>
                        <% else %>
                          <span class="badge bg-secondary text-white px-2 py-1">
                            <i class="fas fa-minus me-1"></i>Sem correções
                          </span>
                        <% end %>
                      </td>
                      
                      <td class="px-3 py-3 text-center">
                        <div class="d-flex gap-1 justify-content-center flex-wrap">
                          <%= link_to correction, 
                                      class: "btn btn-sm btn-info text-dark",
                                      title: "Visualizar detalhes" do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                          
                          <%= link_to edit_stock_correction_path(correction), 
                                      class: "btn btn-sm btn-warning",
                                      title: "Editar conferência" do %>
                            <i class="fas fa-edit"></i>
                          <% end %>
                          
                          <% if correction.items_to_correct.any? && correction.items_to_correct.where(executed: false).any? %>
                            <%= link_to execute_all_stock_correction_path(correction), 
                                        method: :post,
                                        class: "btn btn-sm btn-success",
                                        title: "Executar todas as correções",
                                        confirm: "Deseja executar todas as correções pendentes?" do %>
                              <i class="fas fa-play"></i>
                            <% end %>
                          <% end %>
                          
                          <%= link_to correction, 
                                      method: :delete,
                                      class: "btn btn-sm btn-danger",
                                      title: "Excluir conferência",
                                      confirm: "Tem certeza que deseja excluir esta conferência?" do %>
                            <i class="fas fa-trash"></i>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-clipboard-list fa-3x text-white-50 mb-3"></i>
              <h5 class="text-white-50">Nenhuma conferência encontrada</h5>
              <p class="text-white-50">Clique em "Nova Conferência" para começar.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.075);
}

.font-monospace {
  font-family: 'Courier New', monospace;
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.badge {
  font-weight: 500;
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
}

/* Animações suaves */
.card, .btn {
  transition: all 0.3s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.table tbody tr {
  transition: background-color 0.2s ease;
}

/* Responsividade */
@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.875rem;
  }
  
  .d-flex.gap-1 {
    flex-direction: column;
    gap: 0.5rem !important;
  }
  
  .btn-sm {
    padding: 0.2rem 0.4rem;
    font-size: 0.8rem;
  }
}
</style>
<% end %>
