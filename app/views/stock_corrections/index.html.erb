<% content_for :title, "Controle de Estoque" %>
<% filters = params.permit(:q, :location, :status, :period, :kpi, :sort, :dir).to_h.compact_blank %>
<% list_filters = filters.except('sort', 'dir') %>
<% filtered = list_filters.any? %>
<% clear_url = stock_corrections_path(filters.slice('sort', 'dir')) %>
<% kpi_url = ->(key, value) { stock_corrections_path(filters.except('status', 'kpi').merge(key => (filters[key] == value ? nil : value)).compact) } %>
<% statuses = { 'pending' => ['Pendente', 'yellow', 'Conferência em andamento. Ainda dá para contar produtos e corrigir o estoque.'],
                'executed' => ['Executada', 'green', 'Conferência finalizada. As correções já foram aplicadas no Shopify.'] } %>
<% shop_states = { 'ok' => ['Aplicadas', 'green'], 'final' => ['Aplicadas', 'green'], 'erro' => ['Erro no Shopify', 'red'], 'vazio' => ['Sem correções', 'gray'] } %>
<% accuracy_states = { 'boa' => ['Boa', 'green', '95% ou mais dos itens estavam certos.'], 'atencao' => ['Atenção', 'yellow', 'De 85% a 94% dos itens estavam certos.'],
                       'baixa' => ['Baixa', 'red', 'Menos de 85% dos itens estavam certos. Vale uma nova conferência.'], 'nd' => ['KPI não calculado', 'gray', 'A location ainda não tem conferência para calcular.'] } %>
<% location_options = current_user.available_locations_for_user %>
<% locs = current_user.admin? ? :all : location_options.map(&:first) %>

<%= hc_page_header 'Controle de Estoque', 'Conte o estoque que existe na loja e corrija no Shopify o que não bate.', icon: 'fas fa-warehouse' do %>
  <% if screen_can?(:stock_corrections, :create) %>
    <%= link_to new_stock_correction_path, class: 'btn btn-export' do %><i class="fas fa-plus"></i>Nova conferência<% end %>
  <% end %>
<% end %>

<div class="pg-blocks">
  <%= hc_kpis([
    { label: 'Pendentes', icon: 'fas fa-hourglass-half', tone: 'yellow', value: @kpis[:pending], help: 'Ainda dá para contar e corrigir.',
      url: kpi_url.call('status', 'pending'), active: filters['status'] == 'pending' },
    { label: 'Executadas', icon: 'fas fa-circle-check', tone: 'green', value: @kpis[:executed], help: 'Conferências finalizadas.',
      url: kpi_url.call('status', 'executed'), active: filters['status'] == 'executed' },
    { label: 'Com erro no Shopify', icon: 'fas fa-triangle-exclamation', tone: 'red', value: @kpis[:error], help: 'Reenvie com Executar todas.',
      url: kpi_url.call('kpi', 'error'), active: filters['kpi'] == 'error' },
    { label: 'Correções feitas', icon: 'fas fa-screwdriver-wrench', tone: 'blue', value: @kpis[:corrections], help: 'Produtos ajustados no Shopify.',
      url: kpi_url.call('kpi', 'corrections'), active: filters['kpi'] == 'corrections' }
  ]) %>

  <%= hc_table_card 'Lista de conferências', icon: 'fas fa-clipboard-check', meta: 'Cada conferência é a contagem de uma location numa data. O que não bate é corrigido direto no Shopify.' do %>
    <%= hc_filters stock_corrections_path, clear: (clear_url if filtered) do %>
      <% filters.slice('sort', 'dir', 'kpi').each do |name, value| %><%= hidden_field_tag name, value, id: nil %><% end %>
      <%= hc_filter_field 'Buscar', tip: 'Digite o número da conferência ou uma parte do motivo.', search: true do %>
        <%= hc_filter_search :q, filters['q'], 'Número ou motivo…' %>
      <% end %>
      <%= hc_filter_field 'Location', tip: 'A loja onde a contagem foi feita. Você só vê as lojas liberadas no seu perfil.' do %>
        <%= hc_filter_select :location, location_options, filters['location'], all: 'Todas as lojas' %>
      <% end %>
      <%= hc_filter_field 'Status', tip: 'Pendente: ainda dá para contar. Executada: conferência finalizada.' do %>
        <%= hc_filter_select :status, statuses.map { |k, v| [v[0], k] }, filters['status'], all: 'Todos status' %>
      <% end %>
      <%= hc_filter_field 'Data da conferência' do %>
        <%= hc_filter_select :period, hc_period_options, filters['period'], all: 'Todo o período' %>
      <% end %>
    <% end %>

    <div class="pg-body">
      <% chips = [] %>
      <% chips << { label: 'Buscar', value: "“#{filters['q']}”", clear: stock_corrections_path(filters.except('q')) } if filters['q'] %>
      <% chips << { label: 'Location', value: User.location_name(filters['location']), clear: stock_corrections_path(filters.except('location')) } if filters['location'] %>
      <% chips << { label: 'Status', value: statuses.dig(filters['status'], 0), clear: stock_corrections_path(filters.except('status')) } if statuses[filters['status']] %>
      <% chips << { label: 'Data da conferência', value: HoneyUiHelper::PERIODS[filters['period']], clear: stock_corrections_path(filters.except('period')) } if HoneyUiHelper::PERIODS[filters['period']] %>
      <% chips << { label: { 'error' => 'Com erro no Shopify', 'corrections' => 'Correções feitas' }[filters['kpi']], clear: stock_corrections_path(filters.except('kpi')) } if filters['kpi'] %>
      <%= hc_active_filters @stock_corrections.total_entries, 'conferências', unit1: 'conferência', filtered: filtered, locs: locs, chips: chips,
                            legend: statuses.values %>

      <% if @stock_corrections.any? %>
        <div class="table-responsive">
          <table class="orders-table pg-tbl">
            <thead>
              <tr>
                <%= hc_th 'ID', sort: 'id' %>
                <%= hc_th 'Location' %>
                <%= hc_th 'Motivo' %>
                <%= hc_th 'Data da conferência', sort: 'correction_date' %>
                <%= hc_th 'Itens', sort: 'items', right: true %>
                <%= hc_th 'Correções', sort: 'corrections', right: true %>
                <%= hc_th 'Status' %>
                <th style="text-align: right">Ações</th>
              </tr>
            </thead>
            <tbody class="stagger">
              <% @stock_corrections.each_with_index do |correction, i| %>
                <% status = correction.executed? ? 'executed' : 'pending' %>
                <% shop = if correction.errors_total.to_i.positive? then 'erro'
                          elsif correction.executed? then 'final'
                          elsif correction.corrections_total.to_i.positive? then 'ok'
                          else 'vazio'
                          end %>
                <tr style="--i: <%= i %>">
                  <%= hc_td 'ID', type: :num do %><%= link_to hc_num(correction.id), stock_correction_path(correction), class: 'text-main t' %><% end %>
                  <%= hc_td 'Location' do %><%= hc_location(User.location_name(correction.location), key: correction.location) %><% end %>
                  <%= hc_td 'Motivo', sub: correction.user&.name do %><span class="pg-txt"><%= correction.reason.presence || '—' %></span><% end %>
                  <%= hc_td 'Data da conferência' do %><%= hc_d(correction.correction_date) %><% end %>
                  <%= hc_td 'Itens', type: :qty do %><%= hc_qty(correction.items_total) %><% end %>
                  <%= hc_td 'Correções', type: :qty, sub: shop_states[shop][0] do %><%= hc_qty(correction.corrections_total) %><% end %>
                  <%= hc_td 'Status' do %><%= hc_status(*statuses[status][0, 2], tip: statuses[status][2]) %><% end %>
                  <td class="td-actions" style="text-align: right" data-label="">
                    <%= hc_row_action 'fas fa-eye', 'Ver conferência', stock_correction_path(correction) %>
                    <% if (!correction.executed? || current_user.admin?) && screen_can?(:stock_corrections, :edit) %>
                      <%= hc_row_action 'fas fa-list-check', 'Contar estoque', edit_stock_correction_path(correction) %>
                    <% end %>
                    <% if shop == 'erro' && screen_can?(:stock_corrections, :execute) %>
                      <%= hc_row_action 'fas fa-rotate', 'Executar todas', execute_all_stock_correction_path(correction), method: :post,
                                        confirm: "Executar todas na conferência ##{correction.id}? O sistema manda de novo ao Shopify todas as correções que deram erro." %>
                    <% end %>
                    <% if !correction.executed? && screen_can?(:stock_corrections, :execute) %>
                      <%= hc_row_action 'fas fa-flag-checkered', 'Finalizar conferência', finalize_correction_stock_correction_path(correction), method: :get,
                                        confirm: "Finalizar a conferência ##{correction.id}? Depois de finalizada, ninguém mais conta nem corrige produtos nela." %>
                    <% end %>
                    <% if correction.executed? && current_user.admin? %>
                      <%= hc_row_action 'fas fa-lock-open', 'Reabrir conferência', reopen_stock_correction_path(correction), method: :patch,
                                        confirm: "Reabrir a conferência ##{correction.id}? Ela volta para Pendente e dá para contar e corrigir produtos de novo." %>
                    <% end %>
                    <% if current_user.admin? && screen_can?(:stock_corrections, :destroy) %>
                      <%= hc_row_action 'fas fa-trash', 'Excluir conferência', stock_correction_path(correction), danger: true, method: :delete,
                                        confirm: "Excluir a conferência ##{correction.id}? Esta ação não pode ser desfeita." %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= hc_table_footer @stock_corrections %>
      <% elsif filtered %>
        <%= hc_empty_filtered clear_url %>
      <% else %>
        <%= hc_empty 'Nenhuma conferência encontrada', 'Crie a primeira conferência de estoque da sua loja.',
                     cta: (screen_can?(:stock_corrections, :create) ? link_to(safe_join([content_tag(:i, '', class: 'fas fa-plus'), 'Nova conferência']), new_stock_correction_path, class: 'btn btn-export') : nil) %>
      <% end %>
    </div>
  <% end %>

  <%= hc_table_card 'Acurácia de estoque por location', icon: 'fas fa-bullseye', id: 'acuracia',
                    meta: 'Quantos itens estavam certos, somando todas as conferências da loja. Verde: 95% ou mais. Amarelo: de 85% a 94%. Vermelho: menos de 85%.' do %>
    <div class="pg-body">
      <%= hc_active_filters @accuracy.total_entries, 'locations', unit1: 'location', locs: locs, legend: accuracy_states.values %>
      <% if @accuracy.any? %>
        <div class="table-responsive">
          <table class="orders-table pg-tbl">
            <thead>
              <tr><th>Location</th><th>Acurácia</th><th class="is-r">Conferências</th><th>Situação</th><th style="text-align: right">Ações</th></tr>
            </thead>
            <tbody class="stagger">
              <% @accuracy.each_with_index do |row, i| %>
                <% location = row[:location] %>
                <% pct = location.kpi_ratio&.to_f %>
                <% state = pct.nil? ? 'nd' : pct >= 95 ? 'boa' : pct >= 85 ? 'atencao' : 'baixa' %>
                <tr style="--i: <%= i %>">
                  <%= hc_td 'Location' do %><%= hc_location(location.name, key: location.slug) %><% end %>
                  <%= hc_td 'Acurácia', sub: (location.kpi_updated_at ? "Atualizada #{hc_ago(location.kpi_updated_at)}" : 'Sem conferência para calcular') do %>
                    <% if pct %><%= hc_progress(pct, tone: accuracy_states[state][1]) %><% else %><span class="pg-dash">—</span><% end %>
                  <% end %>
                  <%= hc_td 'Conferências', type: :qty do %><%= hc_qty(row[:conferences]) %><% end %>
                  <%= hc_td 'Situação' do %><%= hc_status(*accuracy_states[state][0, 2], tip: accuracy_states[state][2]) %><% end %>
                  <td class="td-actions" style="text-align: right" data-label="">
                    <%= hc_row_action 'fas fa-eye', "Ver as conferências de #{location.name}", stock_corrections_path(location: location.slug) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= hc_table_footer @accuracy, param_name: :acc_page %>
      <% else %>
        <%= hc_empty 'Nenhuma location liberada', 'Seu perfil ainda não enxerga nenhuma loja. Peça ao administrador para liberar.' %>
      <% end %>
    </div>
  <% end %>
</div>
