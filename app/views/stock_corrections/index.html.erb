<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center flex-wrap">
          <div>
            <h4 class="text-white mb-1">
              <i class="fas fa-clipboard-check me-2"></i>Conferências de Estoque
            </h4>
            <small class="text-white-50">
              <i class="fas fa-clock me-1"></i>
              Última atualização: <%= Time.current.strftime('%d/%m/%Y às %H:%M') %>
            </small>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <%= link_to new_stock_correction_path, class: "btn btn-success" do %>
              <i class="fas fa-plus me-1"></i>Nova Conferência
            <% end %>
            <%= link_to inventory_products_path, class: "btn btn-info" do %>
              <i class="fas fa-boxes me-1"></i>Inventário
            <% end %>
          </div>
        </div>
        
      </div>
    </div>
  </div>
   <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-chart-line me-2"></i>Acurácia de Estoque por Localidade
          </h5>
        </div>

        <div class="card-body bg-black">
          <div class="row g-3">
            <% @locations_kpi.each do |location| %>
              <div class="col-xl-2 col-lg-3 col-md-4 col-6">
                <div class="card bg-dark border-secondary h-100 text-center">
                  <div class="card-body py-3 px-2">

                    <i class="fas fa-store text-info mb-2"></i>

                    <div class="text-white fw-semibold small mb-1">
                      <%= location.name %>
                    </div>

                    <% if location.kpi_ratio.present? %>
                      <div class="fw-bold fs-5
                        <%= location.kpi_ratio >= 95 ? 'text-success' :
                            location.kpi_ratio >= 85 ? 'text-warning' :
                            'text-danger' %>">
                        <%= number_to_percentage(location.kpi_ratio, precision: 0) %>
                      </div>

                      <small class="text-white-50">
                        <%= location.kpi_updated_at&.strftime('%d/%m %H:%M') %>
                      </small>
                    <% else %>
                      <span class="badge bg-secondary mt-2">
                        KPI não calculado
                      </span>
                    <% end %>

                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body bg-black">
          <%= form_with url: stock_corrections_path, method: :get, local: true, 
                        class: "row g-3 align-items-end" do |f| %>
            <div class="col-md-3">
              <label class="form-label text-white fw-bold">Location</label>
              <%= f.select :location, 
                          options_for_select(current_user.available_locations_for_user, params[:location]),
                          { include_blank: "Todas as locations" },
                          { class: "form-select bg-dark text-white border-dark" } %>
            </div>
            <div class="col-md-3">
              <label class="form-label text-white fw-bold">Status</label>
              <%= f.select :status, 
                          options_for_select([
                            ['Todos', ''],
                            ['Pendente', 'pending'],
                            ['Executada', 'executed']
                          ], params[:status]),
                          {},
                          { class: "form-select bg-dark text-white border-dark" } %>
            </div>
            <div class="col-md-3">
              <label class="form-label text-white fw-bold">Data</label>
              <%= f.date_field :date_filter, 
                               value: params[:date_filter],
                               class: "form-control bg-dark text-white border-dark" %>
            </div>
            <div class="col-md-1">
              <%= f.submit "Filtrar", class: "btn btn-primary w-100" %>
            </div>
            <div class="col-md-2">
              <%= link_to stock_corrections_path, class: "btn btn-outline-light w-100" do %>
                <i class="fas fa-times me-1"></i>Limpar
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-list me-2"></i>Lista de Conferências
          </h5>
          <span class="badge bg-info text-dark px-3 py-2">
            <i class="fas fa-clipboard-check me-1"></i>
            <%= @total_corrections %> conferência(s)
          </span>
        </div>
        
        <div class="card-body bg-black p-0">
          <% if @stock_corrections.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-3 py-3">ID</th>
                    <th class="text-white fw-bold px-3 py-3">Location</th>
                    <th class="text-white fw-bold px-3 py-3">Motivo</th>
                    <th class="text-white fw-bold px-3 py-3">Data da Conferência</th>
                    <th class="text-white fw-bold px-3 py-3">Status</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Itens</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Correções</th>
                    <th class="text-white fw-bold px-3 py-3">Criada em</th>
                    <th class="text-white fw-bold px-3 py-3 text-center">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% @stock_corrections.each do |correction| %>
                    <tr class="border-secondary">
                      <td class="px-3 py-3">
                        <span class="text-white font-monospace">
                          #<%= correction.id %>
                        </span>
                      </td>
                      <td class="px-3 py-3">
                        <span class="badge bg-secondary text-white px-2 py-1">
                          <%= User.location_name(correction.location) %>
                        </span>
                      </td>
                      <td class="px-3 py-3">
                        <%= correction.reason %>
                      </td>
                      <td class="px-3 py-3">
                        <span class="text-white">
                          <%= correction.correction_date&.strftime('%d/%m/%Y') || 'N/A' %>
                        </span>
                      </td>
                      <td class="px-3 py-3">
                        <% case correction.status %>
                        <% when 'executed' %>
                          <span class="badge bg-success px-2 py-1">
                            <i class="fas fa-check me-1"></i>Executada
                          </span>
                        <% when 'pending', nil %>
                          <span class="badge bg-warning text-dark px-2 py-1">
                            <i class="fas fa-hourglass-half me-1"></i>Pendente
                          </span>
                        <% else %>
                          <span class="badge bg-secondary px-2 py-1">
                            <%= correction.status&.humanize || 'N/A' %>
                          </span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <span class="text-white">
                          <%= correction.stock_correction_items.count %>
                        </span>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <span class="badge bg-info text-dark px-2 py-1">
                          <%= correction.stock_correction_items.where(needs_correction: true).count %>
                        </span>
                      </td>
                      <td class="px-3 py-3">
                        <span class="text-white-50">
                          <%= correction.created_at.strftime('%d/%m/%Y %H:%M') %>
                        </span>
                      </td>
                      <td class="px-3 py-3 text-center">
                        <div class="btn-group" role="group">
                          <%= link_to correction, class: "btn btn-outline-info btn-sm", title: "Visualizar" do %>
                            <i class="fas fa-eye"></i>
                          <% end %>
                          
                          <% if correction.status != 'executed' || current_user.admin? %>
                            <%= link_to edit_stock_correction_path(correction), class: "btn btn-outline-warning btn-sm", title: "Editar" do %>
                              <i class="fas fa-edit"></i>
                            <% end %>
                          <% end %>
                          
                          <% if current_user.admin? %>
                            <%= button_to stock_correction_path(correction), 
                                          method: :delete,
                                          data: { 
                                            confirm: "Tem certeza que deseja excluir esta conferência? Esta ação não pode ser desfeita.",
                                            turbo_confirm: "Tem certeza que deseja excluir esta conferência? Esta ação não pode ser desfeita."
                                          },
                                          class: "btn btn-outline-danger btn-sm", 
                                          title: "Excluir",
                                          form: { style: "display: inline;" } do %>
                              <i class="fas fa-trash"></i>
                            <% end %>
                          <% end %>
                          
                          <% if correction.status == 'executed' && current_user.admin? %>
                            <%= link_to reopen_stock_correction_path(correction), 
                                        method: :patch,
                                        data: { 
                                          confirm: "Tem certeza que deseja reabrir esta conferência?",
                                          turbo_method: :patch
                                        },
                                        class: "btn btn-outline-secondary btn-sm", 
                                        title: "Reabrir" do %>
                              <i class="fas fa-undo"></i>
                            <% end %>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-clipboard-check fa-3x text-white-50 mb-3"></i>
              <h5 class="text-white-50">Nenhuma conferência encontrada</h5>
              <p class="text-white-50">Crie sua primeira conferência de estoque</p>
              <%= link_to new_stock_correction_path, class: "btn btn-success mt-3" do %>
                <i class="fas fa-plus me-1"></i>Nova Conferência
              <% end %>
            </div>
          <% end %>
        </div>

        <% if @total_pages > 1 %>
          <div class="card-footer bg-dark border-top border-secondary">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
              <div class="text-white-50 mb-2 mb-md-0">
                Mostrando <%= (@current_page - 1) * @per_page + 1 %> a 
                <%= [@current_page * @per_page, @total_corrections].min %> de 
                <%= @total_corrections %> conferências
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <% if @current_page > 1 %>
                  <%= link_to stock_corrections_path(page: @current_page - 1, **request.query_parameters.except('page')),
                              class: "btn btn-outline-light btn-sm" do %>
                    <i class="fas fa-chevron-left"></i> Anterior
                  <% end %>
                <% end %>

                <!-- Simplified pagination logic to show correct page numbers -->
                <% 
                  # Show up to 5 pages around current page
                  window_size = 2
                  page_start = [@current_page - window_size, 1].max
                  page_end = [@current_page + window_size, @total_pages].min
                  
                  # Adjust if we're near the beginning or end
                  if page_end - page_start < 4 && @total_pages > 4
                    if page_start == 1
                      page_end = [5, @total_pages].min
                    elsif page_end == @total_pages
                      page_start = [@total_pages - 4, 1].max
                    end
                  end
                %>
                
                <% (page_start..page_end).each do |page_num| %>
                  <% if page_num == @current_page %>
                    <button class="btn btn-primary btn-sm"><%= page_num %></button>
                  <% else %>
                    <%= link_to page_num, 
                                stock_corrections_path(page: page_num, **request.query_parameters.except('page')),
                                class: "btn btn-outline-light btn-sm" %>
                  <% end %>
                <% end %>

                <% if @current_page < @total_pages %>
                  <%= link_to stock_corrections_path(page: @current_page + 1, **request.query_parameters.except('page')),
                              class: "btn btn-outline-light btn-sm" do %>
                    Próxima <i class="fas fa-chevron-right"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<% end %>
