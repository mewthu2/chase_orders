<script>
document.addEventListener('DOMContentLoaded', function() {
console.log('🚀 Script carregado - Interface Separada');

// Função para obter CSRF token
function getCSRFToken() {
  const token = document.querySelector('meta[name="csrf-token"]');
  return token ? token.getAttribute('content') : '';
}

// Função para mostrar/esconder campos baseado na seleção do dropdown
function toggleFields(itemId, actionType) {
  const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
  const stockInput = row.querySelector('.corrected-stock-input');
  const reasonInput = row.querySelector('.correction-reason-input');
  const saveBtn = row.querySelector('.save-item-btn');
  
  console.log('🔄 Alternando campos para item:', itemId, 'ação:', actionType);
  
  // Esconder todos os campos primeiro
  stockInput.style.display = 'none';
  reasonInput.style.display = 'none';
  saveBtn.style.display = 'none';
  
  // Limpar valores
  stockInput.value = '';
  reasonInput.value = '';
  
  if (actionType === 'checked') {
    // Para conferido, só mostrar o botão salvar
    saveBtn.style.display = 'inline-block';
    console.log('✅ Modo conferido - só botão salvar');
    
  } else if (actionType === 'correction') {
    // Para correção, mostrar campos obrigatórios e botão salvar
    stockInput.style.display = 'block';
    reasonInput.style.display = 'block';
    saveBtn.style.display = 'inline-block';
    
    // Focar no primeiro campo
    stockInput.focus();
    console.log('🔧 Modo correção - campos obrigatórios visíveis');
  }
}

// Função para validar campos obrigatórios
function validateFields(itemId, actionType) {
  const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
  
  if (actionType === 'correction') {
    const stockInput = row.querySelector('.corrected-stock-input');
    const reasonInput = row.querySelector('.correction-reason-input');
    
    if (!stockInput.value || !reasonInput.value) {
      alert('Por favor, preencha o novo estoque e o motivo da correção.');
      return false;
    }
    
    if (parseInt(stockInput.value) < 0) {
      alert('O estoque não pode ser negativo.');
      return false;
    }
  }
  
  return true;
}

// Event listener para mudança no dropdown
document.addEventListener('change', function(e) {
  if (e.target.classList.contains('action-dropdown')) {
    const itemId = e.target.dataset.itemId;
    const actionType = e.target.value;
    
    console.log('📋 Dropdown alterado:', itemId, actionType);
    
    if (actionType) {
      toggleFields(itemId, actionType);
    } else {
      // Se voltou para "Selecione...", esconder tudo
      toggleFields(itemId, '');
    }
  }
});

// Event listener para validação em tempo real
document.addEventListener('input', function(e) {
  if (e.target.classList.contains('corrected-stock-input') || 
      e.target.classList.contains('correction-reason-input')) {
    
    const itemId = e.target.dataset.itemId;
    const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
    const dropdown = row.querySelector('.action-dropdown');
    const saveBtn = row.querySelector('.save-item-btn');
    
    // Verificar se todos os campos obrigatórios estão preenchidos
    if (dropdown.value === 'correction') {
      const stockInput = row.querySelector('.corrected-stock-input');
      const reasonInput = row.querySelector('.correction-reason-input');
      
      if (stockInput.value && reasonInput.value) {
        saveBtn.disabled = false;
        saveBtn.classList.remove('btn-secondary');
        saveBtn.classList.add('btn-success');
      } else {
        saveBtn.disabled = true;
        saveBtn.classList.remove('btn-success');
        saveBtn.classList.add('btn-secondary');
      }
    }
  }
});

// Event listener para salvar item
document.addEventListener('click', function(e) {
  if (e.target.closest('.save-item-btn')) {
    const btn = e.target.closest('.save-item-btn');
    const itemId = btn.dataset.itemId;
    const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
    const dropdown = row.querySelector('.action-dropdown');
    const actionType = dropdown.value;
    
    console.log('💾 Salvando item:', itemId, 'ação:', actionType);
    
    if (!actionType) {
      alert('Por favor, selecione uma ação primeiro.');
      return;
    }
    
    // Validar campos obrigatórios
    if (!validateFields(itemId, actionType)) {
      return;
    }
    
    // Preparar dados
    const data = {
      item_id: itemId,
      action_type: actionType
    };
    
    if (actionType === 'correction') {
      const stockInput = row.querySelector('.corrected-stock-input');
      const reasonInput = row.querySelector('.correction-reason-input');
      
      data.corrected_stock = stockInput.value;
      data.correction_reason = reasonInput.value;
    }
    
    // Mostrar loading
    const icon = btn.querySelector('i');
    const originalIcon = icon.className;
    const originalText = btn.innerHTML;
    
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';
    
    // Enviar para o servidor
    const correctionId = '<%= @stock_correction.id %>';
    fetch(`/stock_corrections/${correctionId}/save_item_correction`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': getCSRFToken()
      },
      body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(data => {
      console.log('📨 Resposta do servidor:', data);
      
      if (data.success) {
        // Mostrar mensagem de sucesso
        alert(data.message);
        
        // Recarregar a página para mostrar o novo estado
        location.reload();
      } else {
        alert('Erro: ' + data.message);
        
        // Restaurar botão
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    })
    .catch(error => {
      console.error('❌ Erro na requisição:', error);
      alert('Erro na requisição: ' + error.message);
      
      // Restaurar botão
      btn.disabled = false;
      btn.innerHTML = originalText;
    });
  }
});

// Permitir salvar com Enter nos campos de input
document.addEventListener('keydown', function(e) {
  if (e.key === 'Enter') {
    if (e.target.classList.contains('corrected-stock-input') || 
        e.target.classList.contains('correction-reason-input')) {
      
      const itemId = e.target.dataset.itemId;
      const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
      const saveBtn = row.querySelector('.save-item-btn');
      
      if (saveBtn && !saveBtn.disabled) {
        saveBtn.click();
      }
    }
  }
});

console.log('✅ Script inicializado - Interface separada pronta');
});
</script>
