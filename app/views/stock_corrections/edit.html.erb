<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <div>
            <h4 class="text-white mb-1">
              <i class="fas fa-edit me-2"></i>Editar Conferência #<%= @stock_correction.id %>
            </h4>
            <small class="text-white-50">
              <i class="fas fa-map-marker-alt me-1"></i>
              <%= location_display_name(@location) %> - 
              <%= @stock_correction.correction_date.strftime('%d/%m/%Y') %>
            </small>
          </div>
          <div class="d-flex gap-2">
            <%= link_to stock_corrections_path, class: "btn btn-outline-light" do %>
              <i class="fas fa-arrow-left me-1"></i>Voltar
            <% end %>
            <% if @stock_correction.status != 'executed' %>
              <%= link_to finalize_correction_stock_correction_path(@stock_correction), 
                          method: :patch,
                          class: "btn btn-success",
                          data: { confirm: "Tem certeza que deseja finalizar esta conferência?" } do %>
                <i class="fas fa-check me-1"></i>Finalizar
              <% end %>
            <% else %>
              <% if current_user.admin? %>
                <%= link_to reopen_stock_correction_path(@stock_correction), 
                            method: :patch,
                            class: "btn btn-warning",
                            data: { confirm: "Tem certeza que deseja reabrir esta conferência?" } do %>
                  <i class="fas fa-undo me-1"></i>Reabrir
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="card-body bg-black">
          <!-- Busca de Produto -->
          <div class="row mb-4">
            <div class="col-12">
              <div class="card bg-dark border border-secondary">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">
                    <i class="fas fa-search me-2"></i>Buscar Produto para Correção
                  </h6>
                </div>
                <div class="card-body">
                  <%= form_with url: edit_stock_correction_path(@stock_correction), 
                                method: :get, local: true, class: "row g-3" do |f| %>
                    <div class="col-md-8">
                      <%= f.text_field :search_term, 
                                       value: @search_term,
                                       placeholder: "Digite o SKU do produto...",
                                       class: "form-control bg-dark text-white border-dark" %>
                    </div>
                    <div class="col-md-4">
                      <%= f.submit "Buscar", class: "btn btn-primary w-100" %>
                    </div>
                  <% end %>
                  
                  <% if @search_error %>
                    <div class="alert alert-danger mt-3">
                      <i class="fas fa-exclamation-triangle me-2"></i>
                      <%= @search_error %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Item Encontrado -->
          <% if @search_item %>
            <div class="row mb-4">
              <div class="col-12">
                <div class="card bg-success border border-success">
                  <div class="card-header bg-success">
                    <h6 class="text-white mb-0">
                      <i class="fas fa-check-circle me-2"></i>Produto Encontrado
                    </h6>
                  </div>
                  <div class="card-body bg-dark">
                    <div class="table-responsive">
                      <table class="table table-dark mb-0">
                        <thead>
                          <tr>
                            <th class="text-white">Produto</th>
                            <th class="text-white text-center">Estoque Atual</th>
                            <th class="text-white text-center">Fonte</th>
                            <th class="text-white text-center">Ações</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <td class="px-3 py-3">
                              <div>
                                <span class="text-white fw-medium d-block"><%= format_product_name_for_correction(@search_item.product) %></span>
                                <small class="text-warning fw-bold font-monospace">
                                  SKU: <%= @search_item.product.sku %>
                                </small>
                                <% if @search_item.product.shopify_variant_id.present? %>
                                  <br><small class="text-white-50">
                                    <i class="fab fa-shopify me-1"></i>ID: <%= @search_item.product.shopify_variant_id %>
                                  </small>
                                <% end %>
                              </div>
                            </td>
                            <td class="text-center">
                              <span class="badge <%= stock_badge_class(@search_item.real_stock) %> px-2 py-1">
                                <%= @search_item.real_stock %> un.
                              </span>
                            </td>
                            <td class="text-center">
                              <%= stock_source_indicator(@search_item) %>
                            </td>
                            <td class="text-center">
                              <button class="btn btn-primary btn-sm" 
                                      onclick="openCorrectionModal('<%= @search_item.product.sku %>', 
                                                                   '<%= @search_item.product.id %>', 
                                                                   <%= @search_item.real_stock %>)">
                                <i class="fas fa-edit me-1"></i>Corrigir
                              </button>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Lista de Produtos com Correção -->
          <div class="row">
            <div class="col-12">
              <div class="card bg-dark border border-secondary">
                <div class="card-header bg-secondary d-flex justify-content-between align-items-center">
                  <h6 class="text-white mb-0">
                    <i class="fas fa-edit me-2"></i>Produtos com Correção
                  </h6>
                  <span class="badge bg-warning text-dark px-3 py-2">
                    <%= @total_processed %> produto(s) corrigido(s)
                  </span>
                </div>
                
                <div class="card-body p-0">
                  <% if @processed_items.any? %>
                    <div class="table-responsive">
                      <table class="table table-dark table-hover mb-0">
                        <thead class="bg-dark">
                          <tr>
                            <th class="text-white fw-bold px-3 py-3">Produto</th>
                            <th class="text-white fw-bold px-3 py-3 text-center">Estoque Atual</th>
                            <th class="text-white fw-bold px-3 py-3 text-center">Estoque Corrigido</th>
                            <th class="text-white fw-bold px-3 py-3">Motivo</th>
                            <th class="text-white fw-bold px-3 py-3 text-center">Status</th>
                            <th class="text-white fw-bold px-3 py-3 text-center">Ações</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% @processed_items.each do |item| %>
                            <tr class="border-secondary">
                              <td class="px-3 py-3">
                                <div>
                                  <span class="text-white fw-medium d-block"><%= format_product_name_for_correction(item.product) %></span>
                                  <small class="text-warning fw-bold font-monospace">
                                    SKU: <%= item.product.sku %>
                                  </small>
                                  <% if item.product.shopify_variant_id.present? %>
                                    <br><small class="text-white-50">
                                      <i class="fab fa-shopify me-1"></i>ID: <%= item.product.shopify_variant_id %>
                                    </small>
                                  <% end %>
                                </div>
                              </td>
                              <td class="px-3 py-3 text-center">
                                <span class="badge <%= stock_badge_class(item.real_stock) %> px-2 py-1">
                                  <%= item.real_stock %> un.
                                </span>
                              </td>
                              <td class="px-3 py-3 text-center">
                                <span class="badge bg-success text-white px-2 py-1">
                                  <%= item.corrected_stock %> un.
                                </span>
                              </td>
                              <td class="px-3 py-3">
                                <small class="text-success">
                                  <i class="fas fa-check me-1"></i>
                                  <%= truncate(item.correction_reason, length: 25) %>
                                </small>
                              </td>
                              <td class="px-3 py-3 text-center">
                                <% if item.executed? %>
                                  <span class="badge bg-success text-white px-2 py-1">
                                    <i class="fas fa-check me-1"></i>Executado
                                  </span>
                                <% else %>
                                  <span class="badge bg-warning text-dark px-2 py-1">
                                    <i class="fas fa-clock me-1"></i>Pendente
                                  </span>
                                <% end %>
                              </td>
                              <td class="px-3 py-3 text-center">
                                <% unless @stock_correction.status == 'executed' %>
                                  <button class="btn btn-primary btn-sm" 
                                          onclick="openCorrectionModal('<%= item.product.sku %>', 
                                                                       '<%= item.product.id %>', 
                                                                       <%= item.real_stock || item.current_stock %>)">
                                    <i class="fas fa-edit me-1"></i>Editar
                                  </button>
                                <% else %>
                                  <span class="text-white-50">
                                    <i class="fas fa-lock me-1"></i>Finalizado
                                  </span>
                                <% end %>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>

                    <!-- Paginação -->
                    <% if @total_pages > 1 %>
                      <div class="card-footer bg-dark border-top border-secondary">
                        <div class="d-flex justify-content-center">
                          <nav>
                            <ul class="pagination pagination-sm mb-0">
                              <% if @current_page > 1 %>
                                <li class="page-item">
                                  <%= link_to edit_stock_correction_path(@stock_correction, page: @current_page - 1), 
                                              class: "page-link bg-dark text-white border-secondary" do %>
                                    <i class="fas fa-chevron-left"></i>
                                  <% end %>
                                </li>
                              <% end %>

                              <% (1..@total_pages).each do |page| %>
                                <li class="page-item <%= 'active' if page == @current_page %>">
                                  <%= link_to page, 
                                              edit_stock_correction_path(@stock_correction, page: page),
                                              class: "page-link #{'bg-primary border-primary' if page == @current_page} #{'bg-dark text-white border-secondary' unless page == @current_page}" %>
                                </li>
                              <% end %>

                              <% if @current_page < @total_pages %>
                                <li class="page-item">
                                  <%= link_to edit_stock_correction_path(@stock_correction, page: @current_page + 1), 
                                              class: "page-link bg-dark text-white border-secondary" do %>
                                    <i class="fas fa-chevron-right"></i>
                                  <% end %>
                                </li>
                              <% end %>
                            </ul>
                          </nav>
                        </div>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="text-center py-5">
                      <i class="fas fa-edit fa-3x text-white-50 mb-3"></i>
                      <h5 class="text-white-50">Nenhum produto com correção ainda</h5>
                      <p class="text-white-50">Use a busca acima para adicionar produtos à conferência</p>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Correção -->
<div class="modal fade" id="correctionModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border border-secondary">
      <div class="modal-header bg-secondary border-bottom border-secondary">
        <h5 class="modal-title text-white">
          <i class="fas fa-edit me-2"></i>Corrigir Estoque
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="correctionForm">
          <input type="hidden" id="productId" name="product_id">
          <input type="hidden" id="itemId" name="item_id">
          
          <div class="mb-3">
            <label class="form-label text-white fw-bold">SKU do Produto</label>
            <input type="text" id="productSku" class="form-control bg-dark text-white border-dark" readonly>
          </div>
          
          <div class="mb-3">
            <label class="form-label text-white fw-bold">Estoque Real Atual</label>
            <input type="number" id="currentStock" class="form-control bg-dark text-white border-dark" readonly>
          </div>
          
          <div class="mb-3">
            <label class="form-label text-white fw-bold">Novo Estoque</label>
            <input type="number" id="correctedStock" name="corrected_stock" 
                   class="form-control bg-dark text-white border-dark" 
                   min="0" required>
          </div>
          
          <div class="mb-3">
            <label class="form-label text-white fw-bold">Motivo da Correção</label>
            <textarea id="correctionReason" name="correction_reason" 
                      class="form-control bg-dark text-white border-dark" 
                      rows="3" required 
                      placeholder="Descreva o motivo da correção..."></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer bg-dark border-top border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          <i class="fas fa-times me-1"></i>Cancelar
        </button>
        <button type="button" class="btn btn-success" onclick="saveCorrection()">
          <i class="fas fa-save me-1"></i>Salvar Correção
        </button>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.form-control, .form-select, .form-control:focus, .form-select:focus {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
}

.table-dark {
  --bs-table-bg: transparent;
}

.table-hover tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.075);
}

.font-monospace {
  font-family: 'Courier New', monospace;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.text-warning {
  color: #ffc107 !important;
}
</style>
<% end %>

<% content_for :javascript do %>
<script>
function openCorrectionModal(sku, productId, currentStock) {
  document.getElementById('productSku').value = sku;
  document.getElementById('productId').value = productId;
  document.getElementById('currentStock').value = currentStock;
  document.getElementById('correctedStock').value = currentStock;
  document.getElementById('correctionReason').value = '';
  
  new bootstrap.Modal(document.getElementById('correctionModal')).show();
}

function saveCorrection() {
  const form = document.getElementById('correctionForm');
  const formData = new FormData(form);
  formData.append('action_type', 'correction');
  
  fetch('<%= save_item_correction_stock_correction_path(@stock_correction) %>', {
    method: 'POST',
    body: formData,
    headers: {
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('Erro: ' + data.message);
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Erro ao salvar correção');
  });
}
</script>
<% end %>
