<div class="container-fluid py-4">

  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h4 class="text-white mb-0">
            <i class="fas fa-edit me-2"></i>
            Editar Conferencia #<%= @stock_correction.id %> - <%= location_display_name(@stock_correction.location) %>
          </h4>
          <div class="d-flex gap-2">
            <% if @stock_correction.status != 'executed' %>
              <% pending_items = @stock_correction.stock_correction_items.where(shopify_sync_status: 'error') %>
              <% if pending_items.any? %>
                <% if @stock_correction.integration_status == 'pending' %>
                  <button type="button" class="btn btn-sm btn-secondary text-white" disabled>
                    <i class="fas fa-spinner fa-spin me-1"></i>Em andamento...
                  </button>
                <% else %>
                  <%= button_to execute_all_stock_correction_path(@stock_correction),
                      method: :post,
                      form_class: "d-inline",
                      class: "btn btn-sm btn-info text-dark",
                      data: { confirm: "Deseja executar todas as correcoes pendentes?", turbo_confirm: "Deseja executar todas as correcoes pendentes?" } do %>
                    <i class="fas fa-play me-1"></i>Executar Todas (<%= pending_items.count %>)
                  <% end %>
                <% end %>
              <% end %>
              <%= link_to finalize_correction_stock_correction_path(@stock_correction),
                  method: :get,
                  class: "btn btn-sm btn-success text-dark",
                  data: { confirm: "Tem certeza que deseja finalizar esta conferencia?" } do %>
                <i class="fas fa-check me-1"></i>Finalizar
              <% end %>
            <% else %>
              <span class="badge bg-success text-dark px-3 py-2">
                <i class="fas fa-check-circle me-1"></i>Conferencia Finalizada
              </span>
              <% if current_user.admin? %>
                <%= button_to reopen_stock_correction_path(@stock_correction),
                    method: :patch,
                    form_class: "d-inline",
                    class: "btn btn-sm btn-warning text-dark",
                    data: { confirm: "Tem certeza que deseja reabrir esta conferencia?", turbo_confirm: "Tem certeza que deseja reabrir esta conferencia?" } do %>
                  <i class="fas fa-undo me-1"></i>Reabrir
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="card-body bg-black">
          <div class="row">
            <div class="col-md-3">
              <strong class="text-white">Data:</strong>
              <p class="text-white-50 mb-2"><%= @stock_correction.correction_date.strftime('%d/%m/%Y') %></p>
            </div>
            <div class="col-md-3">
              <strong class="text-white">Status:</strong>
              <p class="mb-2">
                <span class="badge <%= @stock_correction.status == 'executed' ? 'bg-success text-dark' : 'bg-warning text-dark' %>">
                  <%= @stock_correction.status.humanize %>
                </span>
              </p>
            </div>
            <div class="col-md-6">
              <strong class="text-white">Motivo:</strong>
              <p class="text-white-50 mb-2"><%= @stock_correction.reason %></p>
            </div>
          </div>
          <% if @stock_correction.notes.present? %>
            <div class="row">
              <div class="col-12">
                <strong class="text-white">Observacoes:</strong>
                <p class="text-white-50 mb-0"><%= @stock_correction.notes %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body bg-black">
          <div class="row text-center">
            <div class="col-md-4">
              <div class="p-3">
                <h4 class="text-info mb-1"><%= @stats[:total] %></h4>
                <small class="text-white-50">Total de Produtos</small>
              </div>
            </div>
            <div class="col-md-4">
              <div class="p-3">
                <h4 class="text-warning mb-1"><%= @stats[:corrections] %></h4>
                <small class="text-white-50">Com Correcao</small>
              </div>
            </div>
            <div class="col-md-4">
              <div class="p-3">
                <h4 class="text-primary mb-1"><%= @stats[:executed] %></h4>
                <small class="text-white-50">Executados</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% error_items = @stock_correction.stock_correction_items.where(shopify_sync_status: 'error').includes(:product) %>
  <% if error_items.any? %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card bg-black border border-danger shadow-lg">
          <div class="card-header bg-dark border-bottom border-danger d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse"
               data-bs-target="#shopifyErrorsCollapse"
               aria-expanded="false"
               aria-controls="shopifyErrorsCollapse"
               style="cursor: pointer;">
            <div class="d-flex align-items-center gap-3">
              <h5 class="text-danger mb-0">
                <i class="fas fa-exclamation-triangle me-2"></i>Erros de Integracao Shopify
              </h5>
              <span class="badge bg-danger text-white px-2 py-1">
                <%= error_items.count %> pendente<%= error_items.count > 1 ? 's' : '' %>
              </span>
              <% if @stock_correction.integration_status == 'pending' %>
                <span class="badge bg-info text-dark px-2 py-1">
                  <i class="fas fa-spinner fa-spin me-1"></i>Processando...
                </span>
              <% end %>
            </div>
            <i class="fas fa-chevron-down text-white-50" id="shopifyErrorsChevron" style="transition: transform 0.25s ease;"></i>
          </div>
          <div class="collapse" id="shopifyErrorsCollapse">
            <div class="card-body bg-black p-0">
              <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                <table class="table table-dark table-hover mb-0">
                  <thead class="bg-dark" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                      <th class="text-white-50 fw-semibold px-3 py-2" style="width: 45px;">#</th>
                      <th class="text-white-50 fw-semibold px-3 py-2" style="width: 140px;">SKU</th>
                      <th class="text-white-50 fw-semibold px-3 py-2">Produto</th>
                      <th class="text-white-50 fw-semibold px-3 py-2 text-center" style="width: 110px;">Estoque Corrigido</th>
                      <th class="text-white-50 fw-semibold px-3 py-2">Mensagem de Erro</th>
                      <th class="text-white-50 fw-semibold px-3 py-2 text-center" style="width: 90px;">Acao</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% error_items.each_with_index do |item, index| %>
                      <tr class="border-secondary" id="error-row-<%= item.id %>">
                        <td class="px-3 py-2 text-white-50">
                          <small><%= index + 1 %></small>
                        </td>
                        <td class="px-3 py-2">
                          <span class="text-warning fw-bold font-monospace" style="font-size: 0.8rem;">
                            <%= item.product.sku %>
                          </span>
                        </td>
                        <td class="px-3 py-2">
                          <span class="text-white d-block" style="font-size: 0.875rem;">
                            <%= truncate(format_product_name_for_correction(item.product), length: 45) %>
                          </span>
                          <% if item.product.shopify_variant_id.present? %>
                            <small class="text-white-50">
                              <i class="fab fa-shopify me-1"></i>ID: <%= item.product.shopify_variant_id %>
                            </small>
                          <% else %>
                            <small class="text-danger">
                              <i class="fas fa-unlink me-1"></i>Sem ID Shopify
                            </small>
                          <% end %>
                        </td>
                        <td class="px-3 py-2 text-center">
                          <span class="badge bg-info text-dark px-2 py-1">
                            <%= item.corrected_stock %> un.
                          </span>
                        </td>
                        <td class="px-3 py-2">
                          <small class="text-danger" style="white-space: normal; word-break: break-word;">
                            <i class="fas fa-times-circle me-1"></i><%= item.shopify_sync_error.presence || 'Erro desconhecido' %>
                          </small>
                        </td>
                        <td class="px-3 py-2 text-center">
                          <% if @stock_correction.status != 'executed' %>
                            <button class="btn btn-outline-warning btn-sm"
                                    onclick="retryShopifySync('<%= item.id %>')"
                                    id="retry-btn-<%= item.id %>"
                                    title="Tentar novamente">
                              <i class="fas fa-redo"></i>
                            </button>
                          <% else %>
                            <span class="text-white-50"><i class="fas fa-lock"></i></span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="card-footer bg-dark border-top border-secondary d-flex justify-content-between align-items-center py-2">
              <small class="text-white-50">
                <i class="fas fa-info-circle me-1"></i>
                Use "Executar Todas" no topo para re-sincronizar todos os itens, ou clique em <i class="fas fa-redo ms-1 me-1"></i> para tentar individualmente.
              </small>
              <small class="text-white-50">
                Atualizado em <%= Time.current.strftime('%d/%m/%Y %H:%M') %>
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body bg-black">
          <%= form_with url: edit_stock_correction_path(@stock_correction), method: :get, local: true, class: "row g-3 align-items-end" do |f| %>
            <div class="col-md-8">
              <label class="form-label text-white fw-bold">Buscar Produto</label>
              <div class="input-group">
                <span class="input-group-text bg-dark border-dark text-white">
                  <i class="fas fa-search"></i>
                </span>
                <%= f.text_field :search_term,
                    placeholder: "Digite SKU exato ou nome do produto...",
                    value: @search_term,
                    class: "form-control bg-dark text-white border-dark" %>
              </div>
            </div>
            <div class="col-md-2">
              <%= f.submit "Buscar", class: "btn btn-primary w-100" %>
            </div>
            <div class="col-md-2">
              <%= link_to edit_stock_correction_path(@stock_correction), class: "btn btn-outline-light w-100" do %>
                <i class="fas fa-times me-1"></i>Limpar
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @search_item %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card bg-black border border-info shadow-lg">
          <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
              <i class="fas fa-search me-2"></i>Produto Encontrado
              <% if @search_item.needs_correction? %>
                <span class="badge bg-warning text-dark ms-2">
                  <i class="fas fa-edit me-1"></i>Com Correcao
                </span>
              <% else %>
                <span class="badge bg-secondary text-white ms-2">
                  <i class="fas fa-plus me-1"></i>Disponivel para Correcao
                </span>
              <% end %>
            </h5>
          </div>
          <div class="card-body bg-black p-0">
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-3 py-3" style="width: 250px;">Produto</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 120px;">Estoque Atual</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 100px;">Status</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 140px;">Corrigido</th>
                    <th class="text-white fw-bold px-3 py-3" style="width: 200px;">Motivo</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 100px;">Acoes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-secondary">
                    <td class="px-3 py-3" style="width: 250px;">
                      <% if @product_images.present? %>
                        <div class="d-flex gap-2 mb-2 flex-wrap">
                          <% @product_images.each do |img| %>
                            <a href="<%= img %>" target="_blank" title="Abrir imagem">
                              <img src="<%= img %>"
                                   class="rounded border border-secondary"
                                   style="width: 55px; height: 55px; object-fit: cover;"
                                   loading="lazy">
                            </a>
                          <% end %>
                        </div>
                      <% end %>
                      <div>
                        <span class="text-white fw-medium d-block">
                          <%= format_product_name_for_correction(@search_item.product) %>
                        </span>
                        <small class="text-warning fw-bold font-monospace">
                          SKU: <%= @search_item.product.sku %>
                        </small>
                        <% if @search_item.product.shopify_variant_id.present? %>
                          <br>
                          <small class="text-white-50">
                            <i class="fab fa-shopify me-1"></i>
                            ID: <%= @search_item.product.shopify_variant_id %>
                          </small>
                        <% end %>
                      </div>
                    </td>
                    <td class="px-3 py-3 text-center" style="width: 120px;">
                      <span class="badge <%= stock_badge_class(@search_item.real_stock) %> px-2 py-1">
                        <%= @search_item.real_stock %> un.
                      </span>
                    </td>
                    <td class="px-3 py-3 text-center" style="width: 100px;">
                      <% if @search_item.executed? %>
                        <% if @search_item.needs_correction? %>
                          <span class="badge bg-warning text-dark px-2 py-1">
                            <i class="fas fa-edit me-1"></i>Corrigido
                          </span>
                        <% else %>
                          <span class="badge bg-success text-dark px-2 py-1">
                            <i class="fas fa-check me-1"></i>Processado
                          </span>
                        <% end %>
                      <% else %>
                        <span class="badge bg-secondary text-white px-2 py-1">
                          Pendente
                        </span>
                      <% end %>
                    </td>
                    <td class="px-3 py-3 text-center" style="width: 140px;">
                      <% if @stock_correction.status == 'executed' %>
                        <% if @search_item.needs_correction? %>
                          <span class="text-success fw-bold"><%= @search_item.corrected_stock %> un.</span>
                        <% else %>
                          <span class="text-white-50">-</span>
                        <% end %>
                      <% elsif @search_item.executed? %>
                        <% if @search_item.needs_correction? %>
                          <span class="text-success fw-bold"><%= @search_item.corrected_stock %> un.</span>
                        <% else %>
                          <span class="text-white-50">-</span>
                        <% end %>
                      <% else %>
                        <input type="number"
                               id="correctedStock_<%= @search_item.product.id %>"
                               class="form-control form-control-sm bg-dark text-white border-dark text-center"
                               value="<%= @search_item.needs_correction? ? @search_item.corrected_stock : @search_item.real_stock %>"
                               min="0"
                               style="width: 80px;"
                               placeholder="Novo">
                      <% end %>
                    </td>
                    <td class="px-3 py-3" style="width: 200px;">
                      <% if @stock_correction.status == 'executed' %>
                        <% if @search_item.needs_correction? %>
                          <small class="text-success">
                            <i class="fas fa-check me-1"></i><%= truncate(@search_item.correction_reason, length: 25) %>
                          </small>
                        <% else %>
                          <span class="text-white-50">-</span>
                        <% end %>
                      <% elsif @search_item.executed? %>
                        <% if @search_item.needs_correction? %>
                          <small class="text-success">
                            <i class="fas fa-check me-1"></i><%= truncate(@search_item.correction_reason, length: 25) %>
                          </small>
                        <% else %>
                          <span class="text-white-50">-</span>
                        <% end %>
                      <% else %>
                        <input type="text"
                               id="correctionReason_<%= @search_item.product.id %>"
                               class="form-control form-control-sm bg-dark text-white border-dark"
                               value="<%= @search_item.correction_reason %>"
                               placeholder="Motivo da correcao..."
                               style="width: 180px;">
                      <% end %>
                    </td>
                    <td class="px-3 py-3 text-center" style="width: 100px;">
                      <% if @stock_correction.status == 'executed' %>
                        <span class="text-white-50">Finalizado</span>
                      <% elsif @search_item.executed? %>
                        <span class="text-white-50">
                          <i class="fas fa-lock me-1"></i>Executado
                        </span>
                      <% else %>
                        <button class="btn btn-success btn-sm" onclick="saveCorrection('<%= @search_item.product.id %>')">
                          <i class="fas fa-save me-1"></i>Salvar
                        </button>
                      <% end %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% elsif @search_term.present? %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="alert alert-warning bg-dark border-warning text-white">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <% if @search_error %>
            <%= @search_error %>
          <% else %>
            Nenhum produto encontrado para "<strong><%= @search_term %></strong>".
            Verifique se o SKU esta correto ou se o produto existe na base de dados.
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-check-circle me-2"></i>Produtos com Correcao
          </h5>
          <% if @total_processed > 0 %>
            <span class="badge bg-success text-dark px-3 py-2">
              <%= @total_processed %> produto(s) corrigido(s)
            </span>
          <% end %>
        </div>
        <div class="card-body bg-black p-0">
          <% if @processed_items.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0 table-fixed">
                <thead class="bg-dark">
                  <tr>
                    <th class="text-white fw-bold px-3 py-3" style="width: 220px;">Produto</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 80px;">Status</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 120px;">Corrigido</th>
                    <th class="text-white fw-bold px-3 py-3" style="width: 180px;">Motivo</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 100px;">Shopify</th>
                    <th class="text-white fw-bold px-3 py-3 text-center" style="width: 80px;">Acoes</th>
                  </tr>
                </thead>
                <tbody>
                  <% @processed_items.each do |item| %>
                    <tr class="border-secondary">
                      <td class="px-3 py-3" style="width: 220px;">
                        <div>
                          <span class="text-white fw-medium d-block"><%= format_product_name_for_correction(item.product) %></span>
                          <small class="text-warning fw-bold font-monospace">
                            SKU: <%= item.product.sku %>
                          </small>
                          <% if item.product.shopify_variant_id.present? %>
                            <br><small class="text-white-50">
                              <i class="fab fa-shopify me-1"></i>ID: <%= item.product.shopify_variant_id %>
                            </small>
                          <% end %>
                        </div>
                      </td>
                      <td class="px-3 py-3 text-center" style="width: 80px;">
                        <% if item.needs_correction? %>
                          <span class="badge bg-warning text-dark px-2 py-1">
                            <i class="fas fa-edit me-1"></i>Corrigido
                          </span>
                        <% else %>
                          <span class="badge bg-success text-dark px-2 py-1">
                            <i class="fas fa-check me-1"></i>Processado
                          </span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3 text-center" style="width: 120px;">
                        <% if item.needs_correction? %>
                          <span class="text-success fw-bold"><%= item.corrected_stock %> un.</span>
                        <% else %>
                          <span class="text-white-50">-</span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3" style="width: 180px;">
                        <% if item.needs_correction? %>
                          <small class="text-success">
                            <i class="fas fa-check me-1"></i><%= truncate(item.correction_reason, length: 20) %>
                          </small>
                        <% else %>
                          <span class="text-white-50">-</span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3 text-center" style="width: 100px;">
                        <% if item.product.shopify_inventory_item_id.present? %>
                          <span class="badge <%= item.shopify_sync_status_badge_class %> text-white px-2 py-1"
                                title="<%= item.shopify_sync_error if item.shopify_sync_status == 'error' %>"
                                id="shopify-status-<%= item.id %>">
                            <% case item.shopify_sync_status %>
                            <% when 'synced' %>
                              <i class="fab fa-shopify me-1"></i>Sync
                            <% when 'error' %>
                              <i class="fas fa-exclamation-triangle me-1"></i>Erro
                            <% when 'syncing' %>
                              <i class="fas fa-spinner fa-spin me-1"></i>Sync...
                            <% else %>
                              <i class="fas fa-clock me-1"></i>Pendente
                            <% end %>
                          </span>
                          <% if item.shopify_sync_status != 'synced' && @stock_correction.status != 'executed' %>
                            <button class="btn btn-warning btn-sm mt-1 d-block mx-auto"
                                    onclick="retryShopifySync('<%= item.id %>')"
                                    id="retry-btn-<%= item.id %>"
                                    title="<%= item.shopify_sync_error %>">
                              <i class="fas fa-redo me-1"></i>Tentar Novamente
                            </button>
                          <% end %>
                        <% else %>
                          <span class="badge bg-secondary text-white px-2 py-1" title="Produto sem ID da Shopify">
                            <i class="fas fa-ban me-1"></i>N/A
                          </span>
                        <% end %>
                      </td>
                      <td class="px-3 py-3 text-center" style="width: 80px;">
                        <% if @stock_correction.status == 'executed' %>
                          <span class="text-white-50">
                            <i class="fas fa-lock me-1"></i>Final
                          </span>
                        <% elsif item.executed? %>
                          <span class="text-white-50">
                            <i class="fas fa-check me-1"></i>OK
                          </span>
                        <% else %>
                          <span class="text-white-50">
                            <i class="fas fa-clock me-1"></i>Pend
                          </span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-clipboard-list fa-3x text-white-50 mb-3"></i>
              <h5 class="text-white-50">Nenhum produto com correcao ainda</h5>
              <p class="text-white-50">Os produtos com correcao aparecerao aqui</p>
            </div>
          <% end %>
        </div>
        <% if @total_pages > 1 %>
          <div class="card-footer bg-dark border-top border-secondary">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
              <div class="text-white-50 mb-2 mb-md-0">
                Mostrando <%= (@current_page - 1) * @per_page + 1 %> a <%= [@current_page * @per_page, @total_processed].min %> de <%= @total_processed %> produtos processados
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <% if @current_page > 1 %>
                  <%= link_to edit_stock_correction_path(@stock_correction, page: @current_page - 1, search_term: @search_term),
                      class: "btn btn-outline-light btn-sm" do %>
                    <i class="fas fa-chevron-left"></i> Anterior
                  <% end %>
                <% end %>
                <% page_start = [@current_page - 2, 1].max %>
                <% page_end = [page_start + 4, @total_pages].min %>
                <% (page_start..page_end).each do |page_num| %>
                  <% if page_num == @current_page %>
                    <button class="btn btn-primary btn-sm"><%= page_num %></button>
                  <% else %>
                    <%= link_to page_num, edit_stock_correction_path(@stock_correction, page: page_num, search_term: @search_term),
                        class: "btn btn-outline-light btn-sm" %>
                  <% end %>
                <% end %>
                <% if @current_page < @total_pages %>
                  <%= link_to edit_stock_correction_path(@stock_correction, page: @current_page + 1, search_term: @search_term),
                      class: "btn btn-outline-light btn-sm" do %>
                    Proxima <i class="fas fa-chevron-right"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12">
      <div class="d-flex justify-content-start">
        <%= link_to stock_corrections_path, class: "btn btn-outline-light" do %>
          <i class="fas fa-arrow-left me-2"></i>Voltar para Lista
        <% end %>
      </div>
    </div>
  </div>
</div>

