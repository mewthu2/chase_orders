// Verificar estoque atual na Shopify
document.addEventListener('click', function(e) {
  if (e.target.closest('.check-shopify-btn')) {
    console.log('🔍 Verificando estoque na Shopify');
    const btn = e.target.closest('.check-shopify-btn');
    const itemId = btn.dataset.itemId;
    const icon = btn.querySelector('i');
    
    if (btn.disabled) return;
    
    // Mostrar loading
    btn.disabled = true;
    icon.className = 'fas fa-spinner fa-spin';
    
    const correctionId = '<%= @stock_correction.id %>';
    fetch(`/stock_corrections/${correctionId}/check_shopify_inventory?item_id=${itemId}`, {
      method: 'GET',
      headers: {
        'X-CSRF-Token': getCSRFToken()
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        const inventory = data.inventory;
        alert(`Estoque atual na Shopify:

Location: ${inventory.location_name}
Disponível: ${inventory.available}
Em Mãos: ${inventory.on_hand}
Comprometido: ${inventory.committed}
Chegando: ${inventory.incoming}
Rastreado: ${inventory.tracked ? 'Sim' : 'Não'}`);
      } else {
        alert('Erro ao consultar estoque: ' + data.message);
      }
    })
    .catch(error => {
      alert('Erro na requisição: ' + error.message);
    })
    .finally(() => {
      // Restaurar botão
      btn.disabled = false;
      icon.className = 'fas fa-search';
    });
  }
});

// Verificar botões de integração existentes na inicialização
document.querySelectorAll('.integrate-correction-btn').forEach(btn => {
  const itemId = btn.dataset.itemId;
  console.log('🔍 Verificando botão existente:', itemId);
  toggleIntegrateButton(itemId);
});

console.log('✅ Script inicializado completamente');
});
</script>
