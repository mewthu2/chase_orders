<script>
document.addEventListener('DOMContentLoaded', function() {
  const collapse = document.getElementById('shopifyErrorsCollapse');
  const chevron = document.getElementById('shopifyErrorsChevron');

  if (collapse && chevron) {
    collapse.addEventListener('show.bs.collapse', function() {
      chevron.style.transform = 'rotate(180deg)';
    });
    collapse.addEventListener('hide.bs.collapse', function() {
      chevron.style.transform = 'rotate(0deg)';
    });
  }
});

function saveCorrection(productId) {
  const correctedStock = document.getElementById('correctedStock_' + productId).value;
  const correctionReason = document.getElementById('correctionReason_' + productId).value;

  if (!correctedStock || correctedStock < 0) {
    alert('Por favor, informe um estoque valido.');
    return;
  }

  if (!correctionReason.trim()) {
    alert('Por favor, informe o motivo da correcao.');
    return;
  }

  const button = document.querySelector(`button[onclick="saveCorrection('${productId}')"]`);
  const originalText = button.innerHTML;
  button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Salvando...';
  button.disabled = true;

  const formData = new FormData();
  formData.append('product_id', productId);
  formData.append('corrected_stock', correctedStock);
  formData.append('correction_reason', correctionReason);

  fetch('<%= save_item_correction_stock_correction_path(@stock_correction) %>', {
    method: 'POST',
    body: formData,
    headers: {
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
      'Accept': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      let message = 'Correcao salva com sucesso!';
      if (data.shopify_status) {
        switch(data.shopify_status) {
          case 'synced':        message += '\nIntegrado com Shopify!'; break;
          case 'error':         message += '\nErro na integracao com Shopify (verifique os logs)'; break;
          case 'no_shopify_id': message += '\nProduto sem ID da Shopify'; break;
          default:              message += '\nIntegracao em processamento...';
        }
      }
      alert(message);
      location.reload();
    } else {
      alert('Erro: ' + data.message);
      button.innerHTML = originalText;
      button.disabled = false;
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Erro ao salvar correcao');
    button.innerHTML = originalText;
    button.disabled = false;
  });
}

function retryShopifySync(itemId) {
  const button = document.getElementById('retry-btn-' + itemId);
  const statusBadge = document.getElementById('shopify-status-' + itemId);

  if (!button) {
    alert('Erro ao localizar elementos na pagina');
    return;
  }

  if (!confirm('Deseja tentar novamente a integracao com a Shopify?')) {
    return;
  }

  const originalButtonText = button.innerHTML;
  button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Tentando...';
  button.disabled = true;

  if (statusBadge) {
    statusBadge.className = 'badge bg-info text-white px-2 py-1';
    statusBadge.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Sync...';
  }

  fetch('<%= retry_shopify_sync_stock_correction_path(@stock_correction) %>', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({ item_id: itemId })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      if (statusBadge) {
        statusBadge.className = 'badge bg-success text-white px-2 py-1';
        statusBadge.innerHTML = '<i class="fab fa-shopify me-1"></i>Sync';
        statusBadge.title = '';
      }
      button.remove();

      const errorRow = document.getElementById('error-row-' + itemId);
      if (errorRow) {
        errorRow.style.transition = 'opacity 0.3s ease';
        errorRow.style.opacity = '0';
        setTimeout(() => errorRow.remove(), 300);
      }

      alert('Integracao com Shopify realizada com sucesso!');
    } else {
      if (statusBadge) {
        statusBadge.className = 'badge bg-danger text-white px-2 py-1';
        statusBadge.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Erro';
        statusBadge.title = data.error_details || data.message;
      }
      button.innerHTML = originalButtonText;
      button.disabled = false;
      alert('Erro na integracao:\n' + data.message);
    }
  })
  .catch(error => {
    console.error('Error retrying Shopify sync:', error);
    if (statusBadge) {
      statusBadge.className = 'badge bg-danger text-white px-2 py-1';
      statusBadge.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Erro';
    }
    button.innerHTML = originalButtonText;
    button.disabled = false;
    alert('Erro ao tentar integracao. Verifique sua conexao e tente novamente.');
  });
}
</script>