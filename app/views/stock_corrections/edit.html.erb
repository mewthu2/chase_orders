<script>
document.addEventListener('DOMContentLoaded', function() {
console.log('🚀 Script carregado - Debug Mode ON');

// Função para obter CSRF token
function getCSRFToken() {
  const token = document.querySelector('meta[name="csrf-token"]');
  return token ? token.getAttribute('content') : '';
}

// Função para validar ação antes de executar
function validateItemAction(button, actionName) {
  const itemId = button.getAttribute('data-item-id');
  const productSku = button.getAttribute('data-product-sku');
  const productId = button.getAttribute('data-product-id');
  
  console.log(`🎯 ${actionName} - Validação:`, {
    itemId,
    productSku,
    productId,
    buttonElement: button
  });
  
  // Confirmar com o usuário
  const confirmed = confirm(`Confirmar ${actionName}?\n\nItem ID: ${itemId}\nProduct ID: ${productId}\nSKU: ${productSku}`);
  
  if (!confirmed) {
    console.log('❌ Ação cancelada pelo usuário');
    return false;
  }
  
  return true;
}

// Função para atualizar item via AJAX
function updateItem(itemId, data) {
  console.log('📝 Atualizando item:', itemId, data);
  fetch(`/stock_correction_items/${itemId}`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': getCSRFToken()
    },
    body: JSON.stringify({ stock_correction_item: data })
  });
}

// Função para mostrar/esconder botão de integração
function toggleIntegrateButton(itemId) {
  console.log('🔍 Verificando botão de integração para item:', itemId);
  const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
  if (!row) {
    console.error('❌ Row não encontrada para item:', itemId);
    return;
  }
  
  const stockInput = row.querySelector('.corrected-stock-input');
  const reasonInput = row.querySelector('.correction-reason-input');
  const integrateBtn = row.querySelector('.integrate-correction-btn');
  
  console.log('🔍 Elementos encontrados:', {
    stockInput: !!stockInput,
    reasonInput: !!reasonInput,
    integrateBtn: !!integrateBtn,
    stockValue: stockInput?.value,
    reasonValue: reasonInput?.value
  });
  
  if (integrateBtn && stockInput && reasonInput) {
    const hasStock = stockInput.value && stockInput.value.trim() !== '';
    const hasReason = reasonInput.value && reasonInput.value.trim() !== '';
    
    console.log('✅ Validação:', { hasStock, hasReason });
    
    if (hasStock && hasReason) {
      integrateBtn.style.display = 'inline-block';
      console.log('✅ Mostrando botão de integração');
    } else {
      integrateBtn.style.display = 'none';
      console.log('❌ Escondendo botão de integração');
    }
  } else {
    console.log('⚠️ Alguns elementos não encontrados');
  }
}

// Botão "Marcar Todos"
document.getElementById('markAllBtn').addEventListener('click', function() {
  console.log('📋 Marcando todos os itens');
  const checkboxes = document.querySelectorAll('.checked-checkbox:not(:disabled)');
  checkboxes.forEach(checkbox => {
    if (!checkbox.checked) {
      checkbox.checked = true;
      const itemId = checkbox.dataset.itemId;
      updateItem(itemId, { checked: true });
      
      // Desabilitar correção quando marcar como conferido
      const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
      const correctionCheckbox = row.querySelector('.correction-checkbox');
      const stockInput = row.querySelector('.corrected-stock-input');
      const reasonInput = row.querySelector('.correction-reason-input');
      
      correctionCheckbox.disabled = true;
      correctionCheckbox.checked = false;
      if (stockInput) stockInput.disabled = true;
      if (reasonInput) {
        reasonInput.style.display = 'none';
        reasonInput.value = '';
      }
      
      updateItem(itemId, { needs_correction: false });
    }
  });
});

// Lógica para checkbox "conferido"
document.querySelectorAll('.checked-checkbox').forEach(checkbox => {
  checkbox.addEventListener('change', function() {
    console.log('☑️ Checkbox conferido alterado:', this.dataset.itemId);
    const itemId = this.dataset.itemId;
    const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
    const correctionCheckbox = row.querySelector('.correction-checkbox');
    const stockInput = row.querySelector('.corrected-stock-input');
    const reasonInput = row.querySelector('.correction-reason-input');
    
    if (this.checked) {
      // Se conferido, DESABILITAR correção
      correctionCheckbox.disabled = true;
      correctionCheckbox.checked = false;
      if (stockInput) stockInput.disabled = true;
      if (reasonInput) {
        reasonInput.style.display = 'none';
        reasonInput.value = '';
      }
      
      // Esconder o campo de motivo
      const reasonCell = reasonInput ? reasonInput.parentElement : null;
      if (reasonCell) {
        reasonCell.innerHTML = '<span class="text-white-50">-</span>';
      }
      
      updateItem(itemId, { needs_correction: false });
    } else {
      // Se não conferido, HABILITAR correção
      correctionCheckbox.disabled = false;
    }
    
    // Atualizar no backend
    updateItem(itemId, { checked: this.checked });
  });
});

// Lógica para checkbox "correção"
document.querySelectorAll('.correction-checkbox').forEach(checkbox => {
  checkbox.addEventListener('change', function() {
    console.log('🔧 Checkbox correção alterado:', this.dataset.itemId);
    const itemId = this.dataset.itemId;
    const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
    const stockInput = row.querySelector('.corrected-stock-input');
    const reasonCell = row.querySelector('td:nth-child(7)'); // Coluna do motivo
    const actionsCell = row.querySelector('td:last-child .d-flex');
  
    if (this.checked) {
      console.log('✅ Habilitando correção para item:', itemId);
      // Habilitar campos de correção
      stockInput.disabled = false;
      stockInput.required = true;
      
      // Mostrar campo de motivo
      reasonCell.innerHTML = `
        <input type="text" 
               class="form-control form-control-sm bg-dark text-white border-dark correction-reason-input"
               placeholder="Motivo da correção..."
               data-item-id="${itemId}"
               required>
      `;
      
      // Adicionar botão de integração se não existir
      let integrateBtn = actionsCell.querySelector('.integrate-correction-btn');
      if (!integrateBtn) {
        console.log('➕ Criando botão de integração para item:', itemId);
        integrateBtn = document.createElement('button');
        integrateBtn.className = 'btn btn-sm btn-warning integrate-correction-btn';
        integrateBtn.setAttribute('data-item-id', itemId);
        integrateBtn.setAttribute('data-product-sku', row.getAttribute('data-product-sku'));
        integrateBtn.setAttribute('data-product-id', row.getAttribute('data-product-id'));
        integrateBtn.setAttribute('title', 'Integrar correção diretamente com Shopify');
        integrateBtn.style.display = 'none'; // Inicialmente escondido
        integrateBtn.innerHTML = '<i class="fab fa-shopify"></i>';
        
        // Inserir após o botão de execução
        const executeBtn = actionsCell.querySelector('.execute-btn');
        if (executeBtn) {
          executeBtn.parentNode.insertBefore(integrateBtn, executeBtn.nextSibling);
        } else {
          // Se não tem botão de execução, inserir após o botão de busca
          const searchBtn = actionsCell.querySelector('.check-shopify-btn');
          if (searchBtn) {
            searchBtn.parentNode.insertBefore(integrateBtn, searchBtn.nextSibling);
          }
        }
      }
      
      // Verificar se deve mostrar o botão
      setTimeout(() => toggleIntegrateButton(itemId), 100);
      
    } else {
      console.log('❌ Desabilitando correção para item:', itemId);
      // Desabilitar campos de correção
      stockInput.disabled = true;
      stockInput.required = false;
      stockInput.value = '';
      
      // Esconder campo de motivo
      reasonCell.innerHTML = '<span class="text-white-50">-</span>';
      
      // Remover botão de integração
      const integrateBtn = actionsCell.querySelector('.integrate-correction-btn');
      if (integrateBtn) {
        integrateBtn.remove();
      }
    }
    
    // Atualizar no backend
    updateItem(itemId, { needs_correction: this.checked });
  });
});

// Atualizar estoque corrigido
document.addEventListener('input', function(e) {
  if (e.target.classList.contains('corrected-stock-input')) {
    console.log('📊 Estoque alterado:', e.target.dataset.itemId, e.target.value);
    const itemId = e.target.dataset.itemId;
    updateItem(itemId, { corrected_stock: e.target.value });
    toggleIntegrateButton(itemId);
  }
});

// Atualizar motivo da correção
document.addEventListener('input', function(e) {
  if (e.target.classList.contains('correction-reason-input')) {
    console.log('📝 Motivo alterado:', e.target.dataset.itemId, e.target.value);
    const itemId = e.target.dataset.itemId;
    updateItem(itemId, { correction_reason: e.target.value });
    toggleIntegrateButton(itemId);
  }
});

// Executar correção individual
document.addEventListener('click', function(e) {
  if (e.target.closest('.execute-btn')) {
    console.log('▶️ Executando correção');
    const btn = e.target.closest('.execute-btn');
    
    if (!validateItemAction(btn, 'EXECUTAR CORREÇÃO')) return;
    
    const itemId = btn.dataset.itemId;
    const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
    const stockInput = row.querySelector('.corrected-stock-input');
    const reasonInput = row.querySelector('.correction-reason-input');
    
    // Validar campos obrigatórios
    if (!stockInput.value || !reasonInput.value) {
      alert('Por favor, preencha o novo estoque e o motivo da correção.');
      return;
    }
    
    const correctionId = '<%= @stock_correction.id %>';
    fetch(`/stock_corrections/${correctionId}/execute_item`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': getCSRFToken()
      },
      body: JSON.stringify({ item_id: itemId })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert('Correção executada com sucesso no banco local!');
        location.reload();
      } else {
        alert('Erro ao executar correção: ' + data.message);
      }
    });
  }
});

// Integrar correção específica com Shopify
document.addEventListener('click', function(e) {
  if (e.target.closest('.integrate-correction-btn')) {
    console.log('🔗 Integrando correção');
    const btn = e.target.closest('.integrate-correction-btn');
    
    if (!validateItemAction(btn, 'INTEGRAR COM SHOPIFY')) return;
    
    const itemId = btn.dataset.itemId;
    const row = document.querySelector(`tr[data-item-id="${itemId}"]`);
    const stockInput = row.querySelector('.corrected-stock-input');
    const reasonInput = row.querySelector('.correction-reason-input');
    const icon = btn.querySelector('i');
    
    if (btn.disabled) return;
    
    // Para itens já executados, usar valores salvos ou padrão
    let correctedStock, correctionReason;
    
    if (stockInput && stockInput.value) {
      correctedStock = stockInput.value;
    } else {
      // Se não tem input visível, pegar do badge de estoque atual
      const stockBadge = row.querySelector('.badge');
      if (stockBadge) {
        correctedStock = stockBadge.textContent.replace(' un.', '').trim();
      }
    }
    
    if (reasonInput && reasonInput.value) {
      correctionReason = reasonInput.value;
    } else {
      // Se não tem input visível, usar motivo padrão
      correctionReason = 'Re-integração manual';
    }
    
    console.log('📋 Dados para integração:', { itemId, correctedStock, correctionReason });
    
    // Validar se temos os dados necessários
    if (!correctedStock) {
      alert('Não foi possível determinar o estoque corrigido.');
      return;
    }
    
    // Mostrar loading
    btn.disabled = true;
    icon.className = 'fas fa-spinner fa-spin';
    
    const correctionId = '<%= @stock_correction.id %>';
    fetch(`/stock_corrections/${correctionId}/integrate_item_correction`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': getCSRFToken()
      },
      body: JSON.stringify({ 
        item_id: itemId,
        corrected_stock: correctedStock,
        correction_reason: correctionReason
      })
    })
    .then(response => response.json())
    .then(data => {
      console.log('📨 Resposta da integração:', data);
      if (data.success) {
        alert('Produto integrado com Shopify com sucesso!');
        location.reload();
      } else {
        alert('Erro ao integrar correção: ' + data.message);
      }
    })
    .catch(error => {
      console.error('❌ Erro na requisição:', error);
      alert('Erro na requisição: ' + error.message);
    })
    .finally(() => {
      // Restaurar botão
      btn.disabled = false;
      icon.className = 'fab fa-shopify';
    });
  }
});

// Sincronizar com Shopify individual
document.addEventListener('click', function(e) {
  if (e.target.closest('.sync-shopify-btn')) {
    console.log('🔄 Sincronizando com Shopify');
