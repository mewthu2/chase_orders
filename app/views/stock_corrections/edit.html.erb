<div class="container-fluid py-4">
<div class="row mb-4">
  <div class="col-12">
    <div class="card bg-black border border-dark shadow-lg">
      <div class="card-header bg-dark d-flex justify-content-between align-items-center">
        <h4 class="text-white mb-0">
          <i class="fas fa-clipboard-check me-2"></i>
          Conferência #<%= @stock_correction.id %> - <%= @stock_correction.location_name %>
        </h4>
        <div class="d-flex gap-2">
          <% if @stock_correction.status != 'executed' %>
            <%= link_to finalize_correction_stock_correction_path(@stock_correction), 
                        method: :post,
                        class: "btn btn-sm btn-success",
                        confirm: "Deseja finalizar esta conferência? Esta ação não pode ser desfeita." do %>
              <i class="fas fa-flag-checkered me-1"></i>Finalizar Conferência
            <% end %>
          <% else %>
            <span class="badge bg-success text-white px-3 py-2">
              <i class="fas fa-check me-1"></i>Conferência Finalizada
            </span>
          <% end %>
          
          <%= link_to @stock_correction, class: "btn btn-sm btn-info" do %>
            <i class="fas fa-eye me-1"></i>Visualizar
          <% end %>
        </div>
      </div>
      <div class="card-body bg-black">
        <%= form_with model: @stock_correction, local: true, class: "row g-3" do |f| %>
          <div class="col-md-3">
            <label class="form-label text-white fw-bold">Data:</label>
            <%= f.date_field :correction_date, 
                             class: "form-control bg-dark text-white border-dark" %>
          </div>
          <div class="col-md-3">
            <label class="form-label text-white fw-bold">Location:</label>
            <%= f.select :location, 
                         options_for_select([
                           ['Lagoa Seca', 'lagoa_seca'],
                           ['BH Shopping', 'bh_shopping'],
                           ['RJ - Barra Shopping', 'rj']
                         ], @stock_correction.location),
                         {},
                         { class: "form-select bg-dark text-white border-dark" } %>
          </div>
          <div class="col-md-4">
            <label class="form-label text-white fw-bold">Motivo:</label>
            <%= f.text_field :reason, 
                             class: "form-control bg-dark text-white border-dark" %>
          </div>
          <div class="col-md-2 d-flex align-items-end">
            <%= f.submit "Atualizar", class: "btn btn-primary w-100" %>
          </div>
          <div class="col-12">
            <label class="form-label text-white fw-bold">Observações:</label>
            <%= f.text_area :notes, 
                            rows: 2,
                            class: "form-control bg-dark text-white border-dark" %>
          </div>
        <% end %>
        
        <hr class="border-secondary my-3">
        
        <div class="row">
          <div class="col-md-3">
            <div class="p-3 text-center">
              <h4 class="text-info mb-1"><%= @stock_correction.stock_correction_items.count %></h4>
              <small class="text-white-50">Total de Produtos</small>
            </div>
          </div>
          <div class="col-md-3">
            <div class="p-3 text-center">
              <h4 class="text-success mb-1"><%= @stock_correction.checked_items.count %></h4>
              <small class="text-white-50">Conferidos</small>
            </div>
          </div>
          <div class="col-md-3">
            <div class="p-3 text-center">
              <h4 class="text-warning mb-1"><%= @stock_correction.items_to_correct.count %></h4>
              <small class="text-white-50">Com Correção</small>
            </div>
          </div>
          <div class="col-md-3">
            <div class="p-3 text-center">
              <h4 class="text-primary mb-1"><%= @stock_correction.stock_correction_items.where(executed: true).count %></h4>
              <small class="text-white-50">Executados</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Busca -->
<div class="row mb-4">
  <div class="col-12">
    <div class="card bg-black border border-dark shadow-lg">
      <div class="card-body bg-black">
        <%= form_with url: edit_stock_correction_path(@stock_correction), method: :get, local: true, 
                      class: "row g-3 align-items-end" do |f| %>
          <div class="col-md-8">
            <label class="form-label text-white fw-bold">Buscar Produto</label>
            <div class="input-group">
              <span class="input-group-text bg-dark border-dark text-white">
                <i class="fas fa-search"></i>
              </span>
              <%= f.text_field :search_term, 
                               placeholder: "Digite SKU exato ou nome do produto...", 
                               value: params[:search_term],
                               class: "form-control bg-dark text-white border-dark" %>
            </div>
          </div>
          <div class="col-md-2">
            <%= f.submit "Buscar", class: "btn btn-primary w-100" %>
          </div>
          <div class="col-md-2">
            <%= link_to edit_stock_correction_path(@stock_correction), class: "btn btn-outline-light w-100" do %>
              <i class="fas fa-times me-1"></i>Limpar
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Produto da Busca Atual -->
<% if @search_item %>
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-warning shadow-lg">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="fas fa-search me-2"></i>Produto Encontrado
          </h5>
        </div>
        
        <div class="card-body bg-black p-0">
          <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
              <thead class="bg-dark">
                <tr>
                  <th class="text-white fw-bold px-3 py-3">SKU</th>
                  <th class="text-white fw-bold px-3 py-3">Produto</th>
                  <th class="text-white fw-bold px-3 py-3 text-center">Estoque Atual</th>
                  <th class="text-white fw-bold px-3 py-3 text-center">Ação</th>
                  <th class="text-white fw-bold px-3 py-3 text-center">Novo Estoque</th>
                  <th class="text-white fw-bold px-3 py-3">Motivo</th>
                  <th class="text-white fw-bold px-3 py-3 text-center">Salvar</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-secondary" 
                    data-item-id="<%= @search_item.id %>" 
                    data-product-sku="<%= @search_item.product.sku %>"
                    data-product-id="<%= @search_item.product.id %>">
                  <td class="px-3 py-3">
                    <span class="font-monospace text-white fw-medium">
                      <%= @search_item.product.sku %>
                    </span>
                    <br><small class="text-white-50">Item #<%= @search_item.id %></small>
                  </td>
                  
                  <td class="px-3 py-3">
                    <div>
                      <span class="text-white d-block">
                        <%= @search_item.product.shopify_product_name || "Produto #{@search_item.product.sku}" %>
                      </span>
                      <% if @search_item.product.shopify_variant_id.present? %>
                        <small class="text-white-50">
                          <i class="fab fa-shopify me-1"></i>ID: <%= @search_item.product.shopify_variant_id %>
                        </small>
                      <% end %>
                    </div>
                  </td>
                  
                  <td class="px-3 py-3 text-center">
                    <span class="badge bg-info text-white px-2 py-1">
                      <%= @search_item.current_stock %> un.
                    </span>
                  </td>
                  
                  <td class="px-3 py-3 text-center">
                    <select class="form-select form-select-sm bg-dark text-white border-dark action-dropdown"
                            data-item-id="<%= @search_item.id %>">
                      <option value="">Selecione...</option>
                      <option value="checked">Conferido</option>
                      <option value="correction">Correção</option>
                    </select>
                  </td>
                  
                  <td class="px-3 py-3 text-center">
                    <input type="number" 
                           class="form-control form-control-sm bg-dark text-white border-dark text-center corrected-stock-input"
                           style="width: 100px; margin: 0 auto; display: none;"
                           data-item-id="<%= @search_item.id %>"
                           placeholder="Novo estoque"
                           required>
                  </td>
                  
                  <td class="px-3 py-3">
                    <input type="text" 
                           class="form-control form-control-sm bg-dark text-white border-dark correction-reason-input"
                           style="display: none;"
                           data-item-id="<%= @search_item.id %>"
                           placeholder="Motivo da correção..."
                           required>
                  </td>
                  
                  <td class="px-3 py-3 text-center">
                    <button class="btn btn-sm btn-success save-item-btn" 
                            data-item-id="<%= @search_item.id %>"
                            style="display: none;"
                            title="Salvar e integrar com Shopify">
                      <i class="fas fa-save"></i> Salvar
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
<% elsif @search_term.present? %>
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-warning bg-dark border-warning text-white">
        <i class="fas fa-exclamation-triangle me-2"></i>
        Nenhum produto encontrado para "<strong><%= @search_term %></strong>". 
        Verifique se o SKU está correto ou se o produto existe na base de dados.
      </div>
    </div>
  </div>
<% end %>

<!-- Lista de Produtos Processados -->
<div class="row">
  <div class="col-12">
    <div class="card bg-black border border-dark shadow-lg">
      <div class="card-header bg-dark d-flex justify-content-between align-items-center">
        <h5 class="text-white mb-0">
          <i class="fas fa-check-circle me-2"></i>Produtos Processados
        </h5>
        <% if @total_processed > 0 %>
          <span class="badge bg-success text-white px-3 py-2">
            <%= @total_processed %> produto(s) processado(s)
          </span>
        <% end %>
      </div>
      
      <div class="card-body bg-black p-0">
        <% if @processed_items.any? %>
          <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 table-fixed">
              <thead class="bg-dark">
                <tr>
                  <th class="text-white fw-bold px-3 py-3" style="width: 120px;">SKU</th>
                  <th class="text-white fw-bold px-3 py-3" style="width: 250px;">Produto</th>
                  <th class="text-white fw-bold px-3 py-3 text-center" style="width: 100px;">Estoque Atual</th>
                  <th class="text-white fw-bold px-3 py-3 text-center" style="width: 120px;">Status</th>
                  <th class="text-white fw-bold px-3 py-3 text-center" style="width: 100px;">Novo Estoque</th>
                  <th class="text-white fw-bold px-3 py-3" style="width: 200px;">Motivo</th>
                  <th class="text-white fw-bold px-3 py-3 text-center" style="width: 150px;">Sincronização</th>
                </tr>
              </thead>
              <tbody>
                <% @processed_items.each do |item| %>
                  <tr class="border-secondary">
                    <td class="px-3 py-3" style="width: 120px;">
                      <span class="font-monospace text-white fw-medium">
                        <%= item.product.sku %>
                      </span>
                      <br><small class="text-white-50">Item #<%= item.id %></small>
                    </td>
                    
                    <td class="px-3 py-3" style="width: 250px;">
                      <div>
                        <span class="text-white d-block">
                          <%= truncate(item.product.shopify_product_name || "Produto #{item.product.sku}", length: 30) %>
                        </span>
                        <% if item.product.shopify_variant_id.present? %>
                          <small class="text-white-50">
                            <i class="fab fa-shopify me-1"></i>ID: <%= item.product.shopify_variant_id %>
                          </small>
                        <% end %>
                      </div>
                    </td>
                    
                    <td class="px-3 py-3 text-center" style="width: 100px;">
                      <span class="badge bg-info text-white px-2 py-1">
                        <%= item.current_stock %> un.
                      </span>
                    </td>
                    
                    <td class="px-3 py-3 text-center" style="width: 120px;">
                      <% if item.checked? %>
                        <span class="badge bg-success text-white px-2 py-1">
                          <i class="fas fa-check me-1"></i>Conferido
                        </span>
                      <% elsif item.needs_correction? %>
                        <span class="badge bg-warning text-white px-2 py-1">
                          <i class="fas fa-edit me-1"></i>Corrigido
                        </span>
                      <% end %>
                    </td>
                    
                    <td class="px-3 py-3 text-center" style="width: 100px;">
                      <% if item.needs_correction? %>
                        <span class="badge bg-success text-white px-2 py-1">
                          <%= item.corrected_stock %> un.
                        </span>
                      <% else %>
                        <span class="text-white-50">-</span>
                      <% end %>
                    </td>
                    
                    <td class="px-3 py-3" style="width: 200px;">
                      <% if item.needs_correction? %>
                        <small class="text-success">
                          <i class="fas fa-check me-1"></i><%= truncate(item.correction_reason, length: 25) %>
                        </small>
                      <% else %>
                        <span class="text-white-50">-</span>
                      <% end %>
                    </td>
                    
                    <td class="px-3 py-3 text-center" style="width: 150px;">
                      <% if item.last_shopify_sync_at.present? %>
                        <div>
                          <span class="badge <%= item.shopify_sync_status_badge_class %> text-white px-2 py-1">
                            <%= item.shopify_sync_status_text %>
                          </span>
                          <br><small class="text-white-50">
                            <%= item.last_shopify_sync_at.strftime('%d/%m %H:%M') %>
                          </small>
                        </div>
                      <% else %>
                        <span class="badge bg-secondary text-white px-2 py-1">
                          Processado
                        </span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-5">
            <i class="fas fa-clipboard-list fa-3x text-white-50 mb-3"></i>
            <h5 class="text-white-50">Nenhum produto processado ainda</h5>
            <p class="text-white-50">Use a busca acima para encontrar e processar produtos</p>
          </div>
        <% end %>
      </div>

      <!-- Paginação dos Produtos Processados -->
      <% if @total_pages > 1 %>
        <div class="card-footer bg-dark border-top border-secondary">
          <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div class="text-white-50 mb-2 mb-md-0">
              Mostrando <%= (@current_page - 1) * @per_page + 1 %> a 
              <%= [@current_page * @per_page, @total_processed].min %> de 
              <%= @total_processed %> produtos processados
            </div>
            <div class="d-flex gap-2 flex-wrap">
              <% if @current_page > 1 %>
                <%= link_to edit_stock_correction_path(@stock_correction, page: @current_page - 1, search_term: params[:search_term]),
                            class: "btn btn-outline-light btn-sm" do %>
                  <i class="fas fa-chevron-left"></i> Anterior
                <% end %>
              <% end %>

              <% page_start = [[@current_page - 2, 1].max, [@total_pages - 4, 1].max].max %>
              <% page_end = [[page_start + 4, @total_pages].min, [@current_page + 2, @total_pages].min].max %>
              
              <% (page_start..page_end).each do |page_num| %>
                <% if page_num == @current_page %>
                  <button class="btn btn-primary btn-sm"><%= page_num %></button>
                <% else %>
                  <%= link_to page_num, 
                              edit_stock_correction_path(@stock_correction, page: page_num, search_term: params[:search_term]),
                              class: "btn btn-outline-light btn-sm" %>
                <% end %>
              <% end %>

              <% if @current_page < @total_pages %>
                <%= link_to edit_stock_correction_path(@stock_correction, page: @current_page + 1, search_term: params[:search_term]),
                            class: "btn btn-outline-light btn-sm" do %>
                  Próxima <i class="fas fa-chevron-right"></i>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="row mt-4">
  <div class="col-12">
    <div class="d-flex justify-content-start">
      <%= link_to stock_corrections_path, class: "btn btn-outline-light" do %>
        <i class="fas fa-arrow-left me-2"></i>Voltar para Lista
      <% end %>
    </div>
  </div>
</div>
</div>

