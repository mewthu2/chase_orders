      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': getCSRFToken()
      },
      body: JSON.stringify({ item_id: itemId })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert('Produto sincronizado com Shopify com sucesso!');
