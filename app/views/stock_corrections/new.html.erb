<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h4 class="text-white mb-0">
            <i class="fas fa-plus-circle me-2"></i>Nova Conferência de Estoque
          </h4>
        </div>
        
        <div class="card-body bg-black">
          <!-- Tutorial Integrado -->
          <div class="alert alert-info bg-dark border-info text-white mb-4">
            <div class="d-flex">
              <div class="flex-shrink-0">
                <i class="fas fa-info-circle fa-2x text-info me-3"></i>
              </div>
              <div>
                <h6 class="text-info mb-2">Como funciona a conferência de estoque:</h6>
                <ol class="mb-0 text-white-50">
                  <li>Selecione a <strong>location</strong> e preencha os dados básicos</li>
                  <li>Após criar, use a <strong>busca por SKU</strong> para encontrar produtos</li>
                  <li>Para cada produto: <strong>confira fisicamente</strong> e escolha uma ação</li>
                  <li><strong>Conferido</strong>: estoque está correto</li>
                  <li><strong>Corrigir</strong>: informe o estoque real e o motivo</li>
                  <li>As correções são <strong>integradas automaticamente</strong> com a Shopify</li>
                </ol>
              </div>
            </div>
          </div>

          <%= form_with model: @stock_correction, local: true, class: "needs-validation", novalidate: true do |f| %>
            <% if @stock_correction.errors.any? %>
              <div class="alert alert-danger bg-dark border-danger text-white mb-4">
                <h6 class="text-danger mb-2">
                  <i class="fas fa-exclamation-triangle me-2"></i>
                  Corrija os seguintes erros:
                </h6>
                <ul class="mb-0">
                  <% @stock_correction.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row g-4">
              <!-- Location -->
              <div class="col-md-6">
                <label class="form-label text-white fw-bold">
                  <i class="fas fa-map-marker-alt me-2"></i>Location *
                </label>
                <%= f.select :location, 
                             options_from_collection_for_select(@available_locations, :code, :name, @location),
                             { prompt: 'Selecione uma location...' },
                             { class: "form-select bg-dark text-white border-dark", required: true } %>
                <div class="invalid-feedback">
                  Por favor, selecione uma location.
                </div>
                <small class="text-white-50">
                  <i class="fas fa-info-circle me-1"></i>
                  Location onde será realizada a conferência física
                </small>
              </div>

              <!-- Data da Conferência -->
              <div class="col-md-6">
                <label class="form-label text-white fw-bold">
                  <i class="fas fa-calendar me-2"></i>Data da Conferência *
                </label>
                <%= f.date_field :correction_date, 
                                 value: Date.current,
                                 class: "form-control bg-dark text-white border-dark",
                                 required: true %>
                <div class="invalid-feedback">
                  Por favor, informe a data da conferência.
                </div>
                <small class="text-white-50">
                  <i class="fas fa-info-circle me-1"></i>
                  Data em que a conferência física será realizada
                </small>
              </div>

              <!-- Motivo -->
              <div class="col-12">
                <label class="form-label text-white fw-bold">
                  <i class="fas fa-clipboard-list me-2"></i>Motivo da Conferência *
                </label>
                <%= f.text_area :reason, 
                                 placeholder: "Ex: Conferência mensal, auditoria, divergências identificadas...",
                                 rows: 3,
                                 class: "form-control bg-dark text-white border-dark",
                                 required: true %>
                <div class="invalid-feedback">
                  Por favor, informe o motivo da conferência.
                </div>
                <small class="text-white-50">
                  <i class="fas fa-info-circle me-1"></i>
                  Descreva o motivo ou contexto desta conferência de estoque
                </small>
              </div>

              <!-- Observações -->
              <div class="col-12">
                <label class="form-label text-white fw-bold">
                  <i class="fas fa-sticky-note me-2"></i>Observações
                  <span class="text-white-50 fw-normal">(opcional)</span>
                </label>
                <%= f.text_area :notes, 
                                 placeholder: "Observações adicionais, instruções especiais, etc...",
                                 rows: 2,
                                 class: "form-control bg-dark text-white border-dark" %>
                <small class="text-white-50">
                  <i class="fas fa-info-circle me-1"></i>
                  Informações adicionais sobre esta conferência (opcional)
                </small>
              </div>
            </div>

            <!-- Botões de Ação -->
            <div class="row mt-4">
              <div class="col-12">
                <div class="d-flex justify-content-between">
                  <%= link_to stock_corrections_path, class: "btn btn-outline-light" do %>
                    <i class="fas fa-arrow-left me-2"></i>Cancelar
                  <% end %>
                  
                  <%= f.submit "Criar Conferência", 
                               class: "btn btn-success text-dark",
                               data: { 
                                 confirm: "Deseja criar esta conferência? Isso criará itens para todos os produtos da location selecionada." 
                               } do %>
                    <i class="fas fa-plus me-2"></i>Criar Conferência
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.form-control, .form-select {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
}

.form-control:focus, .form-select:focus {
  background-color: #495057;
  border-color: #6c757d;
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.form-control::placeholder {
  color: #adb5bd;
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.alert {
  border-radius: 6px;
}

.border-info {
  border-color: #0dcaf0 !important;
}

.text-info {
  color: #0dcaf0 !important;
}

/* Validação Bootstrap */
.was-validated .form-control:valid,
.form-control.is-valid {
  border-color: #198754;
  background-image: none;
}

.was-validated .form-control:invalid,
.form-control.is-invalid {
  border-color: #dc3545;
  background-image: none;
}

.was-validated .form-select:valid,
.form-select.is-valid {
  border-color: #198754;
  background-image: none;
}

.was-validated .form-select:invalid,
.form-select.is-invalid {
  border-color: #dc3545;
  background-image: none;
}

.invalid-feedback {
  display: block;
  width: 100%;
  margin-top: 0.25rem;
  font-size: 0.875em;
  color: #dc3545;
}

/* Responsividade */
@media (max-width: 768px) {
  .container-fluid {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  
  .btn {
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
  }
}
</style>
<% end %>

<script>
// Validação do formulário
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();
</script>
