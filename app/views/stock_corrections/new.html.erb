<div class="container-fluid py-4">
  <% content_for :title, 'Nova Conferência de Estoque' %>

  <!-- Tutorial/Ajuda -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-primary shadow-lg">
        <div class="card-header bg-primary">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="text-dark mb-0">
              <i class="fas fa-question-circle me-2"></i>Como criar uma Conferência de Estoque
            </h6>
            <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#helpCollapse">
              <i class="fas fa-chevron-down"></i>
            </button>
          </div>
        </div>
        <div class="collapse" id="helpCollapse">
          <div class="card-body bg-black">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="help-item">
                  <div class="help-icon bg-primary">
                    <i class="fas fa-calendar-alt"></i>
                  </div>
                  <div class="help-content">
                    <h6 class="text-white mb-1">Data da Conferência</h6>
                    <small class="text-primary">Selecione a data em que a conferência será realizada</small>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="help-item">
                  <div class="help-icon bg-warning">
                    <i class="fas fa-map-marker-alt"></i>
                  </div>
                  <div class="help-content">
                    <h6 class="text-white mb-1">Location</h6>
                    <small class="text-primary">Escolha a location onde será feita a conferência de estoque</small>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="help-item">
                  <div class="help-icon bg-info">
                    <i class="fas fa-clipboard-list"></i>
                  </div>
                  <div class="help-content">
                    <h6 class="text-white mb-1">Motivo</h6>
                    <small class="text-primary">Descreva o motivo da conferência (ex: Inventário mensal, Auditoria, etc.)</small>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="help-item">
                  <div class="help-icon bg-success">
                    <i class="fas fa-sticky-note"></i>
                  </div>
                  <div class="help-content">
                    <h6 class="text-white mb-1">Observações</h6>
                    <small class="text-primary">Adicione observações importantes sobre a conferência</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="mt-3 pt-3 border-top border-secondary">
              <div class="d-flex align-items-center text-info">
                <i class="fas fa-lightbulb me-2"></i>
                <small><strong>Dica:</strong> Após criar a conferência, você poderá buscar produtos individualmente e processar as correções!</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Formulário Principal -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h4 class="text-white mb-0">
            <i class="fas fa-plus-circle me-2"></i>Nova Conferência de Estoque
          </h4>
          <div class="d-flex gap-2">
            <%= link_to stock_corrections_path, class: "btn btn-sm btn-outline-light" do %>
              <i class="fas fa-arrow-left me-1"></i>Voltar
            <% end %>
          </div>
        </div>
        
        <div class="card-body bg-black">
          <%= form_with model: @stock_correction, local: true, class: "needs-validation", novalidate: true do |f| %>
            <div class="row g-4">
              <!-- Data da Conferência -->
              <div class="col-md-6">
                <label class="form-label text-white fw-bold">
                  <i class="fas fa-calendar-alt me-2"></i>Data da Conferência
                </label>
                <%= f.date_field :correction_date, 
                                 value: Date.current,
                                 class: "form-control bg-dark text-white border-dark",
                                 required: true %>
                <div class="invalid-feedback">
                  Por favor, selecione uma data válida.
                </div>
                <small class="text-white-50 mt-1">
                  <i class="fas fa-info-circle me-1"></i>Data em que a conferência será realizada
                </small>
              </div>

              <!-- Location -->
              <div class="col-md-6">
                <label class="form-label text-white fw-bold">
                  <i class="fas fa-map-marker-alt me-2"></i>Location
                </label>
                <%= f.select :location, 
                             options_for_select(@available_locations, @location),
                             { prompt: 'Selecione uma location...' },
                             { class: "form-select bg-dark text-white border-dark", required: true } %>
                <div class="invalid-feedback">
                  Por favor, selecione uma location.
                </div>
                <% unless current_user.admin? %>
                  <small class="text-white-50 mt-1">
                    <i class="fas fa-lock me-1"></i>Locations permitidas para seu usuário
                  </small>
                <% else %>
                  <small class="text-white-50 mt-1">
                    <i class="fas fa-globe me-1"></i>Todas as locations disponíveis
                  </small>
                <% end %>
              </div>

              <!-- Motivo -->
              <div class="col-12">
                <label class="form-label text-white fw-bold">
                  <i class="fas fa-clipboard-list me-2"></i>Motivo da Conferência
                </label>
                <%= f.text_field :reason, 
                                 placeholder: "Ex: Inventário mensal, Auditoria, Conferência de rotina...",
                                 class: "form-control bg-dark text-white border-dark",
                                 required: true %>
                <div class="invalid-feedback">
                  Por favor, informe o motivo da conferência.
                </div>
                <small class="text-white-50 mt-1">
                  <i class="fas fa-info-circle me-1"></i>Descreva brevemente o motivo desta conferência
                </small>
              </div>

              <!-- Observações -->
              <div class="col-12">
                <label class="form-label text-white fw-bold">
                  <i class="fas fa-sticky-note me-2"></i>Observações (Opcional)
                </label>
                <%= f.text_area :notes, 
                                rows: 3,
                                placeholder: "Adicione observações importantes sobre esta conferência...",
                                class: "form-control bg-dark text-white border-dark" %>
                <small class="text-white-50 mt-1">
                  <i class="fas fa-info-circle me-1"></i>Informações adicionais sobre a conferência
                </small>
              </div>
            </div>

            <!-- Botões de Ação -->
            <div class="row mt-4">
              <div class="col-12">
                <div class="d-flex justify-content-end gap-3">
                  <%= link_to stock_corrections_path, class: "btn btn-outline-light" do %>
                    <i class="fas fa-times me-2"></i>Cancelar
                  <% end %>
                  
                  <%= f.submit "Criar Conferência", 
                               class: "btn btn-success",
                               data: { 
                                 confirm: "Deseja criar esta conferência? Isso criará itens para todos os produtos da location selecionada."
                               } do %>
                    <i class="fas fa-plus-circle me-2"></i>Criar Conferência
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Informações Importantes -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card bg-black border border-info shadow-lg">
        <div class="card-header bg-info text-dark">
          <h6 class="mb-0">
            <i class="fas fa-info-circle me-2"></i>Informações Importantes
          </h6>
        </div>
        <div class="card-body bg-black">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-database text-info me-3 mt-1"></i>
                <div>
                  <h6 class="text-white mb-1">Produtos Incluídos</h6>
                  <small class="text-white-50">
                    Serão incluídos todos os produtos que possuem SKU e Shopify Inventory Item ID válidos
                  </small>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-search text-info me-3 mt-1"></i>
                <div>
                  <h6 class="text-white mb-1">Busca Individual</h6>
                  <small class="text-white-50">
                    Após criar, você poderá buscar produtos individualmente por SKU ou nome
                  </small>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-sync text-info me-3 mt-1"></i>
                <div>
                  <h6 class="text-white mb-1">Integração Automática</h6>
                  <small class="text-white-50">
                    As correções são automaticamente integradas com a Shopify ao salvar
                  </small>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-lock text-info me-3 mt-1"></i>
                <div>
                  <h6 class="text-white mb-1">Permissões</h6>
                  <small class="text-white-50">
                    Você só pode criar conferências nas locations que tem permissão de acesso
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<style>
body {
  background-color: #121212;
  color: #f8f9fa;
}

.bg-black {
  background-color: #121212 !important;
}

.form-control, .form-select {
  background-color: #343a40;
  border-color: #495057;
  color: #fff;
}

.form-control:focus, .form-select:focus {
  background-color: #495057;
  border-color: #6c757d;
  color: #fff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.form-control::placeholder {
  color: #adb5bd;
  opacity: 1;
}

.card {
  border-radius: 8px;
}

.btn {
  border-radius: 6px;
  font-weight: 500;
}

.shadow-lg {
  box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5) !important;
}

.badge {
  font-weight: 500;
}

.form-label {
  font-size: 0.9rem;
  margin-bottom: 0.3rem;
}

.help-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  border-radius: 0.5rem;
  background: rgba(45, 55, 72, 0.3);
  border: 1px solid #2d3748;
  transition: all 0.3s ease;
}

.help-item:hover {
  background: rgba(66, 153, 225, 0.1);
  border-color: #4299e1;
}

.help-icon {
  width: 40px;
  height: 40px;
  border-radius: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1.1rem;
  flex-shrink: 0;
}

.help-content h6 {
  margin: 0;
  font-weight: 600;
}

.invalid-feedback {
  display: block;
  width: 100%;
  margin-top: 0.25rem;
  font-size: 0.875em;
  color: #dc3545;
}

.was-validated .form-control:invalid,
.was-validated .form-select:invalid {
  border-color: #dc3545;
}

.was-validated .form-control:valid,
.was-validated .form-select:valid {
  border-color: #198754;
}

@media (max-width: 768px) {
  .help-item {
    flex-direction: column;
    text-align: center;
    gap: 0.5rem;
  }
  
  .d-flex.justify-content-end {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .btn {
    width: 100%;
  }
}
</style>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('🚀 Script carregado - Nova Conferência');

  // Validação do formulário
  const form = document.querySelector('.needs-validation');
  
  if (form) {
    form.addEventListener('submit', function(event) {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
        
        // Focar no primeiro campo inválido
        const firstInvalid = form.querySelector(':invalid');
        if (firstInvalid) {
          firstInvalid.focus();
        }
      }
      
      form.classList.add('was-validated');
    });

    // Validação em tempo real
    const inputs = form.querySelectorAll('input, select, textarea');
    inputs.forEach(input => {
      input.addEventListener('blur', function() {
        if (form.classList.contains('was-validated')) {
          input.checkValidity();
        }
      });
      
      input.addEventListener('input', function() {
        if (form.classList.contains('was-validated')) {
          input.checkValidity();
        }
      });
    });
  }

  console.log('✅ Script inicializado - Nova Conferência pronta');
});
</script>
