<% content_for :title, "Nova Conferência de Estoque" %>

<div class="container-fluid px-4">
  <div class="row">
    <div class="col-12">
      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-plus-circle text-primary me-2"></i>
            Nova Conferência de Estoque
          </h1>
          <p class="text-muted mb-0">Crie uma nova conferência para verificar e corrigir o estoque</p>
        </div>
        <%= link_to stock_corrections_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left me-1"></i>
          Voltar
        <% end %>
      </div>

      <!-- Tutorial Card -->
      <div class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #28a745 !important;">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3">
              <i class="fas fa-graduation-cap text-success"></i>
            </div>
            <div class="flex-grow-1">
              <h6 class="mb-0 text-success fw-bold">Como criar uma conferência</h6>
              <small class="text-muted">Tutorial passo-a-passo</small>
            </div>
            <button class="btn btn-sm btn-outline-success" type="button" data-bs-toggle="collapse" data-bs-target="#tutorialCollapse">
              <i class="fas fa-chevron-down"></i>
            </button>
          </div>
        </div>
        <div class="collapse" id="tutorialCollapse">
          <div class="card-body pt-2">
            <div class="row g-3">
              <div class="col-md-4">
                <div class="d-flex align-items-start">
                  <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 14px; font-weight: bold;">
                    1
                  </div>
                  <div>
                    <h6 class="mb-1 text-success">Selecione a Location</h6>
                    <p class="text-muted small mb-0">Escolha a loja onde será feita a conferência. Você só pode acessar locations autorizadas.</p>
                  </div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="d-flex align-items-start">
                  <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 14px; font-weight: bold;">
                    2
                  </div>
                  <div>
                    <h6 class="mb-1 text-success">Defina Data e Motivo</h6>
                    <p class="text-muted small mb-0">Informe quando será feita a conferência e o motivo (inventário, auditoria, etc.).</p>
                  </div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="d-flex align-items-start">
                  <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 14px; font-weight: bold;">
                    3
                  </div>
                  <div>
                    <h6 class="mb-1 text-success">Inicie a Conferência</h6>
                    <p class="text-muted small mb-0">Após criar, você será direcionado para conferir produto por produto.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Verificação de Permissões -->
      <% if @available_locations.empty? %>
        <div class="alert alert-warning d-flex align-items-center" role="alert">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <div>
            <strong>Sem Permissões:</strong> Você não tem acesso a nenhuma location. Entre em contato com o administrador para solicitar permissões.
          </div>
        </div>
      <% else %>
        <!-- Form Card -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white border-0 pb-0">
            <h6 class="mb-0 text-dark fw-bold">
              <i class="fas fa-clipboard-list text-primary me-2"></i>
              Dados da Conferência
            </h6>
          </div>
          <div class="card-body">
            <%= form_with(model: @stock_correction, local: true, class: "needs-validation", novalidate: true) do |form| %>
              <% if @stock_correction.errors.any? %>
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                  <i class="fas fa-exclamation-circle me-2"></i>
                  <div>
                    <strong><%= pluralize(@stock_correction.errors.count, "erro") %> encontrado<%= @stock_correction.errors.count > 1 ? 's' : '' %>:</strong>
                    <ul class="mb-0 mt-1">
                      <% @stock_correction.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>

              <div class="row g-4">
                <!-- Location Selection -->
                <div class="col-md-6">
                  <div class="form-group">
                    <%= form.label :location, class: "form-label fw-semibold" do %>
                      <i class="fas fa-map-marker-alt text-primary me-1"></i>
                      Location <span class="text-danger">*</span>
                    <% end %>
                    <%= form.select :location, 
                        options_for_select(@available_locations.map { |name, key| [name, key] }, @location),
                        { prompt: "Selecione uma location..." },
                        { 
                          class: "form-select #{'is-invalid' if @stock_correction.errors[:location].any?}",
                          required: true,
                          title: "Selecione a location onde será feita a conferência"
                        } %>
                    <% if @stock_correction.errors[:location].any? %>
                      <div class="invalid-feedback">
                        <%= @stock_correction.errors[:location].first %>
                      </div>
                    <% else %>
                      <div class="form-text">
                        <i class="fas fa-info-circle text-info me-1"></i>
                        Você só pode acessar locations autorizadas pelo administrador
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- Correction Date -->
                <div class="col-md-6">
                  <div class="form-group">
                    <%= form.label :correction_date, class: "form-label fw-semibold" do %>
                      <i class="fas fa-calendar-alt text-primary me-1"></i>
                      Data da Conferência <span class="text-danger">*</span>
                    <% end %>
                    <%= form.date_field :correction_date, 
                        value: @stock_correction.correction_date || Date.current,
                        class: "form-control #{'is-invalid' if @stock_correction.errors[:correction_date].any?}",
                        required: true,
                        title: "Data em que a conferência será realizada" %>
                    <% if @stock_correction.errors[:correction_date].any? %>
                      <div class="invalid-feedback">
                        <%= @stock_correction.errors[:correction_date].first %>
                      </div>
                    <% else %>
                      <div class="form-text">
                        <i class="fas fa-info-circle text-info me-1"></i>
                        Data padrão é hoje, mas você pode alterar se necessário
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- Reason -->
                <div class="col-12">
                  <div class="form-group">
                    <%= form.label :reason, class: "form-label fw-semibold" do %>
                      <i class="fas fa-clipboard-question text-primary me-1"></i>
                      Motivo da Conferência <span class="text-danger">*</span>
                    <% end %>
                    <%= form.text_field :reason, 
                        placeholder: "Ex: Inventário mensal, Auditoria, Conferência de rotina...",
                        class: "form-control #{'is-invalid' if @stock_correction.errors[:reason].any?}",
                        required: true,
                        title: "Descreva o motivo desta conferência de estoque" %>
                    <% if @stock_correction.errors[:reason].any? %>
                      <div class="invalid-feedback">
                        <%= @stock_correction.errors[:reason].first %>
                      </div>
                    <% else %>
                      <div class="form-text">
                        <i class="fas fa-info-circle text-info me-1"></i>
                        Seja específico sobre o motivo para facilitar o controle histórico
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- Notes -->
                <div class="col-12">
                  <div class="form-group">
                    <%= form.label :notes, class: "form-label fw-semibold" do %>
                      <i class="fas fa-sticky-note text-primary me-1"></i>
                      Observações <span class="text-muted">(opcional)</span>
                    <% end %>
                    <%= form.text_area :notes, 
                        rows: 3,
                        placeholder: "Observações adicionais sobre esta conferência...",
                        class: "form-control #{'is-invalid' if @stock_correction.errors[:notes].any?}",
                        title: "Adicione observações importantes sobre esta conferência" %>
                    <% if @stock_correction.errors[:notes].any? %>
                      <div class="invalid-feedback">
                        <%= @stock_correction.errors[:notes].first %>
                      </div>
                    <% else %>
                      <div class="form-text">
                        <i class="fas fa-info-circle text-info me-1"></i>
                        Use este campo para anotar informações importantes sobre a conferência
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <div class="text-muted small">
                  <i class="fas fa-info-circle me-1"></i>
                  Após criar, você poderá conferir os produtos individualmente
                </div>
                <div class="d-flex gap-2">
                  <%= link_to stock_corrections_path, class: "btn btn-outline-secondary" do %>
                    <i class="fas fa-times me-1"></i>
                    Cancelar
                  <% end %>
                  <%= form.submit "Criar Conferência", 
                      class: "btn btn-primary",
                      title: "Criar nova conferência e começar a conferir produtos",
                      data: { 
                        confirm: "Tem certeza que deseja criar esta conferência? Isso irá gerar itens para todos os produtos da location selecionada."
                      } do %>
                    <i class="fas fa-plus me-1"></i>
                    Criar Conferência
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Info Cards -->
        <div class="row mt-4">
          <div class="col-md-4">
            <div class="card border-0 bg-light">
              <div class="card-body text-center py-3">
                <i class="fas fa-shield-alt text-success fa-2x mb-2"></i>
                <h6 class="mb-1">Acesso Controlado</h6>
                <p class="text-muted small mb-0">Você só pode criar conferências nas locations autorizadas</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border-0 bg-light">
              <div class="card-body text-center py-3">
                <i class="fas fa-boxes text-info fa-2x mb-2"></i>
                <h6 class="mb-1">Produtos Automáticos</h6>
                <p class="text-muted small mb-0">Todos os produtos da location serão incluídos automaticamente</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border-0 bg-light">
              <div class="card-body text-center py-3">
                <i class="fas fa-sync-alt text-warning fa-2x mb-2"></i>
                <h6 class="mb-1">Sincronização</h6>
                <p class="text-muted small mb-0">Correções podem ser sincronizadas com a Shopify</p>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- JavaScript para validação do formulário -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Validação do formulário
  const forms = document.querySelectorAll('.needs-validation');
  Array.from(forms).forEach(form => {
    form.addEventListener('submit', event => {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  });

  // Atualizar URL quando location mudar
  const locationSelect = document.querySelector('select[name="stock_correction[location]"]');
  if (locationSelect) {
    locationSelect.addEventListener('change', function() {
      const selectedLocation = this.value;
      if (selectedLocation) {
        const url = new URL(window.location);
        url.searchParams.set('location', selectedLocation);
        window.history.replaceState({}, '', url);
      }
    });
  }
});
</script>

<style>
.card {
  transition: all 0.3s ease;
}

.card:hover {
  transform: translateY(-2px);
}

.form-control:focus,
.form-select:focus {
  border-color: #0d6efd;
  box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
}

.btn {
  transition: all 0.3s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.bg-light {
  background-color: #f8f9fa !important;
}

.text-primary {
  color: #0d6efd !important;
}

.border-top {
  border-top: 1px solid #dee2e6 !important;
}
</style>
