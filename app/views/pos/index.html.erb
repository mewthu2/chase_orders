<% content_for :title, "PDV - Point of Sale" %>

<div class="container-fluid py-4">
  <% title 'PDV - Point of Sale' %>

  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-success shadow">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-cash-register me-2"></i>PDV - Ponto de Venda
          </h5>
          <div class="d-flex gap-3">
            <span class="badge bg-success text-dark px-3 py-2">
              <i class="fas fa-user me-1"></i><%= current_user.name %>
            </span>
            <span class="badge bg-info text-dark px-3 py-2">
              <i class="fas fa-clock me-1"></i> <%= Time.now.strftime('%H:%M') %>
            </span>
            <%= link_to order_pdvs_path, class: "btn btn-outline-light btn-sm" do %>
              <i class="fas fa-list me-1"></i>Gerenciar Pedidos
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-4">
              <div class="card bg-black border border-primary h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-white mb-0">
                      <i class="fas fa-shopping-cart me-2"></i>Carrinho Atual
                    </h6>
                    <span class="badge bg-primary" id="cart-count-badge"><%= @cart_items.sum { |item| item['quantity'] } %> itens</span>
                  </div>
                  <div class="text-center">
                    <div class="h3 text-primary mb-0" id="cart-total-display">R$ <%= sprintf('%.2f', @total) %></div>
                    <small class="text-light">Total do carrinho</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card bg-black border border-warning h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-white mb-0">
                      <i class="fas fa-search me-2"></i>Busca Inteligente
                    </h6>
                    <span class="badge bg-warning text-dark">
                      <i class="fas fa-database me-1"></i>Tempo Real
                    </span>
                  </div>
                  <div class="text-center">
                    <div class="h6 text-warning mb-0">Estoque Shopify</div>
                    <small class="text-light">Verificação automática</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card bg-black border border-success h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-white mb-0">
                      <i class="fas fa-tags me-2"></i>Cupons de Desconto
                    </h6>
                    <span class="badge bg-success text-dark" id="coupon-status-badge">
                      <i class="fas fa-ticket-alt me-1"></i>Disponível
                    </span>
                  </div>
                  <div class="text-center">
                    <div class="h6 text-success mb-0" id="coupon-discount-display">R$ 0,00</div>
                    <small class="text-light">Desconto aplicado</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card bg-black border border-dark shadow mb-4">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-search me-2"></i>Buscar Produtos
            <small class="text-success ms-2">
              <i class="fas fa-database me-1"></i>Busca com Estoque em Tempo Real
            </small>
          </h5>
        </div>
        <div class="card-body">
          <input type="text" id="product-search" placeholder="Digite SKU ou nome do produto..." 
                 class="form-control form-control-lg bg-dark text-white border-secondary">
          
          <div id="search-results" class="mt-4"></div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card bg-black border border-dark shadow position-sticky mb-4" style="top: 20px;">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-shopping-cart me-2"></i>Carrinho 
            <small class="text-success">(<span id="cart-unique-count"><%= @cart_items.count %></span> produtos, <span id="cart-total-items"><%= @cart_items.sum { |item| item['quantity'] } %></span> itens)</small>
          </h5>
          <button onclick="clearCart()" class="btn btn-outline-danger btn-sm" id="clear-cart-btn" style="<%= @cart_items.empty? ? 'display: none;' : '' %>">
            <i class="fas fa-trash me-1"></i>Limpar
          </button>
        </div>
        <div class="card-body">
          <div class="mb-3" id="coupon-section">
            <div class="d-flex gap-2 mb-2">
              <input type="text" id="coupon-input" placeholder="Código do cupom..." 
                     class="form-control form-control-sm bg-dark text-white border-secondary">
              <button onclick="searchCoupon()" class="btn btn-success btn-sm" id="search-coupon-btn">
                <i class="fas fa-search"></i>
              </button>
            </div>
            <div id="coupon-result" class="mt-2"></div>
          </div>

          <div id="cart-items">
            <% if @cart_items.any? %>
              <div id="cart-items-container">
                <% @cart_items.each_with_index do |item, index| %>
                  <div class="card bg-dark border-secondary mb-2 cart-item" data-product-id="<%= item['product_id'] %>" data-item-index="<%= index %>">
                    <div class="card-body p-3">
                      <div class="d-flex align-items-start gap-3">
                        <% if item['image_url'].present? %>
                          <img src="<%= item['image_url'] %>" alt="<%= item['name'] %>" 
                               class="rounded" style="width: 70px; height: 90px; object-fit: cover;">
                        <% else %>
                          <div class="bg-secondary rounded d-flex align-items-center justify-content-center" 
                               style="width: 70px; height: 90px;">
                            <i class="fas fa-image text-light"></i>
                          </div>
                        <% end %>

                        <div class="flex-grow-1 min-w-0">
                          <h6 class="text-white mb-1"><%= item['sku'] %></h6>
                          <% if item['name'].present? %>
                            <p class="text-light mb-2 small"><%= truncate(item['name'], length: 25) %></p>
                          <% else %>
                            <p class="text-light mb-2 small">Nome não disponível</p>
                          <% end %>
                          
                          <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                              <button onclick="updateCartQuantity('<%= item['product_id'] %>', <%= item['quantity'].to_i - 1 %>)" 
                                      class="btn btn-outline-secondary btn-sm" style="width: 28px; height: 28px; padding: 0;">
                                <i class="fas fa-minus" style="font-size: 0.7rem;"></i>
                              </button>
                              <span class="text-white fw-bold px-2 cart-quantity" style="min-width: 30px; text-align: center;">
                                <%= item['quantity'] %>
                              </span>
                              <button onclick="updateCartQuantity('<%= item['product_id'] %>', <%= item['quantity'].to_i + 1 %>)" 
                                      class="btn btn-outline-success btn-sm" style="width: 28px; height: 28px; padding: 0;">
                                <i class="fas fa-plus" style="font-size: 0.7rem;"></i>
                              </button>
                            </div>
                            
                            <div class="text-end">
                              <div class="text-success fw-bold cart-item-total">
                                R$ <%= sprintf('%.2f', item['price'].to_f * item['quantity'].to_i) %>
                              </div>
                              <small class="text-light">
                                R$ <%= sprintf('%.2f', item['price'].to_f) %> cada
                              </small>
                            </div>
                          </div>
                        </div>

                        <button onclick="removeFromCart('<%= item['product_id'] %>')" 
                                class="btn btn-outline-danger btn-sm" style="width: 32px; height: 32px; padding: 0;">
                          <i class="fas fa-times"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>

              <div id="cart-summary-section">
                <div class="border-top border-secondary pt-3 mt-3">
                  <div id="cart-summary">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <span class="text-white">Subtotal:</span>
                      <span class="text-white" id="subtotal-display">R$ <%= sprintf('%.2f', @total) %></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2" id="coupon-discount-row" style="display: none !important;">
                      <span class="text-success">Desconto (Cupom):</span>
                      <span class="text-success" id="coupon-discount-amount">R$ 0,00</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 border-top pt-2">
                      <span class="h5 text-white mb-0">Total:</span>
                      <span class="h4 text-success mb-0" id="final-total-display">R$ <%= sprintf('%.2f', @total) %></span>
                    </div>
                  </div>
                  
                  <button onclick="openCheckoutModal()" class="btn btn-success btn-lg w-100">
                    <i class="fas fa-credit-card me-2"></i>Finalizar Venda
                  </button>
                </div>
              </div>
            <% else %>
              <div class="text-center py-5" id="empty-cart-message">
                <div class="mb-3">
                  <i class="fas fa-shopping-cart fa-3x text-light"></i>
                </div>
                <h6 class="text-light">Carrinho vazio</h6>
                <p class="text-light small">Adicione produtos para começar</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="checkout-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">
          <i class="fas fa-credit-card me-2"></i>Finalizar Venda
        </h5>
        <button type="button" class="btn-close btn-close-white" onclick="closeCheckoutModal()"></button>
      </div>
      <div class="modal-body">
        <form id="checkout-form">
          <div class="row">
            <div class="col-md-6">
              <div class="card bg-black border-secondary mb-3">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Configurações da Venda</h6>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Loja *</label>
                      <select name="store_type" class="form-select bg-dark text-white border-secondary" required>
                        <option value="">Selecione a loja</option>
                        <option value="online">Online Store</option>
                        <option value="lagoa_seca">Lagoa Seca</option>
                        <option value="bh_shopping">BH Shopping</option>
                        <option value="rj">Barra Shopping (RJ)</option>
                      </select>
                    </div>
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Forma de Pagamento *</label>
                      <select name="payment_method" id="payment-method-select" class="form-select bg-dark text-white border-secondary" required>
                        <option value="">Selecione o pagamento</option>
                        <option value="dinheiro">Dinheiro</option>
                        <option value="cartao_credito">Cartão de Crédito</option>
                        <option value="cartao_debito">Cartão de Débito</option>
                        <option value="pix">PIX</option>
                        <option value="multi">Pagamento Múltiplo</option>
                      </select>
                    </div>
                    
                    <div class="col-12 mb-3" id="multi-payment-section" style="display: none;">
                      <div class="card bg-dark border-info">
                        <div class="card-header bg-info text-dark">
                          <h6 class="mb-0">
                            <i class="fas fa-credit-card me-2"></i>Configurar Pagamentos
                          </h6>
                        </div>
                        <div class="card-body">
                          <div id="payment-methods-container">
                          </div>
                          <button type="button" onclick="addPaymentMethod()" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-plus me-1"></i>Adicionar Método
                          </button>
                          <div class="mt-2">
                            <small class="text-info">
                              <i class="fas fa-info-circle me-1"></i>
                              Total configurado: <span id="multi-payment-total">R$ 0,00</span>
                            </small>
                          </div>
                        </div>
                      </div>
                    </div>
                    
                    <div class="col-12">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="integrate-shopify" name="integrate_shopify" checked>
                        <label class="form-check-label text-white" for="integrate-shopify">
                          <i class="fas fa-sync me-2"></i>Integrar automaticamente com Shopify
                        </label>
                        <div class="form-text text-info">
                          <small>Pedido será integrado automaticamente após criação</small>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card bg-black border-secondary mb-3">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Dados do Cliente</h6>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Nome Completo *</label>
                      <input type="text" name="customer_name" required class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Email *</label>
                      <input type="email" name="customer_email" required class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label text-white">Telefone *</label>
                      <input type="tel" name="customer_phone" required class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label text-white">CPF *</label>
                      <input type="text" name="customer_cpf" required class="form-control bg-dark text-white border-secondary">
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card bg-black border-secondary mb-3">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Endereço de Entrega</h6>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label text-white">CEP *</label>
                      <input type="text" name="zip" required class="form-control bg-dark text-white border-secondary" placeholder="00000-000" id="cep-input">
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label text-white">Estado *</label>
                      <input type="text" name="state" required class="form-control bg-dark text-white border-secondary" placeholder="SP" maxlength="2" id="state-input">
                    </div>
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Cidade *</label>
                      <input type="text" name="city" required class="form-control bg-dark text-white border-secondary" id="city-input">
                    </div>
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Bairro *</label>
                      <input type="text" name="neighborhood" required class="form-control bg-dark text-white border-secondary" id="neighborhood-input">
                    </div>
                    <div class="col-md-8 mb-3">
                      <label class="form-label text-white">Rua *</label>
                      <input type="text" name="street" required class="form-control bg-dark text-white border-secondary" placeholder="Ex: Rua das Flores" id="street-input">
                    </div>
                    <div class="col-md-4 mb-3">
                      <label class="form-label text-white">Número *</label>
                      <input type="text" name="number" required class="form-control bg-dark text-white border-secondary" placeholder="123" id="number-input">
                    </div>
                    <div class="col-12">
                      <label class="form-label text-white">Complemento</label>
                      <input type="text" name="complement" class="form-control bg-dark text-white border-secondary" placeholder="Ex: Apto 45, Bloco B">
                    </div>
                  </div>
                </div>
              </div>

              <div class="card bg-black border-secondary mb-3">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Desconto Adicional (Opcional)</h6>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label text-white">Valor do Desconto (R$)</label>
                      <input type="number" name="discount_amount" step="0.01" min="0" class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label text-white">Motivo do Desconto</label>
                      <input type="text" name="discount_reason" class="form-control bg-dark text-white border-secondary">
                    </div>
                  </div>
                </div>
              </div>

              <div class="card bg-black border-secondary">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Observações</h6>
                </div>
                <div class="card-body">
                  <textarea name="notes" rows="3" class="form-control bg-dark text-white border-secondary" placeholder="Observações adicionais..."></textarea>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" onclick="closeCheckoutModal()">
          Cancelar
        </button>
        <button type="submit" form="checkout-form" class="btn btn-success" id="finalize-btn">
          <i class="fas fa-check me-1"></i>Finalizar Venda
        </button>
      </div>
    </div>
  </div>
</div>

<div id="quantity-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">
          <i class="fas fa-plus-circle me-2"></i>Adicionar ao Carrinho
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <div id="selected-product-info" class="mb-3">
        </div>
        
        <div class="mb-3">
          <label class="form-label text-white">Quantidade:</label>
          <div class="d-flex justify-content-center align-items-center gap-3">
            <button type="button" onclick="decreaseQuantity()" class="btn btn-outline-secondary btn-sm">
              <i class="fas fa-minus"></i>
            </button>
            <input type="number" id="quantity-input" value="1" min="1" max="999" 
                   class="form-control form-control-sm bg-dark text-white border-secondary text-center" 
                   style="width: 80px;">
            <button type="button" onclick="increaseQuantity()" class="btn btn-outline-secondary btn-sm">
              <i class="fas fa-plus"></i>
            </button>
          </div>
        </div>
        
        <div id="quantity-stock-info" class="mb-3">
        </div>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" id="confirm-add-btn" onclick="confirmAddToCart()" class="btn btn-success">
          <i class="fas fa-cart-plus me-1"></i>Adicionar ao Carrinho
        </button>
      </div>
    </div>
  </div>
</div>

<div id="loading-overlay" class="position-fixed top-0 start-0 w-100 h-100 d-none" 
     style="background: rgba(0,0,0,0.8); z-index: 9999;">
  <div class="d-flex justify-content-center align-items-center h-100">
    <div class="text-center">
      <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
      <h5 class="text-white" id="loading-message">Processando...</h5>
    </div>
  </div>
</div>

<% content_for :styles do %>
  <style>
    body {
      background-color: #121212;
      color: #f8f9fa;
    }

    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2) !important;
    }

    .bg-black {
      background-color: #121212 !important;
    }

    .form-control.bg-dark {
      background-color: #212529 !important;
      border-color: #495057;
    }

    .form-control.bg-dark:focus {
      background-color: #212529 !important;
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .form-select.bg-dark {
      background-color: #212529 !important;
      border-color: #495057;
    }

    .form-select.bg-dark:focus {
      background-color: #212529 !important;
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .modal-content.bg-dark {
      background-color: #212529 !important;
    }

    .form-check-input {
      background-color: #495057;
      border-color: #6c757d;
    }

    .form-check-input:checked {
      background-color: #198754;
      border-color: #198754;
    }

    .form-check-input:focus {
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .product-item {
      background: linear-gradient(135deg, #2d3748 0%, #374151 100%);
      border: 1px solid #4a5568;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    .product-item:hover {
      transform: translateY(-3px);
      border-color: #68d391;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
      background: linear-gradient(135deg, #374151 0%, #4a5568 100%);
    }

    .product-image-container {
      width: 70px;
      height: 90px;
      border-radius: 8px;
      overflow: hidden;
      background: #4a5568;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #68d391;
      flex-shrink: 0;
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-info {
      flex: 1;
      min-width: 0;
      padding: 0 12px;
    }

    .product-sku {
      font-weight: 700;
      font-size: 0.95rem;
      color: #68d391;
      margin: 0 0 4px 0;
      letter-spacing: 0.5px;
    }

    .product-name {
      color: #e2e8f0;
      font-size: 0.85rem;
      margin: 0 0 8px 0;
      line-height: 1.3;
      font-weight: 500;
    }

    .product-price {
      color: #4fd1c7;
      font-weight: 700;
      font-size: 1rem;
      margin: 0 0 6px 0;
    }

    .product-option {
      display: inline-block;
      background: rgba(104, 211, 145, 0.2);
      color: #68d391;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 0.7rem;
      font-weight: 600;
      border: 1px solid rgba(104, 211, 145, 0.3);
    }

    .product-actions {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .add-to-cart-btn {
      padding: 10px 16px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.8rem;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      min-width: 100px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .add-to-cart-btn:enabled {
      background: linear-gradient(135deg, #68d391 0%, #48bb78 100%);
      color: #1a202c;
      box-shadow: 0 4px 12px rgba(104, 211, 145, 0.3);
    }

    .add-to-cart-btn:enabled:hover {
      background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(104, 211, 145, 0.4);
    }

    .add-to-cart-btn:disabled {
      background: linear-gradient(135deg, #718096 0%, #4a5568 100%);
      color: #a0aec0;
      cursor: not-allowed;
      opacity: 0.7;
    }

    .stock-info {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
    }

    .stock-badge {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border: 1px solid;
    }

    .stock-high {
      background: rgba(72, 187, 120, 0.2);
      color: #48bb78;
      border-color: #48bb78;
    }

    .stock-low {
      background: rgba(237, 137, 54, 0.2);
      color: #ed8936;
      border-color: #ed8936;
    }

    .stock-out {
      background: rgba(245, 101, 101, 0.2);
      color: #f56565;
      border-color: #f56565;
    }

    .stock-error {
      background: rgba(160, 174, 192, 0.2);
      color: #a0aec0;
      border-color: #a0aec0;
    }

    .stock-quantity {
      font-weight: 700;
      font-size: 0.8rem;
      color: #e2e8f0;
      background: rgba(45, 55, 72, 0.8);
      padding: 2px 8px;
      border-radius: 12px;
      border: 1px solid #4a5568;
    }

    .search-empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #a0aec0;
    }

    .search-empty-state i {
      font-size: 4rem;
      margin-bottom: 20px;
      opacity: 0.5;
    }

    .search-empty-state h6 {
      font-size: 1.2rem;
      margin-bottom: 10px;
      color: #e2e8f0;
    }

    .search-empty-state p {
      font-size: 0.9rem;
      margin: 0;
      opacity: 0.7;
    }

    .coupon-valid {
      background: rgba(40, 167, 69, 0.15);
      border: 2px solid #28a745;
      border-radius: 10px;
      padding: 14px;
      box-shadow: 0 4px 12px rgba(40, 167, 69, 0.2);
    }

    .coupon-invalid {
      background: rgba(220, 53, 69, 0.15);
      border: 2px solid #dc3545;
      border-radius: 10px;
      padding: 14px;
      box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
    }

    .coupon-applied {
      background: rgba(13, 110, 253, 0.15);
      border: 2px solid #0d6efd;
      border-radius: 10px;
      padding: 14px;
      box-shadow: 0 4px 12px rgba(13, 110, 253, 0.2);
    }

    .payment-method-item {
      background: rgba(13, 110, 253, 0.1);
      border: 1px solid rgba(13, 110, 253, 0.3);
      border-radius: 8px;
      padding: 12px;
      margin-bottom: 8px;
    }

    .btn-loading {
      position: relative;
      color: transparent !important;
    }

    .btn-loading::after {
      content: "";
      position: absolute;
      width: 16px;
      height: 16px;
      top: 50%;
      left: 50%;
      margin-left: -8px;
      margin-top: -8px;
      border: 2px solid #ffffff;
      border-radius: 50%;
      border-top-color: transparent;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>
<% end %>

<script>
let searchTimeout;
let appliedCoupon = null;
let currentProductData = null;
let paymentMethodCounter = 0;

function showLoading(message = 'Processando...') {
  document.getElementById('loading-message').textContent = message;
  document.getElementById('loading-overlay').classList.remove('d-none');
}

function hideLoading() {
  document.getElementById('loading-overlay').classList.add('d-none');
}

document.addEventListener('DOMContentLoaded', function() {
  const integrateCheckbox = document.getElementById('integrate-shopify');
  const finalizeBtn = document.getElementById('finalize-btn');
  const paymentMethodSelect = document.getElementById('payment-method-select');
  
  function updateButtonText() {
    if (integrateCheckbox.checked) {
      finalizeBtn.innerHTML = '<i class="fas fa-sync me-1"></i>Finalizar e Integrar';
    } else {
      finalizeBtn.innerHTML = '<i class="fas fa-save me-1"></i>Salvar Pedido';
    }
  }
  
  integrateCheckbox.addEventListener('change', updateButtonText);
  updateButtonText();
  
  paymentMethodSelect.addEventListener('change', function() {
    const multiPaymentSection = document.getElementById('multi-payment-section');
    if (this.value === 'multi') {
      multiPaymentSection.style.display = 'block';
      addPaymentMethod();
    } else {
      multiPaymentSection.style.display = 'none';
      clearPaymentMethods();
    }
  });
});

function addPaymentMethod() {
  paymentMethodCounter++;
  const container = document.getElementById('payment-methods-container');
  
  const methodDiv = document.createElement('div');
  methodDiv.className = 'payment-method-item';
  methodDiv.id = `payment-method-${paymentMethodCounter}`;
  
  methodDiv.innerHTML = `
    <div class="row align-items-center">
      <div class="col-md-4 mb-2">
        <select class="form-select form-select-sm bg-dark text-white border-secondary payment-method-type" required>
          <option value="">Método</option>
          <option value="dinheiro">Dinheiro</option>
          <option value="cartao_credito">Cartão Crédito</option>
          <option value="cartao_debito">Cartão Débito</option>
          <option value="pix">PIX</option>
        </select>
      </div>
      <div class="col-md-4 mb-2">
        <input type="number" step="0.01" min="0" placeholder="Valor (R$)" 
               class="form-control form-control-sm bg-dark text-white border-secondary payment-amount" 
               onchange="updateMultiPaymentTotal()" required>
      </div>
      <div class="col-md-3 mb-2">
        <input type="date" class="form-control form-control-sm bg-dark text-white border-secondary payment-date" 
               value="${new Date().toISOString().split('T')[0]}" required>
      </div>
      <div class="col-md-1 mb-2">
        <button type="button" onclick="removePaymentMethod(${paymentMethodCounter})" 
                class="btn btn-outline-danger btn-sm">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>
  `;
  
  container.appendChild(methodDiv);
  updateMultiPaymentTotal();
}

function removePaymentMethod(id) {
  const element = document.getElementById(`payment-method-${id}`);
  if (element) {
    element.remove();
    updateMultiPaymentTotal();
  }
}

function clearPaymentMethods() {
  document.getElementById('payment-methods-container').innerHTML = '';
  paymentMethodCounter = 0;
  updateMultiPaymentTotal();
}

function updateMultiPaymentTotal() {
  const amounts = document.querySelectorAll('.payment-amount');
  let total = 0;
  
  amounts.forEach(input => {
    const value = parseFloat(input.value) || 0;
    total += value;
  });
  
  document.getElementById('multi-payment-total').textContent = `R$ ${total.toFixed(2)}`;
}

function getMultiPaymentData() {
  const methods = document.querySelectorAll('.payment-method-item');
  const payments = [];
  
  methods.forEach(method => {
    const type = method.querySelector('.payment-method-type').value;
    const amount = parseFloat(method.querySelector('.payment-amount').value) || 0;
    const date = method.querySelector('.payment-date').value;
    
    if (type && amount > 0) {
      payments.push({
        method: type,
        amount: amount,
        date: date
      });
    }
  });
  
  return payments;
}

document.getElementById('cep-input')?.addEventListener('blur', function(e) {
  const cep = e.target.value.replace(/\D/g, '');

  if (cep.length === 8) {
    fetch(`https://viacep.com.br/ws/${cep}/json/`)
      .then(response => response.json())
      .then(data => {
        if (!data.erro) {
          document.getElementById('street-input').value = data.logradouro || '';
          document.getElementById('neighborhood-input').value = data.bairro || '';
          document.getElementById('city-input').value = data.localidade || '';
          document.getElementById('state-input').value = data.uf || '';
        }
      })
      .catch(error => {
        console.error('Erro ao buscar CEP:', error);
      });
  }
});

document.getElementById('product-search').addEventListener('input', function(e) {
  clearTimeout(searchTimeout);
  const query = e.target.value.trim();

  if (query.length < 2) {
    document.getElementById('search-results').innerHTML = '';
    return;
  }

  searchTimeout = setTimeout(() => {
    searchProducts(query);
  }, 300);
});

function searchProducts(query) {
  showLoading('Buscando produtos e verificando estoque...');

  fetch('/pos/search_product', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ query: query })
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    const resultsContainer = document.getElementById('search-results');

    if (data.success && data.products.length > 0) {
      resultsContainer.innerHTML = data.products.map(product => {
        let stockClass = 'stock-out';
        let stockText = 'Sem Estoque';
        let stockIcon = '❌';

        if (product.stock_status === 'high') {
          stockClass = 'stock-high';
          stockText = 'Disponível';
          stockIcon = '✅';
        } else if (product.stock_status === 'low') {
          stockClass = 'stock-low';
          stockText = 'Baixo';
          stockIcon = '⚠️';
        } else if (product.stock_status === 'error') {
          stockClass = 'stock-error';
          stockText = 'Erro';
          stockIcon = '❓';
        }

        const isOutOfStock = product.stock_status === 'out';
        const buttonText = isOutOfStock ? '❌ Sem Estoque' : '➕ Adicionar';

        return `
          <div class="product-item">
            <div style="display: flex; align-items: center; gap: 12px;">
              <div class="product-image-container">
                ${product.image_url ? 
                  `<img src="${product.image_url}" alt="${product.name}" class="product-image">` :
                  `<i class="fas fa-image" style="color: #a0aec0; font-size: 1.2rem;"></i>`
                }
              </div>
              
              <div class="product-info">
                <div class="product-sku">${product.sku}</div>
                <div class="product-name">${product.name || ''}</div>
                <div class="product-price">R$ ${product.price.toFixed(2)}</div>
                
                ${product.option1 ? 
                  `<div class="product-option">${product.option1}</div>` : 
                  ''
                }
                
                <div class="stock-info">
                  <span class="stock-badge ${stockClass}">
                    ${stockIcon} ${stockText}
                  </span>
                  <span class="stock-quantity">
                    ${product.stock} un.
                  </span>
                </div>
              </div>
              
              <div class="product-actions">
                <button 
                  onclick="openQuantityModal(${JSON.stringify(product).replace(/"/g, '&quot;')})"
                  class="add-to-cart-btn"
                  ${isOutOfStock ? 'disabled' : ''}
                  data-product-id="${product.id}"
                >
                  ${buttonText}
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    } else {
      resultsContainer.innerHTML = `
        <div class="search-empty-state">
          <i class="fas fa-search"></i>
          <h6>Nenhum produto encontrado</h6>
          <p>Tente buscar por SKU ou nome do produto</p>
        </div>
      `;
    }
  })
  .catch(error => {
    hideLoading();
    console.error('Erro na busca:', error);
    document.getElementById('search-results').innerHTML = `
      <div class="search-empty-state">
        <i class="fas fa-exclamation-triangle text-danger"></i>
        <h6>Erro ao buscar produtos</h6>
        <p>Tente novamente em alguns instantes</p>
      </div>
    `;
  });
}

function addToCart(productId, quantity) {
  showLoading('Adicionando produto ao carrinho...');

  fetch('/pos/add_to_cart', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({
      product_id: productId,
      quantity: quantity
    })
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    
    if (data.success) {
      setTimeout(() => {
        location.reload();
      }, 500);
    } else {
      alert(data.message || 'Erro ao adicionar produto');
    }
  })
  .catch(error => {
    console.error('Network error:', error);
    hideLoading();
    alert('Erro ao adicionar produto ao carrinho');
  });
}

function removeFromCart(productId) {
  if (!confirm('Remover este item do carrinho?')) return;

  showLoading('Removendo item do carrinho...');

  fetch('/pos/remove_from_cart', {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ product_id: productId })
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    if (data.success) {
      location.reload();
    } else {
      alert(data.message || 'Erro ao remover item');
    }
  })
  .catch(error => {
    hideLoading();
    console.error('Erro:', error);
    alert('Erro ao remover item do carrinho');
  });
}

function clearCart() {
  if (!confirm('Tem certeza que deseja limpar o carrinho?')) return;

  showLoading('Limpando carrinho...');

  fetch('/pos/clear_cart', {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    }
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    if (data.success) {
      location.reload();
    } else {
      alert(data.message || 'Erro ao limpar carrinho');
    }
  })
  .catch(error => {
    hideLoading();
    console.error('Erro:', error);
    alert('Erro ao limpar carrinho');
  });
}

function updateCartQuantity(productId, newQuantity) {
  if (newQuantity <= 0) {
    removeFromCart(productId);
    return;
  }

  showLoading('Atualizando quantidade...');

  fetch('/pos/update_cart_quantity', {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({
      product_id: productId,
      quantity: newQuantity
    })
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    
    if (data.success) {
      location.reload();
    } else {
      alert(data.message || 'Erro ao atualizar quantidade');
    }
  })
  .catch(error => {
    hideLoading();
    console.error('Erro:', error);
    alert('Erro ao atualizar quantidade');
  });
}

function searchCoupon() {
  const couponCode = document.getElementById('coupon-input').value.trim();

  if (!couponCode) {
    alert('Digite o código do cupom');
    return;
  }

  const button = document.getElementById('search-coupon-btn');
  const originalText = button.innerHTML;

  button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  button.disabled = true;

  fetch('/pos/search_coupon', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ coupon_code: couponCode })
  })
  .then(response => response.json())
  .then(data => {
    button.innerHTML = originalText;
    button.disabled = false;
    
    const resultDiv = document.getElementById('coupon-result');
    
    if (data.success) {
      const discountValue = parseFloat(data.coupon.discount_value);
      const discountText = data.coupon.discount_type === 'percentage' ? 
        `${discountValue}% OFF` : 
        `R$ ${discountValue.toFixed(2)} OFF`;
        
      resultDiv.innerHTML = `
        <div class="coupon-valid">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="text-success">✅ ${data.coupon.code}</strong>
            <button onclick="applyCoupon('${data.coupon.code}')" class="btn btn-success btn-sm">
              Aplicar
            </button>
          </div>
          <small class="text-white-50">
            ${data.coupon.title} - ${discountText}
          </small>
        </div>
      `;
    } else {
      resultDiv.innerHTML = `
        <div class="coupon-invalid">
          <strong class="text-danger">❌ ${data.message}</strong>
        </div>
      `;
      
      setTimeout(() => {
        resultDiv.innerHTML = '';
      }, 3000);
    }
  })
  .catch(error => {
    button.innerHTML = originalText;
    button.disabled = false;
    console.error('Erro:', error);
    
    document.getElementById('coupon-result').innerHTML = `
      <div class="coupon-invalid">
        <strong class="text-danger">❌ Erro ao buscar cupom</strong>
      </div>
    `;
  });
}

function applyCoupon(couponCode) {
  showLoading('Aplicando cupom...');

  fetch('/pos/apply_coupon', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ coupon_code: couponCode })
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    
    if (data.success) {
      location.reload();
    } else {
      document.getElementById('coupon-result').innerHTML = `
        <div class="coupon-invalid">
          <strong class="text-danger">❌ ${data.message}</strong>
        </div>
      `;
    }
  })
  .catch(error => {
    hideLoading();
    console.error('Erro:', error);
    alert('Erro ao aplicar cupom');
  });
}

function removeCoupon() {
  if (!confirm('Remover cupom aplicado?')) return;

  showLoading('Removendo cupom...');

  fetch('/pos/remove_coupon', {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    }
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    
    if (data.success) {
      location.reload();
    } else {
      alert(data.message || 'Erro ao remover cupom');
    }
  })
  .catch(error => {
    hideLoading();
    console.error('Erro:', error);
    alert('Erro ao remover cupom');
  });
}

function openCheckoutModal() {
  const modal = new bootstrap.Modal(document.getElementById('checkout-modal'));
  modal.show();
}

function closeCheckoutModal() {
  const modal = bootstrap.Modal.getInstance(document.getElementById('checkout-modal'));
  if (modal) modal.hide();
}

document.getElementById('checkout-form').addEventListener('submit', function(e) {
  e.preventDefault();

  const formData = new FormData(this);
  const data = Object.fromEntries(formData.entries());
  
  data.integrate_shopify = document.getElementById('integrate-shopify').checked;
  
  if (data.payment_method === 'multi') {
    const multiPayments = getMultiPaymentData();
    if (multiPayments.length === 0) {
      alert('Configure pelo menos um método de pagamento.');
      return;
    }
    data.multi_payments = multiPayments;
  }

  const requiredFields = ['customer_name', 'customer_email', 'customer_phone', 'customer_cpf', 'street', 'number', 'neighborhood', 'city', 'state', 'zip', 'store_type', 'payment_method'];
  const missingFields = requiredFields.filter(field => !data[field] || data[field].trim() === '');

  if (missingFields.length > 0) {
    alert('Por favor, preencha todos os campos obrigatórios.');
    return;
  }

  closeCheckoutModal();
  
  if (data.integrate_shopify) {
    showLoading('Processando venda e integrando com Shopify...');
  } else {
    showLoading('Salvando pedido localmente...');
  }

  fetch('/pos/create_order', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify(data)
  })
  .then(response => response.json())
  .then(data => {
    hideLoading();
    
    if (data.success) {
      let message = `Pedido registrado com sucesso!\n${data.message}`;
      if (data.coupon_used) {
        message += `\n\nCupom ${data.coupon_used} aplicado com sucesso!`;
      }
      alert(message);
      location.reload();
    } else {
      alert(`Erro ao finalizar venda: ${data.message}`);
      openCheckoutModal();
    }
  })
  .catch(error => {
    hideLoading();
    console.error('Erro:', error);
    alert('Erro ao processar venda');
    openCheckoutModal();
  });
});

document.getElementById('coupon-input').addEventListener('keypress', function(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    searchCoupon();
  }
});

function openQuantityModal(productData) {
  currentProductData = productData;

  const productInfo = document.getElementById('selected-product-info');
  productInfo.innerHTML = `
    <div class="d-flex align-items-center gap-3">
      <div style="width: 70px; height: 90px; border-radius: 8px; overflow: hidden; background: #4a5568; display: flex; align-items: center; justify-content: center;">
        ${productData.image_url ? 
          `<img src="${productData.image_url}" style="width: 100%; height: 100%; object-fit: cover;">` :
          `<i class="fas fa-image text-muted"></i>`
        }
      </div>
      <div class="text-start">
        <h6 class="text-white mb-1">${productData.sku}</h6>
        <p class="text-muted mb-1 small">${productData.name || ''}</p>
        <div class="text-success fw-bold">R$ ${productData.price.toFixed(2)}</div>
      </div>
    </div>
  `;

  const stockInfo = document.getElementById('quantity-stock-info');
  let stockClass = 'text-danger';
  let stockText = 'Sem estoque';

  if (productData.stock_status === 'high') {
    stockClass = 'text-success';
    stockText = `${productData.stock} unidades disponíveis`;
  } else if (productData.stock_status === 'low') {
    stockClass = 'text-warning';
    stockText = `Apenas ${productData.stock} unidades disponíveis`;
  }

  stockInfo.innerHTML = `<small class="${stockClass}"><i class="fas fa-info-circle me-1"></i>${stockText}</small>`;

  document.getElementById('quantity-input').value = 1;
  document.getElementById('quantity-input').max = productData.stock;

  const modal = new bootstrap.Modal(document.getElementById('quantity-modal'));
  modal.show();
}

function increaseQuantity() {
  const input = document.getElementById('quantity-input');
  const currentValue = parseInt(input.value);
  const maxValue = parseInt(input.max);

  if (currentValue < maxValue) {
    input.value = currentValue + 1;
  }
}

function decreaseQuantity() {
  const input = document.getElementById('quantity-input');
  const currentValue = parseInt(input.value);

  if (currentValue > 1) {
    input.value = currentValue - 1;
  }
}

function confirmAddToCart() {
  if (!currentProductData) {
    alert('Erro: dados do produto não encontrados');
    return;
  }

  const quantity = parseInt(document.getElementById('quantity-input').value);
  
  const modal = bootstrap.Modal.getInstance(document.getElementById('quantity-modal'));
  if (modal) modal.hide();
  
  addToCart(currentProductData.id, quantity);
}
</script>
