<% content_for :title, "PDV - Point of Sale" %>

<%# ── Header ──────────────────────────────────────────────────────────────── %>
<div style="background:#161b22; border-bottom:1px solid #21262d; padding:16px 24px;" class="d-flex align-items-center justify-content-between mb-0">
  <div class="d-flex align-items-center gap-3">
    <div style="background:#238636; width:36px; height:36px; border-radius:8px; display:flex; align-items:center; justify-content:center;">
      <i class="fas fa-cash-register" style="color:#fff; font-size:16px;"></i>
    </div>
    <div>
      <h1 style="color:#e6edf3; font-size:1.1rem; font-weight:600; margin:0; line-height:1;">PDV — Ponto de Venda</h1>
      <small style="color:#8b949e; font-size:0.75rem;"><%= current_user.name %> &middot; <%= Time.now.strftime('%H:%M') %></small>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to clients_path, style: "color:#8b949e; background:#21262d; border:1px solid #30363d; border-radius:6px; padding:6px 14px; font-size:0.8rem; text-decoration:none; display:inline-flex; align-items:center; gap:6px;" do %>
      <i class="fas fa-users" style="font-size:12px;"></i>Clientes
    <% end %>
    <%= link_to order_pdvs_path, style: "color:#8b949e; background:#21262d; border:1px solid #30363d; border-radius:6px; padding:6px 14px; font-size:0.8rem; text-decoration:none; display:inline-flex; align-items:center; gap:6px;" do %>
      <i class="fas fa-list" style="font-size:12px;"></i>Pedidos
    <% end %>
  </div>
</div>

<%# ── Corpo principal ─────────────────────────────────────────────────────── %>
<div>
  <div class="row g-4">

    <%# ── Busca de produtos ──────────────────────────────────────────────── %>
    <div class="col-lg-8">
      <div style="background:#161b22; border:1px solid #21262d; border-radius:10px; overflow:hidden;">
        <div style="padding:16px 20px; border-bottom:1px solid #21262d; display:flex; align-items:center; gap:10px;">
          <i class="fas fa-search" style="color:#8b949e; font-size:14px;"></i>
          <span style="color:#e6edf3; font-weight:600; font-size:0.95rem;">Buscar Produtos</span>
        </div>
        <div style="padding:20px;">
          <div class="pos-search-wrap mb-3">
            <i class="fas fa-search pos-search-icon"></i>
            <input type="text" id="product-search"
                   class="pos-search-input"
                   placeholder="Digite SKU ou nome do produto...">
          </div>
          <div id="search-results"></div>
        </div>
      </div>
    </div>

    <%# ── Carrinho ───────────────────────────────────────────────────────── %>
    <div class="col-lg-4">
      <div style="background:#161b22; border:1px solid #21262d; border-radius:10px; overflow:hidden; position:sticky; top:16px;">
        <div style="padding:14px 18px; border-bottom:1px solid #21262d; display:flex; align-items:center; justify-content:space-between;">
          <div class="d-flex align-items-center gap-2">
            <i class="fas fa-shopping-cart" style="color:#8b949e; font-size:14px;"></i>
            <span style="color:#e6edf3; font-weight:600; font-size:0.9rem;">Carrinho</span>
            <span style="background:rgba(35,134,54,.15); color:#3fb950; border:1px solid rgba(35,134,54,.3); border-radius:20px; padding:2px 10px; font-size:0.75rem; font-weight:600;">
              <span id="cart-unique-count"><%= @cart_items.count %></span> prod /
              <span id="cart-total-items"><%= @cart_items.sum { |i| i['quantity'] } %></span> it
            </span>
          </div>
          <button onclick="clearCart()" id="clear-cart-btn"
                  style="background:transparent; border:1px solid #da3633; color:#f85149; border-radius:6px; padding:4px 10px; font-size:0.75rem; cursor:pointer; <%= @cart_items.empty? ? 'display:none;' : '' %>">
            <i class="fas fa-trash me-1"></i>Limpar
          </button>
        </div>
        <div style="padding:16px;" id="cart-items">
          <% if @cart_items.any? %>
            <div id="cart-items-container">
              <% @cart_items.each_with_index do |item, index| %>
                <div class="pos-cart-item" data-product-id="<%= item['product_id'] %>" data-item-index="<%= index %>">
                  <div class="pos-cart-item-inner">
                    <div class="pos-cart-thumb">
                      <% if item['image_url'].present? %>
                        <img src="<%= item['image_url'] %>" alt="<%= item['name'] %>" class="pos-cart-img">
                      <% else %>
                        <i class="fas fa-image" style="color:#8b949e; font-size:18px;"></i>
                      <% end %>
                    </div>
                    <div class="pos-cart-details">
                      <div class="pos-cart-sku"><%= item['sku'] %></div>
                      <div class="pos-cart-name"><%= item['name'].present? ? truncate(item['name'], length: 28) : 'Nome não disponível' %></div>
                      <div class="pos-cart-controls">
                        <div class="pos-qty-controls">
                          <button onclick="updateCartQuantity('<%= item['product_id'] %>', <%= item['quantity'].to_i - 1 %>)" class="pos-qty-btn pos-qty-minus"><i class="fas fa-minus"></i></button>
                          <span class="pos-qty-num"><%= item['quantity'] %></span>
                          <button onclick="updateCartQuantity('<%= item['product_id'] %>', <%= item['quantity'].to_i + 1 %>)" class="pos-qty-btn pos-qty-plus"><i class="fas fa-plus"></i></button>
                        </div>
                        <div class="pos-cart-price">
                          <div class="pos-item-total">R$ <%= sprintf('%.2f', item['price'].to_f * item['quantity'].to_i) %></div>
                          <div class="pos-item-unit">R$ <%= sprintf('%.2f', item['price'].to_f) %> un.</div>
                        </div>
                      </div>
                    </div>
                    <button onclick="removeFromCart('<%= item['product_id'] %>')" class="pos-remove-btn"><i class="fas fa-times"></i></button>
                  </div>
                </div>
              <% end %>
            </div>
            <div id="cart-summary-section">
              <div class="pos-cart-summary">
                <div class="pos-summary-row pos-total-row">
                  <span>Total</span>
                  <span id="final-total-display">R$ <%= sprintf('%.2f', @total) %></span>
                </div>
                <button onclick="openCheckoutModal()" class="pos-checkout-btn">
                  <i class="fas fa-credit-card me-2"></i>Finalizar Venda
                </button>
              </div>
            </div>
          <% else %>
            <div class="pos-empty-cart" id="empty-cart-message">
              <i class="fas fa-shopping-cart pos-empty-icon"></i>
              <div class="pos-empty-title">Carrinho vazio</div>
              <div class="pos-empty-sub">Adicione produtos para começar</div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</div>

<%# ── Modal de Checkout ────────────────────────────────────────────────────── %>
<div id="checkout-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content pos-modal">
      <div class="modal-header pos-modal-header">
        <h5 class="modal-title" style="color:#e6edf3; font-size:1rem; font-weight:600; display:flex; align-items:center; gap:8px;">
          <i class="fas fa-credit-card" style="color:#1f6feb;"></i>Finalizar Venda
        </h5>
        <button type="button" class="btn-close btn-close-white" onclick="closeCheckoutModal()"></button>
      </div>
      <div class="modal-body" style="padding:24px;">
        <form id="checkout-form">
          <div class="row g-4">

            <%# Coluna esquerda %>
            <div class="col-md-6">

              <%# Cliente %>
              <div class="pos-modal-card mb-3">
                <div class="pos-modal-card-header">
                  <i class="fas fa-user-check" style="color:#3fb950; font-size:13px;"></i>
                  <span>Cliente (opcional)</span>
                </div>
                <div class="pos-modal-card-body">
                  <div id="client-search-section">
                    <div class="pos-input-group mb-2">
                      <i class="fas fa-search pos-input-icon"></i>
                      <input type="text" id="client-search-input" class="pos-input pos-input-with-icon"
                             placeholder="Nome, razão social ou CNPJ...">
                    </div>
                    <div id="client-search-results" class="pos-dropdown" style="display:none;"></div>
                  </div>

                  <div id="selected-client-display" style="display:none;"
                       class="d-flex align-items-center justify-content-between pos-client-selected mb-2">
                    <div>
                      <span style="color:#e6edf3; font-weight:600; font-size:0.85rem;" id="selected-client-name"></span>
                      <small style="color:#8b949e; display:block; font-size:0.75rem;" id="selected-client-cnpj"></small>
                    </div>
                    <button type="button" id="clear-client-btn" class="pos-icon-btn pos-icon-btn-danger">
                      <i class="fas fa-times"></i>
                    </button>
                  </div>

                  <input type="hidden" name="client_id" id="checkout-client-id">

                  <button type="button" id="toggle-new-client-form-btn" class="pos-link-btn">
                    <i class="fas fa-plus-circle" style="font-size:11px;"></i>Cadastrar novo cliente
                  </button>

                  <div id="new-client-inline-form" style="display:none;" class="mt-3 pt-3" style="border-top:1px solid #21262d;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span style="color:#e6edf3; font-size:0.8rem; font-weight:600;">Novo Cliente</span>
                      <button type="button" class="btn-close btn-close-white btn-sm" id="close-new-client-form-btn"></button>
                    </div>
                    <div class="row g-2">
                      <div class="col-md-6"><input type="text" id="nc-responsible-name" class="pos-input" placeholder="Nome do Responsável *"></div>
                      <div class="col-md-6"><input type="text" id="nc-business-name" class="pos-input" placeholder="Razão Social"></div>
                      <div class="col-md-4"><input type="text" id="nc-registration" class="pos-input" placeholder="CNPJ"></div>
                      <div class="col-md-4"><input type="text" id="nc-state-registration" class="pos-input" placeholder="Insc. Estadual"></div>
                      <div class="col-md-4"><input type="text" id="nc-municipal-registration" class="pos-input" placeholder="Insc. Municipal"></div>
                      <div class="col-md-6"><input type="email" id="nc-email" class="pos-input" placeholder="E-mail"></div>
                      <div class="col-md-6"><input type="text" id="nc-phone" class="pos-input" placeholder="Telefone"></div>
                      <div class="col-12">
                        <button type="button" id="save-new-client-btn" class="pos-btn pos-btn-green">
                          <i class="fas fa-save me-1"></i>Salvar e Selecionar
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <%# Pagamento %>
              <div class="pos-modal-card">
                <div class="pos-modal-card-header">
                  <i class="fas fa-credit-card" style="color:#1f6feb; font-size:13px;"></i>
                  <span>Pagamento</span>
                  <small style="color:#8b949e; margin-left:auto; font-size:0.75rem;">mínimo 1 parcela</small>
                </div>
                <div class="pos-modal-card-body">
                  <div id="payment-parcels-container"></div>
                  <div class="d-flex justify-content-between align-items-center mt-2 mb-1">
                    <button type="button" onclick="addPaymentParcel()" class="pos-link-btn">
                      <i class="fas fa-plus" style="font-size:11px;"></i>Adicionar Parcela
                    </button>
                    <span style="color:#8b949e; font-size:0.8rem;">
                      Total: <strong style="color:#e6edf3;" id="payment-total-display">R$ 0,00</strong>
                    </span>
                  </div>
                  <div id="payment-validation" style="display:none;">
                    <div class="pos-alert pos-alert-danger mt-2">
                      <i class="fas fa-exclamation-triangle"></i>
                      <span id="payment-validation-message"></span>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <%# Coluna direita %>
            <div class="col-md-6">

              <%# Endereço %>
              <div class="pos-modal-card mb-3">
                <div class="pos-modal-card-header">
                  <i class="fas fa-map-marker-alt" style="color:#d29922; font-size:13px;"></i>
                  <span>Endereço de Entrega</span>
                </div>
                <div class="pos-modal-card-body">
                  <div class="row g-2">
                    <div class="col-md-5">
                      <label class="pos-label">CEP *</label>
                      <input type="text" name="zip" required class="pos-input" placeholder="00000-000" id="cep-input">
                    </div>
                    <div class="col-md-7">
                      <label class="pos-label">Estado *</label>
                      <input type="text" name="state" required id="state-input" class="pos-input" placeholder="SP" maxlength="2">
                    </div>
                    <div class="col-12">
                      <label class="pos-label">Cidade *</label>
                      <input type="text" name="city" required id="city-input" class="pos-input">
                    </div>
                    <div class="col-12">
                      <label class="pos-label">Bairro *</label>
                      <input type="text" name="neighborhood" required id="neighborhood-input" class="pos-input">
                    </div>
                    <div class="col-8">
                      <label class="pos-label">Rua *</label>
                      <input type="text" name="street" required id="street-input" class="pos-input" placeholder="Ex: Rua das Flores">
                    </div>
                    <div class="col-4">
                      <label class="pos-label">Número *</label>
                      <input type="text" name="number" required id="number-input" class="pos-input" placeholder="123">
                    </div>
                    <div class="col-12">
                      <label class="pos-label">Complemento</label>
                      <input type="text" name="complement" class="pos-input" placeholder="Apto 45, Bloco B">
                    </div>
                  </div>
                </div>
              </div>

              <%# Observações %>
              <div class="pos-modal-card">
                <div class="pos-modal-card-header">
                  <i class="fas fa-comment-alt" style="color:#8b949e; font-size:13px;"></i>
                  <span>Observações</span>
                </div>
                <div class="pos-modal-card-body">
                  <textarea name="notes" rows="3" class="pos-input" placeholder="Observações adicionais..."></textarea>
                </div>
              </div>

            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer pos-modal-footer">
        <button type="button" class="pos-btn pos-btn-ghost" onclick="closeCheckoutModal()">Cancelar</button>
        <button type="submit" form="checkout-form" class="pos-btn pos-btn-green" id="finalize-btn">
          <i class="fas fa-check me-1"></i>Finalizar Venda
        </button>
      </div>
    </div>
  </div>
</div>

<%# ── Modal de Quantidade ─────────────────────────────────────────────────── %>
<div id="quantity-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content pos-modal">
      <div class="modal-header pos-modal-header">
        <h5 class="modal-title" style="color:#e6edf3; font-size:0.95rem; font-weight:600; display:flex; align-items:center; gap:8px;">
          <i class="fas fa-cart-plus" style="color:#3fb950;"></i>Adicionar ao Carrinho
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center" style="padding:24px;">
        <div id="selected-product-info" class="mb-3"></div>
        <div class="mb-3">
          <label class="pos-label" style="display:block; margin-bottom:8px;">Quantidade</label>
          <div class="d-flex justify-content-center align-items-center gap-3">
            <button type="button" onclick="decreaseQuantity()" class="pos-qty-btn pos-qty-minus" style="width:36px;height:36px;"><i class="fas fa-minus"></i></button>
            <input type="number" id="quantity-input" value="1" min="1" max="999"
                   class="pos-input text-center" style="width:80px;">
            <button type="button" onclick="increaseQuantity()" class="pos-qty-btn pos-qty-plus" style="width:36px;height:36px;"><i class="fas fa-plus"></i></button>
          </div>
        </div>
        <div id="quantity-stock-info" class="mb-2"></div>
      </div>
      <div class="modal-footer pos-modal-footer">
        <button type="button" class="pos-btn pos-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" id="confirm-add-btn" onclick="confirmAddToCart()" class="pos-btn pos-btn-green">
          <i class="fas fa-cart-plus me-1"></i>Adicionar
        </button>
      </div>
    </div>
  </div>
</div>

<%# ── Loading Overlay ─────────────────────────────────────────────────────── %>
<div id="loading-overlay" class="position-fixed top-0 start-0 w-100 h-100 d-none"
     style="background:rgba(13,17,23,.9); z-index:9999;">
  <div class="d-flex justify-content-center align-items-center h-100">
    <div class="text-center">
      <div class="spinner-border mb-3" style="color:#1f6feb; width:3rem; height:3rem;"></div>
      <h5 style="color:#e6edf3;" id="loading-message">Processando...</h5>
    </div>
  </div>
</div>

<%# ── Styles ──────────────────────────────────────────────────────────────── %>
<% content_for :styles do %>
<style>
  /* ── Base ── */
  body { color:#e6edf3; }

  /* ── Search ── */
  .pos-search-wrap { position:relative; }
  .pos-search-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#8b949e; font-size:15px; pointer-events:none; }
  .pos-search-input { width:100%; background:#0d1117; border:1px solid #30363d; border-radius:8px; color:#e6edf3; padding:12px 14px 12px 42px; font-size:0.95rem; outline:none; transition:border-color .2s; }
  .pos-search-input::placeholder { color:#8b949e; }
  .pos-search-input:focus { border-color:#1f6feb; box-shadow:0 0 0 3px rgba(31,111,235,.15); }

  /* ── Product card ── */
  .pos-product-item { background:#0d1117; border:1px solid #21262d; border-radius:8px; padding:14px; margin-bottom:10px; display:flex; align-items:flex-start; gap:14px; transition:border-color .2s, background .2s; }
  .pos-product-item:hover { border-color:#30363d; background:#161b22; }
  .pos-product-thumb { width:64px; height:80px; border-radius:6px; overflow:hidden; background:#21262d; border:1px solid #30363d; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .pos-product-thumb img { width:100%; height:100%; object-fit:cover; }
  .pos-product-sku { color:#3fb950; font-weight:700; font-size:0.85rem; margin-bottom:2px; }
  .pos-product-name { color:#e6edf3; font-size:0.82rem; margin-bottom:6px; line-height:1.3; }
  .pos-product-price { color:#79c0ff; font-weight:700; font-size:0.95rem; margin-bottom:6px; }
  .pos-product-option { background:rgba(31,111,235,.15); color:#79c0ff; border:1px solid rgba(31,111,235,.3); border-radius:12px; padding:2px 8px; font-size:0.7rem; font-weight:600; margin-right:4px; display:inline-block; }
  .pos-add-btn { background:#238636; color:#fff; border:none; border-radius:6px; padding:8px 14px; font-size:0.78rem; font-weight:600; cursor:pointer; transition:background .2s; white-space:nowrap; }
  .pos-add-btn:hover:not(:disabled) { background:#2ea043; }
  .pos-add-btn:disabled { background:#21262d; color:#8b949e; cursor:not-allowed; }

  /* ── Stock badge ── */
  .pos-stock-badge { display:inline-flex; align-items:center; gap:5px; border-radius:20px; padding:3px 10px; font-size:0.72rem; font-weight:600; border:1px solid; text-transform:uppercase; letter-spacing:.4px; }
  .pos-stock-high { background:rgba(35,134,54,.15); color:#3fb950; border-color:rgba(35,134,54,.4); }
  .pos-stock-low { background:rgba(210,153,34,.15); color:#d29922; border-color:rgba(210,153,34,.4); }
  .pos-stock-out { background:rgba(218,54,51,.15); color:#f85149; border-color:rgba(218,54,51,.4); }
  .pos-stock-qty { color:#8b949e; font-size:0.78rem; }

  /* ── Cart item ── */
  .pos-cart-item { background:#0d1117; border:1px solid #21262d; border-radius:8px; margin-bottom:8px; transition:border-color .15s; }
  .pos-cart-item:hover { border-color:#30363d; }
  .pos-cart-item-inner { display:flex; align-items:flex-start; gap:10px; padding:10px; }
  .pos-cart-thumb { width:44px; height:54px; border-radius:5px; overflow:hidden; background:#21262d; display:flex; align-items:center; justify-content:center; flex-shrink:0; border:1px solid #30363d; }
  .pos-cart-img { width:100%; height:100%; object-fit:cover; }
  .pos-cart-details { flex:1; min-width:0; }
  .pos-cart-sku { color:#3fb950; font-weight:700; font-size:0.78rem; margin-bottom:1px; }
  .pos-cart-name { color:#e6edf3; font-size:0.75rem; margin-bottom:7px; line-height:1.2; }
  .pos-cart-controls { display:flex; justify-content:space-between; align-items:center; }
  .pos-qty-controls { display:flex; align-items:center; gap:6px; }
  .pos-qty-btn { width:22px; height:22px; border-radius:4px; border:1px solid #30363d; background:#21262d; color:#e6edf3; display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:0.65rem; transition:background .15s; }
  .pos-qty-minus:hover { background:#da3633; border-color:#da3633; }
  .pos-qty-plus:hover { background:#238636; border-color:#238636; }
  .pos-qty-num { background:rgba(31,111,235,.15); border:1px solid rgba(31,111,235,.3); border-radius:4px; padding:1px 8px; color:#e6edf3; font-size:0.78rem; font-weight:600; min-width:28px; text-align:center; }
  .pos-item-total { color:#79c0ff; font-weight:700; font-size:0.82rem; }
  .pos-item-unit { color:#8b949e; font-size:0.68rem; }
  .pos-remove-btn { width:24px; height:24px; background:#da3633; border:none; border-radius:4px; color:#fff; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:0.7rem; flex-shrink:0; transition:background .15s; }
  .pos-remove-btn:hover { background:#b91c1c; }

  /* ── Cart summary ── */
  .pos-cart-summary { background:#0d1117; border:1px solid #21262d; border-radius:8px; padding:14px; margin-top:12px; }
  .pos-summary-row { display:flex; justify-content:space-between; align-items:center; color:#8b949e; font-size:0.85rem; margin-bottom:6px; }
  .pos-total-row { border-top:1px solid #21262d; padding-top:10px; margin-top:10px; font-weight:700; font-size:1rem; color:#e6edf3; }
  .pos-total-row span:last-child { color:#79c0ff; font-size:1.05rem; }
  .pos-checkout-btn { width:100%; background:#238636; color:#fff; border:none; padding:11px; border-radius:8px; font-weight:600; font-size:0.95rem; margin-top:12px; cursor:pointer; transition:background .2s; }
  .pos-checkout-btn:hover { background:#2ea043; }

  /* ── Empty cart ── */
  .pos-empty-cart { text-align:center; padding:40px 20px; }
  .pos-empty-icon { font-size:2.5rem; color:#30363d; display:block; margin-bottom:12px; }
  .pos-empty-title { color:#8b949e; font-size:0.95rem; font-weight:600; margin-bottom:4px; }
  .pos-empty-sub { color:#6e7681; font-size:0.8rem; }

  /* ── Modal ── */
  .pos-modal { background:#161b22; border:1px solid #21262d; border-radius:12px; }
  .pos-modal-header { background:#161b22; border-bottom:1px solid #21262d; padding:16px 20px; }
  .pos-modal-footer { background:#161b22; border-top:1px solid #21262d; padding:14px 20px; }
  .pos-modal-card { background:#0d1117; border:1px solid #21262d; border-radius:8px; overflow:hidden; }
  .pos-modal-card-header { padding:10px 14px; border-bottom:1px solid #21262d; display:flex; align-items:center; gap:8px; color:#e6edf3; font-size:0.85rem; font-weight:600; background:#161b22; }
  .pos-modal-card-body { padding:14px; }

  /* ── Form elements ── */
  .pos-input { background:#0d1117; border:1px solid #30363d; border-radius:6px; color:#e6edf3; padding:8px 12px; font-size:0.85rem; width:100%; outline:none; transition:border-color .15s; }
  .pos-input::placeholder { color:#6e7681; }
  .pos-input:focus { border-color:#1f6feb; box-shadow:0 0 0 3px rgba(31,111,235,.12); }
  .pos-input-group { position:relative; }
  .pos-input-icon { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#8b949e; font-size:13px; pointer-events:none; }
  .pos-input-with-icon { padding-left:36px; }
  .pos-label { color:#8b949e; font-size:0.78rem; margin-bottom:4px; display:block; }

  /* ── Buttons ── */
  .pos-btn { border-radius:6px; padding:8px 16px; font-size:0.85rem; font-weight:600; cursor:pointer; transition:background .15s, border-color .15s; border:1px solid transparent; display:inline-flex; align-items:center; gap:6px; }
  .pos-btn-green { background:#238636; color:#fff; border-color:#238636; }
  .pos-btn-green:hover { background:#2ea043; }
  .pos-btn-ghost { background:transparent; color:#8b949e; border-color:#30363d; }
  .pos-btn-ghost:hover { background:#21262d; color:#e6edf3; }
  .pos-link-btn { background:transparent; border:none; color:#1f6feb; font-size:0.8rem; cursor:pointer; padding:0; display:inline-flex; align-items:center; gap:5px; }
  .pos-link-btn:hover { color:#79c0ff; }
  .pos-icon-btn { width:28px; height:28px; border-radius:6px; border:1px solid; background:transparent; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:12px; }
  .pos-icon-btn-danger { border-color:rgba(218,54,51,.5); color:#f85149; }
  .pos-icon-btn-danger:hover { background:rgba(218,54,51,.15); }

  /* ── Payment parcel ── */
  .payment-parcel-item { background:#161b22; border:1px solid #21262d; border-radius:8px; padding:12px; margin-bottom:8px; }
  .payment-parcel-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; }
  .payment-parcel-number { background:rgba(31,111,235,.15); color:#1f6feb; padding:3px 8px; border-radius:4px; font-size:0.72rem; font-weight:600; }
  .pos-dropdown { border:1px solid #21262d; border-radius:8px; background:#161b22; overflow:hidden; max-height:200px; overflow-y:auto; }
  .pos-dropdown-item { padding:10px 14px; cursor:pointer; border-bottom:1px solid #21262d; transition:background .15s; }
  .pos-dropdown-item:last-child { border-bottom:none; }
  .pos-dropdown-item:hover { background:#21262d; }
  .pos-client-selected { background:#0d1117; border:1px solid rgba(35,134,54,.4); border-radius:8px; padding:10px 12px; }

  /* ── Alerts ── */
  .pos-alert { border-radius:6px; padding:8px 12px; font-size:0.8rem; display:flex; align-items:center; gap:8px; }
  .pos-alert-danger { background:rgba(218,54,51,.12); border:1px solid rgba(218,54,51,.3); color:#f85149; }
  .pos-alert-warning { background:rgba(210,153,34,.12); border:1px solid rgba(210,153,34,.3); color:#d29922; }
  .pos-alert-success { background:rgba(35,134,54,.12); border:1px solid rgba(35,134,54,.3); color:#3fb950; }

  /* ── Loading btn ── */
  .btn-loading { position:relative; color:transparent !important; pointer-events:none; }
  .btn-loading::after { content:""; position:absolute; width:14px; height:14px; top:50%; left:50%; margin:-7px 0 0 -7px; border:2px solid #fff; border-radius:50%; border-top-color:transparent; animation:spin 1s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }

  /* ── Animations ── */
  .pos-fade-in { animation:posFade .3s ease; }
  @keyframes posFade { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }

  /* ── Responsive ── */
  @media (max-width:992px) { [style*="position:sticky"] { position:relative !important; top:auto !important; } }
  @media (max-width:768px) {
    .pos-product-item { flex-wrap:wrap; }
    .pos-product-thumb { width:80px; height:100px; }
    .pos-cart-item-inner { flex-wrap:wrap; }
  }
  
  /* ── Form selects dark ── */
  select.pos-input { background-color:#0d1117 !important; }
  select.pos-input option { background:#161b22; color:#e6edf3; }
</style>
<% end %>

<%# ── JavaScript ──────────────────────────────────────────────────────────── %>
<script>
// ── Globals ────────────────────────────────────────────────────────────────
let selectedProduct  = null;
let searchTimeout    = null;
let paymentParcels   = [];
let clientSearchTimeout = null;

// ── Init ───────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {
  setupEventListeners();
  setupClientSearch();
  addPaymentParcel();
  setupFormValidation();
});

// ── Event listeners ────────────────────────────────────────────────────────
function setupEventListeners() {
  const searchInput = document.getElementById('product-search');
  if (searchInput) {
    searchInput.addEventListener('input', function (e) {
      const query = e.target.value.trim();
      clearTimeout(searchTimeout);
      if (query.length < 2) {
        clearSearchResults();
        return;
      }
      searchTimeout = setTimeout(() => searchProducts(query), 500);
    });

    searchInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        clearTimeout(searchTimeout);
        const query = e.target.value.trim();
        if (query.length >= 2) searchProducts(query);
      }
    });
  }

  const checkoutForm = document.getElementById('checkout-form');
  if (checkoutForm) checkoutForm.addEventListener('submit', handleCheckoutSubmit);

  const cepInput = document.getElementById('cep-input');
  if (cepInput) {
    cepInput.addEventListener('blur', function (e) {
      const cep = e.target.value.replace(/\D/g, '');
      if (cep.length === 8) lookupAddress(cep);
    });
  }

  const quantityInput = document.getElementById('quantity-input');
  if (quantityInput) {
    quantityInput.addEventListener('change', function (e) {
      if (parseInt(e.target.value) < 1) e.target.value = 1;
      updateQuantityStockInfo();
    });
  }
}

function hasItemsInCart() {
  const cartUniqueCount = document.getElementById('cart-unique-count');
  return cartUniqueCount ? parseInt(cartUniqueCount.textContent) > 0 : false;
}

// ── Form validation ────────────────────────────────────────────────────────
function setupFormValidation() {
  document.querySelectorAll('input[required], select[required]').forEach(field => {
    field.addEventListener('blur', () => validateField(field));
    field.addEventListener('input', () => {
      if (field.classList.contains('is-invalid')) validateField(field);
    });
  });
}

function validateField(field) {
  if (field.checkValidity()) {
    field.classList.remove('is-invalid');
    field.classList.add('is-valid');
    return true;
  } else {
    field.classList.remove('is-valid');
    field.classList.add('is-invalid');
    return false;
  }
}

// ── Client search & selection ──────────────────────────────────────────────
function setupClientSearch() {
  const input = document.getElementById('client-search-input');
  if (!input) return;

  input.addEventListener('input', function () {
    clearTimeout(clientSearchTimeout);
    const q = this.value.trim();
    if (q.length < 2) {
      document.getElementById('client-search-results').style.display = 'none';
      return;
    }
    clientSearchTimeout = setTimeout(() => searchClients(q), 300);
  });

  document.addEventListener('click', function (e) {
    if (!e.target.closest('#client-search-section')) {
      document.getElementById('client-search-results').style.display = 'none';
    }
  });

  document.getElementById('clear-client-btn')?.addEventListener('click', clearSelectedClient);

  document.getElementById('toggle-new-client-form-btn')?.addEventListener('click', function () {
    document.getElementById('new-client-inline-form').style.display = 'block';
    this.style.display = 'none';
  });

  document.getElementById('close-new-client-form-btn')?.addEventListener('click', function () {
    document.getElementById('new-client-inline-form').style.display = 'none';
    document.getElementById('toggle-new-client-form-btn').style.display = 'inline-flex';
  });

  document.getElementById('save-new-client-btn')?.addEventListener('click', saveAndSelectNewClient);
}

function searchClients(query) {
  fetch(`/clients/search?q=${encodeURIComponent(query)}`)
    .then(r => r.json())
    .then(data => {
      const resultsEl = document.getElementById('client-search-results');
      resultsEl.innerHTML = '';

      if (!data.success || data.clients.length === 0) {
        resultsEl.innerHTML = '<div class="pos-dropdown-item" style="color:#8b949e; font-size:0.82rem;">Nenhum cliente encontrado</div>';
        resultsEl.style.display = 'block';
        return;
      }

      data.clients.forEach(client => {
        const item = document.createElement('div');
        item.className = 'pos-dropdown-item';
        item.innerHTML = `
          <div style="color:#e6edf3; font-size:0.85rem; font-weight:600;">${client.display_name}</div>
          <small style="color:#8b949e; font-size:0.75rem;">${client.registration || ''}${client.city ? ' · ' + client.city : ''}</small>`;
        item.addEventListener('click', () => selectClient(client));
        resultsEl.appendChild(item);
      });

      resultsEl.style.display = 'block';
    })
    .catch(err => console.error('Erro ao buscar clientes:', err));
}

function selectClient(client) {
  document.getElementById('checkout-client-id').value          = client.id;
  document.getElementById('selected-client-name').textContent  = client.display_name;
  document.getElementById('selected-client-cnpj').textContent  = client.registration || '';
  document.getElementById('selected-client-display').style.display = 'flex';
  document.getElementById('client-search-input').value         = '';
  document.getElementById('client-search-results').style.display = 'none';

  if (client.email)         setFieldIfEmpty('checkout-email', client.email);
  if (client.phone)         setFieldIfEmpty('checkout-phone', client.phone);
  if (client.street)        setFieldIfEmpty('street-input', client.street);
  if (client.number)        setFieldIfEmpty('number-input', client.number);
  if (client.city)          setFieldIfEmpty('city-input', client.city);
  if (client.state)         setFieldIfEmpty('state-input', client.state);
  if (client.zip)           setFieldIfEmpty('cep-input', client.zip);
  if (client.neighbourhood) setFieldIfEmpty('neighborhood-input', client.neighbourhood);
}

function setFieldIfEmpty(id, value) {
  const el = document.getElementById(id);
  if (el && !el.value) el.value = value;
}

function clearSelectedClient() {
  document.getElementById('checkout-client-id').value = '';
  document.getElementById('selected-client-display').style.display = 'none';
  document.getElementById('client-search-input').value = '';
}

function saveAndSelectNewClient() {
  const responsibleName = document.getElementById('nc-responsible-name').value.trim();
  if (!responsibleName) {
    showNotification('Nome do Responsável é obrigatório.', 'warning');
    return;
  }

  const payload = {
    client: {
      responsible_name:       responsibleName,
      business_name:          document.getElementById('nc-business-name').value,
      registration:           document.getElementById('nc-registration').value,
      state_registration:     document.getElementById('nc-state-registration').value,
      municipal_registration: document.getElementById('nc-municipal-registration').value,
      email:                  document.getElementById('nc-email').value,
      phone:                  document.getElementById('nc-phone').value
    }
  };

  const saveBtn = document.getElementById('save-new-client-btn');
  if (saveBtn) { saveBtn.classList.add('btn-loading'); saveBtn.disabled = true; }

  fetch('/clients', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
      'Accept': 'application/json'
    },
    body: JSON.stringify(payload)
  })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        selectClient(data.client);
        document.getElementById('new-client-inline-form').style.display = 'none';
        document.getElementById('toggle-new-client-form-btn').style.display = 'inline-flex';
        ['nc-responsible-name','nc-business-name','nc-registration',
         'nc-state-registration','nc-municipal-registration','nc-email','nc-phone']
          .forEach(id => { document.getElementById(id).value = ''; });
        showNotification('Cliente cadastrado e selecionado!', 'success');
      } else {
        showNotification('Erro ao salvar cliente:\n' + (data.errors || []).join('\n'), 'error');
      }
    })
    .catch(() => showNotification('Erro de comunicação ao salvar cliente.', 'error'))
    .finally(() => {
      if (saveBtn) { saveBtn.classList.remove('btn-loading'); saveBtn.disabled = false; }
    });
}

// ── Product search ─────────────────────────────────────────────────────────
function searchProducts(query) {
  showSearchLoading();

  fetch('/pos/search_product', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ query: query })
  })
    .then(response => {
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      return response.json();
    })
    .then(data => displaySearchResults(data.products || []))
    .catch(() => showSearchError('Erro ao buscar produtos. Tente novamente.'));
}

function showSearchLoading() {
  const el = document.getElementById('search-results');
  if (el) el.innerHTML = `
    <div class="text-center py-5">
      <div class="spinner-border mb-3" style="color:#1f6feb; width:2rem; height:2rem;"></div>
      <p style="color:#8b949e; font-size:0.85rem;">Buscando produtos...</p>
    </div>`;
}

function showSearchError(message) {
  const el = document.getElementById('search-results');
  if (el) el.innerHTML = `<div class="pos-alert pos-alert-danger"><i class="fas fa-exclamation-triangle"></i>${message}</div>`;
}

function clearSearchResults() {
  const el = document.getElementById('search-results');
  if (el) el.innerHTML = '';
}

function displaySearchResults(products) {
  const container = document.getElementById('search-results');
  if (!container) return;

  if (!products || products.length === 0) {
    container.innerHTML = `
      <div class="text-center py-5" style="color:#8b949e;">
        <i class="fas fa-search" style="font-size:2.5rem; opacity:.3; display:block; margin-bottom:12px;"></i>
        <div style="font-size:0.95rem; color:#e6edf3; margin-bottom:4px;">Nenhum produto encontrado</div>
        <div style="font-size:0.82rem;">Tente buscar por SKU, nome ou características do produto</div>
      </div>`;
    return;
  }

  container.innerHTML = products.map(product => {
    const stockQty    = parseInt(product.stock || 0);
    const stockStatus = product.stock_status || 'out';
    const location    = product.location || 'Online Store';
    const available   = stockQty > 0;
    const badgeCls    = { high: 'pos-stock-high', low: 'pos-stock-low', out: 'pos-stock-out' }[stockStatus] || 'pos-stock-out';
    const stockText   = stockQty === 0 || stockStatus === 'out' ? 'Sem Estoque' : stockStatus === 'low' ? 'Estoque Baixo' : 'Em Estoque';
    const imgHtml     = product.image_url
      ? `<img src="${product.image_url}" alt="${product.name || product.sku}">`
      : `<i class="fas fa-image" style="color:#8b949e; font-size:20px;"></i>`;

    return `
      <div class="pos-product-item pos-fade-in" data-product-id="${product.id}">
        <div class="pos-product-thumb">${imgHtml}</div>
        <div class="flex-grow-1" style="min-width:0;">
          <div class="pos-product-sku">${product.sku}</div>
          <div class="pos-product-name">${product.name || 'Nome não disponível'}</div>
          <div class="pos-product-price">R$ ${parseFloat(product.price || 0).toFixed(2)}</div>
          ${product.option1 || product.option2 || product.option3 ? `<div class="mb-1">
            ${product.option1 ? `<span class="pos-product-option">${product.option1}</span>` : ''}
            ${product.option2 ? `<span class="pos-product-option">${product.option2}</span>` : ''}
            ${product.option3 ? `<span class="pos-product-option">${product.option3}</span>` : ''}
          </div>` : ''}
          <div class="d-flex align-items-center gap-2 mt-1">
            <span class="pos-stock-badge ${badgeCls}">${stockText}</span>
            ${available ? `<span class="pos-stock-qty">${stockQty} un.</span>` : ''}
            <small style="color:#6e7681; font-size:0.7rem;"><i class="fas fa-store" style="margin-right:3px;"></i>${location}</small>
          </div>
        </div>
        <div style="flex-shrink:0;">
          <button onclick="openQuantityModal('${product.id}','${product.sku}','${(product.name || '').replace(/'/g,"\\'")}',${product.price || 0},'${product.image_url || ''}',${stockQty})"
                  class="pos-add-btn" ${available ? '' : 'disabled'}>
            <i class="fas fa-cart-plus" style="margin-right:5px;"></i>${available ? 'Adicionar' : 'Sem Estoque'}
          </button>
        </div>
      </div>`;
  }).join('');
}

// ── Quantity modal ─────────────────────────────────────────────────────────
function openQuantityModal(productId, sku, name, price, imageUrl, stockQuantity) {
  selectedProduct = { id: productId, sku, name, price: parseFloat(price), image_url: imageUrl, stock_quantity: parseInt(stockQuantity) };

  const productInfo = document.getElementById('selected-product-info');
  if (productInfo) {
    const imgHtml = imageUrl
      ? `<img src="${imageUrl}" alt="${name}" style="width:70px;height:90px;object-fit:cover;border-radius:6px;border:1px solid #21262d;" class="mb-2">`
      : `<div style="width:70px;height:90px;background:#21262d;border-radius:6px;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;"><i class="fas fa-image" style="color:#8b949e;"></i></div>`;
    productInfo.innerHTML = `
      ${imgHtml}
      <div style="color:#3fb950; font-weight:700; font-size:0.85rem;">${sku}</div>
      <div style="color:#e6edf3; font-size:0.8rem; margin:2px 0 6px;">${name || 'Nome não disponível'}</div>
      <div style="color:#79c0ff; font-weight:700;">R$ ${parseFloat(price).toFixed(2)}</div>`;
  }

  const quantityInput = document.getElementById('quantity-input');
  if (quantityInput) { quantityInput.value = 1; quantityInput.max = stockQuantity; }

  updateQuantityStockInfo();
  new bootstrap.Modal(document.getElementById('quantity-modal')).show();
}

function updateQuantityStockInfo() {
  if (!selectedProduct) return;

  const quantityInput = document.getElementById('quantity-input');
  const stockInfo     = document.getElementById('quantity-stock-info');
  const confirmBtn    = document.getElementById('confirm-add-btn');
  if (!quantityInput || !stockInfo || !confirmBtn) return;

  const requested = parseInt(quantityInput.value);
  const available = selectedProduct.stock_quantity;

  if (requested > available) {
    stockInfo.innerHTML = `<div class="pos-alert pos-alert-warning"><i class="fas fa-exclamation-triangle"></i>Excede o estoque disponível (${available})</div>`;
    confirmBtn.disabled = true;
    quantityInput.value = available;
  } else {
    stockInfo.innerHTML = `<div class="pos-alert pos-alert-success"><i class="fas fa-check-circle"></i>${available} unidades disponíveis</div>`;
    confirmBtn.disabled = false;
  }
}

function increaseQuantity() {
  const input = document.getElementById('quantity-input');
  if (input && parseInt(input.value) < parseInt(input.max)) {
    input.value = parseInt(input.value) + 1;
    updateQuantityStockInfo();
  }
}

function decreaseQuantity() {
  const input = document.getElementById('quantity-input');
  if (input && parseInt(input.value) > 1) {
    input.value = parseInt(input.value) - 1;
    updateQuantityStockInfo();
  }
}

function confirmAddToCart() {
  if (!selectedProduct) return;

  const quantity  = parseInt(document.getElementById('quantity-input').value);
  if (quantity < 1 || quantity > selectedProduct.stock_quantity) return;

  const confirmBtn = document.getElementById('confirm-add-btn');
  if (confirmBtn) { confirmBtn.classList.add('btn-loading'); confirmBtn.disabled = true; }

  fetch('/pos/add_to_cart', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ product_id: selectedProduct.id, quantity })
  })
    .then(r => { if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`); return r.json(); })
    .then(data => {
      if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('quantity-modal'))?.hide();
        updateCartDisplay(data.cart_items, data.total);
        showNotification('Produto adicionado ao carrinho!', 'success');
      } else {
        throw new Error(data.error || 'Erro ao adicionar produto ao carrinho');
      }
    })
    .catch(error => showNotification(error.message || 'Erro ao adicionar produto ao carrinho', 'error'))
    .finally(() => {
      if (confirmBtn) { confirmBtn.classList.remove('btn-loading'); confirmBtn.disabled = false; }
    });
}

// ── Cart display ───────────────────────────────────────────────────────────
function updateCartDisplay(cartItems, total) {
  const totalItems  = cartItems.reduce((sum, item) => sum + parseInt(item.quantity), 0);
  const uniqueItems = cartItems.length;

  const cartUniqueCount   = document.getElementById('cart-unique-count');
  const cartTotalItems    = document.getElementById('cart-total-items');
  const finalTotalDisplay = document.getElementById('final-total-display');

  if (cartUniqueCount)   cartUniqueCount.textContent  = uniqueItems;
  if (cartTotalItems)    cartTotalItems.textContent    = totalItems;
  if (finalTotalDisplay) finalTotalDisplay.textContent = `R$ ${parseFloat(total).toFixed(2)}`;

  const cartItemsContainer = document.getElementById('cart-items-container');
  const emptyCartMessage   = document.getElementById('empty-cart-message');
  const cartSummarySection = document.getElementById('cart-summary-section');
  const clearCartBtn       = document.getElementById('clear-cart-btn');
  const cartItemsElement   = document.getElementById('cart-items');

  if (cartItems.length === 0) {
    if (cartItemsContainer) cartItemsContainer.style.display = 'none';
    if (cartSummarySection) cartSummarySection.style.display = 'none';
    if (clearCartBtn)       clearCartBtn.style.display = 'none';
    if (emptyCartMessage) {
      emptyCartMessage.style.display = 'block';
    } else if (cartItemsElement) {
      cartItemsElement.innerHTML = `
        <div class="pos-empty-cart" id="empty-cart-message">
          <i class="fas fa-shopping-cart pos-empty-icon"></i>
          <div class="pos-empty-title">Carrinho vazio</div>
          <div class="pos-empty-sub">Adicione produtos para começar</div>
        </div>`;
    }
  } else {
    if (emptyCartMessage) emptyCartMessage.style.display = 'none';
    if (cartSummarySection) cartSummarySection.style.display = 'block';
    if (clearCartBtn) clearCartBtn.style.display = 'inline-flex';

    if (cartItemsContainer) {
      cartItemsContainer.style.display = 'block';
      cartItemsContainer.innerHTML = generateCartItemsHtml(cartItems);
    } else if (cartItemsElement) {
      cartItemsElement.innerHTML = `
        <div id="cart-items-container">${generateCartItemsHtml(cartItems)}</div>
        <div id="cart-summary-section">
          <div class="pos-cart-summary">
            <div class="pos-summary-row pos-total-row">
              <span>Total</span>
              <span id="final-total-display">R$ ${parseFloat(total).toFixed(2)}</span>
            </div>
            <button onclick="openCheckoutModal()" class="pos-checkout-btn">
              <i class="fas fa-credit-card" style="margin-right:8px;"></i>Finalizar Venda
            </button>
          </div>
        </div>`;
    }
  }
}

function generateCartItemsHtml(cartItems) {
  return cartItems.map((item, index) => {
    const imageHtml  = item.image_url
      ? `<img src="${item.image_url}" alt="${item.name}" class="pos-cart-img">`
      : `<i class="fas fa-image" style="color:#8b949e; font-size:16px;"></i>`;
    const itemTotal  = parseFloat(item.price) * parseInt(item.quantity);

    return `
      <div class="pos-cart-item" data-product-id="${item.product_id}" data-item-index="${index}">
        <div class="pos-cart-item-inner">
          <div class="pos-cart-thumb">${imageHtml}</div>
          <div class="pos-cart-details">
            <div class="pos-cart-sku">${item.sku}</div>
            <div class="pos-cart-name">${item.name || 'Nome não disponível'}</div>
            <div class="pos-cart-controls">
              <div class="pos-qty-controls">
                <button onclick="updateCartQuantity('${item.product_id}', ${parseInt(item.quantity) - 1})" class="pos-qty-btn pos-qty-minus"><i class="fas fa-minus"></i></button>
                <span class="pos-qty-num">${item.quantity}</span>
                <button onclick="updateCartQuantity('${item.product_id}', ${parseInt(item.quantity) + 1})" class="pos-qty-btn pos-qty-plus"><i class="fas fa-plus"></i></button>
              </div>
              <div class="pos-cart-price">
                <div class="pos-item-total">R$ ${itemTotal.toFixed(2)}</div>
                <div class="pos-item-unit">R$ ${parseFloat(item.price).toFixed(2)} un.</div>
              </div>
            </div>
          </div>
          <button onclick="removeFromCart('${item.product_id}')" class="pos-remove-btn"><i class="fas fa-times"></i></button>
        </div>
      </div>`;
  }).join('');
}

// ── Cart actions ───────────────────────────────────────────────────────────
function updateCartQuantity(productId, newQuantity) {
  if (newQuantity < 1) { removeFromCart(productId); return; }

  fetch('/pos/update_cart_quantity', {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') },
    body: JSON.stringify({ product_id: productId, quantity: newQuantity })
  })
    .then(r => { if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`); return r.json(); })
    .then(data => { if (data.success) updateCartDisplay(data.cart_items, data.total); else throw new Error(data.error); })
    .catch(error => showNotification(error.message || 'Erro ao atualizar quantidade', 'error'));
}

function removeFromCart(productId) {
  fetch('/pos/remove_from_cart', {
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') },
    body: JSON.stringify({ product_id: productId })
  })
    .then(r => { if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`); return r.json(); })
    .then(data => { if (data.success) { updateCartDisplay(data.cart_items, data.total); showNotification('Produto removido do carrinho', 'success'); } else throw new Error(data.error); })
    .catch(error => showNotification(error.message || 'Erro ao remover produto', 'error'));
}

function clearCart() {
  if (!confirm('Tem certeza que deseja limpar o carrinho?')) return;

  fetch('/pos/clear_cart', {
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') }
  })
    .then(r => { if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`); return r.json(); })
    .then(data => { if (data.success) { updateCartDisplay([], 0); showNotification('Carrinho limpo', 'success'); } else throw new Error(data.error); })
    .catch(error => showNotification(error.message || 'Erro ao limpar carrinho', 'error'));
}

// ── Checkout modal ─────────────────────────────────────────────────────────
function openCheckoutModal() {
  if (!hasItemsInCart()) {
    showNotification('Adicione produtos ao carrinho antes de finalizar a venda', 'warning');
    return;
  }
  updatePaymentTotal();
  new bootstrap.Modal(document.getElementById('checkout-modal')).show();
}

function closeCheckoutModal() {
  bootstrap.Modal.getInstance(document.getElementById('checkout-modal'))?.hide();
}

// ── Payment parcels ────────────────────────────────────────────────────────
function addPaymentParcel() {
  const container = document.getElementById('payment-parcels-container');
  if (!container) return;

  const parcelNumber = paymentParcels.length + 1;
  const parcelId     = `parcel-${Date.now()}-${parcelNumber}`;

  container.insertAdjacentHTML('beforeend', `
    <div class="payment-parcel-item" data-parcel-id="${parcelId}">
      <div class="payment-parcel-header">
        <span class="payment-parcel-number">Parcela ${parcelNumber}</span>
        ${parcelNumber > 1 ? `<button type="button" onclick="removePaymentParcel('${parcelId}')" style="background:transparent; border:1px solid rgba(218,54,51,.4); color:#f85149; border-radius:4px; padding:3px 8px; font-size:0.72rem; cursor:pointer;"><i class="fas fa-trash"></i></button>` : ''}
      </div>
      <div class="row g-2">
        <div class="col-md-6">
          <select name="payment_parcels[${parcelNumber - 1}][payment_method]"
                  class="pos-input" required onchange="updatePaymentTotal()" style="background:#0d1117 !important;">
            <option value="">Método de Pagamento</option>
            <option value="dinheiro">Dinheiro</option>
            <option value="cartao_credito">Cartão de Crédito</option>
            <option value="cartao_debito">Cartão de Débito</option>
            <option value="pix">PIX</option>
            <option value="transferencia">Transferência</option>
            <option value="cheque">Cheque</option>
          </select>
        </div>
        <div class="col-md-6">
          <input type="number" name="payment_parcels[${parcelNumber - 1}][amount]"
                 step="0.01" min="0.01" placeholder="Valor (R$)"
                 class="pos-input" required onchange="updatePaymentTotal()">
        </div>
        <div class="col-12">
          <input type="text" name="payment_parcels[${parcelNumber - 1}][notes]"
                 placeholder="Observações (opcional)" class="pos-input">
        </div>
      </div>
    </div>`);

  paymentParcels.push({ id: parcelId, number: parcelNumber });
  updatePaymentTotal();
}

function removePaymentParcel(parcelId) {
  document.querySelector(`[data-parcel-id="${parcelId}"]`)?.remove();
  paymentParcels = paymentParcels.filter(p => p.id !== parcelId);

  document.querySelectorAll('.payment-parcel-item').forEach((parcel, index) => {
    const numberSpan = parcel.querySelector('.payment-parcel-number');
    if (numberSpan) numberSpan.textContent = `Parcela ${index + 1}`;
    parcel.querySelectorAll('input, select').forEach(input => {
      const name = input.getAttribute('name');
      if (name && name.includes('payment_parcels['))
        input.setAttribute('name', name.replace(/payment_parcels\[\d+\]/, `payment_parcels[${index}]`));
    });
  });

  updatePaymentTotal();
}

function updatePaymentTotal() {
  let total = 0;
  document.querySelectorAll('input[name*="[amount]"]').forEach(input => { total += parseFloat(input.value) || 0; });

  const el = document.getElementById('payment-total-display');
  if (el) el.textContent = `R$ ${total.toFixed(2)}`;
  validatePaymentTotal(total);
}

function validatePaymentTotal(paymentTotal) {
  const finalTotalEl         = document.getElementById('final-total-display');
  const paymentValidation    = document.getElementById('payment-validation');
  const paymentValidationMsg = document.getElementById('payment-validation-message');
  if (!finalTotalEl || !paymentValidation || !paymentValidationMsg) return true;

  const cartTotal  = parseFloat(finalTotalEl.textContent.replace('R$ ', '').replace(',', '.'));
  const difference = Math.abs(cartTotal - paymentTotal);

  if (difference > 0.01) {
    paymentValidation.style.display = 'block';
    paymentValidationMsg.textContent = paymentTotal > cartTotal
      ? `Pagamento (R$ ${paymentTotal.toFixed(2)}) maior que o total (R$ ${cartTotal.toFixed(2)})`
      : `Pagamento (R$ ${paymentTotal.toFixed(2)}) menor que o total (R$ ${cartTotal.toFixed(2)})`;
    return false;
  }

  paymentValidation.style.display = 'none';
  return true;
}

// ── Checkout submit ────────────────────────────────────────────────────────
function handleCheckoutSubmit(e) {
  e.preventDefault();

  let paymentTotal = 0;
  document.querySelectorAll('input[name*="[amount]"]').forEach(input => { paymentTotal += parseFloat(input.value) || 0; });

  if (!validatePaymentTotal(paymentTotal)) { showNotification('Corrija os valores de pagamento antes de continuar', 'error'); return; }
  if (paymentTotal === 0) { showNotification('Configure pelo menos uma forma de pagamento', 'error'); return; }

  const form      = e.target;
  const formData  = new FormData(form);
  const orderData = {};

  for (let [key, value] of formData.entries()) {
    if (key.includes('payment_parcels[')) {
      if (!orderData.payment_parcels) orderData.payment_parcels = [];
      const match = key.match(/payment_parcels\[(\d+)\]\[(\w+)\]/);
      if (match) {
        const index = parseInt(match[1]);
        const field = match[2];
        if (!orderData.payment_parcels[index]) orderData.payment_parcels[index] = {};
        orderData.payment_parcels[index][field] = value;
      }
    } else {
      orderData[key] = value;
    }
  }

  showLoadingOverlay('Criando pedido...');

  const submitBtn = document.getElementById('finalize-btn');
  if (submitBtn) { submitBtn.classList.add('btn-loading'); submitBtn.disabled = true; }

  fetch('/pos/create_order', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') },
    body: JSON.stringify(orderData)
  })
    .then(r => { if (!r.ok) throw new Error(`HTTP error! status: ${r.status}`); return r.json(); })
    .then(data => {
      if (data.success) {
        closeCheckoutModal();
        showNotification(data.message, 'success', 5000);
        form.reset();
        paymentParcels = [];
        updateCartDisplay([], 0);
        clearSelectedClient();
        const container = document.getElementById('payment-parcels-container');
        if (container) container.innerHTML = '';
        setTimeout(() => addPaymentParcel(), 100);
        if (confirm('Pedido criado com sucesso! Deseja visualizar o pedido?')) {
          window.open(`/order_pdvs/${data.order_id}`, '_blank');
        }
      } else {
        throw new Error(data.error || 'Erro ao criar pedido');
      }
    })
    .catch(error => showNotification(error.message || 'Erro ao processar pedido', 'error'))
    .finally(() => {
      hideLoadingOverlay();
      if (submitBtn) { submitBtn.classList.remove('btn-loading'); submitBtn.disabled = false; }
    });
}

// ── CEP lookup ─────────────────────────────────────────────────────────────
function lookupAddress(cep) {
  fetch(`https://viacep.com.br/ws/${cep}/json/`)
    .then(r => r.json())
    .then(data => {
      if (data.erro) throw new Error('CEP não encontrado');
      setFieldIfEmpty('state-input',        data.uf         || '');
      setFieldIfEmpty('city-input',         data.localidade || '');
      setFieldIfEmpty('neighborhood-input', data.bairro     || '');
      setFieldIfEmpty('street-input',       data.logradouro || '');
      showNotification('Endereço preenchido automaticamente', 'success');
    })
    .catch(() => showNotification('Erro ao buscar endereço. Verifique o CEP.', 'warning'));
}

// ── Loading overlay ────────────────────────────────────────────────────────
function showLoadingOverlay(message = 'Carregando...') {
  const overlay = document.getElementById('loading-overlay');
  const msg     = document.getElementById('loading-message');
  if (overlay) { overlay.classList.remove('d-none'); overlay.classList.add('d-flex'); }
  if (msg) msg.textContent = message;
}

function hideLoadingOverlay() {
  const overlay = document.getElementById('loading-overlay');
  if (overlay) { overlay.classList.remove('d-flex'); overlay.classList.add('d-none'); }
}

// ── Notifications ──────────────────────────────────────────────────────────
function showNotification(message, type = 'info', duration = 3000) {
  const colorMap = { success: '#3fb950', error: '#f85149', warning: '#d29922', info: '#79c0ff' };
  const iconMap  = { success: 'fas fa-check-circle', error: 'fas fa-exclamation-triangle', warning: 'fas fa-exclamation-triangle', info: 'fas fa-info-circle' };
  const color    = colorMap[type] || colorMap.info;
  const icon     = iconMap[type]  || iconMap.info;

  const el = document.createElement('div');
  el.style.cssText = `position:fixed; top:20px; right:20px; z-index:10000; min-width:280px; max-width:420px;
    background:#161b22; border:1px solid #21262d; border-left:3px solid ${color};
    border-radius:8px; padding:12px 16px; box-shadow:0 8px 24px rgba(0,0,0,.4);
    display:flex; align-items:center; gap:10px; animation:posFade .3s ease;`;
  el.innerHTML = `
    <i class="${icon}" style="color:${color}; font-size:15px; flex-shrink:0;"></i>
    <span style="color:#e6edf3; font-size:0.85rem; flex:1;">${message}</span>
    <button onclick="this.parentElement.remove()" style="background:none; border:none; color:#8b949e; cursor:pointer; padding:0; font-size:16px; line-height:1;">&times;</button>`;
  document.body.appendChild(el);
  setTimeout(() => { if (el.parentNode) el.remove(); }, duration);
}

// ── Utilities ──────────────────────────────────────────────────────────────
function truncate(str, length) {
  if (!str) return '';
  return str.length > length ? str.substring(0, length) + '...' : str;
}
