<% content_for :title, "PDV - Point of Sale" %>

<div class="container-fluid py-4">
  <% title 'PDV - Point of Sale' %>
  
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-success shadow">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-cash-register me-2"></i>PDV - Ponto de Venda
          </h5>
          <div class="d-flex gap-3">
            <span class="badge bg-success text-dark px-3 py-2">
              <i class="fas fa-user me-1"></i><%= current_user.name %>
            </span>
            <span class="badge bg-info text-dark px-3 py-2">
              <i class="fas fa-clock me-1"></i> <%= Time.now.strftime('%H:%M') %>
            </span>
            <%= link_to order_pdvs_path, class: "btn btn-outline-light btn-sm" do %>
              <i class="fas fa-list me-1"></i>Gerenciar Pedidos
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-4">
              <div class="card bg-black border border-primary h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-white mb-0">
                      <i class="fas fa-shopping-cart me-2"></i>Carrinho Atual
                    </h6>
                    <span class="badge bg-primary" id="cart-count-badge"><%= @cart_items.sum { |item| item['quantity'] } %> itens</span>
                  </div>
                  <div class="text-center">
                    <div class="h3 text-primary mb-0" id="cart-total-display">R$ <%= sprintf('%.2f', @total) %></div>
                    <small class="text-light">Total do carrinho</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card bg-black border border-warning h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-white mb-0">
                      <i class="fas fa-search me-2"></i>Busca Inteligente
                    </h6>
                    <span class="badge bg-warning text-dark">
                      <i class="fas fa-database me-1"></i>Multi-Location
                    </span>
                  </div>
                  <div class="text-center">
                    <div class="h6 text-warning mb-0">Estoque por Loja</div>
                    <small class="text-light">Verificação em tempo real</small>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card bg-black border border-success h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="text-white mb-0">
                      <i class="fas fa-tags me-2"></i>Cupons de Desconto
                    </h6>
                    <span class="badge bg-success text-dark" id="coupon-status-badge">
                      <i class="fas fa-ticket-alt me-1"></i>Disponível
                    </span>
                  </div>
                  <div class="text-center">
                    <div class="h6 text-success mb-0" id="coupon-discount-display">R$ 0,00</div>
                    <small class="text-light">Desconto aplicado</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card bg-black border border-dark shadow mb-4">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-search me-2"></i>Buscar Produtos
            <small class="text-success ms-2">
              <i class="fas fa-store me-1"></i>Estoque por Location em Tempo Real
            </small>
          </h5>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-8">
              <input type="text" id="product-search" placeholder="Digite SKU ou nome do produto..."
                     class="form-control form-control-lg bg-dark text-white border-secondary">
            </div>
            <div class="col-md-4">
              <select id="store-type-select" class="form-select form-select-lg bg-dark text-white border-secondary store-select">
                <option value="lagoa_seca" data-color="lagoa-seca">● Lagoa Seca</option>
                <option value="bh_shopping" data-color="bh-shopping">● BH Shopping</option>
                <option value="rj" data-color="barra-shopping">● Barra Shopping (RJ)</option>
                <option value="online" data-color="online">● Online Store</option>
              </select>
            </div>
          </div>
          
          <div id="search-results" class="mt-4"></div>
        </div>
      </div>
    </div>
    
    <div class="col-lg-4">
      <div class="card bg-black border border-dark shadow position-sticky mb-4" style="top: 20px;">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-shopping-cart me-2"></i>Carrinho 
            <small class="text-success">(<span id="cart-unique-count"><%= @cart_items.count %></span> produtos, <span id="cart-total-items"><%= @cart_items.sum { |item| item['quantity'] } %></span> itens)</small>
          </h5>
          <button onclick="clearCart()" class="btn btn-outline-danger btn-sm" id="clear-cart-btn" style="<%= @cart_items.empty? ? 'display: none;' : '' %>">
            <i class="fas fa-trash me-1"></i>Limpar
          </button>
        </div>
        <div class="card-body">
          <div class="mb-3" id="coupon-section">
            <div class="d-flex gap-2 mb-2">
              <input type="text" id="coupon-input" placeholder="Código do cupom..."
                     class="form-control form-control-sm bg-dark text-white border-secondary">
              <button onclick="searchCoupon()" class="btn btn-success btn-sm" id="search-coupon-btn">
                <i class="fas fa-search"></i>
              </button>
            </div>
            <div id="coupon-result" class="mt-2"></div>
          </div>
          
          <div id="cart-items">
            <% if @cart_items.any? %>
              <div id="cart-items-container">
                <% @cart_items.each_with_index do |item, index| %>
                  <div class="cart-item-card mb-2" data-product-id="<%= item['product_id'] %>" data-item-index="<%= index %>">
                    <div class="cart-item-content">
                      <div class="cart-item-image">
                        <% if item['image_url'].present? %>
                          <img src="<%= item['image_url'] %>" alt="<%= item['name'] %>" class="cart-product-image">
                        <% else %>
                          <div class="cart-image-placeholder">
                            <i class="fas fa-image"></i>
                          </div>
                        <% end %>
                      </div>
                      
                      <div class="cart-item-details">
                        <div class="cart-item-sku"><%= item['sku'] %></div>
                        <div class="cart-item-name">
                          <% if item['name'].present? %>
                            <%= truncate(item['name'], length: 25) %>
                          <% else %>
                            Nome não disponível
                          <% end %>
                        </div>
                        
                        <div class="cart-item-controls">
                          <div class="quantity-controls">
                            <button onclick="updateCartQuantity('<%= item['product_id'] %>', <%= item['quantity'].to_i - 1 %>)" class="quantity-btn quantity-minus">
                              <i class="fas fa-minus"></i>
                            </button>
                            <span class="quantity-display"><%= item['quantity'] %></span>
                            <button onclick="updateCartQuantity('<%= item['product_id'] %>', <%= item['quantity'].to_i + 1 %>)" class="quantity-btn quantity-plus">
                              <i class="fas fa-plus"></i>
                            </button>
                          </div>
                          
                          <div class="cart-item-price">
                            <div class="item-total">R$ <%= sprintf('%.2f', item['price'].to_f * item['quantity'].to_i) %></div>
                            <div class="item-unit-price">R$ <%= sprintf('%.2f', item['price'].to_f) %> cada</div>
                          </div>
                        </div>
                      </div>
                      
                      <button onclick="removeFromCart('<%= item['product_id'] %>')" class="cart-remove-btn">
                        <i class="fas fa-times"></i>
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>
              
              <div id="cart-summary-section">
                <div class="cart-summary">
                  <div class="summary-row">
                    <span>Subtotal:</span>
                    <span id="subtotal-display">R$ <%= sprintf('%.2f', @total) %></span>
                  </div>
                  <div class="summary-row coupon-row" id="coupon-discount-row" style="display: none;">
                    <span class="text-success">Desconto (Cupom):</span>
                    <span class="text-success" id="coupon-discount-amount">R$ 0,00</span>
                  </div>
                  <div class="summary-row total-row">
                    <span>Total:</span>
                    <span id="final-total-display">R$ <%= sprintf('%.2f', @total) %></span>
                  </div>
                  
                  <button onclick="openCheckoutModal()" class="checkout-btn">
                    <i class="fas fa-credit-card me-2"></i>Finalizar Venda
                  </button>
                </div>
              </div>
            <% else %>
              <div class="empty-cart" id="empty-cart-message">
                <div class="empty-cart-icon">
                  <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="empty-cart-text">Carrinho vazio</div>
                <div class="empty-cart-subtext">Adicione produtos para começar</div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Confirmação de Mudança de Loja -->
<div id="store-change-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark border-warning">
      <div class="modal-header border-warning">
        <h5 class="modal-title text-warning">
          <i class="fas fa-exclamation-triangle me-2"></i>Mudança de Loja
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="text-center mb-3">
          <i class="fas fa-store fa-3x text-warning mb-3"></i>
          <h6 class="text-white">Atenção!</h6>
        </div>
        <div class="alert alert-warning" role="alert">
          <div class="d-flex align-items-start">
            <i class="fas fa-info-circle me-2 mt-1"></i>
            <div>
              <strong>Você possui itens no carrinho!</strong><br>
              Ao mudar de loja, todos os itens do carrinho serão removidos, pois os produtos podem ter estoques diferentes em cada localização.
            </div>
          </div>
        </div>
        <div class="text-center">
          <p class="text-light mb-0">
            <strong>De:</strong> <span id="current-store-name" class="text-info"></span><br>
            <strong>Para:</strong> <span id="new-store-name" class="text-success"></span>
          </p>
        </div>
      </div>
      <div class="modal-footer border-warning">
        <button type="button" class="btn btn-secondary" onclick="cancelStoreChange()">
          <i class="fas fa-times me-1"></i>Cancelar
        </button>
        <button type="button" class="btn btn-warning" onclick="confirmStoreChange()">
          <i class="fas fa-check me-1"></i>Confirmar Mudança
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Checkout -->
<div id="checkout-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">
          <i class="fas fa-credit-card me-2"></i>Finalizar Venda
        </h5>
        <button type="button" class="btn-close btn-close-white" onclick="closeCheckoutModal()"></button>
      </div>
      <div class="modal-body">
        <form id="checkout-form">
          <div class="row">
            <div class="col-md-6">
              <div class="card bg-black border-secondary mb-3">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Configurações da Venda</h6>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Loja *</label>
                      <select name="store_type" id="checkout-store-type" class="form-select bg-dark text-white border-secondary store-select" required>
                        <option value="">Selecione a loja</option>
                        <option value="lagoa_seca" data-color="lagoa-seca">● Lagoa Seca</option>
                        <option value="bh_shopping" data-color="bh-shopping">● BH Shopping</option>
                        <option value="rj" data-color="barra-shopping">● Barra Shopping (RJ)</option>
                        <option value="online" data-color="online">● Online Store</option>
                      </select>
                    </div>
                    
                    <div class="col-12 mb-3">
                      <div class="card bg-dark border-info">
                        <div class="card-header bg-info text-dark">
                          <h6 class="mb-0">
                            <i class="fas fa-credit-card me-2"></i>Configurar Pagamento
                            <small class="ms-2">(Mínimo 1 parcela)</small>
                          </h6>
                        </div>
                        <div class="card-body">
                          <div id="payment-parcels-container">
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-3">
                            <button type="button" onclick="addPaymentParcel()" class="btn btn-outline-info btn-sm">
                              <i class="fas fa-plus me-1"></i>Adicionar Parcela
                            </button>
                            <div class="text-info">
                              <small>
                                <i class="fas fa-info-circle me-1"></i>
                                Total: <span id="payment-total-display">R$ 0,00</span>
                              </small>
                            </div>
                          </div>
                          <div id="payment-validation" class="mt-2" style="display: none;">
                            <div class="alert alert-danger py-2 mb-0">
                              <small>
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                <span id="payment-validation-message"></span>
                              </small>
                            </div>
                          </div>
                          <div class="mt-2">
                            <small class="text-muted">
                              <i class="fas fa-lightbulb me-1"></i>
                              <strong>Dica:</strong> Para pagamento único, adicione apenas 1 parcela com o valor total.
                            </small>
                          </div>
                        </div>
                      </div>
                    </div>
                    
                    <div class="col-12">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="integrate-shopify" name="integrate_shopify" checked>
                        <label class="form-check-label text-white" for="integrate-shopify">
                          <i class="fas fa-sync me-2"></i>Integrar automaticamente com Shopify
                        </label>
                        <div class="form-text text-info">
                          <small>Pedido será integrado automaticamente após criação</small>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="card bg-black border-secondary mb-3">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Dados do Cliente</h6>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Nome Completo *</label>
                      <input type="text" name="customer_name" required class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Email *</label>
                      <input type="email" name="customer_email" required class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label text-white">Telefone *</label>
                      <input type="tel" name="customer_phone" required class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label text-white">CPF *</label>
                      <input type="text" name="customer_cpf" required class="form-control bg-dark text-white border-secondary">
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="card bg-black border-secondary mb-3">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Endereço de Entrega</h6>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label text-white">CEP *</label>
                      <input type="text" name="zip" required class="form-control bg-dark text-white border-secondary" placeholder="00000-000" id="cep-input">
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label text-white">Estado *</label>
                      <input type="text" name="state" required class="form-control bg-dark text-white border-secondary" placeholder="SP" maxlength="2" id="state-input">
                    </div>
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Cidade *</label>
                      <input type="text" name="city" required class="form-control bg-dark text-white border-secondary" id="city-input">
                    </div>
                    <div class="col-12 mb-3">
                      <label class="form-label text-white">Bairro *</label>
                      <input type="text" name="neighborhood" required class="form-control bg-dark text-white border-secondary" id="neighborhood-input">
                    </div>
                    <div class="col-md-8 mb-3">
                      <label class="form-label text-white">Rua *</label>
                      <input type="text" name="street" required class="form-control bg-dark text-white border-secondary" placeholder="Ex: Rua das Flores" id="street-input">
                    </div>
                    <div class="col-md-4 mb-3">
                      <label class="form-label text-white">Número *</label>
                      <input type="text" name="number" required class="form-control bg-dark text-white border-secondary" placeholder="123" id="number-input">
                    </div>
                    <div class="col-12">
                      <label class="form-label text-white">Complemento</label>
                      <input type="text" name="complement" class="form-control bg-dark text-white border-secondary" placeholder="Ex: Apto 45, Bloco B">
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="card bg-black border-secondary mb-3">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Desconto Adicional (Opcional)</h6>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label text-white">Valor do Desconto (R$)</label>
                      <input type="number" name="discount_amount" step="0.01" min="0" class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label text-white">Motivo do Desconto</label>
                      <input type="text" name="discount_reason" class="form-control bg-dark text-white border-secondary">
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="card bg-black border-secondary">
                <div class="card-header bg-secondary">
                  <h6 class="text-white mb-0">Observações</h6>
                </div>
                <div class="card-body">
                  <textarea name="notes" rows="3" class="form-control bg-dark text-white border-secondary" placeholder="Observações adicionais..."></textarea>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" onclick="closeCheckoutModal()">
          Cancelar
        </button>
        <button type="submit" form="checkout-form" class="btn btn-success" id="finalize-btn">
          <i class="fas fa-check me-1"></i>Finalizar Venda
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Quantidade -->
<div id="quantity-modal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">
          <i class="fas fa-plus-circle me-2"></i>Adicionar ao Carrinho
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <div id="selected-product-info" class="mb-3">
        </div>
        
        <div class="mb-3">
          <label class="form-label text-white">Quantidade:</label>
          <div class="d-flex justify-content-center align-items-center gap-3">
            <button type="button" onclick="decreaseQuantity()" class="btn btn-outline-secondary btn-sm">
              <i class="fas fa-minus"></i>
            </button>
            <input type="number" id="quantity-input" value="1" min="1" max="999"
                   class="form-control form-control-sm bg-dark text-white border-secondary text-center"
                   style="width: 80px;">
            <button type="button" onclick="increaseQuantity()" class="btn btn-outline-secondary btn-sm">
              <i class="fas fa-plus"></i>
            </button>
          </div>
        </div>
        
        <div id="quantity-stock-info" class="mb-3">
        </div>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button" id="confirm-add-btn" onclick="confirmAddToCart()" class="btn btn-success">
          <i class="fas fa-cart-plus me-1"></i>Adicionar ao Carrinho
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Loading Overlay -->
<div id="loading-overlay" class="position-fixed top-0 start-0 w-100 h-100 d-none"
     style="background: rgba(0,0,0,0.8); z-index: 9999;">
  <div class="d-flex justify-content-center align-items-center h-100">
    <div class="text-center">
      <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
      <h5 class="text-white" id="loading-message">Processando...</h5>
    </div>
  </div>
</div>

<% content_for :styles do %>
  <style>
    body {
      background-color: #121212;
      color: #f8f9fa;
    }
    
    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2) !important;
    }
    
    .bg-black {
      background-color: #121212 !important;
    }
    
    .form-control.bg-dark {
      background-color: #212529 !important;
      border-color: #495057;
    }
    
    .form-control.bg-dark:focus {
      background-color: #212529 !important;
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    .form-select.bg-dark {
      background-color: #212529 !important;
      border-color: #495057;
    }
    
    .form-select.bg-dark:focus {
      background-color: #212529 !important;
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    .modal-content.bg-dark {
      background-color: #212529 !important;
    }
    
    .form-check-input {
      background-color: #495057;
      border-color: #6c757d;
    }
    
    .form-check-input:checked {
      background-color: #198754;
      border-color: #198754;
    }
    
    .form-check-input:focus {
      border-color: #86b7fe;
      box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    /* Cart Item Styles */
    .cart-item-card {
      background: #2d3748;
      border: 1px solid #4a5568;
      border-radius: 8px;
