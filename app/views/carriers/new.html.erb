<% content_for :title, "Nova Transportadora" %>
<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon 'fas fa-truck' %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title">Nova Transportadora</h1>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
      <%= link_to carriers_path, class: "btn-back" do %><i class="fas fa-arrow-left me-1"></i>Voltar<% end %>
    </div>
  </div>
  <%= render 'form' %>
</div>
