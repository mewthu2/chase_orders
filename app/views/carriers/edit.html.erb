<% content_for :title, "Editar Transportadora" %>
<div class="users-container">
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title"><i class="fas fa-truck me-2"></i>Editar Transportadora</h1>
      <p class="page-subtitle"><%= @carrier.name %></p>
    </div>
    <div class="header-actions">
      <%= link_to carriers_path, class: "btn-back" do %><i class="fas fa-arrow-left me-1"></i>Voltar<% end %>
    </div>
  </div>
  <%= render 'form' %>
</div>
