<% content_for :title, "Setores" %>

<div class="users-container">
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title"><i class="fas fa-building me-2"></i>Setores</h1>
      <p class="page-subtitle">Agrupam as responsabilidades; em Perfis e Permissões você escolhe quais setores cada perfil enxerga</p>
    </div>
    <div class="header-actions">
      <%= link_to new_ticket_sector_path, class: "btn-export" do %><i class="fas fa-plus me-2"></i>Novo Setor<% end %>
    </div>
  </div>

  <div class="table-card">
    <% if @sectors.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Descrição</th>
              <th>Responsabilidades</th>
              <th>Perfis que enxergam</th>
              <th class="text-center">Status</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @sectors.each do |sector| %>
              <tr>
                <td class="text-main"><%= sector.name %></td>
                <td class="text-muted-custom"><%= truncate(sector.description, length: 90) %></td>
                <td class="text-muted-custom"><%= sector.ticket_responsabilities.map(&:name).sort.to_sentence.presence || '—' %></td>
                <td class="text-muted-custom"><%= sector.profiles.map(&:name).sort.to_sentence.presence || 'Só administradores' %></td>
                <td class="text-center">
                  <span class="status-pill <%= sector.active? ? 'status-pill--active' : 'status-pill--inactive' %>"><%= sector.active? ? 'Ativo' : 'Inativo' %></span>
                </td>
                <td class="text-end">
                  <div class="table-actions">
                    <%= link_to edit_ticket_sector_path(sector), class: "action-btn action-btn--edit", title: "Editar" do %><i class="fas fa-pencil-alt"></i><% end %>
                    <%= button_to ticket_sector_path(sector), method: :delete, class: "action-btn action-btn--danger", title: "Excluir",
                                  form: { onsubmit: "return confirm('Excluir este setor?')" } do %><i class="fas fa-trash"></i><% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="ticket-empty">
        <i class="fas fa-building"></i>
        <p>Nenhum setor cadastrado ainda.</p>
      </div>
    <% end %>
  </div>
</div>
