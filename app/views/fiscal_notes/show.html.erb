<% content_for :title, "Nota Fiscal #{@fiscal_note.number}" %>
<% note = @fiscal_note %>
<%# Nota de produção de empresa em homologação: os botões de envio dão lugar ao aviso com o link para ligar a produção. %>
<% locked_action = if !note.production_blocked? then nil
                   elsif note.emittable? && screen_can?(:fiscal_notes, :execute) then 'Emitir na SEFAZ'
                   elsif note.transmittable? then 'Transmitir à SEFAZ'
                   elsif note.regenerable? && note.shopify_order_name.blank? && screen_can?(:fiscal_notes, :create) then 'Gerar nova nota'
                   end %>

<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon 'fas fa-file-invoice' %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title">NF-e <%= note.number %> / <%= note.series %></h1>
        <p class="page-subtitle"><%= fiscal_note_status_pill(note) %> <span class="ms-2"><%= note.environment_label %></span></p>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
      <%= link_to fiscal_notes_path, class: "btn-back" do %><i class="fas fa-arrow-left me-1"></i>Voltar<% end %>
      <% if note.consultable? %>
        <%= button_to consult_fiscal_note_path(note), method: :post, class: "btn-back", form: { class: 'd-inline' } do %><i class="fas fa-sync-alt me-1"></i>Consultar na SEFAZ<% end %>
      <% end %>
      <% if note.transmittable? && !locked_action %>
        <%= button_to transmit_fiscal_note_path(note), method: :post, class: "btn-sefaz", form: { class: 'd-inline', data: { turbo_submits_with: 'Enviando…' } } do %><i class="fas fa-paper-plane me-2"></i>Transmitir à SEFAZ<% end %>
      <% end %>
      <% if note.emittable? && !locked_action && screen_can?(:fiscal_notes, :execute) %>
        <%= button_to transmit_fiscal_note_path(note), method: :post, class: "btn-sefaz",
                      form: { class: 'd-inline', data: { hc_confirm: { title: "Emitir a NF-e nº #{note.number} na SEFAZ?",
                                                                      text: (note.producao? ? 'Ela passa a valer como documento fiscal.' : 'Homologação: sem valor fiscal.'),
                                                                      ok: 'Emitir', no: 'Voltar', icon: 'fas fa-paper-plane' }.to_json } } do %><i class="fas fa-paper-plane me-2"></i>Emitir na SEFAZ<% end %>
      <% end %>
      <% if note.regenerable? && !locked_action && screen_can?(:fiscal_notes, :create) %>
        <%= button_to regenerate_fiscal_note_path(note), method: :post, class: "btn-export",
                      form: { class: 'd-inline', data: { hc_confirm: { title: 'Gerar uma nova nota no lugar desta?',
                                                                      text: 'A nova nota é gerada e assinada, mas não vai à SEFAZ: você confere e emite depois.',
                                                                      ok: 'Gerar nova nota', no: 'Voltar', icon: 'fas fa-file-circle-plus' }.to_json } } do %><i class="fas fa-file-circle-plus me-2"></i>Gerar nova nota<% end %>
      <% end %>
      <% if note.rejeitada? && note.shopify_order_name.present? %>
        <%= link_to shopify_fiscal_notes_path(order: note.shopify_order_name), class: "btn-export" do %><i class="fas fa-redo me-2"></i>Corrigir e emitir de novo<% end %>
      <% end %>
      <% if note.cancelable? && screen_can?(:fiscal_notes, :destroy) %>
        <a href="#cancelar" class="btn btn-danger nf-cancel-open">Cancelar na SEFAZ</a>
      <% end %>
      <% if note.cancel_xml.attached? %>
        <%= link_to cancel_xml_fiscal_note_path(note), class: "btn-export" do %><i class="fas fa-file-circle-xmark me-2"></i>XML do cancelamento<% end %>
      <% end %>
      <% if note.xml_available? %>
        <%= link_to danfe_fiscal_note_path(note), class: "btn-export", data: { turbo: false } do %><i class="fas fa-file-pdf me-2"></i>Baixar DANFE<% end %>
        <%= link_to xml_fiscal_note_path(note), class: "btn-export" do %><i class="fas fa-download me-2"></i>Baixar XML<% end %>
      <% end %>
    </div>
  </div>

  <% if locked_action %>
    <%= render 'fiscal_notes/production_lock', company: note.company, label: locked_action %>
  <% end %>

  <% if note.cancelada? %>
    <div class="sefaz-result sefaz-result--bad nf-canceled">
      <div class="sefaz-result__icon"><i class="fas fa-ban"></i></div>
      <div>
        <div class="sefaz-result__text">Cancelada na SEFAZ<%= ' (homologação)' if note.homologacao? %><%= ": #{note.cancel_reason}" if note.cancel_reason.present? %></div>
        <div class="sefaz-result__code">
          <% if note.cancel_protocol.present? %>Protocolo do cancelamento <%= note.cancel_protocol %><% end %>
          <% if note.canceled_at %> · <%= note.canceled_at.in_time_zone.strftime('%d/%m/%Y %H:%M:%S') %><% end %>
          <% if note.canceled_by.present? %> · por <%= note.canceled_by %><% end %>
          <% if note.sefaz_status_code.present? %> · <%= note.sefaz_status_code %> <%= note.sefaz_message %><% end %>
        </div>
      </div>
    </div>
  <% elsif note.autorizada? %>
    <div class="sefaz-result sefaz-result--ok">
      <div class="sefaz-result__icon"><i class="fas fa-check"></i></div>
      <div>
        <div class="sefaz-result__text">Autorizada pela SEFAZ<%= ' — sem valor fiscal (homologação)' if note.homologacao? %></div>
        <div class="sefaz-result__code">Protocolo <%= note.protocol %> · <%= note.authorized_at&.in_time_zone&.strftime('%d/%m/%Y %H:%M:%S') %></div>
      </div>
    </div>
  <% elsif note.rejeitada? || note.erro? %>
    <div class="sefaz-result sefaz-result--bad">
      <div class="sefaz-result__icon"><i class="fas fa-times"></i></div>
      <div>
        <div class="sefaz-result__text"><%= note.error_message.presence || note.sefaz_message %></div>
        <div class="sefaz-result__code">
          <%= note.erro? ? 'Sem resposta definitiva da SEFAZ: consulte antes de transmitir de novo.' : "Código #{note.sefaz_status_code}" %>
        </div>
      </div>
    </div>
  <% elsif note.rascunho? %>
    <div class="sefaz-result sefaz-result--wait">
      <div class="sefaz-result__icon"><i class="fas fa-file-circle-check"></i></div>
      <div>
        <div class="sefaz-result__text">Gerada e não emitida</div>
        <div class="sefaz-result__code">Confira o DANFE e o XML. Quando estiver certo, use “Emitir na SEFAZ”. Nada é emitido sozinho.</div>
      </div>
    </div>
  <% elsif note.assinada? %>
    <div class="sefaz-result sefaz-result--wait">
      <div class="sefaz-result__icon"><i class="fas fa-hourglass-half"></i></div>
      <div>
        <div class="sefaz-result__text">Assinada, ainda não autorizada</div>
        <div class="sefaz-result__code">Use “Transmitir à SEFAZ” para pedir a autorização.</div>
      </div>
    </div>
  <% end %>

  <% if note.cancelable? && screen_can?(:fiscal_notes, :destroy) %>
    <% hours = note.authorized_at ? ((Time.current - note.authorized_at) / 3600).floor : nil %>
    <div class="form-section nf-cancel" id="cancelar" <%= 'data-open' if params[:cancelar].present? %>>
      <div class="form-section-header"><h5 class="form-section-title"><i class="fas fa-ban me-2"></i>Cancelar na SEFAZ</h5></div>
      <div class="form-section-body">
        <p class="text-muted-custom mb-2">
          O cancelamento vai direto para a SEFAZ e não tem volta: a nota deixa de valer, e o número não é reaproveitado.
          <% if hours %>
            Autorizada há <strong><%= hours < 1 ? 'menos de 1 hora' : pluralize(hours, 'hora', plural: 'horas') %></strong>.
            <% if note.within_cancel_window? %>
              Dentro do prazo normal de 24 horas (até <%= note.cancel_deadline.in_time_zone.strftime('%d/%m/%Y às %H:%M') %>).
            <% else %>
              <span class="nf-cancel__late"><i class="fas fa-clock"></i> Passou do prazo normal de 24 horas: a SEFAZ pode recusar ou aceitar como cancelamento fora do prazo (pode haver multa, conforme o estado).</span>
            <% end %>
          <% end %>
        </p>
        <%# Confirmação do Honey (data-hc-confirm): o turbo_confirm não pergunta nada com o Drive desligado. %>
        <%= form_with url: cancel_fiscal_note_path(note), method: :post, local: true,
                      data: { hc_confirm: { title: "Cancelar a NF-e nº #{note.number} na SEFAZ?",
                                            text: "Série #{note.series}#{', homologação' if note.homologacao?}. A nota deixa de valer e não dá para desfazer.",
                                            ok: 'Sim, cancelar a nota', no: 'Voltar', danger: true, icon: 'fas fa-ban' }.to_json } do %>
          <label class="field-label" for="nfCancelReason">Motivo do cancelamento</label>
          <textarea name="reason" id="nfCancelReason" class="field-input" rows="3" minlength="15" maxlength="255" required
                    placeholder="Ex.: Nota emitida com a natureza de operação errada; será emitida outra no lugar."></textarea>
          <div class="nf-cancel__foot">
            <span class="text-muted-custom" id="nfCancelCount">0 / 255 · mínimo de 15 caracteres</span>
            <button type="submit" class="btn btn-danger nf-cancel__btn" id="nfCancelSubmit" disabled>Cancelar a nota na SEFAZ</button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>


  <div class="form-section">
    <div class="form-section-header"><h5 class="form-section-title"><i class="fas fa-info-circle me-2"></i>Dados da nota</h5></div>
    <div class="form-section-body">
      <div class="form-grid">
        <div class="form-col-6"><label class="field-label">Empresa emissora</label><div class="text-main"><%= note.company.legal_name %> (<%= note.company.cnpj_formatted %>)</div></div>
        <div class="form-col-6">
          <label class="field-label">Pedido</label>
          <div class="text-main">
            <% if fiscal_note_order_path(note) %><%= link_to fiscal_note_order_label(note), fiscal_note_order_path(note), target: (note.order ? '_blank' : nil) %><% else %><%= fiscal_note_order_label(note) %><% end %>
          </div>
        </div>
        <div class="form-col-12"><label class="field-label">Chave de acesso</label><div class="text-main"><%= note.access_key.presence || '-' %></div></div>
        <div class="form-col-4"><label class="field-label">Finalidade</label><div class="text-main"><% fin = FiscalNote::PURPOSES[note.purpose] %><span class="ticket-status" style="--c: <%= hc_tone(fin[1]) %>" data-tip="<%= fin[0] %>: <%= fin[2] %>"><%= fin[0] %></span></div></div>
        <div class="form-col-4"><label class="field-label">Natureza da operação</label><div class="text-main"><%= note.operation_nature.presence || '-' %></div></div>
        <div class="form-col-4"><label class="field-label">CFOP</label><div class="text-main"><%= note.cfop_summary.presence || '-' %></div></div>
        <div class="form-col-4"><label class="field-label">Valor total</label><div class="text-main"><%= number_to_currency(note.total_value, unit: 'R$', separator: ',', delimiter: '.', format: '%u %n') %></div></div>
        <div class="form-col-4"><label class="field-label">Ambiente</label><div class="text-main"><%= note.environment_label %></div></div>
        <div class="form-col-4"><label class="field-label">Protocolo de autorização</label><div class="text-main"><%= note.protocol.presence || 'Não autorizada' %></div></div>
        <div class="form-col-4"><label class="field-label">Emitida em</label><div class="text-main"><%= (note.issued_at || note.created_at).in_time_zone.strftime('%d/%m/%Y %H:%M') %></div></div>
        <% if note.sefaz_status_code.present? %>
          <div class="form-col-12"><label class="field-label">Último retorno da SEFAZ</label><div class="text-main"><%= note.sefaz_status_code %> — <%= note.sefaz_message %></div></div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if note.cancelable? && screen_can?(:fiscal_notes, :destroy) %>
  <% content_for :scripts do %>
  <script>
  // Cancelar na SEFAZ: o formulário fica escondido até clicar no botão; o contador libera o envio com 15 a 255 caracteres.
  document.addEventListener('DOMContentLoaded', function () {
    var box = document.getElementById('cancelar');
    var text = document.getElementById('nfCancelReason');
    var count = document.getElementById('nfCancelCount');
    var submit = document.getElementById('nfCancelSubmit');
    if (!box || !text) return;
    function open() { box.classList.add('is-open'); text.focus(); box.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    if (box.hasAttribute('data-open') || window.location.hash === '#cancelar') open();
    document.querySelectorAll('.nf-cancel-open').forEach(function (btn) {
      btn.addEventListener('click', function (event) { event.preventDefault(); open(); });
    });
    text.addEventListener('input', function () {
      var size = text.value.replace(/\s+/g, ' ').trim().length;
      count.textContent = size + ' / 255 · mínimo de 15 caracteres';
      submit.disabled = size < 15 || size > 255;
    });
  });
  </script>
  <% end %>
<% end %>
