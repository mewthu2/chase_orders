<% content_for :title, "Editar Transferência Interna" %>
<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon 'fas fa-exchange-alt' %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title">Editar Transferência Interna</h1>
        <p class="page-subtitle">#<%= @transfer.id %></p>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
      <%= link_to internal_transfer_path(@transfer), class: "btn-back" do %><i class="fas fa-arrow-left me-1"></i>Voltar<% end %>
    </div>
  </div>
  <%= render 'approval', transfer: @transfer, approvers: @approvers %>
  <%= render 'form' %>
</div>
