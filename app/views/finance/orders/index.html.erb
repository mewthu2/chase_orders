<% content_for :title, 'Financeiro · Pedidos de Atacado' %>
<% money = ->(v) { number_to_currency(v, unit: 'R$ ', separator: ',', delimiter: '.') } %>
<% can_pay = screen_can?(:finance_orders, :edit) %>
<% can_export = screen_can?(:finance_orders, :export) %>
<% today = Date.current %>
<% table = finance_receivables_table(@receivables) %>
<% filter_query = request.query_parameters.except('page').to_query %>
<% with_query = ->(path) { filter_query.empty? ? path : "#{path}?#{filter_query}" } %>

<%= hc_page_header 'Pedidos de Atacado', 'Recebimentos do atacado: PIX e cartão já pagos, boletos com baixa parcela a parcela.', icon: 'fas fa-hand-holding-dollar' do %>
  <% if can_export && table.total.positive? %>
    <%= form_with url: with_query.call(export_finance_orders_path), method: :post, data: { turbo: false }, class: 'fin-head-form' do %>
      <%= hidden_field_tag :all, '1' %>
      <button type="submit" class="btn btn-export" data-tip="Baixa uma planilha (Excel) com todas as linhas que o filtro mostra, de todas as páginas.">
        <i class="fas fa-file-excel"></i>Baixar planilha do filtro
      </button>
    <% end %>
  <% end %>
<% end %>

<div class="pg-blocks fin">
  <%= hc_pg_kpis(table) %>
  <% bulk = capture do %>
    <div class="pg-bulk fin-bulk fnl-bulk" data-fin-bulk data-total="<%= table.total %>" data-scope="<%= request.path %>?<%= request.query_parameters.except('page', 'sort', 'dir').to_query %>">
      <script type="application/json" data-fin-rows><%= raw json_escape(finance_selection_rows(table).to_json) %></script>
      <span><b data-fin-count>0</b> <span data-fin-unit>selecionados</span></span>
      <span class="fnl-sum" data-tip="Soma do valor das linhas selecionadas (todas as páginas).">
        <i class="fas fa-sack-dollar"></i><b data-fin-sum>R$ 0,00</b>
      </span>
      <% if table.total > table.page_rows.size %>
        <button type="button" class="btn btn-ghost btn-sm fin-all" data-fin-all data-tip="Marca todas as linhas do filtro, não só as desta página.">
          <i class="fas fa-layer-group"></i>Selecionar os <%= number_with_delimiter(table.total, delimiter: '.') %> do filtro
        </button>
      <% end %>
      <span class="fin-all-on" data-fin-all-on hidden><i class="fas fa-check-double"></i>Todo o filtro selecionado</span>

      <% if can_pay %>
        <%= form_with url: pay_many_finance_payments_path, method: :patch, class: 'fin-pay', data: { fin_pay: true, turbo: false } do %>
          <%= hidden_field_tag :ids, '', data: { fin_ids: true } %>
          <%= hidden_field_tag :return_to, request.fullpath %>
          <label class="fin-date">Pago em <%= date_field_tag :paid_at, today, class: 'field-input' %></label>
          <label class="fin-date" data-tip="Cada parcela fica paga na data do próprio vencimento. Use para boletos antigos que já foram pagos: a comissão do consultor cai no mês certo.">
            <%= check_box_tag :on_due, '1', false %> Pago no vencimento
          </label>
          <button type="submit" class="btn btn-sm btn-primary" data-fin-submit disabled><i class="fas fa-check-double"></i>Dar baixa em <b data-fin-open>0</b></button>
        <% end %>
      <% end %>

      <% if can_export %>
        <% [[export_finance_orders_path, 'fas fa-file-excel', 'Baixar planilha', 'Planilha (Excel) só com as linhas selecionadas.'],
            [xmls_finance_orders_path, 'fas fa-file-zipper', 'Baixar XML', 'ZIP com o XML da NF-e de cada pedido selecionado (autorizadas e canceladas, com o evento de cancelamento).']].each do |path, icon, label, tip| %>
          <%= form_with url: with_query.call(path), method: :post, class: 'fin-dl', data: { fin_download: true, turbo: false } do %>
            <%= hidden_field_tag :keys, '', data: { fin_keys: true } %>
            <%= hidden_field_tag :all, '', data: { fin_all_field: true } %>
            <button type="submit" class="btn btn-sm btn-secondary" disabled data-fin-dl data-tip="<%= tip %>"><i class="<%= icon %>"></i><%= label %></button>
          <% end %>
        <% end %>
      <% end %>
      <button type="button" class="btn btn-ghost btn-sm" data-fin-clear hidden>Limpar seleção</button>
      <span class="pg-bulk-hint">Marque as linhas (ou todo o filtro) para somar, dar baixa e baixar a planilha ou os XML.</span>
    </div>
  <% end %>
  <%= hc_pg_table(table, title: 'Recebimentos', icon: 'fas fa-sack-dollar',
        meta: 'Cada boleto é uma linha. Parcelas vencidas de meses anteriores sempre aparecem. A comissão do consultor sai no mês em que a parcela foi paga.',
        select: ->(r) { { key: r[:id], value: r[:valor] } },
        bulk: bulk,
        empty: { title: 'Nada a receber neste período', text: 'Use as setas do mês ou escolha "todos" para ver outros vencimentos.' },
        detail: { title: ->(r) { "Pedido ##{r[:num]} · parcela #{r[:parcela]}" }, fields: [['Forma de pagamento', :forma], ['Vendedor', :digitador], ['Baixa por', :quem]] },
        actions: ->(r) {
          payment = r[:record]
          next ''.html_safe unless can_pay
          edit = hc_row_action('fas fa-user-pen', 'Editar ou tirar o consultor', edit_finance_order_path(r[:order], return_to: request.fullpath))
          next edit unless payment
          edit + if payment.paid?
            hc_row_action('fas fa-rotate-left', 'Desfazer baixa', unpay_finance_payment_path(payment), method: :patch, params: { return_to: request.fullpath },
                          confirm: { title: "Desfazer a baixa da parcela #{r[:parcela]} do pedido ##{r[:num]}?", text: 'A parcela volta a ficar pendente e a comissão do consultor sai do mês em que foi paga.' })
          else
            hc_row_action('fas fa-check', 'Dar baixa hoje', pay_finance_payment_path(payment), method: :patch, params: { return_to: request.fullpath, paid_at: today.iso8601 },
                          confirm: { title: "Baixar a parcela #{r[:parcela]} do pedido ##{r[:num]} (#{money.call(r[:valor])})?", text: "Fica paga em #{l(today, format: '%d/%m/%Y')}. Para outra data, marque a parcela e use a barra de baixa em lote.", ok: 'Dar baixa' })
          end
        }) %>
</div>

<script>
  // Seleção que vale para todo o filtro: guarda as chaves marcadas (de qualquer página) no sessionStorage,
  // por filtro, e soma/baixa/exporta a partir da lista completa de linhas do filtro (data-fin-rows).
  (function () {
    var bar = document.querySelector('[data-fin-bulk]');
    if (!bar) return;
    var table = bar.closest('.pg-body') || document;
    var money = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    var rows = JSON.parse(bar.querySelector('[data-fin-rows]').textContent);
    var byKey = {};
    rows.forEach(function (r) { byKey[r.k] = r; });
    var storeKey = 'fin-sel:' + bar.dataset.scope;
    var state = { all: false, keys: {} };
    try {
      var saved = JSON.parse(sessionStorage.getItem(storeKey) || 'null');
      if (saved) { state.all = !!saved.all; (saved.keys || []).forEach(function (k) { if (byKey[k]) state.keys[k] = true; }); }
    } catch (e) { /* sessão sem storage: começa vazia */ }

    function boxes() { return table.querySelectorAll('.row-select-checkbox'); }
    function isOn(k) { return state.all || !!state.keys[k]; }
    function selected() { return rows.filter(function (r) { return isOn(r.k); }); }
    function save() {
      try { sessionStorage.setItem(storeKey, JSON.stringify({ all: state.all, keys: Object.keys(state.keys) })); } catch (e) { /* ignora */ }
    }
    function set(k, on) {
      if (state.all && !on) { state.all = false; rows.forEach(function (r) { state.keys[r.k] = true; }); }
      if (on) state.keys[k] = true; else delete state.keys[k];
      if (!state.all && rows.length && rows.every(function (r) { return state.keys[r.k]; })) { state.all = true; state.keys = {}; }
    }

    function refresh() {
      var sel = selected();
      var sum = 0, open = [];
      sel.forEach(function (r) { sum += r.v; if (r.o) open.push(r.p); });
      boxes().forEach(function (cb) { cb.checked = isOn(cb.dataset.key); });
      var all = table.querySelector('#selectAllCheckbox');
      var pageBoxes = Array.prototype.slice.call(boxes());
      if (all) all.checked = pageBoxes.length > 0 && pageBoxes.every(function (cb) { return cb.checked; });

      bar.querySelector('[data-fin-count]').textContent = sel.length.toLocaleString('pt-BR');
      bar.querySelector('[data-fin-unit]').textContent = sel.length === 1 ? 'selecionado' : 'selecionados';
      bar.querySelector('[data-fin-sum]').textContent = money.format(sum);
      bar.classList.toggle('is-on', sel.length > 0);
      var allBtn = bar.querySelector('[data-fin-all]');
      if (allBtn) allBtn.hidden = state.all;
      bar.querySelector('[data-fin-all-on]').hidden = !(state.all && rows.length > pageBoxes.length);
      bar.querySelector('[data-fin-clear]').hidden = sel.length === 0;

      var pay = bar.querySelector('[data-fin-pay]');
      if (pay) {
        pay.querySelector('[data-fin-ids]').value = open.join(',');
        pay.querySelector('[data-fin-open]').textContent = open.length + (open.length === 1 ? ' parcela' : ' parcelas');
        pay.querySelector('[data-fin-submit]').disabled = open.length === 0;
      }
      bar.querySelectorAll('[data-fin-download]').forEach(function (form) {
        form.querySelector('[data-fin-all-field]').value = state.all ? '1' : '';
        form.querySelector('[data-fin-keys]').value = state.all ? '' : sel.map(function (r) { return r.k; }).join(',');
        form.querySelector('[data-fin-dl]').disabled = sel.length === 0;
      });
      save();
    }

    table.addEventListener('change', function (e) {
      if (e.target.id === 'selectAllCheckbox') {
        boxes().forEach(function (cb) { set(cb.dataset.key, e.target.checked); });
      } else if (e.target.classList.contains('row-select-checkbox')) {
        set(e.target.dataset.key, e.target.checked);
      } else return;
      refresh();
    });
    var allBtn = bar.querySelector('[data-fin-all]');
    if (allBtn) allBtn.addEventListener('click', function () { state.all = true; state.keys = {}; refresh(); });
    bar.querySelector('[data-fin-clear]').addEventListener('click', function () { state.all = false; state.keys = {}; refresh(); });
    var pay = bar.querySelector('[data-fin-pay]');
    if (pay) pay.addEventListener('submit', function () { try { sessionStorage.removeItem(storeKey); } catch (e) { /* ignora */ } });
    refresh();
  })();
</script>
