<% content_for :title, "Recebimento do pedido ##{@order.id}" %>
<% back = finance_return_to %>
<% here = request.fullpath %>
<% can_edit = screen_can?(:finance_orders, :edit) %>
<% money = ->(v) { number_to_currency(v, unit: 'R$ ', separator: ',', delimiter: '.') } %>
<% receipt = finance_receipt(@order) %>
<% today = Date.current %>
<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon 'fas fa-hand-holding-dollar' %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title">Recebimento do pedido #<%= @order.id %></h1>
        <p class="page-subtitle">
          <%= b2b_order_destination(@order) %> · <%= money.call(@order.grand_total) %> · <%= @order.payment_description.presence || 'Sem forma (boleto à vista)' %> ·
          <%= hc_status(*FinanceHelper::FINANCE_RECEIPT_STATUSES.fetch(receipt[:status]).first(2)) %>
          <%= hc_status(*b2b_order_statuses.fetch(@order.status, [@order.status, 'gray']).first(2)) %>
        </p>
      </div>
    </div>
    <div class="header-actions">
      <%= link_to back, class: 'btn-back' do %><i class="fas fa-arrow-left me-1"></i>Voltar às notas<% end %>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header"><h5 class="form-section-title"><i class="fas fa-file-invoice-dollar me-2"></i>Parcelas</h5></div>
    <div class="form-section-body">
      <% if @order.payments.empty? %>
        <p class="mb-0"><%= receipt[:text] %>: <b><%= money.call(@order.paid_on_creation? ? @order.creation_paid_amount : 0) %></b>. Não há parcela para dar baixa.</p>
      <% else %>
        <% if @order.paid_on_creation? && @order.creation_paid_amount.positive? %>
          <p><%= @order.payment_label %>, pago na criação: <b><%= money.call(@order.creation_paid_amount) %></b>.</p>
        <% end %>
        <div class="table-responsive">
          <table class="table fin-parcels">
            <thead><tr><th>Parcela</th><th>Vencimento</th><th>Valor</th><th>Situação</th><th>Pago em</th><th>Baixa por</th><th></th></tr></thead>
            <tbody>
              <% @order.payments.each do |payment| %>
                <% st = finance_payment_status(payment, today) %>
                <tr>
                  <td class="mono"><%= payment.number %>/<%= @order.payments.size %></td>
                  <td><%= l(payment.due_date, format: '%d/%m/%Y') %></td>
                  <td><%= money.call(payment.amount) %></td>
                  <td><% label, tone, tip = FinanceHelper::FINANCE_PAYMENT_STATUSES.fetch(st) %><%= hc_status(label, tone, tip: tip) %></td>
                  <td><%= payment.paid_at ? l(payment.paid_at, format: '%d/%m/%Y') : '—' %></td>
                  <td><%= payment.paid_by&.name || '—' %></td>
                  <td style="text-align: right">
                    <% if can_edit && @order.status != 'cancelado' %>
                      <% if payment.paid? %>
                        <%= hc_row_action('fas fa-rotate-left', 'Desfazer baixa', unpay_finance_payment_path(payment), method: :patch, params: { return_to: here },
                                          confirm: { title: "Desfazer a baixa da parcela #{payment.number}?", text: 'A parcela volta a ficar pendente e a comissão do consultor sai do mês em que foi paga.' }) %>
                      <% else %>
                        <%= form_with url: pay_finance_payment_path(payment), method: :patch, class: 'fin-pay-one',
                                      data: { turbo: false, hc_confirm: { title: "Dar baixa na parcela #{payment.number}/#{@order.payments.size} do pedido ##{@order.id}?",
                                                                         text: "Tem certeza? A parcela de #{money.call(payment.amount)} (vencimento #{l(payment.due_date, format: '%d/%m/%Y')}) fica paga na data escolhida.",
                                                                         ok: 'Sim, dar baixa', icon: 'fas fa-circle-check' }.to_json } do %>
                          <%= hidden_field_tag :return_to, here %>
                          <%= date_field_tag :paid_at, today, class: 'field-input', 'aria-label': 'Pago em' %>
                          <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-check"></i>Dar baixa</button>
                        <% end %>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="mb-0">Recebido <b><%= money.call(@order.payments.select(&:paid?).sum(&:amount)) %></b> · a receber <b><%= money.call(receipt[:open_value]) %></b></p>
      <% end %>
    </div>
  </div>

  <% if @order.payment_method == 'boleto' && can_edit && @order.status != 'cancelado' %>
    <% paid_numbers = @order.payments.select(&:paid?).map(&:number) %>
    <div class="form-section fin-terms" id="prazos"
         data-base="<%= (@order.created_at || Time.current).to_date.iso8601 %>" data-total="<%= @order.grand_total.to_f %>"
         data-paid="<%= @order.payments.select(&:paid?).map { |p| { n: p.number, v: p.amount.to_f, due: p.due_date.iso8601 } }.to_json %>"
         data-current="<%= @order.payment_terms %>">
      <div class="form-section-header"><h5 class="form-section-title"><i class="fas fa-layer-group me-2"></i>Prazos do boleto</h5></div>
      <div class="form-section-body">
        <p class="fin-terms-help">Aumente ou diminua as parcelas. As já pagas não mudam; o que falta receber é dividido de novo entre as pendentes.
          <% if @order.fiscal_notes.any? { |n| n.status.in?(%w[autorizada]) } %><br><i class="fas fa-triangle-exclamation"></i> A NF-e já autorizada continua com as duplicatas antigas.<% end %></p>
        <%= form_with url: terms_finance_order_path(@order), method: :patch, local: true, data: { fin_terms_form: true } do %>
          <%= hidden_field_tag :return_to, back %>
          <div class="fin-terms-row">
            <button type="button" class="btn btn-secondary btn-sm" data-fin-terms="-1" aria-label="Uma parcela a menos"><i class="fas fa-minus"></i></button>
            <div class="fin-terms-count"><b data-fin-terms-n><%= @order.installment_days.size %></b><span>parcelas</span></div>
            <button type="button" class="btn btn-secondary btn-sm" data-fin-terms="1" aria-label="Uma parcela a mais"><i class="fas fa-plus"></i></button>
            <label class="fin-terms-field">Prazos em dias
              <%= text_field_tag :payment_terms, @order.payment_terms, class: 'field-input mono', placeholder: '30 60 90', autocomplete: 'off', data: { fin_terms_input: true } %>
            </label>
          </div>
          <ol class="fin-terms-preview" data-fin-terms-preview></ol>
          <p class="fin-terms-error" data-fin-terms-error hidden></p>
          <div class="form-actions">
            <button type="submit" class="btn-submit" data-fin-terms-save disabled><i class="fas fa-check me-1"></i>Salvar parcelas</button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="form-section">
    <div class="form-section-header"><h5 class="form-section-title"><i class="fas fa-handshake me-2"></i>Quem recomendou</h5></div>
    <div class="form-section-body">
      <p>Vendedor (quem digitou): <b><%= @order.user&.name || '—' %></b> · consultor hoje: <b><%= @order.consultant_label || 'sem consultor' %></b><%= ' (cadastro pendente)' if @order.consultant_pending? %></p>
      <% if can_edit %>
        <%= form_with url: finance_order_path(@order), method: :patch, local: true do %>
          <%= hidden_field_tag :return_to, back %>
          <div class="form-grid">
            <div class="form-col-6">
              <label class="field-label" for="consultant_id">Consultor cadastrado</label>
              <%= select_tag :consultant_id, options_from_collection_for_select(@consultants, :id, :name, @order.consultant_id), include_blank: 'Escolha…', class: 'field-input' %>
            </div>
            <div class="form-col-6">
              <label class="field-label" for="name">Ou digite um nome (fica pendente até cadastrar)</label>
              <%= text_field_tag :name, (@order.salesperson_name if @order.consultant_pending?), class: 'field-input', placeholder: 'Primeiro nome' %>
            </div>
          </div>
          <div class="form-actions">
            <%= submit_tag 'Salvar consultor', class: 'btn-submit' %>
            <% if @order.consultant_label %>
              <%= submit_tag 'Tirar o consultor', name: 'remove', value: 'Tirar o consultor', class: 'btn-cancel', data: { tip: 'O pedido fica sem consultor: só o vendedor recebe comissão.' } %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<style>
  .fin-pay-one { display: inline-flex; gap: .4rem; align-items: center; justify-content: flex-end; }
  .fin-pay-one .field-input { width: 9.5rem; padding: .25rem .5rem; }
  .fin-parcels td { vertical-align: middle; }
</style>

<script>
  // Prazos do boleto: −/+ parcela, prévia das datas e dos valores e o "Tem certeza?" com o antes e o depois.
  (function () {
    var box = document.querySelector('.fin-terms');
    if (!box) return;
    var form = box.querySelector('[data-fin-terms-form]');
    var input = box.querySelector('[data-fin-terms-input]');
    var preview = box.querySelector('[data-fin-terms-preview]');
    var error = box.querySelector('[data-fin-terms-error]');
    var save = box.querySelector('[data-fin-terms-save]');
    var count = box.querySelector('[data-fin-terms-n]');
    var base = new Date(box.dataset.base + 'T12:00:00');
    var total = parseFloat(box.dataset.total);
    var paid = JSON.parse(box.dataset.paid || '[]');
    var current = box.dataset.current;
    var max = <%= B2bOrder::MAX_INSTALLMENTS %>;
    var money = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    var paidMax = paid.reduce(function (m, p) { return Math.max(m, p.n); }, 0);

    function days() { return input.value.replace(/[,;\/]/g, ' ').trim().split(/\s+/).filter(Boolean); }
    function problem(d) {
      if (!d.length) return 'Informe os prazos em dias, por exemplo: 30 60 90.';
      if (!d.every(function (x) { return /^\d{1,3}$/.test(x); })) return 'Use só números de dias, separados por espaço.';
      var n = d.map(Number);
      if (n.length > max) return 'No máximo ' + max + ' parcelas.';
      for (var i = 1; i < n.length; i++) if (n[i] <= n[i - 1]) return 'Os prazos precisam crescer: cada parcela vence depois da anterior.';
      if (n.length < paidMax) return 'Já tem ' + paidMax + ' parcela(s) paga(s): deixe pelo menos ' + paidMax + '.';
      return null;
    }
    function render() {
      var d = days();
      var err = problem(d);
      count.textContent = d.length;
      error.hidden = !err;
      error.textContent = err || '';
      var same = d.join(' ') === current;
      save.disabled = !!err || same;
      preview.innerHTML = '';
      if (err) return;
      var paidBy = {}; var paidSum = 0;
      paid.forEach(function (p) { paidBy[p.n] = p; paidSum += p.v; });
      var open = d.map(function (x, i) { return i + 1; }).filter(function (n) { return !paidBy[n]; });
      var balance = Math.max(total - paidSum, 0);
      var each = open.length ? Math.floor(balance / open.length * 100) / 100 : 0;
      d.forEach(function (x, i) {
        var n = i + 1; var p = paidBy[n];
        var due = new Date(base); due.setDate(due.getDate() + Number(x));
        var value = p ? p.v : (n === open[open.length - 1] ? balance - each * (open.length - 1) : each);
        var li = document.createElement('li');
        li.className = p ? 'is-paid' : '';
        li.style.setProperty('--n', i);
        li.innerHTML = '<b>' + x + '</b><span>' + due.toLocaleDateString('pt-BR') + '</span><span>' + money.format(value) + '</span>' + (p ? '<i class="fas fa-check" title="Paga"></i>' : '');
        preview.appendChild(li);
      });
      form.dataset.hcConfirm = JSON.stringify({
        title: 'Mudar o boleto para ' + d.length + 'x (' + d.join(' ') + ')?',
        text: 'Tem certeza? Hoje está ' + (current ? current.split(' ').length + 'x (' + current + ')' : 'sem prazos') + '. As parcelas pendentes são refeitas com o saldo de ' + money.format(balance) + '.',
        ok: 'Sim, mudar as parcelas', icon: 'fas fa-layer-group' });
    }
    box.querySelectorAll('[data-fin-terms]').forEach(function (b) {
      b.addEventListener('click', function () {
        var d = days().filter(function (x) { return /^\d+$/.test(x); }).map(Number);
        if (b.dataset.finTerms === '1') {
          if (d.length >= max) return;
          var step = d.length > 1 ? d[d.length - 1] - d[d.length - 2] : 30;
          d.push(d.length ? d[d.length - 1] + step : 30);
        } else if (d.length > Math.max(1, paidMax)) {
          d.pop();
        }
        input.value = d.join(' ');
        render();
      });
    });
    input.addEventListener('input', render);
    render();
  })();
</script>
