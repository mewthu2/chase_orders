<% content_for :title, "Novo Perfil" %>

<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon 'fas fa-user-shield' %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title">Novo Perfil</h1>
        <p class="page-subtitle">Escolha as áreas, as lojas e as ações que o perfil libera</p>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
      <%= link_to profiles_path, class: "btn-cancel" do %>
        <i class="fas fa-arrow-left"></i>Todos os perfis
      <% end %>
    </div>
  </div>

  <%= render 'form' %>
</div>
