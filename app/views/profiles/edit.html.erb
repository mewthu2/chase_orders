<% content_for :title, "Editar Perfil" %>

<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon 'fas fa-user-shield' %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title">Perfis e Permissões</h1>
        <p class="page-subtitle">Defina o que o perfil <b><%= @profile.name %></b> vê e faz: por área do negócio, por loja e por ação</p>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
      <%= link_to profiles_path, class: "btn-cancel" do %>
        <i class="fas fa-arrow-left"></i>Todos os perfis
      <% end %>
    </div>
  </div>

  <%= render 'form' %>
</div>
