<%= form_with model: @profile, local: true, class: 'needs-validation', novalidate: true do |form| %>
  <% if @profile.errors.any? %>
    <div class="form-error-box">
      <i class="fas fa-exclamation-triangle me-2"></i>
      <ul class="mb-0 mt-1">
        <% @profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-section">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-id-badge me-2"></i>Informações Básicas</h5>
    </div>
    <div class="form-section-body">
      <div class="form-grid">
        <div class="form-col-6">
          <label class="field-label">Nome <span class="required">*</span></label>
          <%= form.text_field :name,
              class: "field-input #{'field-input--error' if @profile.errors[:name].any?}",
              required: true %>
          <% if @profile.errors[:name].any? %>
            <span class="field-error"><%= @profile.errors[:name].first %></span>
          <% end %>
        </div>
        <div class="form-col-6">
          <label class="field-label">Descrição</label>
          <%= form.text_field :description, class: "field-input" %>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-toggle-on me-2"></i>Status</h5>
    </div>
    <div class="form-section-body">
      <div class="form-check form-switch">
        <%= form.check_box :active, class: 'form-check-input', role: 'switch', checked: @profile.new_record? ? true : @profile.active? %>
        <label class="form-check-label text-main fw-bold">Perfil Ativo</label>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-desktop me-2"></i>Telas Permitidas</h5>
    </div>
    <div class="form-section-body">
      <% Screen.grouped.each do |group_name, options| %>
        <div class="mb-3 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <strong class="text-main"><i class="fas fa-layer-group me-2"></i><%= group_name %></strong>
            <button type="button" class="btn-back btn-sm screen-group-toggle" data-group="<%= group_name.parameterize %>">
              Marcar/desmarcar todos
            </button>
          </div>
          <div class="form-grid" data-group-checkboxes="<%= group_name.parameterize %>">
            <% options.each do |label, key| %>
              <div class="form-col-4">
                <div class="form-check">
                  <%= check_box_tag 'profile[screen_keys][]',
                                    key,
                                    @profile.screen_keys.include?(key),
                                    { class: 'form-check-input', id: "screen_#{key}" } %>
                  <label class="form-check-label text-main" for="screen_<%= key %>"><%= label %></label>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <span class="text-muted-custom d-block mt-2">
        <i class="fas fa-info-circle me-1"></i>
        Perfis novos começam sem nenhuma tela marcada. Os grupos espelham o menu lateral — marque só os itens que o perfil deve ver.
      </span>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header">
      <h5 class="form-section-title"><i class="fas fa-ticket-alt me-2"></i>Setores de Chamados</h5>
    </div>
    <div class="form-section-body">
      <% sectors = TicketSector.ordered %>
      <% if @profile.id == Profile::ADMIN %>
        <span class="text-muted-custom d-block">
          <i class="fas fa-crown me-1"></i>
          Administradores abrem chamados para todos os setores — não precisa marcar nenhum.
        </span>
      <% else %>
      <%= hidden_field_tag 'profile[ticket_sector_ids][]', '', id: nil %>
      <% if sectors.any? %>
        <div class="form-grid">
          <% sectors.each do |sector| %>
            <div class="form-col-4">
              <div class="form-check">
                <%= check_box_tag 'profile[ticket_sector_ids][]', sector.id, @profile.ticket_sector_ids.include?(sector.id),
                                  { class: 'form-check-input', id: "ticket_sector_#{sector.id}" } %>
                <label class="form-check-label text-main" for="ticket_sector_<%= sector.id %>">
                  <%= sector.name %><% unless sector.active? %> <span class="text-muted-custom">(inativo)</span><% end %>
                </label>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <span class="text-muted-custom d-block">Nenhum setor cadastrado ainda — cadastre em Chamados → Setores.</span>
      <% end %>
      <span class="text-muted-custom d-block mt-2">
        <i class="fas fa-info-circle me-1"></i>
        Usuários deste perfil só abrem chamados para as responsabilidades desses setores e enxergam todos os chamados deles. Administradores veem todos os setores.
      </span>
      <% end %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit (@profile.new_record? ? 'Criar Perfil' : 'Salvar Alterações'), class: "btn-submit" %>
    <%= link_to "Cancelar", profiles_path, class: "btn-cancel" %>
  </div>
<% end %>

<% content_for :scripts do %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.screen-group-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var group = btn.dataset.group;
        var boxes = document.querySelectorAll('[data-group-checkboxes="' + group + '"] input[type="checkbox"]');
        var allChecked = Array.prototype.every.call(boxes, function (b) { return b.checked; });
        boxes.forEach(function (b) { b.checked = !allChecked; });
      });
    });
  });
</script>
<% end %>
