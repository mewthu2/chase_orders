<% content_for :title, 'Notas Fiscais de Entrada' %>
<% table = stock_entries_table(@entries) %>

<%= hc_page_header 'Notas Fiscais de Entrada', 'Suba o XML da nota de compra: fornecedor, itens e valores ficam guardados para a colocação no Log02 e no Log03.', icon: 'fas fa-file-import' %>

<div class="pg-blocks">
  <% if screen_can?(:stock_entries, :create) %>
    <%# Arraste o XML para a área (ou clique para escolher): ele sobe na hora. %>
    <%= form_with url: stock_entries_path, method: :post, multipart: true, local: true, data: { turbo: false } do %>
      <label class="se-drop" data-controller="dropzone" data-dropzone-accept-value="\.xml$"
             data-action="dragenter->dropzone#enter dragover->dropzone#over dragleave->dropzone#leave drop->dropzone#drop">
        <%= file_field_tag :xml, accept: '.xml,application/xml,text/xml', hidden: true, data: { dropzone_target: 'input' }, id: 'seXmlInput' %>
        <span class="se-drop-ic"><i class="fas fa-file-arrow-up"></i></span>
        <span class="se-drop-txt">
          <b data-se-title>Arraste o XML da nota aqui</b>
          <span data-se-sub>ou clique para escolher o arquivo no computador. Ele sobe na hora.</span>
        </span>
      </label>
    <% end %>
    <script>
      (function () {
        var input = document.getElementById('seXmlInput');
        if (!input) return;
        var zone = input.closest('.se-drop');
        function send(file) {
          if (!file) return;
          zone.classList.add('is-busy');
          zone.querySelector('[data-se-title]').textContent = 'Enviando ' + file.name + '…';
          zone.querySelector('[data-se-sub]').textContent = 'Lendo a nota, só um instante.';
          input.form.submit();
        }
        input.addEventListener('change', function () { send(input.files[0]); });
        zone.addEventListener('dropzone:dropped', function (e) { send(e.detail.file); });
        zone.addEventListener('dropzone:rejected', function () {
          zone.classList.add('is-error');
          zone.querySelector('[data-se-title]').textContent = 'Esse arquivo não é um XML';
          zone.querySelector('[data-se-sub]').textContent = 'Arraste o arquivo .xml da NF-e (não o PDF/DANFE).';
          setTimeout(function () { zone.classList.remove('is-error'); }, 2500);
        });
      })();
    </script>
  <% end %>
  <%= hc_pg_kpis(table) %>
  <%= hc_pg_table(table, title: 'Notas de entrada', icon: 'fas fa-file-import', meta: 'Clique no número para ver os itens.',
        link: ->(r) { stock_entry_path(r[:record]) },
        empty: { title: 'Nenhuma nota de entrada ainda', text: 'Arraste o XML de uma nota de compra para a área no topo.' },
        actions: ->(r) {
          screen_can?(:stock_entries, :export) ? hc_row_action('fas fa-file-code', 'Baixar XML', xml_stock_entry_path(r[:record])) : ''.html_safe
        }) %>
</div>
