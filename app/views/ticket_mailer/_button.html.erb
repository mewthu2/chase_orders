<%# locals: (url:, label:) %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 4px;">
  <tr>
    <td bgcolor="#1f6feb" style="border-radius:10px;background-color:#1f6feb;background-image:linear-gradient(135deg,#1f6feb,#8957e5);box-shadow:0 6px 16px rgba(31,111,235,.35);">
      <a href="<%= url %>" style="display:inline-block;padding:14px 30px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;"><%= label %> <span class="cta-arrow">→</span></a>
    </td>
  </tr>
</table>
