<%# locals: (ticket:) %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px;border:1px solid #e5e7eb;border-radius:10px;border-collapse:separate;">
  <tr>
    <td colspan="2" style="padding:16px 18px 8px;">
      <div style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;">Chamado #<%= ticket.id %></div>
      <div style="font-size:19px;font-weight:700;color:#111827;margin-top:2px;"><%= ticket.title %></div>
    </td>
  </tr>
  <% rows = [
       ['Setor', ticket.sector&.name || '—'],
       ['Responsabilidade', ticket.ticket_responsability.name],
       ['Status', ticket.status_label],
       ['Prazo de resposta', ticket_due_text(ticket)],
       ['Aguardando', ticket.waiting_on_label || '—'],
       ['Aberto por', "#{ticket.requester.name} em #{ticket_datetime(ticket.created_at)}"],
       ['Responsáveis notificados', ticket.responsibles.map(&:name).to_sentence.presence || '—'],
       ['Acompanhantes', ticket.followers.map(&:name).to_sentence.presence || '—']
     ] %>
  <% rows.each do |label, value| %>
    <tr>
      <td style="padding:7px 18px;font-size:13px;color:#6b7280;width:42%;vertical-align:top;border-top:1px solid #f3f4f6;"><%= label %></td>
      <td style="padding:7px 18px;font-size:14px;color:#111827;font-weight:600;vertical-align:top;border-top:1px solid #f3f4f6;<%= 'color:#da3633;' if label == 'Prazo de resposta' && ticket.overdue? %>"><%= value %></td>
    </tr>
  <% end %>
</table>
