<% title 'Campanhas de Marketing' %>
<%= render 'layouts/partials/messages' %>

<div class="orders-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-bullhorn me-2"></i>Campanhas de Marketing
      </h1>
      <small class="page-subtitle">
        <i class="fas fa-clock me-1"></i>
        Atualizado em <%= Time.current.strftime('%d/%m/%Y às %H:%M') %>
      </small>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-list me-1"></i><%= @campaigns.size %> campanha(s)
      </span>
      <%= link_to new_marketing_campaign_path, class: "btn-export" do %>
        <i class="fas fa-plus me-2"></i>Nova Campanha
      <% end %>
    </div>
  </div>

  <%# ===== ESTATÍSTICAS GLOBAIS ===== %>
  <div class="summary-grid">
    <div class="summary-card">
      <div class="summary-icon summary-icon--blue"><i class="fas fa-bullhorn"></i></div>
      <div class="summary-body">
        <span class="summary-value"><%= @stats[:total_campaigns] %></span>
        <span class="summary-label">Total de Campanhas</span>
      </div>
    </div>
    <div class="summary-card">
      <div class="summary-icon summary-icon--green"><i class="fas fa-check-circle"></i></div>
      <div class="summary-body">
        <span class="summary-value"><%= @stats[:active_campaigns] %></span>
        <span class="summary-label">Campanhas Ativas</span>
      </div>
    </div>
    <div class="summary-card">
      <div class="summary-icon summary-icon--blue"><i class="fas fa-tasks"></i></div>
      <div class="summary-body">
        <span class="summary-value"><%= @stats[:total_tasks] %></span>
        <span class="summary-label">Total de Tarefas</span>
      </div>
    </div>
    <div class="summary-card">
      <div class="summary-icon summary-icon--yellow"><i class="fas fa-chart-line"></i></div>
      <div class="summary-body">
        <span class="summary-value"><%= @stats[:conversion_rate] %>%</span>
        <span class="summary-label">Taxa de Conversão</span>
      </div>
    </div>
  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">

    <div class="table-card-header">
      <h2 class="table-card-title">
        <i class="fas fa-list me-2"></i>Todas as Campanhas
      </h2>
    </div>

    <% if @campaigns.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Objetivo</th>
              <th>Período</th>
              <th>Status</th>
              <th>Agentes</th>
              <th>Total</th>
              <th>Pendentes</th>
              <th>Convertidas</th>
              <th>Taxa</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @campaigns.each do |campaign| %>
              <tr>
                <td class="text-main">
                  <%= link_to campaign.name, edit_marketing_campaign_path(campaign), class: "text-main" %>
                </td>
                <td class="text-muted-custom"><%= campaign.objective %></td>
                <td class="text-muted-custom">
                  <%= campaign.start_date.strftime('%d/%m/%Y') %> &rarr; <%= campaign.end_date.strftime('%d/%m/%Y') %>
                </td>
                <td>
                  <span class="badge <%= campaign.status_active? ? 'bg-success' : 'bg-secondary' %>">
                    <i class="fas <%= campaign.status_active? ? 'fa-check-circle' : 'fa-pause-circle' %> me-1"></i>
                    <%= campaign.status_active? ? 'Ativa' : 'Inativa' %>
                  </span>
                </td>
                <td class="text-main">
                  <i class="fas fa-users me-1"></i><%= campaign.campaign_users.count %>
                </td>
                <td>
                  <span class="badge bg-secondary"><%= campaign.marketing_tasks.count %></span>
                </td>
                <td>
                  <span class="badge bg-warning"><%= campaign.marketing_tasks.pending.count %></span>
                </td>
                <td>
                  <span class="badge bg-success"><%= campaign.marketing_tasks.converted.count %></span>
                </td>
                <td>
                  <span class="badge bg-info"><%= campaign.conversion_rate %>%</span>
                </td>
                <td class="text-end">
                  <div class="table-actions">
                    <%= link_to statistics_marketing_campaign_path(campaign), class: "action-btn", title: "Estatísticas" do %>
                      <i class="fas fa-chart-bar"></i>
                    <% end %>
                    <%= link_to edit_marketing_campaign_path(campaign), class: "action-btn action-btn--edit", title: "Editar" do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                    <%= button_to toggle_status_marketing_campaign_path(campaign),
                        method: :patch,
                        class: "action-btn #{campaign.status_active? ? 'action-btn--danger' : 'action-btn--edit'}",
                        form_class: "d-inline-block",
                        title: campaign.status_active? ? 'Desativar' : 'Ativar' do %>
                      <i class="fas fa-power-off"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
        <h5>Nenhuma campanha encontrada</h5>
        <p>Comece criando a primeira campanha</p>
        <%= link_to new_marketing_campaign_path, class: "btn-export" do %>
          <i class="fas fa-plus me-1"></i>Criar Primeira Campanha
        <% end %>
      </div>
    <% end %>

  </div>

</div>

<% content_for :styles do %>
<% end %>
