<% title @campaign.name %>
<%= render 'layouts/partials/messages' %>

<div class="orders-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-bullhorn me-2"></i><%= @campaign.name %>
      </h1>
      <small class="page-subtitle"><%= @campaign.objective %></small>
    </div>
    <div class="header-actions">
      <%# Removed admin namespace from paths %>
      <%= link_to edit_marketing_campaign_path(@campaign), class: "btn-primary-sm" do %>
        <i class="fas fa-edit me-1"></i>Editar
      <% end %>
      <%= link_to marketing_campaigns_path, class: "btn-back" do %>
        <i class="fas fa-arrow-left me-1"></i>Voltar
      <% end %>
    </div>
  </div>

  <%# ===== AGENTES DA CAMPANHA ===== %>
  <% campaign_users = @campaign.campaign_users.includes(:user) %>
  <div class="table-card">
    <div class="table-card-header">
      <h2 class="table-card-title">
        <i class="fas fa-users me-2"></i>Agentes de Marketing
      </h2>
      <button type="button" class="btn-primary-sm" data-bs-toggle="modal" data-bs-target="#addAgentModal">
        <i class="fas fa-plus me-1"></i>Adicionar
      </button>
    </div>

    <% if campaign_users.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Tasks</th>
              <th>Conversões</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% campaign_users.each do |campaign_user| %>
              <tr>
                <td class="text-main">
                  <i class="fas fa-user-circle me-2"></i><%= campaign_user.user.name %>
                </td>
                <td class="text-main">
                  <%= campaign_user.user.marketing_tasks.where(campaign: @campaign).count %>
                </td>
                <td class="text-main">
                  <%= campaign_user.user.marketing_tasks.where(campaign: @campaign).converted.count %>
                </td>
                <td class="text-end">
                  <div class="table-actions">
                    <%# Removed admin namespace from path %>
                    <%= button_to campaign_user_path(@campaign, campaign_user),
                        method: :delete,
                        class: "action-btn action-btn--danger",
                        form_class: "d-inline-block",
                        title: "Remover",
                        data: { "turbo-confirm": "Remover este agente da campanha?" } do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-users fa-3x mb-3 d-block"></i>
        <h5>Nenhum agente atribuído</h5>
        <p>Adicione agentes de marketing para começar a distribuir tarefas</p>
      </div>
    <% end %>
  </div>

</div>

<!-- Modal Adicionar Agente -->
<div class="modal fade" id="addAgentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white">Adicionar Agente</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <%# Removed admin namespace from path %>
      <%= form_with url: campaign_users_path(@campaign), method: :post, local: true do |f| %>
        <div class="modal-body">
          <div class="mb-3">
            <label class="field-label">Selecione o Agente</label>
            <%= f.select :user_id,
                User.marketing_agents.map { |u| [u.name, u.id] },
                { prompt: 'Selecione...' },
                class: "field-input field-select" %>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancelar</button>
          <%= f.submit "Adicionar", class: "btn-submit" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% content_for :styles do %>
<% end %>
