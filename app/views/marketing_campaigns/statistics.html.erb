<div class="container-fluid py-4">
  <% title "Estatísticas - #{@campaign.name}" %>

  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark d-flex justify-content-between align-items-center">
          <h5 class="text-white mb-0">
            <i class="fas fa-chart-bar me-2"></i>Estatísticas - <%= @campaign.name %>
          </h5>
          <%= link_to edit_marketing_campaign_path(@campaign), class: "btn btn-outline-light btn-sm" do %>
            <i class="fas fa-arrow-left me-2"></i>Voltar
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Cards de Estatísticas Principais -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-white-50 mb-1 small">Total de Tarefas</p>
              <h3 class="text-white mb-0"><%= @stats[:total_tasks] %></h3>
              <small class="text-white-50">
                <i class="fas fa-calendar-week me-1"></i>
                <%= @stats[:tasks_this_week] %> esta semana
              </small>
            </div>
            <div class="text-primary">
              <i class="fas fa-tasks fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-white-50 mb-1 small">Conversões</p>
              <h3 class="text-success mb-0"><%= @stats[:converted] %></h3>
              <small class="text-white-50">
                <i class="fas fa-calendar-week me-1"></i>
                <%= @stats[:conversions_this_week] %> esta semana
              </small>
            </div>
            <div class="text-success">
              <i class="fas fa-check-circle fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-white-50 mb-1 small">Taxa de Conversão</p>
              <h3 class="text-warning mb-0"><%= @stats[:conversion_rate] %>%</h3>
              <small class="text-white-50">
                <%= @stats[:converted] %> de <%= @stats[:completed] %> concluídas
              </small>
            </div>
            <div class="text-warning">
              <i class="fas fa-percentage fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-3 mb-3">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-white-50 mb-1 small">Tempo Médio</p>
              <h3 class="text-info mb-0"><%= @stats[:avg_completion_time] %>h</h3>
              <small class="text-white-50">
                Para conclusão
              </small>
            </div>
            <div class="text-info">
              <i class="fas fa-clock fa-2x"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Distribuição por Status -->
  <div class="row mb-4">
    <div class="col-md-6 mb-3">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h6 class="text-white mb-0">
            <i class="fas fa-chart-pie me-2"></i>Distribuição por Status
          </h6>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-white-50">Pendentes</span>
              <span class="text-white"><%= @stats[:pending] %> (<%= (@stats[:pending].to_f / @stats[:total_tasks] * 100).round(1) %>%)</span>
            </div>
            <div class="progress" style="height: 25px;">
              <div class="progress-bar bg-warning" role="progressbar" 
                   style="width: <%= (@stats[:pending].to_f / @stats[:total_tasks] * 100).round(1) %>%">
              </div>
            </div>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-white-50">Em Progresso</span>
              <span class="text-white"><%= @stats[:in_progress] %> (<%= (@stats[:in_progress].to_f / @stats[:total_tasks] * 100).round(1) %>%)</span>
            </div>
            <div class="progress" style="height: 25px;">
              <div class="progress-bar bg-info" role="progressbar" 
                   style="width: <%= (@stats[:in_progress].to_f / @stats[:total_tasks] * 100).round(1) %>%">
              </div>
            </div>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-white-50">Convertidas</span>
              <span class="text-white"><%= @stats[:converted] %> (<%= (@stats[:converted].to_f / @stats[:total_tasks] * 100).round(1) %>%)</span>
            </div>
            <div class="progress" style="height: 25px;">
              <div class="progress-bar bg-success" role="progressbar" 
                   style="width: <%= (@stats[:converted].to_f / @stats[:total_tasks] * 100).round(1) %>%">
              </div>
            </div>
          </div>

          <div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-white-50">Não Convertidas</span>
              <span class="text-white"><%= @stats[:not_converted] %> (<%= (@stats[:not_converted].to_f / @stats[:total_tasks] * 100).round(1) %>%)</span>
            </div>
            <div class="progress" style="height: 25px;">
              <div class="progress-bar bg-secondary" role="progressbar" 
                   style="width: <%= (@stats[:not_converted].to_f / @stats[:total_tasks] * 100).round(1) %>%">
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Performers -->
    <div class="col-md-6 mb-3">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h6 class="text-white mb-0">
            <i class="fas fa-trophy me-2"></i>Top Performers
          </h6>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-dark table-sm mb-0">
              <thead>
                <tr>
                  <th class="text-white-50 small">Agente</th>
                  <th class="text-white-50 small text-center">Tarefas</th>
                  <th class="text-white-50 small text-center">Conversões</th>
                  <th class="text-white-50 small text-center">Taxa</th>
                </tr>
              </thead>
              <tbody>
                <% @top_performers.each_with_index do |performer, index| %>
                  <tr>
                    <td class="text-white">
                      <% if index == 0 %>
                        <i class="fas fa-crown text-warning me-2"></i>
                      <% end %>
                      <%= performer.name %>
                    </td>
                    <td class="text-white text-center"><%= performer.total_tasks %></td>
                    <td class="text-success text-center"><%= performer.conversions %></td>
                    <td class="text-center">
                      <span class="badge bg-<%= performer.conversion_rate >= 50 ? 'success' : 'warning' %>">
                        <%= performer.conversion_rate.round(1) %>%
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Conversões Recentes -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h6 class="text-white mb-0">
            <i class="fas fa-history me-2"></i>Conversões Recentes
          </h6>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
              <thead class="bg-dark">
                <tr>
                  <th class="px-4 py-3 text-white-50 small">Cliente</th>
                  <th class="px-4 py-3 text-white-50 small">Agente</th>
                  <th class="px-4 py-3 text-white-50 small">Pedido</th>
                  <th class="px-4 py-3 text-white-50 small">Convertido em</th>
                  <th class="px-4 py-3 text-white-50 small">Tempo</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_conversions.each do |task| %>
                  <tr class="border-secondary">
                    <td class="px-4 py-3 text-white"><%= task.lead_name %></td>
                    <td class="px-4 py-3 text-white-50"><%= task.user&.name %></td>
                    <td class="px-4 py-3">
                      <span class="badge bg-success"><%= task.order_number %></span>
                    </td>
                    <td class="px-4 py-3 text-white-50">
                      <%= task.completed_at.strftime('%d/%m/%Y %H:%M') %>
                    </td>
                    <td class="px-4 py-3 text-white-50">
                      <% if task.started_at && task.completed_at %>
                        <%= ((task.completed_at - task.started_at) / 3600).round(1) %>h
                      <% else %>
                        -
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <% if @recent_conversions.empty? %>
              <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-white-50 mb-3"></i>
                <p class="text-white-50 mb-0">Nenhuma conversão ainda</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<% end %>
