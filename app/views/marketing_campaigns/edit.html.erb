<div class="container-fluid py-4">
  <% title 'Editar Campanha' %>
  <%= render 'layouts/partials/messages' %>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card bg-black border border-dark shadow-lg">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-edit me-2"></i>Editar Campanha
          </h5>
        </div>
        <div class="card-body bg-black">
          <%= form_with model: @campaign, local: true do |f| %>
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label text-white">Nome da Campanha</label>
                <%= f.text_field :name, class: "form-control bg-black text-white border-secondary", placeholder: "Ex: Recuperação de Carrinho Abandonado Q1" %>
              </div>

              <div class="col-12">
                <label class="form-label text-white">Objetivo</label>
                <%= f.text_area :objective, rows: 3, class: "form-control bg-black text-white border-secondary", placeholder: "Descreva o objetivo desta campanha..." %>
              </div>

              <div class="col-md-6">
                <label class="form-label text-white">Data de Início</label>
                <%= f.date_field :start_date, class: "form-control bg-black text-white border-secondary" %>
              </div>

              <div class="col-md-6">
                <label class="form-label text-white">Data de Fim</label>
                <%= f.date_field :end_date, class: "form-control bg-black text-white border-secondary" %>
              </div>

              <div class="col-12">
                <label class="form-label text-white">Buscar Carrinhos Abandonados A Partir De</label>
                <%= f.date_field :sync_from_date, class: "form-control bg-black text-white border-secondary" %>
                <small class="text-white-50">
                  Data a partir da qual o sistema buscará carrinhos abandonados na Shopify. 
                  Se não informado, usará a data de início da campanha.
                </small>
              </div>

              <!-- Added min_days_abandoned field -->
              <div class="col-md-6">
                <label class="form-label text-white">Dias Mínimos de Abandono</label>
                <%= f.number_field :min_days_abandoned, class: "form-control bg-black text-white border-secondary", placeholder: "Ex: 3", min: 0 %>
                <small class="text-white-50">
                  Apenas distribuir tarefas para carrinhos abandonados há X dias ou mais. 
                  Use 0 para distribuir imediatamente.
                </small>
              </div>

              <div class="col-md-6">
                <label class="form-label text-white">Leads por Semana (por usuário)</label>
                <%= f.number_field :users_per_week, class: "form-control bg-black text-white border-secondary", placeholder: "Ex: 100" %>
                <small class="text-white-50">Quantos leads cada agente receberá por semana</small>
              </div>

              <div class="col-md-6">
                <label class="form-label text-white">Tipo de Campanha</label>
                <%= f.select :campaign_type, 
                    [['Abandono de Carrinho', 'abandoned_cart']], 
                    {},
                    class: "form-select bg-black text-white border-secondary" %>
              </div>

              <div class="col-md-6">
                <label class="form-label text-white">Status</label>
                <%= f.select :status, 
                    [
                      ['Rascunho', 'draft'],
                      ['Ativa', 'active'],
                      ['Pausada', 'paused'],
                      ['Concluída', 'completed'],
                      ['Cancelada', 'cancelled']
                    ], 
                    {},
                    class: "form-select bg-black text-white border-secondary" %>
              </div>
            </div>

            <div class="d-flex gap-3 justify-content-end mt-4">
              <%= link_to "Cancelar", marketing_campaigns_path, class: "btn btn-secondary" %>
              <%= f.submit "Salvar Alterações", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="card bg-black border border-dark shadow-lg mt-4">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-users me-2"></i>Agentes de Marketing
          </h5>
        </div>
        <div class="card-body bg-black">
          <% if @campaign_users.any? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover">
                <thead>
                  <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Perfil</th>
                    <th>Tarefas</th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% @campaign_users.each do |campaign_user| %>
                    <tr>
                      <td><%= campaign_user.user.name %></td>
                      <td><%= campaign_user.user.email %></td>
                      <td>
                        <% if campaign_user.user.admin_marketing? %>
                          <span class="badge bg-warning">Admin Marketing</span>
                        <% else %>
                          <span class="badge bg-info">Agente Marketing</span>
                        <% end %>
                      </td>
                      <td>
                        <span class="badge bg-secondary">
                          <%= @campaign.marketing_tasks.where(user_id: campaign_user.user_id).count %> tarefas
                        </span>
                      </td>
                      <td class="text-end">
                        <%= button_to remove_user_marketing_campaign_path(@campaign, user_id: campaign_user.user_id), 
                            method: :delete,
                            class: "btn btn-sm btn-danger",
                            data: { confirm: "Tem certeza que deseja remover este usuário?" } do %>
                          <i class="fas fa-trash"></i> Remover
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle me-2"></i>
              Nenhum agente de marketing atribuído a esta campanha. Adicione usuários abaixo para começar a distribuir tarefas.
            </div>
          <% end %>

          <hr class="border-secondary my-4">

          <h6 class="text-white mb-3">Adicionar Agente</h6>
          <% if @available_users.any? %>
            <%= form_with url: add_user_marketing_campaign_path(@campaign), method: :post, local: true do |f| %>
              <div class="row g-3">
                <div class="col-md-8">
                  <%= f.select :user_id, 
                      @available_users.map { |u| ["#{u.name} (#{u.email}) - #{u.admin_marketing? ? 'Admin' : 'Agente'}", u.id] },
                      { prompt: "Selecione um agente..." },
                      class: "form-select bg-black text-white border-secondary" %>
                </div>
                <div class="col-md-4">
                  <%= f.submit "Adicionar", class: "btn btn-success w-100" %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="alert alert-info">
              <i class="fas fa-info-circle me-2"></i>
              Todos os agentes de marketing disponíveis já estão atribuídos a esta campanha.
            </div>
          <% end %>
        </div>
      </div>

      <div class="card bg-black border border-dark shadow-lg mt-4">
        <div class="card-header bg-dark">
          <h5 class="text-white mb-0">
            <i class="fas fa-chart-bar me-2"></i>Estatísticas da Campanha
          </h5>
        </div>
        <div class="card-body bg-black">
          <div class="row g-3">
            <div class="col-md-3">
              <div class="text-center p-3 border border-secondary rounded">
                <h3 class="text-primary mb-0"><%= @stats[:total_tasks] %></h3>
                <small class="text-white-50">Total de Tarefas</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="text-center p-3 border border-secondary rounded">
                <h3 class="text-warning mb-0"><%= @stats[:pending] %></h3>
                <small class="text-white-50">Pendentes</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="text-center p-3 border border-secondary rounded">
                <h3 class="text-success mb-0"><%= @stats[:converted] %></h3>
                <small class="text-white-50">Convertidas</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="text-center p-3 border border-secondary rounded">
                <h3 class="text-info mb-0"><%= number_to_percentage(@stats[:conversion_rate], precision: 1) %></h3>
                <small class="text-white-50">Taxa de Conversão</small>
              </div>
            </div>
          </div>

          <% if @stats[:total_tasks] > 0 %>
            <hr class="border-secondary my-4">
            <div class="alert alert-danger border-danger">
              <h6 class="text-danger mb-3">
                <i class="fas fa-exclamation-triangle me-2"></i>Zona de Perigo
              </h6>
              <p class="mb-3 text-white-50">
                Esta ação irá excluir permanentemente todas as <%= @stats[:total_tasks] %> tarefa(s) desta campanha. 
                Esta operação não pode ser desfeita.
              </p>
              <%= button_to delete_all_tasks_marketing_campaign_path(@campaign), 
                  method: :delete,
                  class: "btn btn-danger",
                  data: { 
                    confirm: "ATENÇÃO: Você está prestes a excluir TODAS as #{@stats[:total_tasks]} tarefa(s) desta campanha.\n\nEsta ação é IRREVERSÍVEL e não pode ser desfeita.\n\nTem certeza absoluta que deseja continuar?" 
                  } do %>
                <i class="fas fa-trash-alt me-2"></i>Excluir Todas as Tarefas
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
<% end %>
