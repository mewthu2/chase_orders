<% title 'Nova Campanha' %>
<%= render 'layouts/partials/messages' %>

<div class="client-form-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-plus-circle me-2"></i>Nova Campanha
      </h1>
      <p class="page-subtitle">Crie uma nova campanha de marketing</p>
    </div>
    <div class="header-actions">
      <%= link_to marketing_campaigns_path, class: "btn-back" do %>
        <i class="fas fa-arrow-left me-1"></i>Voltar
      <% end %>
    </div>
  </div>

  <%= form_with model: @campaign, local: true do |f| %>

    <div class="form-section">
      <div class="form-section-header">
        <h3 class="form-section-title">
          <i class="fas fa-bullhorn me-2"></i>Dados da Campanha
        </h3>
      </div>
      <div class="form-section-body">
        <div class="form-grid">
          <div class="form-col-12">
            <label class="field-label">Nome da Campanha <span class="required">*</span></label>
            <%= f.text_field :name, class: "field-input", placeholder: "Ex: Recuperação de Carrinho Abandonado Q1" %>
          </div>

          <div class="form-col-12">
            <label class="field-label">Objetivo <span class="required">*</span></label>
            <%= f.text_area :objective, rows: 3, class: "field-input", placeholder: "Descreva o objetivo desta campanha..." %>
          </div>

          <div class="form-col-6">
            <label class="field-label">Data de Início <span class="required">*</span></label>
            <%= f.date_field :start_date, class: "field-input" %>
          </div>

          <div class="form-col-6">
            <label class="field-label">Data de Fim <span class="required">*</span></label>
            <%= f.date_field :end_date, class: "field-input" %>
          </div>

          <div class="form-col-12">
            <label class="field-label">Buscar Carrinhos Abandonados A Partir De</label>
            <%= f.date_field :sync_from_date, class: "field-input" %>
            <span class="field-error text-muted-custom">
              Data a partir da qual o sistema buscará carrinhos abandonados na Shopify.
              Se não informado, usará a data de início da campanha.
            </span>
          </div>

          <%# Added min_days_abandoned field %>
          <div class="form-col-6">
            <label class="field-label">Dias Mínimos de Abandono</label>
            <%= f.number_field :min_days_abandoned, class: "field-input", placeholder: "Ex: 3", min: 0, value: 0 %>
            <span class="field-error text-muted-custom">
              Apenas distribuir tarefas para carrinhos abandonados há X dias ou mais.
              Use 0 para distribuir imediatamente.
            </span>
          </div>

          <div class="form-col-6">
            <label class="field-label">Leads por Semana (por usuário) <span class="required">*</span></label>
            <%= f.number_field :users_per_week, class: "field-input", placeholder: "Ex: 100" %>
            <span class="field-error text-muted-custom">Quantos leads cada agente receberá por semana</span>
          </div>

          <div class="form-col-6">
            <label class="field-label">Tipo de Campanha <span class="required">*</span></label>
            <%= f.select :campaign_type,
                [['Abandono de Carrinho', 'abandoned_cart']],
                { prompt: 'Selecione...' },
                class: "field-input field-select" %>
          </div>

          <div class="form-col-12">
            <div class="form-check">
              <%= f.check_box :active, class: "form-check-input" %>
              <%= f.label :active, "Ativar campanha imediatamente", class: "form-check-label text-main" %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "Criar Campanha", class: "btn-submit" %>
      <%= link_to "Cancelar", marketing_campaigns_path, class: "btn-cancel" %>
    </div>
  <% end %>

</div>

<% content_for :styles do %>
<% end %>
