<% content_for :title, "Pedidos do Planejador" %>
<% statuses = { 'draft' => ['Rascunho', 'gray', 'Começou a ser criado e não foi salvo. Se aparecer, abra e confira a planilha.'],
                'saved' => ['Salvo', 'blue', 'Planilha lida e pedido pronto. Ainda não foi para o Tiny.'],
                'transmitted' => ['Transmitido', 'green', 'Enviado ao Tiny. Confira a coluna Nota Tiny: se estiver "aguardando", o número da nota ainda não voltou.'],
                'error' => ['Erro', 'red', 'O Tiny recusou ou deu falha. Abra o pedido, leia a mensagem e use Retransmitir.'] } %>
<% map = ->(o) {
     items = o.planner_order_items
     waiting = o.status == 'transmitted' && o.tiny_note_number.blank?
     { id: o.id, record: o, ref: o.reference, st: o.status, nota: o.tiny_note_number.presence || (waiting ? 'aguardando' : '—'), waiting: waiting,
       itens: items.sum { |i| i.quantity.to_i }, dt: o.created_at, arquivo: o.csv_filename.presence || '—', pedido: o.order_number.presence || '—',
       por: o.user&.name || '—', prods: items.size, tags: o.tags.presence || '—', tx: o.transmitted_at ? l(o.transmitted_at.in_time_zone, format: '%d/%m/%Y %H:%M') : '—',
       erro: o.error_message }
   } %>
<% search = ->(scope, text) { term = "%#{ActiveRecord::Base.sanitize_sql_like(text.strip)}%"; scope.where('planner_orders.reference LIKE :t OR planner_orders.csv_filename LIKE :t OR planner_orders.order_number LIKE :t OR planner_orders.id = :id', t: term, id: text.to_i) } %>
<% waiting = ->(scope) { scope.where(status: :transmitted, tiny_note_number: [nil, '']) } %>
<% table = HoneyQueryTable.new(params, scope: @scope, map: map, search: search, page_size: 8, unit: 'pedidos', unit1: 'pedido',
     attrs: { st: :status }, sort_sql: { ref: 'planner_orders.reference', dt: 'planner_orders.created_at' },
     cols: [
       { k: :id, label: 'Id', t: :num, hide: true, nodetail: true },
       { k: :ref, label: 'Referência', t: :mono, main: true, copy: true, sort: true, sub: :arquivo },
       { k: :st, label: 'Status', t: :status, map: statuses },
       { k: :nota, label: 'Nota Tiny', t: :tag },
       { k: :itens, label: 'Total de itens', t: :qty, unit: 'un' },
       { k: :dt, label: 'Data', t: :dt, sort: true },
       { k: :arquivo, label: 'Arquivo CSV', hide: true },
       { k: :pedido, label: 'Número do pedido', hide: true },
       { k: :por, label: 'Criado por', hide: true },
       { k: :prods, label: 'Produtos diferentes', t: :qty, hide: true },
       { k: :tags, label: 'Marcadores', hide: true },
       { k: :tx, label: 'Transmitido em', hide: true }
     ],
     filters: [
       { id: :q, type: :search, label: 'Buscar por referência', ph: 'Ex.: PO-2026 ou TO-5134', tip: 'Procura pela referência (PO-...), pelo nome do arquivo ou pelo número do pedido que está no nome (TO-...).' },
       { id: :status, type: :select, label: 'Status', col: :st, all: 'Todos os status', tip: 'Em que ponto está o pedido: salvo, já no Tiny ou com erro.' }
     ],
     kpis: [
       { label: 'Para transmitir', icon: 'fas fa-paper-plane', tone: 'blue', help: 'Salvos e prontos. Ainda não foram ao Tiny.', col: :st, val: 'saved' },
       { label: 'Transmitidos', icon: 'fas fa-file-invoice', tone: 'green', help: 'Já enviados ao Tiny. Veja a coluna Nota Tiny.', col: :st, val: 'transmitted' },
       { label: 'Sem nota ainda', icon: 'fas fa-hourglass-half', tone: 'orange', help: 'Foram ao Tiny, mas o número da nota não voltou.', col: :nota, val: 'aguardando',
         value: ->(scope) { waiting.call(scope).count }, filter: waiting },
       { label: 'Com erro', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'O Tiny recusou. Leia o motivo e retransmita.', col: :st, val: 'error' }
     ]) %>

<%= hc_page_header 'Pedidos do Planejador', 'Transforma uma planilha de produtos em nota de transferência no Tiny.', icon: 'fas fa-clipboard-list' do %>
  <% if screen_can?(:planner_orders, :create) %>
    <%= link_to new_planner_order_path, class: 'btn btn-export' do %><i class="fas fa-plus"></i>Novo pedido<% end %>
  <% end %>
<% end %>

<div class="pg-blocks">
  <%= hc_pg_kpis(table) %>
  <%= hc_pg_table(table, title: 'Lista de pedidos', icon: 'fas fa-list', meta: 'Cada pedido nasce de uma planilha CSV e vira uma nota de transferência no Tiny.',
        link: ->(r) { planner_order_path(r[:record]) },
        empty: { title: 'Nenhum pedido ainda', text: 'Suba a primeira planilha para criar um pedido de transferência.',
                 cta: (link_to(safe_join([content_tag(:i, '', class: 'fas fa-plus'), 'Novo pedido']), new_planner_order_path, class: 'btn btn-export') if screen_can?(:planner_orders, :create)) },
        detail: { title: ->(r) { "Pedido #{r[:ref]}" }, fields: [['Data de criação', :dt]],
                  note: ->(r) { r[:erro].present? ? "Mensagem do Tiny: #{r[:erro]}" : nil } },
        actions: ->(r) {
          order = r[:record]
          can_x = screen_can?(:planner_orders, :execute)
          safe_join([
            (hc_row_action('fas fa-paper-plane', 'Transmitir para o Tiny', transmit_planner_order_path(order), method: :post,
                           confirm: { title: "Transmitir o pedido #{r[:ref]} para o Tiny?", text: "O sistema monta a nota de transferência (CFOP 5152) com os #{r[:itens]} itens da planilha e envia ao Tiny. Os marcadores entram nas observações da nota.", ok: 'Transmitir' }) if r[:st] == 'saved' && can_x),
            (hc_row_action('fas fa-rotate-right', 'Retransmitir', transmit_planner_order_path(order), method: :post,
                           confirm: (r[:waiting] ? { title: "Retransmitir o pedido #{r[:ref]}?", text: 'Ele já foi ao Tiny, mas o número da nota não voltou. Antes, confira no Tiny se ela não foi emitida.', ok: 'Retransmitir' }
                                                 : { title: "Tentar de novo o pedido #{r[:ref]}?", text: 'O sistema pede a nota ao Tiny outra vez. Se o problema foi o cadastro de um produto, corrija antes no Tiny.', ok: 'Retransmitir' })) if (r[:st] == 'error' || r[:waiting]) && can_x),
            (hc_row_action('fas fa-tags', 'Editar marcadores', edit_planner_order_path(order)) if screen_can?(:planner_orders, :edit)),
            (hc_row_action('fas fa-file-csv', 'Exportar CSV Correios', export_xlsx_planner_order_path(order)) if screen_can?(:planner_orders, :export))
          ].compact)
        }) %>
</div>
