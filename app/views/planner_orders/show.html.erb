<% content_for :title, "Pedido #{@planner_order.reference}" %>

<div class="orders-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-file-invoice me-2"></i><%= @planner_order.reference %>
      </h1>
      <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
        <% case @planner_order.status %>
        <% when 'draft' %>
          <span class="badge bg-secondary"><i class="fas fa-pencil-alt me-1"></i>Rascunho</span>
        <% when 'saved' %>
          <span class="badge bg-primary"><i class="fas fa-save me-1"></i>Salvo</span>
        <% when 'transmitted' %>
          <span class="badge bg-success"><i class="fas fa-check me-1"></i>Transmitido</span>
        <% when 'error' %>
          <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Erro</span>
        <% end %>

        <% if @planner_order.tiny_note_number.present? %>
          <span class="badge bg-info text-dark">
            <i class="fas fa-file-invoice me-1"></i>Nota #<%= @planner_order.tiny_note_number %>
          </span>
        <% end %>
      </div>
    </div>
    <div class="header-actions">
      <%= link_to planner_orders_path, class: "btn-back" do %>
        <i class="fas fa-arrow-left me-1"></i>Voltar
      <% end %>
    </div>
  </div>

  <%# ===== FLASH ===== %>
  <% if flash[:notice] %>
    <div class="flash-msg flash-msg--success">
      <i class="fas fa-check-circle me-2"></i><%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="flash-msg flash-msg--danger">
      <i class="fas fa-exclamation-triangle me-2"></i><%= flash[:alert] %>
    </div>
  <% end %>

  <% if @planner_order.error_message.present? %>
    <div class="flash-msg flash-msg--danger">
      <i class="fas fa-exclamation-triangle me-2"></i>
      <strong>Erro ao Transmitir:</strong> <%= @planner_order.error_message %>
    </div>
  <% end %>

  <div class="row g-3">
    <%# ===== COLUNA PRINCIPAL ===== %>
    <div class="col-lg-8">

      <%# --- Informações do pedido --- %>
      <div class="info-section mb-3">
        <div class="info-section-title">
          <i class="fas fa-info-circle me-1"></i>Informações do Pedido
        </div>

        <div class="info-row">
          <span class="info-key">Data de Criação</span>
          <span class="info-val"><%= @planner_order.created_at.strftime('%d/%m/%Y às %H:%M') %></span>
        </div>

        <% if @planner_order.transmitted_at.present? %>
          <div class="info-row">
            <span class="info-key">Data de Transmissão</span>
            <span class="info-val"><%= @planner_order.transmitted_at.strftime('%d/%m/%Y às %H:%M') %></span>
          </div>
        <% end %>

        <% if @planner_order.csv_filename.present? %>
          <div class="info-row">
            <span class="info-key">Arquivo CSV</span>
            <span class="info-val"><%= @planner_order.csv_filename %></span>
          </div>
        <% end %>

        <% if @planner_order.order_number.present? %>
          <div class="info-row">
            <span class="info-key">Número do Pedido</span>
            <span class="info-val"><%= @planner_order.order_number %></span>
          </div>
        <% end %>

        <% if @planner_order.user.present? %>
          <div class="info-row">
            <span class="info-key">Criado por</span>
            <span class="info-val"><%= @planner_order.user.name || @planner_order.user.email %></span>
          </div>
        <% end %>
      </div>

      <%# --- Produtos do pedido --- %>
      <div class="table-card">
        <div class="table-card-header">
          <h2 class="table-card-title">
            <i class="fas fa-list me-2"></i>Produtos do Pedido
          </h2>
          <span class="total-badge"><%= @planner_order_items.count %> produtos</span>
        </div>

        <% if @planner_order_items.any? %>
          <div class="order-items-list">
            <% @planner_order_items.each do |item| %>
              <div class="order-item-card">
                <div class="item-img-placeholder"><i class="fas fa-tshirt"></i></div>
                <div class="order-item-info">
                  <div class="order-item-name"><%= item.name %></div>
                  <div class="order-item-meta">
                    <span class="item-meta-tag"><%= item.sku %></span>
                  </div>
                </div>
                <div class="order-item-qty">
                  <div class="qty-value"><%= item.quantity %>x</div>
                  <div class="qty-unit">un.</div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="empty-state">
            <i class="fas fa-box-open fa-3x mb-3 d-block"></i>
            <h5>Nenhum produto</h5>
            <p>Este pedido não possui produtos cadastrados</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# ===== SIDEBAR ===== %>
    <div class="col-lg-4">

      <%# --- Resumo --- %>
      <div class="info-section mb-3">
        <div class="info-section-title">
          <i class="fas fa-chart-bar me-1"></i>Resumo do Pedido
        </div>
        <div class="info-row">
          <span class="info-key">Total de Itens</span>
          <span class="info-val"><%= @total_items %></span>
        </div>
        <div class="info-row">
          <span class="info-key">Produtos Diferentes</span>
          <span class="info-val"><%= @planner_order_items.count %></span>
        </div>
      </div>

      <%# --- Marcadores --- %>
      <div class="form-section mb-3">
        <div class="form-section-header">
          <h3 class="form-section-title">
            <i class="fas fa-tags me-2"></i>Marcadores Personalizados
          </h3>
        </div>
        <div class="form-section-body">
          <%= form_with model: @planner_order, url: planner_order_path(@planner_order), method: :patch, local: true do |f| %>
            <label class="field-label">Marcadores / Tags</label>
            <%= f.text_area :tags,
              class: "field-input",
              rows: 3,
              placeholder: "Ex: pedido 455, depósito padrão..." %>
            <p class="page-subtitle mt-2 mb-3">
              <i class="fas fa-info-circle me-1"></i>
              Estes marcadores aparecerão nas observações da nota fiscal
            </p>
            <%= f.submit "Salvar Marcadores", class: "btn-submit w-100" %>
          <% end %>

          <% if @planner_order.tags.present? %>
            <div class="info-row mt-3">
              <span class="info-key">Marcadores atuais</span>
              <span class="info-val"><%= @planner_order.tags %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# --- Ações --- %>
      <div class="form-section">
        <div class="form-section-header">
          <h3 class="form-section-title">
            <i class="fas fa-cog me-2"></i>Ações do Pedido
          </h3>
        </div>
        <div class="form-section-body">
          <div class="d-grid gap-2">
            <%= link_to export_xlsx_planner_order_path(@planner_order), class: "btn-cancel text-center" do %>
              <i class="fas fa-file-csv me-2"></i>Exportar CSV Correios
            <% end %>

            <% if @planner_order.saved? %>
              <%= button_to transmit_planner_order_path(@planner_order),
                method: :post,
                data: { confirm: 'Tem certeza que deseja transmitir este pedido para o Tiny?' },
                class: "btn-submit w-100" do %>
                <i class="fas fa-paper-plane me-2"></i>Transmitir para Tiny
              <% end %>
            <% end %>

            <% if @planner_order.error? || (@planner_order.transmitted? && @planner_order.tiny_note_number.blank?) %>
              <%= button_to transmit_planner_order_path(@planner_order),
                method: :post,
                data: { confirm: 'Deseja tentar retransmitir este pedido para o Tiny?' },
                class: "btn-retry w-100" do %>
                <i class="fas fa-redo me-2"></i>Retransmitir para Tiny
              <% end %>
            <% end %>
          </div>

          <% if @planner_order.transmitted? && @planner_order.tiny_note_number.present? %>
            <div class="info-row mt-3">
              <span class="info-key"><i class="fas fa-check-circle me-1"></i>Pedido Transmitido</span>
              <span class="info-val">Nota #<%= @planner_order.tiny_note_number %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>
