<% content_for :title, "Novo Pedido do Planejador" %>

<div class="container-fluid py-4">
  <div class="row mb-3">
    <div class="col-12">
      <%= link_to planner_orders_path, class: 'btn btn-outline-light btn-sm' do %>
        <i class="fas fa-arrow-left me-1"></i>Voltar
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Coluna Principal - Upload -->
    <div class="col-lg-7">
      <div class="card bg-black border border-success shadow h-100">
        <div class="card-header bg-dark">
          <h4 class="text-white mb-0">
            <i class="fas fa-plus-circle me-2"></i>Criar Novo Pedido do Planejador
          </h4>
        </div>
        
        <div class="card-body d-flex flex-column">
          <% if flash[:alert] %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>

          <%= form_with url: planner_orders_path, method: :post, multipart: true, local: true, class: 'flex-grow-1 d-flex flex-column' do |form| %>
            <div class="mb-4 flex-grow-1">
              <label class="form-label text-white fs-5 mb-3">
                <i class="fas fa-file-csv me-2"></i>Selecione a Planilha CSV
              </label>
              
              <div class="card bg-dark border-secondary border-dashed h-100" style="border-width: 3px; min-height: 300px;">
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-center py-5">
                  <i class="fas fa-cloud-upload-alt fa-5x text-primary mb-4"></i>
                  
                  <h5 class="text-white mb-3">Arraste o arquivo aqui ou clique para selecionar</h5>
                  
                  <div class="mb-4 w-100" style="max-width: 400px;">
                    <%= file_field_tag :csv_file, 
                      accept: '.csv',
                      required: true,
                      class: 'form-control form-control-lg bg-dark text-white border-secondary',
                      id: 'csv-file-input' %>
                  </div>
                  
                  <p class="text-light mb-2">
                    <i class="fas fa-info-circle me-2"></i>
                    Formato aceito: <strong class="text-info">CSV</strong>
                  </p>
                  
                  <small class="text-muted">
                    A planilha será processada automaticamente após o upload
                  </small>
                </div>
              </div>
            </div>

            <div class="d-flex gap-3 mt-3">
              <%= form.submit 'Salvar Pedido', class: 'btn btn-success btn-lg flex-fill', data: { disable_with: '<i class="fas fa-spinner fa-spin me-2"></i>Processando...' } %>
              <%= link_to 'Cancelar', planner_orders_path, class: 'btn btn-outline-secondary btn-lg' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Sidebar - Instruções -->
    <div class="col-lg-5">
      <!-- Card de Requisitos -->
      <div class="card bg-black border border-info shadow mb-4">
        <div class="card-header bg-info text-dark">
          <h6 class="mb-0 fw-bold">
            <i class="fas fa-clipboard-check me-2"></i>Requisitos da Planilha
          </h6>
        </div>
        <div class="card-body">
          <p class="text-light mb-3">
            <strong>A planilha CSV deve conter as seguintes colunas:</strong>
          </p>
          
          <div class="d-flex align-items-start mb-3">
            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
              <i class="fas fa-tag text-primary"></i>
            </div>
            <div>
              <strong class="text-white d-block">Name</strong>
              <small class="text-light">Nome completo do produto</small>
            </div>
          </div>
          
          <div class="d-flex align-items-start mb-3">
            <div class="bg-success bg-opacity-10 rounded p-2 me-3">
              <i class="fas fa-barcode text-success"></i>
            </div>
            <div>
              <strong class="text-white d-block">SKU</strong>
              <small class="text-light">Código de identificação do produto</small>
            </div>
          </div>
          
          <div class="d-flex align-items-start">
            <div class="bg-warning bg-opacity-10 rounded p-2 me-3">
              <i class="fas fa-sort-numeric-up text-warning"></i>
            </div>
            <div>
              <strong class="text-white d-block">Ordered</strong>
              <small class="text-light">Quantidade solicitada</small>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Card de Exemplo -->
      <div class="card bg-black border border-warning shadow">
        <div class="card-header bg-warning text-dark">
          <h6 class="mb-0 fw-bold">
            <i class="fas fa-file-code me-2"></i>Exemplo de Arquivo CSV
          </h6>
        </div>
        <div class="card-body">
          <p class="text-light mb-3">
            <small>Estrutura correta do arquivo:</small>
          </p>
          <pre class="bg-black text-success p-3 rounded mb-3" style="font-size: 0.9rem;"><code>Name,SKU,Ordered
Top Harmony Seamless Black G,TOP-947-G,27
Top Harmony Seamless Black M,TOP-947-M,36
Top Harmony Seamless Black P,TOP-947-P,36
Legging Ultra Comfort Blue GG,LEG-142-GG,15</code></pre>
          
          <div class="alert alert-warning mb-0" role="alert">
            <div class="d-flex">
              <i class="fas fa-exclamation-triangle me-2 mt-1"></i>
              <div>
                <strong class="d-block mb-1">Importante:</strong>
                <small>
                  • O arquivo deve estar em formato CSV (separado por vírgulas)<br>
                  • Codificação UTF-8 para caracteres especiais<br>
                  • A primeira linha deve conter os cabeçalhos
                </small>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Card de Processo -->
      <div class="card bg-black border border-primary shadow mt-4">
        <div class="card-header bg-dark">
          <h6 class="text-white mb-0">
            <i class="fas fa-tasks me-2"></i>Como Funciona
          </h6>
        </div>
        <div class="card-body">
          <div class="d-flex align-items-start mb-3">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; min-width: 32px;">
              <strong>1</strong>
            </div>
            <div>
              <strong class="text-white d-block">Upload</strong>
              <small class="text-light">Faça upload da planilha CSV</small>
            </div>
          </div>
          
          <div class="d-flex align-items-start mb-3">
            <div class="bg-info text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; min-width: 32px;">
              <strong>2</strong>
            </div>
            <div>
              <strong class="text-white d-block">Processamento</strong>
              <small class="text-light">Sistema valida e processa os dados</small>
            </div>
          </div>
          
          <div class="d-flex align-items-start mb-3">
            <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; min-width: 32px;">
              <strong>3</strong>
            </div>
            <div>
              <strong class="text-white d-block">Salvar</strong>
              <small class="text-light">Pedido é salvo e fica pronto para transmissão</small>
            </div>
          </div>
          
          <div class="d-flex align-items-start">
            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; min-width: 32px;">
              <strong>4</strong>
            </div>
            <div>
              <strong class="text-white d-block">Transmitir</strong>
              <small class="text-light">Envie a nota fiscal para o Tiny</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
