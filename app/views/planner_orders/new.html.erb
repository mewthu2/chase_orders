<% content_for :title, "Novo Pedido do Planejador" %>

<div class="client-form-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-plus-circle me-2"></i>Novo Pedido do Planejador
      </h1>
      <p class="page-subtitle">Importe uma planilha CSV para criar um novo pedido</p>
    </div>
    <div class="header-actions">
      <%= link_to planner_orders_path, class: "btn-back" do %>
        <i class="fas fa-arrow-left me-1"></i>Voltar
      <% end %>
    </div>
  </div>

  <% if flash[:alert] %>
    <div class="flash-msg flash-msg--danger">
      <i class="fas fa-exclamation-triangle me-2"></i><%= flash[:alert] %>
    </div>
  <% end %>

  <%# ===== UPLOAD ===== %>
  <div class="form-section">
    <div class="form-section-header">
      <h3 class="form-section-title">
        <i class="fas fa-file-csv me-2"></i>Selecione a Planilha CSV
      </h3>
    </div>
    <div class="form-section-body">
      <%= form_with url: planner_orders_path, method: :post, multipart: true, local: true do |form| %>
        <div class="upload-dropzone">
          <i class="fas fa-cloud-upload-alt fa-3x mb-3"></i>
          <p class="text-main mb-3">Arraste o arquivo aqui ou clique para selecionar</p>

          <%= file_field_tag :csv_file,
            accept: '.csv',
            required: true,
            class: "field-input",
            id: "csv-file-input" %>

          <p class="page-subtitle mt-3 mb-0">
            Formato aceito: <strong>CSV</strong> &middot; a planilha será processada automaticamente após o upload
          </p>
        </div>

        <div class="form-actions">
          <%= form.submit "Salvar Pedido",
              class: "btn-submit",
              data: { disable_with: '<i class="fas fa-spinner fa-spin me-2"></i>Processando...' } %>
          <%= link_to "Cancelar", planner_orders_path, class: "btn-cancel" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# ===== REQUISITOS ===== %>
  <div class="form-section">
    <div class="form-section-header">
      <h3 class="form-section-title">
        <i class="fas fa-clipboard-check me-2"></i>Requisitos da Planilha
      </h3>
    </div>
    <div class="form-section-body">
      <p class="text-main mb-3">A planilha CSV deve conter as seguintes colunas:</p>

      <div class="info-row">
        <span class="info-key"><i class="fas fa-tag me-1"></i>Name</span>
        <span class="info-val">Nome completo do produto</span>
      </div>
      <div class="info-row">
        <span class="info-key"><i class="fas fa-barcode me-1"></i>SKU</span>
        <span class="info-val">Código de identificação do produto</span>
      </div>
      <div class="info-row">
        <span class="info-key"><i class="fas fa-sort-numeric-up me-1"></i>Ordered</span>
        <span class="info-val">Quantidade solicitada</span>
      </div>
    </div>
  </div>

  <%# ===== EXEMPLO ===== %>
  <div class="form-section">
    <div class="form-section-header">
      <h3 class="form-section-title">
        <i class="fas fa-file-code me-2"></i>Exemplo de Arquivo CSV
      </h3>
    </div>
    <div class="form-section-body">
      <p class="page-subtitle mb-2">Estrutura correta do arquivo:</p>
      <pre class="csv-example"><code>Name,SKU,Ordered
Top Harmony Seamless Black G,TOP-947-G,27
Top Harmony Seamless Black M,TOP-947-M,36
Top Harmony Seamless Black P,TOP-947-P,36
Legging Ultra Comfort Blue GG,LEG-142-GG,15</code></pre>

      <p class="page-subtitle mb-0">
        <i class="fas fa-exclamation-triangle me-1"></i>
        O arquivo deve estar em formato CSV (separado por vírgulas), codificação UTF-8 para caracteres especiais,
        e a primeira linha deve conter os cabeçalhos.
      </p>
    </div>
  </div>

  <%# ===== COMO FUNCIONA ===== %>
  <div class="form-section">
    <div class="form-section-header">
      <h3 class="form-section-title">
        <i class="fas fa-tasks me-2"></i>Como Funciona
      </h3>
    </div>
    <div class="form-section-body">
      <div class="info-row">
        <span class="info-key">1. Upload</span>
        <span class="info-val">Faça upload da planilha CSV</span>
      </div>
      <div class="info-row">
        <span class="info-key">2. Processamento</span>
        <span class="info-val">Sistema valida e processa os dados</span>
      </div>
      <div class="info-row">
        <span class="info-key">3. Salvar</span>
        <span class="info-val">Pedido é salvo e fica pronto para transmissão</span>
      </div>
      <div class="info-row">
        <span class="info-key">4. Transmitir</span>
        <span class="info-val">Envie a nota fiscal para o Tiny</span>
      </div>
    </div>
  </div>

</div>
