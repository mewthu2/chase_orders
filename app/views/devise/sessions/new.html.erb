<% content_for :title, 'Entrar' %>

<%= render layout: 'devise/shared/auth_card', locals: { title: 'Entre no painel', subtitle: 'Use seu e-mail e senha para continuar.' } do %>
  <div class="login-form">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, 'E-mail', class: 'form-label' %>
        <div class="input-group">
          <div class="input-group-text" aria-hidden="true"><i class="fas fa-envelope"></i></div>
          <%= f.email_field :email, autofocus: true, autocomplete: 'username', inputmode: 'email', autocapitalize: 'none', spellcheck: false, required: true, class: 'form-control', placeholder: 'voce@exemplo.com' %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :password, 'Senha', class: 'form-label' %>
        <div class="input-group">
          <div class="input-group-text" aria-hidden="true"><i class="fas fa-lock"></i></div>
          <%= f.password_field :password, autocomplete: 'current-password', required: true, class: 'form-control', placeholder: 'Digite sua senha' %>
          <button type="button" class="password-toggle" data-password-toggle aria-controls="<%= f.field_id(:password) %>" aria-label="Mostrar senha" aria-pressed="false" hidden>Mostrar</button>
        </div>
        <p class="login-hint" data-caps-lock role="status" hidden>Caps Lock está ativado.</p>
      </div>

      <div class="login-options">
        <% if devise_mapping.rememberable? %>
          <div class="form-check">
            <%= f.check_box :remember_me, class: 'form-check-input' %>
            <%= f.label :remember_me, 'Lembrar de mim', class: 'form-check-label' %>
          </div>
        <% end %>
        <% if devise_mapping.recoverable? %>
          <%= link_to 'Esqueci minha senha', new_password_path(resource_name), class: 'login-recovery' %>
        <% end %>
      </div>

      <div class="form-actions">
        <%= f.submit 'Entrar', class: 'btn btn-login', data: { disable_with: 'Entrando…', turbo_submits_with: 'Entrando…' } %>
      </div>
    <% end %>
  </div>
<% end %>
