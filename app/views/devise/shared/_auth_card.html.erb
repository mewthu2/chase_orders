<%# Telas de autenticação (login e recuperação de senha): painel da marca à esquerda e o cartão à direita. %>
<section class="login-view" aria-label="Entrar no Honey.Chase">
  <aside class="login-brand" aria-hidden="true">
    <div class="aurora"><span></span><span></span><span></span></div>
    <div class="grid-lines"></div>
    <div class="brand-logo"><%= image_tag 'admin/honey-chase-logo.webp', alt: '', width: 440, height: 48 %></div>
    <div>
      <h2><span class="grad">Tudo da Chase em um só lugar.</span></h2>
      <p class="lead">Chamados, pedidos, envios e estoque organizados por área, com um guia em cada tela para ninguém se perder.</p>
      <ul class="brand-points">
        <li><i class="fas fa-compass"></i><div><strong>Menu por área do negócio</strong>Loja Física, Ecommerce, Logística, Atacado e Adm, cada uma com a sua cor.</div></li>
        <li><i class="fas fa-search"></i><div><strong>Busca rápida</strong>Digite o que precisa, como "rastreio" ou "nota fiscal".</div></li>
        <li><i class="fas fa-life-ring"></i><div><strong>Ajuda em toda tela</strong>Para que serve, passo a passo e o significado de cada termo.</div></li>
      </ul>
    </div>
    <div class="floating-cards">
      <div class="float-card"><span class="ic" style="color:#e3b341;background:rgba(227,179,65,.15)"><i class="fas fa-bell"></i></span><div>Chamados aguardando você<small>Geral · Chamados</small></div></div>
      <div class="float-card"><span class="ic" style="color:#3fb950;background:rgba(63,185,80,.15)"><i class="fas fa-shipping-fast"></i></span><div>Pedido enviado com rastreio<small>Ecommerce · Log03 · Rastreamento</small></div></div>
      <div class="float-card"><span class="ic" style="color:#58a6ff;background:rgba(88,166,255,.15)"><i class="fas fa-file-invoice"></i></span><div>NF-e autorizada na SEFAZ<small>Adm · Notas Fiscais</small></div></div>
    </div>
    <div class="legal">© <%= Date.current.year %> Chase Brasil · Painel interno</div>
  </aside>

  <div class="login-side">
<div class="login-container">
  <section class="login-card" aria-labelledby="login-title">
    <div class="logo-container">
      <%= image_tag 'admin/honey-chase-logo.webp', class: 'logo-image', alt: 'HONEY.CHASE', width: 440, height: 48 %>
    </div>

    <% if local_assigns[:icon] %>
      <div class="login-badge" aria-hidden="true"><i class="fas <%= icon %>"></i></div>
    <% end %>
    <h1 id="login-title" class="login-title"><%= title %></h1>
    <p class="login-subtitle"><%= subtitle %></p>

    <%# flash.delete devolve o próprio flash, não a mensagem: lê antes e só então remove. %>
    <% [:alert, :notice].each do |type| %>
      <% message = flash[type] %>
      <% flash.delete(type) %>
      <% if message.present? %>
        <div class="login-message login-message-<%= type %>" role="<%= type == :alert ? 'alert' : 'status' %>">
          <i class="fas <%= type == :alert ? 'fa-exclamation-circle' : 'fa-check-circle' %>"></i><span><%= message %></span>
        </div>
      <% end %>
    <% end %>

    <%= yield %>

    <footer class="login-footer">
      <span>© <%= Date.current.year %> Chase Brasil</span>
      <span>Precisa de ajuda? <%= link_to 'Fale com o suporte', NavigationHelper::SUPPORT_WHATSAPP, target: '_blank', rel: 'noopener' %></span>
    </footer>
  </section>
</div>
  </div>
</section>

<% content_for :scripts do %>
  <script>
    (() => {
      document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
        const password = document.getElementById(toggle.getAttribute('aria-controls'));
        if (!password) return;
        const capsLock = password.closest('.form-group')?.querySelector('[data-caps-lock]');

        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const visible = password.type === 'password';
          password.type = visible ? 'text' : 'password';
          toggle.textContent = visible ? 'Ocultar' : 'Mostrar';
          toggle.setAttribute('aria-label', visible ? 'Ocultar senha' : 'Mostrar senha');
          toggle.setAttribute('aria-pressed', String(visible));
        });

        if (!capsLock) return;
        const updateCapsLock = (event) => {
          if (event.getModifierState) capsLock.hidden = !event.getModifierState('CapsLock');
        };
        password.addEventListener('keydown', updateCapsLock);
        password.addEventListener('keyup', updateCapsLock);
        password.addEventListener('blur', () => { capsLock.hidden = true; });
      });

      // Nova senha: avisa em tempo real se a confirmação não bate e se falta tamanho.
      const newPassword = document.querySelector('[data-new-password]');
      const confirmation = document.querySelector('[data-password-confirmation]');
      const lengthRule = document.querySelector('[data-rule-length]');
      const matchRule = document.querySelector('[data-rule-match]');
      if (!newPassword || !confirmation) return;
      const minLength = Number(newPassword.getAttribute('minlength')) || 0;
      const check = () => {
        if (lengthRule) lengthRule.classList.toggle('is-ok', newPassword.value.length >= minLength);
        if (matchRule) matchRule.classList.toggle('is-ok', confirmation.value.length > 0 && confirmation.value === newPassword.value);
        confirmation.setCustomValidity(confirmation.value && confirmation.value !== newPassword.value ? 'As senhas não conferem.' : '');
      };
      newPassword.addEventListener('input', check);
      confirmation.addEventListener('input', check);
    })();
  </script>
<% end %>
