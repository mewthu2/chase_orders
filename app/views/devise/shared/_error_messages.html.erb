<% if resource.errors.any? %>
  <div class="login-message login-message-alert" role="alert" data-turbo-cache="false">
    <% if resource.errors.count == 1 %>
      <%= resource.errors.full_messages.first %>
    <% else %>
      <ul class="login-message-list">
        <% resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
