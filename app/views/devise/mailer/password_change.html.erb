<% content_for :hero_emoji, '✅' %>
<% content_for :hero_title, 'Sua senha foi alterada' %>
<% content_for :banner_color, '#2ea043' %>
<% content_for :preheader, 'A senha da sua conta no ChaseOrders acabou de ser alterada.' %>

<p style="margin:0 0 14px;">Olá, <strong><%= @resource.name.presence || @resource.email %></strong>!</p>
<p style="margin:0 0 22px;color:#374151;">A senha da sua conta foi alterada em <strong><%= l(Time.current, format: '%d/%m/%Y às %H:%M') %></strong>. Se foi você, está tudo certo e não precisa fazer nada. <span style="font-size:18px;">🎉</span></p>

<div style="margin:0 0 18px;padding:14px 16px;border-radius:12px;background:#fdecec;border:1px solid #f5b5b2;font-size:14px;line-height:1.55;color:#8a1c17;">
  🚨 <strong>Não foi você?</strong> Redefina a senha agora mesmo e avise um administrador do ChaseOrders.
</div>

<table role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td bgcolor="#0d1117" style="border-radius:12px;background-color:#0d1117;">
      <a class="cta" href="<%= new_password_url(@resource) %>" style="display:inline-block;padding:12px 22px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;border-radius:12px;">Redefinir minha senha <span class="cta-arrow">→</span></a>
    </td>
  </tr>
</table>
