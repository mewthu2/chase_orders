<% channel = params[:channel].presence_in(%w[b2c b2b]) %>
<% kind_labels = { 'create_correios_order' => 'Criação no Correios', 'emission_invoice' => 'Emissão de nota', 'send_xml' => 'Envio de XML', 'get_tracking' => 'Rastreamento',
                   'create_correios_order_tiny2' => 'Criação no Correios', 'emission_invoice_tiny2' => 'Emissão de nota', 'send_xml_tiny2' => 'Envio de XML', 'get_tracking_tiny2' => 'Rastreamento',
                   'create_correios_order_honey' => 'Criação no Correios (Honey)', 'send_xml_honey' => 'NF-e + XML (Honey)', 'get_tracking_honey' => 'Rastreamento (Honey)',
                   'create_note_tiny2' => 'Nota no Tiny 2', 'transfer_tiny_to_shopify_order' => 'Pedido Tiny → Shopify', 'sync_correios_stock' => 'Sincronização de estoque' } %>
<% kinds = channel == 'b2b' ? Attempt::B2B_KINDS : (channel == 'b2c' ? Attempt::B2C_KINDS : kind_labels.keys) %>
<% statuses = { 'success' => ['Sucesso', 'green', 'Deu certo.'], 'fail' => ['Falha', 'orange', 'O outro sistema recusou, por exemplo por falta de estoque.'],
                'error' => ['Erro', 'red', 'Problema técnico ou dado do pedido errado.'], 'processing' => ['Processando', 'purple', 'Ainda rodando.'],
                'none' => ['Sem status', 'gray', 'A tentativa não terminou.'] } %>
<% account = channel == 'b2b' ? 'Log02' : (channel == 'b2c' ? 'Log03' : 'Log03 e Log02') %>
<% tiny_url = ENV.fetch('TINY_SELLS_URL', 'https://erp.tiny.com.br/vendas') %>
<% corrections = {} %>
<% map = ->(a) {
     { id: a.id, record: a, tiny: a.tiny_order_id.to_s.presence, cliente: a.customer_name.presence || '—', kind: kind_labels[a.kinds] || a.kinds.to_s.humanize,
       st: a.status || 'none', code: a.status_code.present? ? "Código #{a.status_code}" : '—', msg: (a.message.presence || a.error.presence || '—').to_s.truncate(140),
       dt: a.created_at, corr: a.order_correios_id.presence&.to_s || '—', nf: a.id_nota_fiscal.presence&.to_s || '—', trk: a.tracking.presence || '—', erro: a.error.presence || '—',
       held: corrections[a.tiny_order_id.to_s] }
   } %>
<% table = HoneyQueryTable.new(params, scope: @attempts_scope, map: map, page_size: 10, unit: 'tentativas', unit1: 'tentativa',
     preload: ->(records) { corrections.merge!(AddressCorrection.where(tiny_order_id: records.map { |r| r.tiny_order_id.to_s }.reject(&:blank?).uniq).index_by(&:tiny_order_id)) },
     search: ->(scope, text) { scope.search(text.strip) },
     attrs: { kind: :kinds, dt: :created_at },
     filter_sql: { status: ->(scope, v) { v.in?(%w[nil none]) ? scope.where(status: nil) : scope.where(status: v) } },
     sort_sql: { dt: 'attempts.created_at' },
     tabs: { col: :kind, param: :kinds, items: [['', 'Todas']] + kinds.map { |k| [k, kind_labels[k]] } },
     cols: [
       { k: :id, label: 'Tentativa', t: :num },
       { k: :tiny, label: 'Pedido (Tiny)', t: :html, main: true },
       { k: :cliente, label: 'Cliente', hide: true },
       { k: :kind, label: 'Etapa', t: :tag },
       { k: :st, label: 'Status', t: :status, map: statuses, sub: :code },
       { k: :code, label: 'Código de status', hide: true },
       { k: :msg, label: 'Resultado' },
       { k: :dt, label: 'Quando', t: :dt, sort: true },
       { k: :corr, label: 'Pedido no Correios', hide: true },
       { k: :nf, label: 'Nota fiscal', hide: true },
       { k: :trk, label: 'Código de rastreio', hide: true },
       { k: :erro, label: 'Mensagem do sistema', hide: true }
     ],
     filters: [
       { id: :search, type: :search, label: 'Buscar tentativa', ph: 'Pedido do Tiny, pedido no Correios ou mensagem', tip: 'Procura pelo número da tentativa, pelo pedido no Tiny, pelo pedido no Correios ou por um pedaço da mensagem.' },
       { id: :status, type: :select, label: 'Status', options: statuses.map { |k, v| [k == 'none' ? 'nil' : k, v[0]] }, all: 'Todos', tip: 'Falha: o outro sistema recusou. Erro: problema técnico ou dado errado. Sem status: a tentativa não terminou.' },
       { id: :per, type: :period, label: 'Período', col: :dt }
     ],
     kpis: [
       { label: 'Sucesso', icon: 'fas fa-circle-check', tone: 'green', help: 'Deram certo.', col: :st, val: 'success', value: ->(s) { s.where(status: :success).count }, filter: ->(s) { s.where(status: :success) } },
       { label: 'Falha', icon: 'fas fa-box-open', tone: 'orange', help: 'O outro sistema recusou.', col: :st, val: 'fail', value: ->(s) { s.where(status: :fail).count }, filter: ->(s) { s.where(status: :fail) } },
       { label: 'Erro', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'Técnico ou dado errado.', col: :st, val: 'error', value: ->(s) { s.where(status: :error).count }, filter: ->(s) { s.where(status: :error) } },
       { label: 'Em aberto', icon: 'fas fa-circle-half-stroke', tone: 'gray', help: 'Processando ou sem status.', col: :st, val: 'open',
         value: ->(s) { s.where(status: [nil, :processing]).count }, filter: ->(s) { s.where(status: [nil, :processing]) } }
     ]) %>
<% rows = table.page_rows %>
<% rows.each do |r|
     tiny = r[:tiny]
     r[:tiny] = if tiny
                  content_tag(:span, tiny, class: 'mono pg-mono') + content_tag(:button, content_tag(:i, '', class: 'far fa-copy'), type: 'button', class: 'pg-copy', data: { pg_copy: tiny, tip: 'Copiar' }) +
                    (r[:cliente] != '—' ? content_tag(:span, r[:cliente], class: 'cell-sub') : ''.html_safe) + address_correction_badge(r[:held]).to_s.html_safe
                else
                  content_tag(:span, '—', class: 'pg-dash')
                end
   end %>
<% content_for :title, "Tentativas (#{account})" %>

<%= hc_page_header "Tentativas (#{account})", 'Cada vez que o sistema falou com o Correios ou com o Tiny.', icon: 'fas fa-paperclip' do %>
  <% unless channel == 'b2b' %>
    <%= link_to correios_pipeline_dashboard_index_path, class: 'btn btn-secondary' do %><i class="fas fa-stream"></i>Funil de Pedidos<% end %>
  <% end %>
<% end %>

<div class="callout pg-banner is-info"><i class="fas fa-circle-info"></i><div><strong>Como ler esta lista.</strong> Cada linha é uma vez que o sistema falou com o Correios ou com o Tiny. Falha: o outro sistema recusou (por exemplo, sem estoque). Erro: problema técnico ou dado do pedido errado. Use Reprocessar quando o motivo já foi resolvido.</div></div>

<div class="pg-blocks">
  <%= hc_pg_kpis(table) %>
  <%= hc_pg_table(table, title: "Tentativas do #{account}", icon: 'fas fa-list-check', meta: 'Da mais recente para a mais antiga. Use as abas para ver só uma etapa.',
        foot: 'tentativas com erro ou falha são apagadas depois de 7 dias; as com sucesso ficam guardadas',
        empty: { title: 'Nenhuma tentativa encontrada', text: 'Quando o sistema falar com o Correios ou com o Tiny, as tentativas aparecem aqui.' },
        detail: { title: ->(r) { "Tentativa ##{r[:id]}" }, fields: [['Mensagem do sistema', :erro]] },
        actions: ->(r) {
          a = r[:record]
          safe_join([
            (hc_row_action('fas fa-rotate-right', 'Reprocessar', reprocess_attempts_path(attempt_id: a.id), method: :get,
                           confirm: { title: "Reprocessar a tentativa ##{a.id}?", text: 'O sistema repete agora esta etapa do pedido. Se o motivo já foi resolvido, ela vira Sucesso.', ok: 'Reprocessar' }) if (a.status.nil? || %w[fail error].include?(a.status)) && screen_can?(:dashboard_correios, :execute)),
            (link_to(content_tag(:i, '', class: 'fas fa-paperclip'), verify_attempts_attempts_path(tiny_order_id: a.tiny_order_id), class: 'action-btn', data: { tip: 'Todas as tentativas do pedido' }, 'aria-label': 'Todas as tentativas do pedido') if a.tiny_order_id.present?),
            (link_to(content_tag(:i, '', class: 'fas fa-arrow-up-right-from-square'), "#{tiny_url}#edit/#{a.tiny_order_id}", class: 'action-btn', target: '_blank', rel: 'noopener', data: { tip: 'Ver no Tiny' }, 'aria-label': 'Ver no Tiny') if a.tiny_order_id.present?)
          ].compact)
        }) %>
</div>
