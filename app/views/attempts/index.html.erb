<%
  page_title = case params[:kinds]
    when 'create_note_tiny2' then 'Tentativas de Criação de Nota no Tiny2'
    when 'emission_invoice_tiny2' then 'Tentativas de Emissão de Nota Fiscal no Tiny2'
    when 'transfer_tiny_to_shopify_order' then 'Tentativas de Transferência do Tiny para Shopify'
    else
      case params[:channel]
      when 'b2c' then 'Tentativas B2C (Correios direto)'
      when 'b2b' then 'Tentativas B2B (Transportadora)'
      else 'Todas as Tentativas'
      end
  end

  page_icon = case params[:kinds]
    when 'create_note_tiny2' then 'fa-sticky-note'
    when 'emission_invoice_tiny2' then 'fa-file-invoice-dollar'
    when 'transfer_tiny_to_shopify_order' then 'fa-exchange-alt'
    else
      case params[:channel]
      when 'b2c' then 'fa-store'
      when 'b2b' then 'fa-truck'
      else 'fa-list-check'
      end
  end

  title page_title

  has_filters = params[:kinds].present? || params[:status].present? || params[:search].present? || params[:channel].present?
%>

<div class="container-fluid py-4">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <i class="fas <%= page_icon %> me-2"></i><%= page_title %>
      </h1>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-list me-1"></i><%= @attempts.total_entries %> registro(s)
      </span>
    </div>
  </div>

  <%# ===== PAINEL DE FILTROS ===== %>
  <div class="filters-panel">

    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-code-branch me-1"></i>Canal
      </label>
      <div class="period-buttons">
        <%= link_to attempts_path(status: params[:status], search: params[:search]),
                    class: "btn-period #{params[:channel].blank? ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-list-ul me-1"></i>Todos
        <% end %>

        <%= link_to attempts_path(channel: 'b2c', status: params[:status], search: params[:search]),
                    class: "btn-period #{params[:channel] == 'b2c' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-store me-1"></i>B2C
        <% end %>

        <%= link_to attempts_path(channel: 'b2b', status: params[:status], search: params[:search]),
                    class: "btn-period #{params[:channel] == 'b2b' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-truck me-1"></i>B2B
        <% end %>
      </div>
    </div>

    <div class="filter-divider"></div>

    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-list-ul me-1"></i>Tipo de Tentativa
      </label>
      <div class="period-buttons">
        <%= link_to attempts_path(channel: params[:channel], status: params[:status], search: params[:search]),
                    class: "btn-period #{params[:kinds].blank? ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-list-ul me-1"></i>Todos
        <% end %>

        <% if params[:channel] == 'b2c' %>
          <%= link_to attempts_path(channel: 'b2c', kinds: 'create_correios_order', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'create_correios_order' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-box me-1"></i>Criação de Pedido
          <% end %>

          <%= link_to attempts_path(channel: 'b2c', kinds: 'send_xml', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'send_xml' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-file-code me-1"></i>Envio XML
          <% end %>

          <%= link_to attempts_path(channel: 'b2c', kinds: 'emission_invoice', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'emission_invoice' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-file-invoice-dollar me-1"></i>Emissão de Nota
          <% end %>

          <%= link_to attempts_path(channel: 'b2c', kinds: 'get_tracking', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'get_tracking' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-truck-fast me-1"></i>Rastreamento
          <% end %>
        <% elsif params[:channel] == 'b2b' %>
          <%= link_to attempts_path(channel: 'b2b', kinds: 'create_correios_order_tiny2', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'create_correios_order_tiny2' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-box me-1"></i>Criação de Pedido
          <% end %>

          <%= link_to attempts_path(channel: 'b2b', kinds: 'send_xml_tiny2', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'send_xml_tiny2' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-file-code me-1"></i>Envio XML
          <% end %>

          <%= link_to attempts_path(channel: 'b2b', kinds: 'emission_invoice_tiny2', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'emission_invoice_tiny2' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-file-invoice-dollar me-1"></i>Emissão de Nota
          <% end %>

          <%= link_to attempts_path(channel: 'b2b', kinds: 'get_tracking_tiny2', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'get_tracking_tiny2' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-truck-fast me-1"></i>Rastreamento
          <% end %>
        <% else %>
          <%= link_to attempts_path(kinds: 'create_note_tiny2', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'create_note_tiny2' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-sticky-note me-1"></i>Criação de Nota no Tiny2
          <% end %>

          <%= link_to attempts_path(kinds: 'emission_invoice_tiny2', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'emission_invoice_tiny2' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-file-invoice-dollar me-1"></i>Emissão de Nota Fiscal no Tiny2
          <% end %>

          <%= link_to attempts_path(kinds: 'transfer_tiny_to_shopify_order', status: params[:status], search: params[:search]),
                      class: "btn-period #{params[:kinds] == 'transfer_tiny_to_shopify_order' ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-exchange-alt me-1"></i>Transferência Tiny para Shopify
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="filter-divider"></div>

    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-info-circle me-1"></i>Status
      </label>
      <div class="period-buttons">
        <%= link_to attempts_path(channel: params[:channel], kinds: params[:kinds], search: params[:search]),
                    class: "btn-period #{params[:status].blank? ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-list-ul me-1"></i>Todos
        <% end %>

        <%= link_to attempts_path(channel: params[:channel], kinds: params[:kinds], status: 'success', search: params[:search]),
                    class: "btn-period #{params[:status] == 'success' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-check me-1"></i>Success
        <% end %>

        <%= link_to attempts_path(channel: params[:channel], kinds: params[:kinds], status: 'fail', search: params[:search]),
                    class: "btn-period #{params[:status] == 'fail' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-times me-1"></i>Fail
        <% end %>

        <%= link_to attempts_path(channel: params[:channel], kinds: params[:kinds], status: 'error', search: params[:search]),
                    class: "btn-period #{params[:status] == 'error' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-wrench me-1"></i>Error
        <% end %>

        <%= link_to attempts_path(channel: params[:channel], kinds: params[:kinds], status: 'processing', search: params[:search]),
                    class: "btn-period #{params[:status] == 'processing' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-spinner me-1"></i>Processing
        <% end %>

        <%= link_to attempts_path(channel: params[:channel], kinds: params[:kinds], status: 'nil', search: params[:search]),
                    class: "btn-period #{params[:status] == 'nil' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-question me-1"></i>Sem Status
        <% end %>
      </div>
    </div>

    <div class="filter-divider"></div>

    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-search me-1"></i>Buscar tentativa
      </label>
      <%= form_tag(attempts_path, method: 'get') do %>
        <%= hidden_field_tag :channel, params[:channel] %>
        <%= hidden_field_tag :status, params[:status] %>
        <%= hidden_field_tag :kinds, params[:kinds] %>
        <div class="search-row">
          <%= text_field_tag :search, params[:search], class: 'search-input',
              placeholder: 'Pesquise por número pedido Tiny/Correios/Nota Fiscal ou por erro' %>
          <%= button_tag class: 'btn-primary-sm' do %>
            <i class="fa fa-search me-1"></i>Pesquisar
          <% end %>
          <% if has_filters %>
            <%= link_to attempts_path, class: "btn-clear" do %>
              <i class="fas fa-times me-1"></i>Limpar tudo
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">

    <div class="table-card-header">
      <h5 class="table-card-title">
        <i class="fas fa-list-check me-2"></i>Tentativas
      </h5>
    </div>

    <% if @attempts.any? %>
      <div class="table-responsive">
        <table class="orders-table" id="attempts-table">
          <thead>
            <tr>
              <th width="60" class="text-center"><i class="fa fa-cog"></i></th>
              <th class="text-center"><%= 'ID' %></th>
              <th class="text-center"><%= 'Pedido no Tiny' %></th>
              <th class="text-center"><%= 'Rastreio' %></th>
              <th class="text-center"><%= Attempt.human_attribute_name :order_correios_id %></th>
              <th class="text-center"><%= Attempt.human_attribute_name :id_nota_fiscal %></th>
              <th class="text-center"><%= Attempt.human_attribute_name :kinds %></th>
              <th class="text-center"><%= Attempt.human_attribute_name :status %></th>
              <th class="text-center"><%= Attempt.human_attribute_name :status_code %></th>
              <th class="text-center"><%= Attempt.human_attribute_name :created_at %></th>
              <th class="text-center">Detalhes</th>
            </tr>
          </thead>
          <tbody>
            <% @attempts.each do |attempt| %>
              <%
                status_class = case attempt.status
                  when 'success' then 'success'
                  when 'fail' then 'danger'
                  when 'error' then 'secondary'
                  when 'processing' then 'warning'
                  else 'dark'
                end

                status_icon = case attempt.status
                  when 'success' then '<i class="fas fa-check"></i>'
                  when 'fail' then '<i class="fas fa-times"></i>'
                  when 'error' then '<i class="fas fa-wrench"></i>'
                  when 'processing' then '<i class="fas fa-spinner fa-spin"></i>'
                  else '<i class="fas fa-question"></i>'
                end
              %>
              <tr>
                <td class="text-center">
                  <% if attempt.status == 'fail' || attempt.status == 'error' || attempt.status.nil? %>
                    <%= link_to reprocess_attempts_path(attempt_id: attempt.id), class: 'btn btn-sm btn-primary', title: 'Reprocessar' do %>
                      <i class="fas fa-sync-alt"></i>
                    <% end %>
                  <% end %>
                </td>
                <td class="text-center"><span class="badge bg-dark"><%= attempt.id %></span></td>
                <td class="text-center">
                  <% if attempt.tiny_order_id.present? %>
                    <div class="d-flex align-items-center justify-content-center gap-2">
                      <span class="badge bg-dark"><%= attempt.tiny_order_id %></span>
                      <a href="<%= ENV.fetch('TINY_SELLS_URL', '#') %>#edit/<%= attempt.tiny_order_id %>"
                         target="_blank" class="btn btn-sm btn-primary" title="Ver no Tiny">
                        <i class="fas fa-external-link-alt"></i>
                      </a>
                    </div>
                  <% else %>
                    <span class="badge bg-secondary">Não disponível</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if attempt.tracking.present? %>
                    <span class="badge bg-info text-dark"><%= truncate(attempt.tracking, length: 30) %></span>
                  <% else %>
                    <span class="badge bg-secondary">Não disponível</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if attempt.order_correios_id.present? %>
                    <span class="badge bg-primary"><%= attempt.order_correios_id %></span>
                  <% else %>
                    <span class="badge bg-secondary">Não disponível</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if attempt.id_nota_fiscal.present? %>
                    <span class="badge bg-success"><%= attempt.id_nota_fiscal %></span>
                  <% else %>
                    <span class="badge bg-secondary">Não disponível</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <span class="badge bg-dark"><%= attempt.kinds.humanize %></span>
                </td>
                <td class="text-center">
                  <span class="badge bg-<%= status_class %>">
                    <%= status_icon.html_safe %> <%= attempt.status.present? ? attempt.status.humanize : 'Sem status' %>
                  </span>
                </td>
                <td class="text-center">
                  <% if attempt.status_code.present? %>
                    <span class="badge bg-dark"><%= attempt.status_code %></span>
                  <% else %>
                    <span class="badge bg-secondary">N/A</span>
                  <% end %>
                </td>
                <td class="text-center text-main"><%= attempt.created_at.strftime('%d/%m/%Y %H:%M') %></td>
                <td class="text-center">
                  <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#attemptModal<%= attempt.id %>">
                    <i class="fas fa-info-circle"></i> Detalhes
                  </button>

                  <!-- Modal para detalhes -->
                  <div class="modal fade" id="attemptModal<%= attempt.id %>" tabindex="-1" aria-labelledby="attemptModalLabel<%= attempt.id %>" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                      <div class="modal-content bg-dark text-white">
                        <div class="modal-header">
                          <h5 class="modal-title" id="attemptModalLabel<%= attempt.id %>">
                            Detalhes da Tentativa #<%= attempt.id %>
                          </h5>
                          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <div class="row mb-3">
                            <div class="col-md-6">
                              <h6 class="text-info">Informações Básicas</h6>
                              <table class="table table-dark table-sm">
                                <tr>
                                  <th>ID:</th>
                                  <td><%= attempt.id %></td>
                                </tr>
                                <tr>
                                  <th>Tipo:</th>
                                  <td><%= attempt.kinds.humanize %></td>
                                </tr>
                                <tr>
                                  <th>Status:</th>
                                  <td><span class="badge bg-<%= status_class %>"><%= attempt.status.present? ? attempt.status.humanize : 'Sem status' %></span></td>
                                </tr>
                                <tr>
                                  <th>Código de Status:</th>
                                  <td><%= attempt.status_code.present? ? attempt.status_code : 'N/A' %></td>
                                </tr>
                                <tr>
                                  <th>Data de Criação:</th>
                                  <td><%= attempt.created_at.strftime('%d/%m/%Y %H:%M:%S') %></td>
                                </tr>
                              </table>
                            </div>
                            <div class="col-md-6">
                              <h6 class="text-info">Identificadores</h6>
                              <table class="table table-dark table-sm">
                                <tr>
                                  <th>Pedido Tiny:</th>
                                  <td>
                                    <% if attempt.tiny_order_id.present? %>
                                      <%= attempt.tiny_order_id %>
                                      <a href="<%= ENV.fetch('TINY_SELLS_URL', '#') %>#edit/<%= attempt.tiny_order_id %>"
                                         target="_blank" class="btn btn-sm btn-primary ms-2">
                                        <i class="fas fa-external-link-alt"></i> Ver no Tiny
                                      </a>
                                    <% else %>
                                      N/A
                                    <% end %>
                                  </td>
                                </tr>
                                <tr>
                                  <th>Pedido Correios:</th>
                                  <td><%= attempt.order_correios_id.present? ? attempt.order_correios_id : 'N/A' %></td>
                                </tr>
                                <tr>
                                  <th>Nota Fiscal:</th>
                                  <td><%= attempt.id_nota_fiscal.present? ? attempt.id_nota_fiscal : 'N/A' %></td>
                                </tr>
                                <tr>
                                  <th>Rastreio:</th>
                                  <td><%= attempt.tracking.present? ? attempt.tracking : 'N/A' %></td>
                                </tr>
                              </table>
                            </div>
                          </div>

                          <% if attempt.error.present? %>
                            <div class="row mb-3">
                              <div class="col-12">
                                <h6 class="text-danger">Erro</h6>
                                <div class="bg-black p-3 rounded" style="max-height: 200px; overflow-y: auto;">
                                  <pre class="text-danger mb-0" style="white-space: pre-wrap;"><%= attempt.error %></pre>
                                </div>
                              </div>
                            </div>
                          <% end %>

                          <% if attempt.message.present? %>
                            <div class="row mb-3">
                              <div class="col-12">
                                <h6 class="text-info">Mensagem</h6>
                                <div class="bg-black p-3 rounded" style="max-height: 200px; overflow-y: auto;">
                                  <pre class="text-white mb-0" style="white-space: pre-wrap;"><%= attempt.message %></pre>
                                </div>
                              </div>
                            </div>
                          <% end %>

                          <% if attempt.exception.present? %>
                            <div class="row mb-3">
                              <div class="col-12">
                                <h6 class="text-warning">Exceção</h6>
                                <div class="bg-black p-3 rounded">
                                  <code class="text-warning"><%= attempt.exception %></code>
                                </div>
                              </div>
                            </div>
                          <% end %>

                          <% if attempt.classification.present? %>
                            <div class="row mb-3">
                              <div class="col-12">
                                <h6 class="text-info">Classificação</h6>
                                <div class="bg-black p-3 rounded">
                                  <span class="badge bg-info text-dark"><%= attempt.classification %></span>
                                </div>
                              </div>
                            </div>
                          <% end %>
                        </div>
                        <div class="modal-footer">
                          <% if attempt.status == 'fail' || attempt.status == 'error' || attempt.status.nil? %>
                            <%= link_to reprocess_attempts_path(attempt_id: attempt.id), class: 'btn btn-primary' do %>
                              <i class="fas fa-sync-alt me-1"></i> Reprocessar
                            <% end %>
                          <% end %>
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-search fa-3x mb-3 d-block"></i>
        <h5>Nenhuma tentativa encontrada</h5>
        <p>Tente ajustar os filtros aplicados</p>
        <% if has_filters %>
          <%= link_to attempts_path, class: "btn-clear" do %>
            <i class="fas fa-times me-1"></i>Limpar filtros
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# PAGINAÇÃO %>
    <div class="pagination-footer">
      <div class="pagination-info">
        <%= page_entries_info @attempts %>
      </div>
      <div class="pagination-controls">
        <%= will_paginate @attempts, list_classes: %w[pagination pagination-sm], inner_window: 1, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
      </div>
    </div>

  </div>

</div>

<% content_for :styles do %>
<% end %>

<% content_for :scripts do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Inicializar tooltips
      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
      });

      // Ajustar altura máxima da tabela para dispositivos móveis
      function adjustTableHeight() {
        if (window.innerWidth < 768) {
          document.querySelector('.table-responsive').style.maxHeight = '500px';
        } else {
          document.querySelector('.table-responsive').style.maxHeight = 'none';
        }
      }

      adjustTableHeight();
      window.addEventListener('resize', adjustTableHeight);
    });
  </script>
<% end %>
