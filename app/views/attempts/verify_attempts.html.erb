<div class="container-fluid py-4">
  <% title 'Tentativas de Integração' %>

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <i class="fas fa-history me-2"></i>Tentativas de Integração
      </h1>
      <p class="page-subtitle">
        <i class="fas fa-info-circle me-1"></i>
        Histórico completo de todas as tentativas de integração com os sistemas externos (Correios, Tiny, etc.)
      </p>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-list me-1"></i><%= page_entries_info @attempts %>
      </span>
      <a href="<%= root_path %>" class="btn btn-dark">
        <i class="fas fa-tachometer-alt me-1"></i> Dashboard
      </a>
      <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse" aria-expanded="false" aria-controls="filtersCollapse">
        <i class="fas fa-filter me-1"></i> Filtros
      </button>
    </div>
  </div>

  <%# ===== PAINEL DE FILTROS ===== %>
  <div class="collapse mb-4" id="filtersCollapse">
    <div class="filters-panel">
      <form method="get">
        <%= hidden_field_tag :tiny_order_id, params[:tiny_order_id] %>
        <div class="filter-section">
          <div class="row g-3">
            <div class="col-md-3">
              <label for="status" class="filter-label">Status</label>
              <select name="status" id="status" class="form-select">
                <option value="">Todos</option>
                <option value="0">Pendente</option>
                <option value="1">Processando</option>
                <option value="2">Sucesso</option>
                <option value="3">Erro</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="kinds" class="filter-label">Tipo</label>
              <select name="kinds" id="kinds" class="form-select">
                <option value="">Todos</option>
                <option value="create_correios_order" <%= 'selected' if params[:kinds] == 'create_correios_order' %>>Criação Correios</option>
                <option value="send_xml" <%= 'selected' if params[:kinds] == 'send_xml' %>>Envio XML</option>
                <option value="emission_invoice" <%= 'selected' if params[:kinds] == 'emission_invoice' %>>Emissão de Nota</option>
                <option value="get_tracking" <%= 'selected' if params[:kinds] == 'get_tracking' %>>Rastreamento</option>
                <option value="create_note_tiny2" <%= 'selected' if params[:kinds] == 'create_note_tiny2' %>>Criação de Nota no Tiny2</option>
                <option value="emission_invoice_tiny2" <%= 'selected' if params[:kinds] == 'emission_invoice_tiny2' %>>Emissão de Nota Fiscal no Tiny2</option>
                <option value="transfer_tiny_to_shopify_order" <%= 'selected' if params[:kinds] == 'transfer_tiny_to_shopify_order' %>>Transferência Tiny para Shopify</option>
                <option value="sync_correios_stock" <%= 'selected' if params[:kinds] == 'sync_correios_stock' %>>Sincronização de Estoque Correios</option>
                <option value="create_correios_order_tiny2" <%= 'selected' if params[:kinds] == 'create_correios_order_tiny2' %>>Criação Correios (B2B)</option>
                <option value="send_xml_tiny2" <%= 'selected' if params[:kinds] == 'send_xml_tiny2' %>>Envio XML (B2B)</option>
                <option value="get_tracking_tiny2" <%= 'selected' if params[:kinds] == 'get_tracking_tiny2' %>>Rastreamento (B2B)</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="period" class="filter-label">Período</label>
              <select name="period" id="period" class="form-select">
                <option value="">Todo o período</option>
                <option value="today">Hoje</option>
                <option value="7">Últimos 7 dias</option>
                <option value="30">Últimos 30 dias</option>
                <option value="90">Últimos 90 dias</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="order_id" class="filter-label">ID do Pedido</label>
              <input type="text" name="order_id" id="order_id" class="form-control" placeholder="Ex: 123456">
            </div>
          </div>
          <div class="mt-3 text-end">
            <button type="submit" class="btn-primary-sm">
              <i class="fas fa-search me-1"></i> Aplicar Filtros
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">

    <div class="table-card-header">
      <h5 class="table-card-title">
        <i class="fas fa-history me-2"></i>Tentativas de Integração
      </h5>
    </div>

    <% if @attempts.present? %>
      <div class="table-responsive">
        <table class="orders-table" id="attemptsTable">
          <thead>
            <tr>
              <th width="50" class="text-center">
                <i class="fas fa-cog"></i>
              </th>
              <th class="text-center">
                <i class="fas fa-hashtag me-1"></i>
                <%= Attempt.human_attribute_name :id %>
              </th>
              <th class="text-center">
                <i class="fas fa-shopping-cart me-1"></i>
                <%= Attempt.human_attribute_name :tiny_order_id %>
              </th>
              <th class="text-center">
                <i class="fas fa-cog me-1"></i>
                <%= Attempt.human_attribute_name :kinds %>
              </th>
              <th class="text-center">
                <i class="fas fa-comment me-1"></i>
                <%= Attempt.human_attribute_name :message %>
              </th>
              <th class="text-center">
                <i class="fas fa-info-circle me-1"></i>
                <%= Attempt.human_attribute_name :status %>
              </th>
              <th class="text-center">
                <i class="fas fa-code me-1"></i>
                <%= Attempt.human_attribute_name :status_code %>
              </th>
              <th class="text-center">
                <i class="fas fa-exclamation-triangle me-1"></i>
                <%= Attempt.human_attribute_name :error %>
              </th>
              <th class="text-center">
                <i class="fas fa-file-code me-1"></i>
                XML Enviado
              </th>
              <th class="text-center">
                <i class="fas fa-calendar me-1"></i>
                <%= Attempt.human_attribute_name :created_at %>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @attempts.each do |attempt| %>
              <tr>
                <td class="text-center">
                  <% if attempt.requisition.present? || attempt.params.present? %>
                    <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#requisitionModal<%= attempt.id %>" title="Ver Requisição">
                      <i class="fas fa-file-code"></i>
                    </button>

                    <div class="modal fade" id="requisitionModal<%= attempt.id %>" tabindex="-1" aria-labelledby="requisitionModalLabel<%= attempt.id %>" aria-hidden="true">
                      <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content bg-dark text-white">
                          <div class="modal-header">
                            <h5 class="modal-title" id="requisitionModalLabel<%= attempt.id %>">
                              Requisição da Tentativa #<%= attempt.id %>
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body">
                            <div class="mb-3">
                              <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="text-info mb-0">Parâmetros (params)</h6>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="copyAttemptField(this, 'attemptParams<%= attempt.id %>')">
                                  <i class="fas fa-copy me-1"></i>Copiar
                                </button>
                              </div>
                              <div class="bg-black p-3 rounded" style="max-height: 300px; overflow-y: auto;">
                                <pre id="attemptParams<%= attempt.id %>" class="text-white mb-0" style="white-space: pre-wrap; word-break: break-all;"><%= attempt.params.presence || 'N/A' %></pre>
                              </div>
                            </div>

                            <div>
                              <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="text-info mb-0">Requisição (requisition)</h6>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="copyAttemptField(this, 'attemptRequisition<%= attempt.id %>')">
                                  <i class="fas fa-copy me-1"></i>Copiar
                                </button>
                              </div>
                              <div class="bg-black p-3 rounded" style="max-height: 300px; overflow-y: auto;">
                                <pre id="attemptRequisition<%= attempt.id %>" class="text-white mb-0" style="white-space: pre-wrap; word-break: break-all;"><%= attempt.requisition.presence || 'N/A' %></pre>
                              </div>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% else %>
                    <span class="text-muted-custom">-</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <span class="fw-bold text-main"><%= attempt.id %></span>
                  <button type="button" class="btn-copy-cell" data-copy-value="<%= attempt.id %>" title="Copiar ID">
                    <i class="fas fa-copy"></i>
                  </button>
                </td>
                <td class="text-center">
                  <div class="d-flex flex-column align-items-center">
                    <span class="fw-bold text-main">
                      <%= attempt.tiny_order_id %>
                      <button type="button" class="btn-copy-cell" data-copy-value="<%= attempt.tiny_order_id %>" title="Copiar ID do pedido">
                        <i class="fas fa-copy"></i>
                      </button>
                    </span>
                    <button class="btn btn-sm btn-outline-primary mt-1"
                            onclick="window.open('<%= ENV.fetch('TINY_SELLS_URL') %>#edit/<%= attempt.tiny_order_id %>', '_blank');"
                            title="Ver no Tiny">
                      <i class="fas fa-external-link-alt me-1"></i>Ver no Tiny
                    </button>
                  </div>
                </td>
                <td class="text-center">
                  <% case attempt.kinds %>
                  <% when 'create_correios_order' %>
                    <span class="badge bg-primary">
                      <i class="fas fa-plus-circle"></i> Criação Correios
                    </span>
                  <% when 'emission_invoice' %>
                    <span class="badge bg-warning text-dark">
                      <i class="fas fa-file-invoice"></i> Emissão Nota
                    </span>
                  <% when 'send_xml' %>
                    <span class="badge bg-info text-dark">
                      <i class="fas fa-file-code"></i> Envio XML
                    </span>
                  <% when 'get_tracking' %>
                    <span class="badge bg-success">
                      <i class="fas fa-shipping-fast"></i> Rastreamento
                    </span>
                  <% else %>
                    <span class="badge bg-secondary"><%= attempt.kinds %></span>
                  <% end %>
                  <button type="button" class="btn-copy-cell" data-copy-value="<%= attempt.kinds %>" title="Copiar tipo">
                    <i class="fas fa-copy"></i>
                  </button>
                </td>
                <td class="text-center">
                  <span class="text-main" title="<%= attempt.message %>">
                    <%= truncate(attempt.message, length: 30) %>
                  </span>
                  <% if attempt.message.present? %>
                    <button type="button" class="btn-copy-cell" data-copy-value="<%= attempt.message %>" title="Copiar mensagem completa">
                      <i class="fas fa-copy"></i>
                    </button>
                  <% end %>
                </td>
                <td class="text-center">
                  <% case attempt.status %>
                  <% when 0 %>
                    <span class="badge bg-warning text-dark">
                      <i class="fas fa-clock"></i> Pendente
                    </span>
                  <% when 1 %>
                    <span class="badge bg-primary">
                      <i class="fas fa-spinner fa-spin"></i> Processando
                    </span>
                  <% when 2 %>
                    <span class="badge bg-success">
                      <i class="fas fa-check-circle"></i> Sucesso
                    </span>
                  <% when 3 %>
                    <span class="badge bg-danger">
                      <i class="fas fa-times-circle"></i> Erro
                    </span>
                  <% else %>
                    <span class="badge bg-secondary"><%= attempt.status %></span>
                  <% end %>
                  <button type="button" class="btn-copy-cell" data-copy-value="<%= attempt.status %>" title="Copiar status">
                    <i class="fas fa-copy"></i>
                  </button>
                </td>
                <td class="text-center">
                  <div class="d-flex flex-column align-items-center">
                    <span class="text-main">
                      <%= attempt.status_code %>
                      <% if attempt.status_code.present? %>
                        <button type="button" class="btn-copy-cell" data-copy-value="<%= attempt.status_code %>" title="Copiar status code">
                          <i class="fas fa-copy"></i>
                        </button>
                      <% end %>
                    </span>
                    <% if attempt.message.present? %>
                      <small class="text-muted-custom" title="<%= attempt.message %>">
                        <%= truncate(attempt.message, length: 20) %>
                      </small>
                    <% end %>
                  </div>
                </td>
                <td class="text-center">
                  <% if attempt.error.present? %>
                    <span class="text-danger" title="<%= attempt.error %>">
                      <i class="fas fa-exclamation-triangle"></i>
                      <%= truncate(attempt.error, length: 20) %>
                    </span>
                    <button type="button" class="btn-copy-cell" data-copy-value="<%= attempt.error %>" title="Copiar erro completo">
                      <i class="fas fa-copy"></i>
                    </button>

                    <% if attempt.kinds.in?(%w[create_correios_order create_correios_order_tiny2]) && attempt.error.to_s.downcase.include?('bairro') %>
                      <br>
                      <button type="button" class="btn btn-sm btn-outline-warning mt-1"
                              onclick="openBairroFixModal(<%= attempt.id %>, '<%= attempt.tiny_order_id %>', <%= attempt.kinds == 'create_correios_order_tiny2' %>)"
                              title="Corrigir bairro">
                        <i class="fas fa-map-marker-alt me-1"></i>Corrigir Bairro
                      </button>
                    <% end %>
                  <% else %>
                    <span class="text-muted-custom">-</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if attempt.xml_nota.present? %>
                    <div class="d-flex justify-content-center gap-2">
                      <button class="btn btn-sm btn-outline-success"
                              onclick="copiarConteudo(<%= attempt.id %>)"
                              title="Copiar XML">
                        <i class="fas fa-copy me-1"></i>Copiar XML
                      </button>

                      <a href="<%= download_xml_attempts_path(id: attempt.id) %>"
                        class="btn btn-sm btn-outline-info"
                        title="Baixar XML">
                        <i class="fas fa-download me-1"></i>Baixar XML
                      </a>
                    </div>

                    <span class="content<%= attempt.id %>" style="display:none">
                      <%= attempt.xml_nota %>
                    </span>
                  <% else %>
                    <span class="text-muted-custom">-</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <div class="d-flex flex-column align-items-center">
                    <span class="text-main"><%= attempt.created_at.strftime('%d/%m/%Y') %></span>
                    <small class="text-muted-custom"><%= attempt.created_at.strftime('%H:%M') %></small>
                    <button type="button" class="btn-copy-cell" data-copy-value="<%= attempt.created_at.strftime('%d/%m/%Y %H:%M') %>" title="Copiar data">
                      <i class="fas fa-copy"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="pagination-footer">
        <div class="pagination-info">
          <%= page_entries_info @attempts %>
        </div>
        <div class="pagination-controls">
          <%= will_paginate @attempts,
              class: 'pagination pagination-dark justify-content-center',
              inner_window: 1,
              previous_label: '<i class="fas fa-chevron-left"></i>'.html_safe,
              next_label: '<i class="fas fa-chevron-right"></i>'.html_safe %>
        </div>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-search fa-3x mb-3 d-block"></i>
        <h5>Nenhuma tentativa encontrada</h5>
        <p>Não há tentativas de integração para os filtros aplicados.</p>
      </div>
    <% end %>
  </div>

  <%# ===== MODAL: CORRIGIR BAIRRO ===== %>
  <div class="modal fade" id="bairroFixModal" tabindex="-1" aria-labelledby="bairroFixModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content bg-dark text-white">
        <div class="modal-header">
          <h5 class="modal-title" id="bairroFixModalLabel">Corrigir Bairro</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="bairroFixLoading" class="text-center py-3">
            <i class="fas fa-spinner fa-spin fa-2x"></i>
            <p class="mt-2 mb-0" id="bairroFixLoadingText">Buscando dados do pedido na Tiny...</p>
          </div>

          <div id="bairroFixContent" style="display:none">
            <div id="bairroFixWarning" class="alert alert-warning" style="display:none">
              <i class="fas fa-exclamation-triangle me-1"></i>
              Este pedido tem um endereço de entrega próprio na Tiny, diferente do cadastro do cliente.
              A correção abaixo atualiza apenas o <strong>cadastro do cliente</strong> — pode não refletir
              nesse pedido específico (limitação da API da Tiny).
            </div>

            <p class="mb-3">
              <strong>Pedido Tiny:</strong> <span id="bairroFixTinyOrderId"></span>
              <span id="bairroFixChannelBadge" class="badge ms-1"></span>
            </p>

            <div class="mb-3">
              <label for="bairroFixCep" class="form-label">CEP</label>
              <div class="input-group">
                <input type="text" class="form-control" id="bairroFixCep" placeholder="00000-000">
                <button class="btn btn-outline-info" type="button" id="bairroFixSearchBtn">
                  <i class="fas fa-search me-1"></i>Buscar CEP
                </button>
              </div>
              <small class="text-muted-custom" id="bairroFixCepAddress" style="display:none"></small>
            </div>

            <div class="row g-2 mb-2">
              <div class="col-8">
                <label for="bairroFixEndereco" class="form-label">Endereço</label>
                <input type="text" class="form-control" id="bairroFixEndereco" placeholder="Rua/Avenida">
              </div>
              <div class="col-4">
                <label for="bairroFixNumero" class="form-label">Número</label>
                <input type="text" class="form-control" id="bairroFixNumero">
              </div>
            </div>

            <div class="mb-2">
              <label for="bairroFixComplemento" class="form-label">Complemento</label>
              <input type="text" class="form-control" id="bairroFixComplemento">
            </div>

            <div class="mb-2">
              <label for="bairroFixBairro" class="form-label">Bairro <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="bairroFixBairro" placeholder="Digite ou confirme o bairro">
              <small class="text-muted-custom">Alguns CEPs (geralmente de cidade toda) não têm bairro no ViaCEP — nesse caso digite manualmente.</small>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-8">
                <label for="bairroFixCidade" class="form-label">Cidade</label>
                <input type="text" class="form-control" id="bairroFixCidade">
              </div>
              <div class="col-4">
                <label for="bairroFixUf" class="form-label">UF</label>
                <input type="text" class="form-control" id="bairroFixUf" maxlength="2">
              </div>
            </div>

            <div id="bairroFixResult" style="display:none"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
          <button type="button" class="btn btn-primary" id="bairroFixConfirmBtn" style="display:none">
            <i class="fas fa-check me-1"></i>Confirmar Correção
          </button>
          <button type="button" class="btn btn-success" id="bairroFixRetryBtn" style="display:none">
            <i class="fas fa-redo me-1"></i>Tentar Criar Pedido Novamente
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :styles do %>
  <style>
    .btn-copy-cell {
      background: transparent;
      border: none;
      color: #8a94a6;
      padding: 0 4px;
      margin-left: 2px;
      cursor: pointer;
      font-size: 0.75rem;
      line-height: 1;
      vertical-align: middle;
    }

    .btn-copy-cell:hover {
      color: #fff;
    }

    .btn-copy-cell.copy-success {
      color: #28a745;
    }

    .btn-copy-cell.copy-error {
      color: #dc3545;
    }
  </style>
<% end %>

<% content_for :scripts do %>
  <script>
    function copyAttemptField(button, elementId) {
      var el = document.getElementById(elementId);
      if (!el) return;

      navigator.clipboard.writeText(el.textContent).then(function() {
        var original = button.innerHTML;
        button.innerHTML = '<i class="fas fa-check me-1"></i>Copiado!';
        setTimeout(function() {
          button.innerHTML = original;
        }, 2000);
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      if (document.getElementById('attemptsTable')) {
        $('#attemptsTable').DataTable({
          responsive: true,
          pageLength: 25,
          order: [[1, 'desc']],
          language: {
            url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
          },
          columnDefs: [
            { orderable: false, targets: [0] },
            { className: "text-center", targets: "_all" }
          ]
        });
      }

      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });

      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-copy-cell');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        copiarValorCelula(btn);
      });

      const cards = document.querySelectorAll('.card');
      cards.forEach((card, index) => {
        setTimeout(() => {
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, index * 50);
      });
    });

    function copiarValorCelula(botao) {
      var texto = botao.getAttribute('data-copy-value') || '';
      if (!texto) return;

      var aplicarFeedback = function(sucesso) {
        var icone = botao.querySelector('i');
        var classeOriginal = icone.className;

        icone.className = sucesso ? 'fas fa-check' : 'fas fa-times';
        botao.classList.add(sucesso ? 'copy-success' : 'copy-error');

        setTimeout(function() {
          icone.className = classeOriginal;
          botao.classList.remove('copy-success', 'copy-error');
        }, 1200);
      };

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(texto).then(function() {
          aplicarFeedback(true);
        }).catch(function() {
          aplicarFeedback(false);
        });
      } else {
        var areaTransferencia = document.createElement('textarea');
        areaTransferencia.value = texto;
        document.body.appendChild(areaTransferencia);
        areaTransferencia.select();

        try {
          aplicarFeedback(document.execCommand('copy'));
        } catch (err) {
          aplicarFeedback(false);
        }

        document.body.removeChild(areaTransferencia);
      }
    }

    function copiarConteudo(id) {
      var conteudo = document.querySelector('.content' + id);
      if (conteudo) {
        var texto = conteudo.textContent.trim();

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(texto).then(function() {
            showCopyFeedback(id, true);
          }).catch(function(err) {
            console.error('Erro ao copiar: ', err);
            showCopyFeedback(id, false);
          });
        } else {
          var areaTransferencia = document.createElement('textarea');
          areaTransferencia.value = texto;
          document.body.appendChild(areaTransferencia);
          areaTransferencia.select();

          try {
            var sucesso = document.execCommand('copy');
            showCopyFeedback(id, sucesso);
          } catch (err) {
            console.error('Erro ao copiar: ', err);
            showCopyFeedback(id, false);
          }

          document.body.removeChild(areaTransferencia);
        }
      }
    }

    var bairroFixState = {};

    function openBairroFixModal(attemptId, tinyOrderId, isB2b) {
      var modalEl = document.getElementById('bairroFixModal');
      var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      var channelLabel = isB2b ? 'Tiny 2 (B2B)' : 'Tiny 3 (B2C)';

      bairroFixState = { attemptId: attemptId, tinyOrderId: tinyOrderId, kinds: null, cpfCnpj: null };

      document.getElementById('bairroFixLoadingText').textContent = 'Buscando dados do pedido no ' + channelLabel + '...';

      var channelBadge = document.getElementById('bairroFixChannelBadge');
      channelBadge.textContent = channelLabel;
      channelBadge.className = 'badge ms-1 ' + (isB2b ? 'bg-info text-dark' : 'bg-primary');

      document.getElementById('bairroFixLoading').style.display = 'block';
      document.getElementById('bairroFixContent').style.display = 'none';
      document.getElementById('bairroFixWarning').style.display = 'none';
      document.getElementById('bairroFixCepAddress').style.display = 'none';
      document.getElementById('bairroFixResult').style.display = 'none';
      document.getElementById('bairroFixResult').innerHTML = '';
      ['bairroFixCep', 'bairroFixEndereco', 'bairroFixNumero', 'bairroFixComplemento',
       'bairroFixBairro', 'bairroFixCidade', 'bairroFixUf'].forEach(function(id) {
        document.getElementById(id).value = '';
      });
      document.getElementById('bairroFixConfirmBtn').style.display = 'none';
      document.getElementById('bairroFixRetryBtn').style.display = 'none';
      document.getElementById('bairroFixTinyOrderId').textContent = tinyOrderId;

      modal.show();

      fetch('<%= bairro_lookup_attempts_path %>?attempt_id=' + encodeURIComponent(attemptId), {
        headers: { 'Accept': 'application/json' }
      })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          document.getElementById('bairroFixLoading').style.display = 'none';

          if (!data.success) {
            document.getElementById('bairroFixResult').style.display = 'block';
            document.getElementById('bairroFixResult').innerHTML =
              '<div class="alert alert-danger mb-0">' + (data.error || 'Erro ao buscar pedido na Tiny') + '</div>';
            return;
          }

          bairroFixState.kinds = data.kinds;
          bairroFixState.cpfCnpj = data.cpf_cnpj;

          document.getElementById('bairroFixContent').style.display = 'block';
          document.getElementById('bairroFixCep').value = data.cep || '';
          document.getElementById('bairroFixEndereco').value = data.endereco || '';
          document.getElementById('bairroFixNumero').value = data.numero || '';
          document.getElementById('bairroFixComplemento').value = data.complemento || '';
          document.getElementById('bairroFixBairro').value = data.bairro || '';
          document.getElementById('bairroFixCidade').value = data.cidade || '';
          document.getElementById('bairroFixUf').value = data.uf || '';
          document.getElementById('bairroFixWarning').style.display = data.endereco_entrega_presente ? 'block' : 'none';
          document.getElementById('bairroFixConfirmBtn').style.display = 'inline-block';
        })
        .catch(function(err) {
          document.getElementById('bairroFixLoading').style.display = 'none';
          document.getElementById('bairroFixResult').style.display = 'block';
          document.getElementById('bairroFixResult').innerHTML =
            '<div class="alert alert-danger mb-0">Falha de comunicação: ' + err.message + '</div>';
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
      var searchCepBtn = document.getElementById('bairroFixSearchBtn');
      if (searchCepBtn) {
        searchCepBtn.addEventListener('click', function() {
          var cep = document.getElementById('bairroFixCep').value.replace(/\D/g, '');
          var addressEl = document.getElementById('bairroFixCepAddress');

          if (cep.length !== 8) {
            addressEl.style.display = 'block';
            addressEl.textContent = 'CEP inválido.';
            return;
          }

          searchCepBtn.disabled = true;
          searchCepBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

          fetch('https://viacep.com.br/ws/' + cep + '/json/')
            .then(function(response) { return response.json(); })
            .then(function(data) {
              addressEl.style.display = 'block';

              if (data.erro) {
                addressEl.textContent = 'CEP não encontrado no ViaCEP.';
                return;
              }

              if (data.logradouro) document.getElementById('bairroFixEndereco').value = data.logradouro;
              if (data.localidade) document.getElementById('bairroFixCidade').value = data.localidade;
              if (data.uf) document.getElementById('bairroFixUf').value = data.uf;

              if (data.bairro) {
                document.getElementById('bairroFixBairro').value = data.bairro;
                addressEl.textContent = 'Endereço preenchido a partir do ViaCEP.';
              } else {
                addressEl.textContent = 'Este CEP não tem bairro cadastrado no ViaCEP (comum em CEPs gerais de cidade) — digite o bairro manualmente.';
              }
            })
            .catch(function() {
              addressEl.style.display = 'block';
              addressEl.textContent = 'Falha ao consultar o ViaCEP.';
            })
            .finally(function() {
              searchCepBtn.disabled = false;
              searchCepBtn.innerHTML = '<i class="fas fa-search me-1"></i>Buscar CEP';
            });
        });
      }

      var confirmBtn = document.getElementById('bairroFixConfirmBtn');
      if (confirmBtn) {
        confirmBtn.addEventListener('click', function() {
          var bairro = document.getElementById('bairroFixBairro').value.trim();
          var resultEl = document.getElementById('bairroFixResult');

          if (!bairro) {
            resultEl.style.display = 'block';
            resultEl.innerHTML = '<div class="alert alert-warning mb-0">Informe o bairro antes de confirmar.</div>';
            return;
          }

          confirmBtn.disabled = true;
          confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Corrigindo...';

          fetch('<%= fix_bairro_attempts_path %>', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({
              attempt_id: bairroFixState.attemptId,
              cpf_cnpj: bairroFixState.cpfCnpj,
              endereco: document.getElementById('bairroFixEndereco').value.trim(),
              numero: document.getElementById('bairroFixNumero').value.trim(),
              complemento: document.getElementById('bairroFixComplemento').value.trim(),
              bairro: bairro,
              cep: document.getElementById('bairroFixCep').value.trim(),
              cidade: document.getElementById('bairroFixCidade').value.trim(),
              uf: document.getElementById('bairroFixUf').value.trim()
            })
          })
            .then(function(response) { return response.json(); })
            .then(function(data) {
              resultEl.style.display = 'block';

              if (data.success) {
                resultEl.innerHTML = '<div class="alert alert-success mb-0"><i class="fas fa-check-circle me-1"></i>Endereço corrigido na Tiny com sucesso!</div>';
                confirmBtn.style.display = 'none';
                document.getElementById('bairroFixRetryBtn').style.display = 'inline-block';
              } else {
                resultEl.innerHTML = '<div class="alert alert-danger mb-0">' + (data.error || 'Erro ao corrigir bairro') + '</div>';
              }
            })
            .catch(function(err) {
              resultEl.style.display = 'block';
              resultEl.innerHTML = '<div class="alert alert-danger mb-0">Falha de comunicação: ' + err.message + '</div>';
            })
            .finally(function() {
              confirmBtn.disabled = false;
              confirmBtn.innerHTML = '<i class="fas fa-check me-1"></i>Confirmar Correção';
            });
        });
      }

      var retryBtn = document.getElementById('bairroFixRetryBtn');
      if (retryBtn) {
        retryBtn.addEventListener('click', function() {
          var resultEl = document.getElementById('bairroFixResult');
          var retryUrl = bairroFixState.kinds === 'create_correios_order_tiny2'
            ? '<%= run_order_correios_create_b2b_now_dashboard_index_path %>'
            : '<%= run_order_correios_create_now_dashboard_index_path %>';

          retryBtn.disabled = true;
          retryBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Recriando...';

          fetch(retryUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ attempt_id: bairroFixState.tinyOrderId })
          })
            .then(function(response) { return response.json(); })
            .then(function(data) {
              resultEl.style.display = 'block';

              if (data.success) {
                resultEl.innerHTML += '<div class="alert alert-success mb-0 mt-2"><i class="fas fa-check-circle me-1"></i>Pedido criado no Correios com sucesso! Recarregando...</div>';
                setTimeout(function() { location.reload(); }, 1500);
              } else {
                resultEl.innerHTML += '<div class="alert alert-danger mb-0 mt-2">Falha ao recriar: ' + (data.error || 'erro desconhecido') + '</div>';
              }
            })
            .catch(function(err) {
              resultEl.style.display = 'block';
              resultEl.innerHTML += '<div class="alert alert-danger mb-0 mt-2">Falha de comunicação: ' + err.message + '</div>';
            })
            .finally(function() {
              retryBtn.disabled = false;
              retryBtn.innerHTML = '<i class="fas fa-redo me-1"></i>Tentar Criar Pedido Novamente';
            });
        });
      }
    });

    function showCopyFeedback(id, sucesso) {
      var botao = document.querySelector(`button[onclick="copiarConteudo(${id})"]`);
      if (botao) {
        var textoOriginal = botao.innerHTML;

        if (sucesso) {
          botao.innerHTML = '<i class="fas fa-check me-1"></i>Copiado!';
          botao.classList.remove('btn-outline-success');
          botao.classList.add('btn-success');
        } else {
          botao.innerHTML = '<i class="fas fa-times me-1"></i>Erro!';
          botao.classList.remove('btn-outline-success');
          botao.classList.add('btn-danger');
        }

        setTimeout(function() {
          botao.innerHTML = textoOriginal;
          botao.classList.remove('btn-success', 'btn-danger');
          botao.classList.add('btn-outline-success');
        }, 2000);
      }
    }
  </script>
<% end %>
