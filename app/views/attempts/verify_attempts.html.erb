<div class="container-fluid py-4">
  <% title 'Tentativas de Integração' %>

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <i class="fas fa-history me-2"></i>Tentativas de Integração
      </h1>
      <p class="page-subtitle">
        <i class="fas fa-info-circle me-1"></i>
        Histórico completo de todas as tentativas de integração com os sistemas externos (Correios, Tiny, etc.)
      </p>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-list me-1"></i><%= page_entries_info @attempts %>
      </span>
      <a href="<%= root_path %>" class="btn btn-dark">
        <i class="fas fa-tachometer-alt me-1"></i> Dashboard
      </a>
      <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse" aria-expanded="false" aria-controls="filtersCollapse">
        <i class="fas fa-filter me-1"></i> Filtros
      </button>
    </div>
  </div>

  <%# ===== PAINEL DE FILTROS ===== %>
  <div class="collapse mb-4" id="filtersCollapse">
    <div class="filters-panel">
      <form method="get">
        <%= hidden_field_tag :tiny_order_id, params[:tiny_order_id] %>
        <div class="filter-section">
          <div class="row g-3">
            <div class="col-md-3">
              <label for="status" class="filter-label">Status</label>
              <select name="status" id="status" class="form-select">
                <option value="">Todos</option>
                <option value="0">Pendente</option>
                <option value="1">Processando</option>
                <option value="2">Sucesso</option>
                <option value="3">Erro</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="kinds" class="filter-label">Tipo</label>
              <select name="kinds" id="kinds" class="form-select">
                <option value="">Todos</option>
                <option value="create_correios_order" <%= 'selected' if params[:kinds] == 'create_correios_order' %>>Criação Correios</option>
                <option value="send_xml" <%= 'selected' if params[:kinds] == 'send_xml' %>>Envio XML</option>
                <option value="emission_invoice" <%= 'selected' if params[:kinds] == 'emission_invoice' %>>Emissão de Nota</option>
                <option value="get_tracking" <%= 'selected' if params[:kinds] == 'get_tracking' %>>Rastreamento</option>
                <option value="create_note_tiny2" <%= 'selected' if params[:kinds] == 'create_note_tiny2' %>>Criação de Nota no Tiny2</option>
                <option value="emission_invoice_tiny2" <%= 'selected' if params[:kinds] == 'emission_invoice_tiny2' %>>Emissão de Nota Fiscal no Tiny2</option>
                <option value="transfer_tiny_to_shopify_order" <%= 'selected' if params[:kinds] == 'transfer_tiny_to_shopify_order' %>>Transferência Tiny para Shopify</option>
                <option value="sync_correios_stock" <%= 'selected' if params[:kinds] == 'sync_correios_stock' %>>Sincronização de Estoque Correios</option>
                <option value="create_correios_order_tiny2" <%= 'selected' if params[:kinds] == 'create_correios_order_tiny2' %>>Criação Correios (B2B)</option>
                <option value="send_xml_tiny2" <%= 'selected' if params[:kinds] == 'send_xml_tiny2' %>>Envio XML (B2B)</option>
                <option value="get_tracking_tiny2" <%= 'selected' if params[:kinds] == 'get_tracking_tiny2' %>>Rastreamento (B2B)</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="period" class="filter-label">Período</label>
              <select name="period" id="period" class="form-select">
                <option value="">Todo o período</option>
                <option value="today">Hoje</option>
                <option value="7">Últimos 7 dias</option>
                <option value="30">Últimos 30 dias</option>
                <option value="90">Últimos 90 dias</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="order_id" class="filter-label">ID do Pedido</label>
              <input type="text" name="order_id" id="order_id" class="form-control" placeholder="Ex: 123456">
            </div>
          </div>
          <div class="mt-3 text-end">
            <button type="submit" class="btn-primary-sm">
              <i class="fas fa-search me-1"></i> Aplicar Filtros
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">

    <div class="table-card-header">
      <h5 class="table-card-title">
        <i class="fas fa-history me-2"></i>Tentativas de Integração
      </h5>
    </div>

    <% if @attempts.present? %>
      <div class="table-responsive">
        <table class="orders-table" id="attemptsTable">
          <thead>
            <tr>
              <th class="text-center">
                <i class="fas fa-hashtag me-1"></i>
                <%= Attempt.human_attribute_name :id %>
              </th>
              <th class="text-center">
                <i class="fas fa-shopping-cart me-1"></i>
                <%= Attempt.human_attribute_name :tiny_order_id %>
              </th>
              <th class="text-center">
                <i class="fas fa-cog me-1"></i>
                <%= Attempt.human_attribute_name :kinds %>
              </th>
              <th class="text-center">
                <i class="fas fa-comment me-1"></i>
                <%= Attempt.human_attribute_name :message %>
              </th>
              <th class="text-center">
                <i class="fas fa-info-circle me-1"></i>
                <%= Attempt.human_attribute_name :status %>
              </th>
              <th class="text-center">
                <i class="fas fa-code me-1"></i>
                <%= Attempt.human_attribute_name :status_code %>
              </th>
              <th class="text-center">
                <i class="fas fa-exclamation-triangle me-1"></i>
                <%= Attempt.human_attribute_name :error %>
              </th>
              <th class="text-center">
                <i class="fas fa-file-code me-1"></i>
                XML Enviado
              </th>
              <th class="text-center">
                <i class="fas fa-calendar me-1"></i>
                <%= Attempt.human_attribute_name :created_at %>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @attempts.each do |attempt| %>
              <tr>
                <td class="text-center">
                  <span class="fw-bold text-main"><%= attempt.id %></span>
                </td>
                <td class="text-center">
                  <div class="d-flex flex-column align-items-center">
                    <span class="fw-bold text-main"><%= attempt.tiny_order_id %></span>
                    <button class="btn btn-sm btn-outline-primary mt-1"
                            onclick="window.open('<%= ENV.fetch('TINY_SELLS_URL') %>#edit/<%= attempt.tiny_order_id %>', '_blank');"
                            title="Ver no Tiny">
                      <i class="fas fa-external-link-alt me-1"></i>Ver no Tiny
                    </button>
                  </div>
                </td>
                <td class="text-center">
                  <% case attempt.kinds %>
                  <% when 'create_correios_order' %>
                    <span class="badge bg-primary">
                      <i class="fas fa-plus-circle"></i> Criação Correios
                    </span>
                  <% when 'emission_invoice' %>
                    <span class="badge bg-warning text-dark">
                      <i class="fas fa-file-invoice"></i> Emissão Nota
                    </span>
                  <% when 'send_xml' %>
                    <span class="badge bg-info text-dark">
                      <i class="fas fa-file-code"></i> Envio XML
                    </span>
                  <% when 'get_tracking' %>
                    <span class="badge bg-success">
                      <i class="fas fa-shipping-fast"></i> Rastreamento
                    </span>
                  <% else %>
                    <span class="badge bg-secondary"><%= attempt.kinds %></span>
                  <% end %>
                </td>
                <td class="text-center">
                  <span class="text-main" title="<%= attempt.message %>">
                    <%= truncate(attempt.message, length: 30) %>
                  </span>
                </td>
                <td class="text-center">
                  <% case attempt.status %>
                  <% when 0 %>
                    <span class="badge bg-warning text-dark">
                      <i class="fas fa-clock"></i> Pendente
                    </span>
                  <% when 1 %>
                    <span class="badge bg-primary">
                      <i class="fas fa-spinner fa-spin"></i> Processando
                    </span>
                  <% when 2 %>
                    <span class="badge bg-success">
                      <i class="fas fa-check-circle"></i> Sucesso
                    </span>
                  <% when 3 %>
                    <span class="badge bg-danger">
                      <i class="fas fa-times-circle"></i> Erro
                    </span>
                  <% else %>
                    <span class="badge bg-secondary"><%= attempt.status %></span>
                  <% end %>
                </td>
                <td class="text-center">
                  <div class="d-flex flex-column align-items-center">
                    <span class="text-main"><%= attempt.status_code %></span>
                    <% if attempt.message.present? %>
                      <small class="text-muted-custom" title="<%= attempt.message %>">
                        <%= truncate(attempt.message, length: 20) %>
                      </small>
                    <% end %>
                  </div>
                </td>
                <td class="text-center">
                  <% if attempt.error.present? %>
                    <span class="text-danger" title="<%= attempt.error %>">
                      <i class="fas fa-exclamation-triangle"></i>
                      <%= truncate(attempt.error, length: 20) %>
                    </span>
                  <% else %>
                    <span class="text-muted-custom">-</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if attempt.xml_nota.present? %>
                    <div class="d-flex justify-content-center gap-2">
                      <button class="btn btn-sm btn-outline-success"
                              onclick="copiarConteudo(<%= attempt.id %>)"
                              title="Copiar XML">
                        <i class="fas fa-copy me-1"></i>Copiar XML
                      </button>

                      <a href="<%= download_xml_attempts_path(id: attempt.id) %>"
                        class="btn btn-sm btn-outline-info"
                        title="Baixar XML">
                        <i class="fas fa-download me-1"></i>Baixar XML
                      </a>
                    </div>

                    <span class="content<%= attempt.id %>" style="display:none">
                      <%= attempt.xml_nota %>
                    </span>
                  <% else %>
                    <span class="text-muted-custom">-</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <div class="d-flex flex-column align-items-center">
                    <span class="text-main"><%= attempt.created_at.strftime('%d/%m/%Y') %></span>
                    <small class="text-muted-custom"><%= attempt.created_at.strftime('%H:%M') %></small>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="pagination-footer">
        <div class="pagination-info">
          <%= page_entries_info @attempts %>
        </div>
        <div class="pagination-controls">
          <%= will_paginate @attempts,
              class: 'pagination pagination-dark justify-content-center',
              inner_window: 1,
              previous_label: '<i class="fas fa-chevron-left"></i>'.html_safe,
              next_label: '<i class="fas fa-chevron-right"></i>'.html_safe %>
        </div>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-search fa-3x mb-3 d-block"></i>
        <h5>Nenhuma tentativa encontrada</h5>
        <p>Não há tentativas de integração para os filtros aplicados.</p>
      </div>
    <% end %>
  </div>
</div>

<% content_for :styles do %>
<% end %>

<% content_for :scripts do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (document.getElementById('attemptsTable')) {
        $('#attemptsTable').DataTable({
          responsive: true,
          pageLength: 25,
          order: [[0, 'desc']],
          language: {
            url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
          },
          columnDefs: [
            { className: "text-center", targets: "_all" }
          ]
        });
      }

      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });

      const cards = document.querySelectorAll('.card');
      cards.forEach((card, index) => {
        setTimeout(() => {
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, index * 50);
      });
    });

    function copiarConteudo(id) {
      var conteudo = document.querySelector('.content' + id);
      if (conteudo) {
        var texto = conteudo.textContent.trim();

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(texto).then(function() {
            showCopyFeedback(id, true);
          }).catch(function(err) {
            console.error('Erro ao copiar: ', err);
            showCopyFeedback(id, false);
          });
        } else {
          var areaTransferencia = document.createElement('textarea');
          areaTransferencia.value = texto;
          document.body.appendChild(areaTransferencia);
          areaTransferencia.select();

          try {
            var sucesso = document.execCommand('copy');
            showCopyFeedback(id, sucesso);
          } catch (err) {
            console.error('Erro ao copiar: ', err);
            showCopyFeedback(id, false);
          }

          document.body.removeChild(areaTransferencia);
        }
      }
    }

    function showCopyFeedback(id, sucesso) {
      var botao = document.querySelector(`button[onclick="copiarConteudo(${id})"]`);
      if (botao) {
        var textoOriginal = botao.innerHTML;

        if (sucesso) {
          botao.innerHTML = '<i class="fas fa-check me-1"></i>Copiado!';
          botao.classList.remove('btn-outline-success');
          botao.classList.add('btn-success');
        } else {
          botao.innerHTML = '<i class="fas fa-times me-1"></i>Erro!';
          botao.classList.remove('btn-outline-success');
          botao.classList.add('btn-danger');
        }

        setTimeout(function() {
          botao.innerHTML = textoOriginal;
          botao.classList.remove('btn-success', 'btn-danger');
          botao.classList.add('btn-outline-success');
        }, 2000);
      }
    }
  </script>
<% end %>
