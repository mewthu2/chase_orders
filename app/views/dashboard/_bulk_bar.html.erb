<%# Barra de ação em lote (pg-bulk do protótipo); os ids são os que o JS de execução usa. %>
<div class="pg-bulk">
  <span><b id="bulkRunCount">0</b> selecionados</span>
  <button type="button" class="btn btn-sm btn-primary" id="bulkRunBtn" disabled><i class="<%= icon %>"></i><%= label %></button>
  <button type="button" class="btn btn-ghost btn-sm" id="bulkClearBtn">Limpar seleção</button>
  <span class="pg-bulk-hint"><%= hint %></span>
</div>
