<%# Topo das telas "API Correios - Consultas". O comportamento fica nos controllers Stimulus
    stock-lookup (estoque de um item) e frame-lookup (rastreio, respondido num Turbo Frame).
    Locais: title, subtitle, cross_label, b2b. %>
<% b2b_param = b2b ? 1 : 0 %>
<%= hc_page_header title, subtitle, icon: 'fas fa-cogs' do %>
  <button type="button" class="btn btn-export" data-controller="modal-opener" data-modal-opener-modal-outlet="#bulkStockModal" data-action="modal-opener#open"><i class="fas fa-list-check"></i>Consultar estoque em lote</button>
<% end %>

<% if within_schedule? %>
  <div class="callout pg-banner is-ok"><i class="fas fa-circle-check"></i><div><strong>API Correios online.</strong> Consultas sendo processadas normalmente. A API atende de segunda a sexta, das 08:00 às 22:00.</div></div>
<% else %>
  <div class="callout pg-banner is-warn"><i class="fas fa-moon"></i><div><strong>API Correios offline.</strong> Fora do horário de funcionamento. As consultas voltam de segunda a sexta, às 08:00.</div></div>
<% end %>

<div class="pg-blocks">
  <div class="pg-split" style="--cols: 1.5fr 1fr">
    <div class="pg-split-a">
      <div class="panel pg-card pg-lookup spot"
           data-controller="stock-lookup"
           data-stock-lookup-b2b-value="<%= b2b %>"
           data-stock-lookup-stock-url-value="<%= stockend_dashboard_index_path %>"
           data-stock-lookup-search-url-value="<%= search_product_dashboard_index_path %>"
           data-stock-lookup-stuck-url-value="<%= stuck_orders_dashboard_index_path %>"
           data-stock-lookup-cross-url-value="<%= b2b ? api_correios_dashboard_index_path : api_correios_b2b_dashboard_index_path %>"
           data-stock-lookup-export-filename-value="<%= b2b ? 'lista_estoque_b2b' : 'lista_estoque' %>">
        <h3><i class="fas fa-box"></i>Buscar estoque de item</h3>
        <p class="pg-p" style="margin-bottom: 12px">Mostra o estoque disponível no armazém do Correios e se há pedidos travados por falta desse SKU.</p>
        <div class="pg-lk-form">
          <div class="filter-field" style="flex: 1">
            <label class="field-label" for="item_code">Buscar por SKU ou nome do produto</label>
            <div class="select-wrap pg-search"><input type="text" class="field-input" id="item_code" autocomplete="off" placeholder="Ex.: TOP-947-G ou &quot;harmony&quot;" data-stock-lookup-target="input" data-action="input->stock-lookup#suggest keydown->stock-lookup#keydown"></div>
          </div>
          <button class="btn btn-primary" type="button" data-stock-lookup-target="button" data-action="stock-lookup#search"><i class="fas fa-magnifying-glass" data-stock-lookup-target="icon"></i>Consultar</button>
        </div>
        <div class="list-group mt-2" data-stock-lookup-target="results"></div>
        <div class="pg-answer" data-stock-lookup-target="panel" hidden>
          <div style="display: flex; align-items: center; gap: 14px">
            <img alt="" style="width: 64px; height: 64px; object-fit: cover; border-radius: 10px; flex: none" data-stock-lookup-target="image" hidden>
            <div class="text-main" style="flex: 1" data-stock-lookup-target="result" aria-live="polite"></div>
          </div>
          <div style="display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap">
            <button type="button" class="btn btn-secondary btn-sm" data-stock-lookup-target="addButton" data-action="stock-lookup#addToList" hidden><i class="fas fa-plus"></i>Adicionar à lista</button>
            <a href="#" target="_blank" class="btn btn-ghost btn-sm" data-stock-lookup-target="crossLink" hidden><i class="fas fa-exchange-alt"></i><%= cross_label %></a>
          </div>
        </div>
        <div style="margin-top: 16px" data-stock-lookup-target="exportSection" hidden>
          <div class="pg-fsec">Lista para exportar (<span data-stock-lookup-target="exportCount">0</span>)</div>
          <div class="table-responsive" style="max-height: 260px; overflow-y: auto">
            <table class="orders-table pg-tbl pg-mini">
              <thead><tr><th></th><th>SKU</th><th>Nome</th><th style="width: 130px">Quantidade</th><th></th></tr></thead>
              <tbody data-stock-lookup-target="exportBody"></tbody>
            </table>
          </div>
          <button type="button" class="btn btn-primary btn-sm" style="margin-top: 10px" data-action="stock-lookup#downloadList"><i class="fas fa-file-export"></i>Exportar lista (CSV)</button>
        </div>
      </div>

      <div class="panel pg-card pg-lookup spot" data-controller="frame-lookup">
        <h3><i class="fas fa-route"></i>Buscar código de rastreio</h3>
        <p class="pg-p" style="margin-bottom: 12px">Digite o número do pedido e veja o código de rastreio e onde o pacote está.</p>
        <%= form_with url: tracking_dashboard_index_path, method: :get, class: 'pg-lk-form',
              data: { turbo: true, turbo_frame: 'tracking_lookup', action: 'turbo:submit-start->frame-lookup#start turbo:submit-end->frame-lookup#finish' } do %>
          <%= hidden_field_tag :b2b, b2b_param, id: nil %>
          <div class="filter-field" style="flex: 1">
            <label class="field-label" for="tracking_number">Número do pedido</label>
            <div class="select-wrap pg-search"><input type="text" class="field-input" id="tracking_number" name="tracking_number" placeholder="Ex.: 58213" required autocomplete="off"></div>
          </div>
          <button class="btn btn-primary" type="submit" data-frame-lookup-target="button"><i class="fas fa-magnifying-glass" data-frame-lookup-target="icon"></i>Consultar</button>
        <% end %>
        <%= turbo_frame_tag 'tracking_lookup', data: { frame_lookup_target: 'frame', action: 'turbo:frame-missing->frame-lookup#missing' } do %>
          <div class="pg-answer">
            <div class="text-main"><i class="fas fa-circle-info"></i> Digite o número de um pedido e clique em Consultar.</div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="pg-split-b">
      <div class="panel pg-card pg-howto">
        <h3><i class="fas fa-list-ol"></i>Instruções de uso</h3>
        <ol>
          <% ['<b>Estoque de item:</b> digite o SKU ou o nome e clique em Consultar.', '<b>Pedidos travados:</b> o resultado avisa se algum pedido espera esse SKU.',
              '<b>Rastreio:</b> digite o número do pedido, não o código dos Correios.', '<b>Várias de uma vez:</b> use Consultar estoque em lote, com planilha .csv.'].each_with_index do |text, i| %>
            <li style="--i: <%= i %>"><span class="n"><%= i + 1 %></span><span><%= text.html_safe %></span></li>
          <% end %>
        </ol>
      </div>
      <div class="panel pg-card">
        <h3><i class="fas fa-moon"></i>Fora do horário?</h3>
        <p class="pg-p">Das 22:00 às 08:00 e nos fins de semana a API fica offline. As telas continuam abertas, mas as consultas voltam só na segunda às 08:00.</p>
        <% if b2b %><div class="pg-fnote" style="margin: 12px 0 0"><i class="fas fa-circle-info"></i><span>Todas as consultas nesta tela usam o cartão de postagem e o token <b>B2B</b> (Tiny 2).</span></div><% end %>
      </div>
    </div>
  </div>
</div>
