<% title 'Funil de Pedidos no Correios' %>
<% periods = { 'today' => 'Hoje', '7' => '7 dias', '30' => '30 dias', '90' => '90 dias' } %>

<%= hc_page_header 'Funil de Pedidos (Log03)', 'Quantos pedidos passaram por cada etapa e quais estão parados.', icon: 'fas fa-stream' do %>
  <%= link_to order_correios_create_dashboard_index_path, class: 'btn btn-secondary' do %><i class="fas fa-plus-circle"></i>Criação de Pedidos<% end %>
<% end %>

<div class="callout pg-banner is-info"><i class="fas fa-circle-info"></i><div><strong>Como ler este painel.</strong> O funil mostra quantos pedidos já passaram por cada etapa no período. A lista abaixo traz só os que precisam de atenção: com erro na última tentativa ou parados há mais de 6 horas. Pedidos que nem chegaram ao Correios ficam em Criação de Pedidos.</div></div>

<div class="pg-blocks">
  <div class="scope-tabs pg-tabs" role="tablist">
    <% periods.each do |key, label| %>
      <%= link_to correios_pipeline_dashboard_index_path(period: key), class: "scope-tab#{' is-active' if @period == key}", role: 'tab', 'aria-selected': @period == key do %><i class="fas fa-calendar"></i><%= label %><% end %>
    <% end %>
  </div>

  <div id="pipelineLoading" class="panel pg-card" style="text-align: center; padding: 40px 20px">
    <span class="spinner" style="width: 28px; height: 28px"></span>
    <p class="pg-p" style="margin-top: 14px">Calculando o funil… isso pode levar até 30 segundos.</p>
  </div>
  <div id="pipelineError" class="callout pg-banner is-err" style="display: none"><i class="fas fa-triangle-exclamation"></i><div id="pipelineErrorText"></div></div>
  <div id="pipelineContent" style="display: none" class="pg-blocks"></div>
</div>

<% content_for :scripts do %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var STATUS_URL = <%= raw correios_pipeline_dashboard_index_path(period: @period, format: :json).to_json %>;
  var PERIOD = <%= raw periods[@period].to_s.to_json %>;
  var URLS = { invoice: <%= raw invoice_emition_dashboard_index_path.to_json %>, xml: <%= raw send_xml_dashboard_index_path.to_json %>, tracking: <%= raw push_tracking_dashboard_index_path.to_json %> };
  var CAN_RUN = <%= screen_can?(:dashboard_correios, :execute) ? 'true' : 'false' %>;
  var STAGE = { invoice: 'Aguardando nota', xml: 'Aguardando XML', tracking: 'Aguardando rastreio' };
  var REASON = { error: ['Com erro', '#f85149', 'A última tentativa falhou.'], idle: ['Parado há mais de 6 h', '#e3b341', 'Sem nova tentativa na etapa.'] };
  function esc (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function fmt (n) { return Number(n || 0).toLocaleString('pt-BR'); }

  function funnel (c) {
    var completed = c.completed || 0, tracking = c.tracking || 0, xml = c.xml || 0, invoice = c.invoice || 0;
    var steps = [
      { label: 'Criados no Correios', value: invoice + xml + tracking + completed, sub: 'Entraram no funil no período', tone: '#8b949e' },
      { label: 'Emissão de Notas', value: xml + tracking + completed, sub: 'esperam: ' + fmt(invoice), tone: '#e3b341', go: URLS.invoice },
      { label: 'Enviar XML', value: tracking + completed, sub: 'esperam: ' + fmt(xml), tone: '#58a6ff', go: URLS.xml },
      { label: 'Rastreamento (concluídos)', value: completed, sub: 'esperam: ' + fmt(tracking), tone: '#3fb950', go: URLS.tracking }
    ];
    var max = Math.max.apply(null, [1].concat(steps.map(function (s) { return s.value; })));
    return '<div class="panel pg-card pg-funnel"><h3><i class="fas fa-stream"></i>Do pedido ao rastreio</h3><p class="pg-p" style="margin-bottom:14px">' + esc(PERIOD) + '. Cada barra é quanto já passou da etapa. O número entre as barras é quanto ainda espera. Clique numa etapa para abrir a fila.</p><div class="pg-fn">' +
      steps.map(function (x, i) {
        var drop = i ? steps[i - 1].value - x.value : 0;
        var gap = i ? '<div class="pg-fn-gap"><i class="fas fa-arrow-down"></i>' + (drop > 0 ? ' ' + fmt(drop) + ' ainda não passaram' : '') + '</div>' : '';
        var tag = x.go ? 'a href="' + x.go + '"' : 'div';
        var close = x.go ? 'a' : 'div';
        return gap + '<' + tag + ' class="pg-fn-step" style="--w:' + Math.max(26, (x.value / max) * 100).toFixed(1) + '%;--i:' + i + ';--tone:' + x.tone + '"><span class="pg-fn-bar"><b>' + fmt(x.value) + '</b><span>' + esc(x.label) + '</span></span><small>' + esc(x.sub) + '</small>' + (x.go ? '<i class="fas fa-arrow-right go"></i>' : '') + '</' + close + '>';
      }).join('') + '</div></div>';
  }

  function kpis (attention) {
    var errors = attention.filter(function (r) { return r.reason === 'error'; }).length;
    var idle = attention.length - errors;
    var items = [
      ['Precisam de atenção', 'fas fa-triangle-exclamation', '#f0883e', 'Com erro ou parados. Veja a lista abaixo.', attention.length],
      ['Com erro', 'fas fa-circle-xmark', '#f85149', 'A última tentativa falhou.', errors],
      ['Parados há mais de 6 h', 'fas fa-hourglass-half', '#e3b341', 'Sem nova tentativa na etapa.', idle],
      ['Período', 'fas fa-calendar', '#58a6ff', 'Pedidos criados no Correios neste período.', PERIOD]
    ];
    return '<div class="kpi-grid stagger pg-kpis" style="--cols:4">' + items.map(function (k, i) {
      var num = typeof k[4] === 'number';
      return '<div class="pg-kpi is-static spot" style="--i:' + i + '"><div class="stat-card' + (num && !k[4] ? ' is-zero' : '') + '" style="--tone:' + k[2] + '"><span class="tone-bar"></span><div class="stat-top"><span class="ticket-stat__label">' + k[0] + '</span><span class="stat-ic"><i class="' + k[1] + '"></i></span></div><div class="stat-value' + (num ? '' : ' is-text') + '">' + (num ? fmt(k[4]) : esc(k[4])) + '</div><div class="stat-help"><span>' + k[3] + '</span></div></div></div>';
    }).join('') + '</div>';
  }

  function table (attention) {
    var head = '<div class="table-toolbar"><div><h3><i class="fas fa-exclamation-triangle" style="color:var(--text-3);margin-right:8px"></i>Pedidos que precisam de atenção</h3><div class="meta">Só os pedidos que já existem no Correios e não andaram. O mais antigo aparece primeiro.</div></div><div class="pg-tools"><a class="btn btn-secondary btn-sm" href="<%= attempts_path(channel: 'b2c') %>"><i class="fas fa-paperclip"></i>Verificar tentativas</a></div></div>';
    var legend = '<div class="legend"><span style="color:var(--text-4)">Situação:</span>' + Object.keys(REASON).map(function (k) { return '<span class="lg" data-tip="' + esc(REASON[k][0] + ': ' + REASON[k][2]) + '"><span class="dot" style="color:' + REASON[k][1] + '"></span>' + REASON[k][0] + '</span>'; }).join('') + '</div>';
    var shown = '<div class="active-filters"><span>Mostrando ' + fmt(attention.length) + ' ' + (attention.length === 1 ? 'pedido' : 'pedidos') + ':</span>' + legend + '</div>';
    if (!attention.length) {
      return '<section class="table-card pg-card">' + head + '<div class="pg-body">' + shown + '<div class="ticket-empty pg-empty"><h3>Nenhum pedido travado</h3><p>Todos os pedidos deste período estão andando ou já foram concluídos.</p></div></div></section>';
    }
    var rows = attention.map(function (r, i) {
      var reason = REASON[r.reason] || REASON.idle;
      var badge = r.address_correction === 'awaiting' ? '<span class="badge bg-warning text-dark address-correction-badge">Aguardando correção da nota no Tiny</span>'
        : (r.address_correction === 'corrected' ? '<span class="badge bg-info text-dark address-correction-badge">Endereço corrigido</span>' : '');
      var retry = (r.attempt_id && CAN_RUN)
        ? '<form method="get" action="/attempts/reprocess" style="display:inline" data-hc-confirm="' + esc(JSON.stringify({ title: 'Reprocessar o pedido ' + r.tiny_order_id + '?', text: 'O sistema repete agora a próxima etapa do pedido e fala de novo com o Tiny ou com o Correios. Se der certo, ele sai desta lista.', ok: 'Reprocessar', icon: 'fas fa-rotate-right' })) + '"><input type="hidden" name="attempt_id" value="' + r.attempt_id + '"><button type="submit" class="action-btn" data-tip="Reprocessar" aria-label="Reprocessar"><i class="fas fa-rotate-right"></i></button></form>'
        : '';
      return '<tr style="--i:' + i + '"><td class="title-cell" data-label="Pedido (Tiny)"><span class="mono pg-mono">' + esc(r.tiny_order_id) + '</span><button type="button" class="pg-copy" data-pg-copy="' + esc(r.tiny_order_id) + '" data-tip="Copiar"><i class="far fa-copy"></i></button>' + badge + '</td>' +
        '<td data-label="Etapa atual"><span class="pg-tag">' + esc(STAGE[r.current_stage] || r.current_stage) + '</span></td>' +
        '<td data-label="Motivo"><span class="ticket-status" style="--c:' + reason[1] + '">' + reason[0] + '</span></td>' +
        '<td data-label="Última mensagem"><span class="pg-txt">' + esc(r.message || '—') + '</span></td>' +
        '<td class="due" data-label="Última atividade"><b class="pg-d1">' + esc(r.last_activity_at || '—') + '</b></td>' +
        '<td class="td-actions" style="text-align:right" data-label=""><a class="action-btn" href="/attempts/verify_attempts?tiny_order_id=' + encodeURIComponent(r.tiny_order_id) + '" target="_blank" data-tip="Ver histórico" aria-label="Ver histórico"><i class="fas fa-paperclip"></i></a>' + retry + '</td></tr>';
    }).join('');
    return '<section class="table-card pg-card">' + head + '<div class="pg-body">' + shown + '<div class="table-responsive"><table class="orders-table pg-tbl"><thead><tr><th>Pedido (Tiny)</th><th>Etapa atual</th><th>Motivo</th><th>Última mensagem</th><th>Última atividade</th><th style="text-align:right">Ações</th></tr></thead><tbody class="stagger">' + rows + '</tbody></table></div>' +
      '<div class="table-footer"><span>Mostrando 1–' + attention.length + ' de ' + fmt(attention.length) + '</span></div></div></section>';
  }

  function show (err) {
    document.getElementById('pipelineLoading').style.display = 'none';
    document.getElementById('pipelineError').style.display = 'flex';
    document.getElementById('pipelineErrorText').innerHTML = '<strong>Não deu para calcular o funil.</strong> ' + esc(err);
  }
  function poll () {
    fetch(STATUS_URL, { headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (data.status === 'processing') { setTimeout(poll, 3000); return; }
        if (data.status === 'error') { show(data.error); return; }
        document.getElementById('pipelineLoading').style.display = 'none';
        var content = document.getElementById('pipelineContent');
        content.innerHTML = funnel(data.counts || {}) + kpis(data.attention || []) + table(data.attention || []);
        content.style.display = '';
      })
      .catch(function () { show('Erro de conexão.'); });
  }
  poll();
});
</script>
<% end %>
