<script>
  var runNowShouldReloadOnClose = false;

  function runNowIsBusy() {
    var modalEl = document.getElementById('runNowModal');
    return !!(modalEl && modalEl.classList.contains('show'));
  }

  function runQueueItemNow(url, attemptId, label) {
    var modalEl = document.getElementById('runNowModal');
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);

    document.getElementById('runNowModalLabel').textContent = label || 'Executando rotina...';
    document.getElementById('runNowLoading').style.display = 'block';
    document.getElementById('runNowBulkProgress').style.display = 'none';
    document.getElementById('runNowResult').style.display = 'none';
    document.getElementById('runNowMessageWrap').style.display = 'none';
    document.getElementById('runNowErrorWrap').style.display = 'none';
    document.getElementById('runNowParamsWrap').style.display = 'none';
    document.getElementById('runNowRequisitionWrap').style.display = 'none';
    document.getElementById('runNowXmlWrap').style.display = 'none';
    document.getElementById('runNowCloseBtn').disabled = false;
    document.getElementById('runNowModalCloseX').disabled = false;
    runNowShouldReloadOnClose = false;

    modal.show();

    fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({ attempt_id: attemptId })
    })
      .then(function(response) { return response.json(); })
      .then(function(data) { renderRunNowResult(data); })
      .catch(function(err) {
        renderRunNowResult({ success: false, error: 'Falha de comunicação com o servidor: ' + err.message });
      });
  }

  function renderRunNowResult(data) {
    document.getElementById('runNowModalLabel').textContent = 'Resultado da execução';
    document.getElementById('runNowLoading').style.display = 'none';
    document.getElementById('runNowResult').style.display = 'block';
    runNowShouldReloadOnClose = true;

    var banner = document.getElementById('runNowStatusBanner');
    if (data.success) {
      banner.innerHTML = '<div class="alert alert-success mb-0"><i class="fas fa-check-circle me-1"></i>Sucesso</div>';
    } else if (data.status === 'processing') {
      banner.innerHTML = '<div class="alert alert-warning mb-0 text-dark"><i class="fas fa-spinner me-1"></i>Processando</div>';
    } else {
      banner.innerHTML = '<div class="alert alert-danger mb-0"><i class="fas fa-times-circle me-1"></i>Falha ao processar</div>';
    }

    document.getElementById('runNowId').textContent = data.id || '-';
    document.getElementById('runNowKinds').textContent = data.kinds || '-';
    document.getElementById('runNowStatusCode').textContent = data.status_code || '-';
    document.getElementById('runNowCreatedAt').textContent = data.created_at || '-';
    document.getElementById('runNowTinyOrderId').textContent = data.tiny_order_id || '-';
    document.getElementById('runNowOrderCorreiosId').textContent = data.order_correios_id || '-';
    document.getElementById('runNowIdNotaFiscal').textContent = data.id_nota_fiscal || '-';
    document.getElementById('runNowTracking').textContent = data.tracking || '-';

    var tinyFixWrap = document.getElementById('runNowTinyFixWrap');
    if (tinyFixWrap) {
      if (data.tiny_fix) {
        document.getElementById('runNowTinyFixText').textContent = data.tiny_fix.instructions;
        document.getElementById('runNowTinyFixLink').href = data.tiny_fix.nota_url;
        tinyFixWrap.style.display = 'block';
      } else {
        tinyFixWrap.style.display = 'none';
      }
    }

    if (data.message) {
      document.getElementById('runNowMessage').textContent = data.message;
      document.getElementById('runNowMessageWrap').style.display = 'block';
    }

    if (data.error) {
      document.getElementById('runNowError').textContent = data.error;
      document.getElementById('runNowErrorWrap').style.display = 'block';
    }

    if (data.xml_nota) {
      document.getElementById('runNowXml').value = data.xml_nota;
      document.getElementById('runNowXmlWrap').style.display = 'block';
    }

    if (data.params) {
      document.getElementById('runNowParams').textContent = data.params;
      document.getElementById('runNowParamsWrap').style.display = 'block';
    }

    if (data.requisition) {
      document.getElementById('runNowRequisition').textContent = data.requisition;
      document.getElementById('runNowRequisitionWrap').style.display = 'block';
    }
  }

  function runQueueItemsBulk(url, items, label) {
    var modalEl = document.getElementById('runNowModal');
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    var closeBtn = document.getElementById('runNowCloseBtn');
    var closeX = document.getElementById('runNowModalCloseX');

    document.getElementById('runNowModalLabel').textContent = label || 'Executando selecionados...';
    document.getElementById('runNowLoading').style.display = 'none';
    document.getElementById('runNowResult').style.display = 'none';
    document.getElementById('runNowBulkProgress').style.display = 'block';
    document.getElementById('runNowBulkResultsBody').innerHTML = '';
    document.getElementById('runNowBulkProgressBar').style.width = '0%';
    document.getElementById('runNowBulkProgressLabel').textContent = 'Processando 0 de ' + items.length + '...';
    runNowShouldReloadOnClose = false;

    closeBtn.disabled = true;
    closeX.disabled = true;

    modal.show();

    var index = 0;

    function processNext() {
      if (index >= items.length) {
        document.getElementById('runNowBulkProgressLabel').textContent =
          'Concluído: ' + items.length + ' de ' + items.length + ' processados.';
        closeBtn.disabled = false;
        closeX.disabled = false;
        runNowShouldReloadOnClose = true;
        return;
      }

      var item = items[index];
      var row = document.createElement('tr');
      row.innerHTML =
        '<td><span class="badge bg-secondary"><i class="fas fa-spinner fa-spin"></i> Processando</span></td>' +
        '<td>' + (item.tinyOrderId || '-') + '</td>' +
        '<td class="text-muted">aguardando resultado...</td>';
      document.getElementById('runNowBulkResultsBody').appendChild(row);

      fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ attempt_id: item.id })
      })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          var badge = data.success
            ? '<span class="badge bg-success"><i class="fas fa-check"></i> Sucesso</span>'
            : '<span class="badge bg-danger"><i class="fas fa-times"></i> Falha</span>';
          var detail = data.error || data.message || '-';
          row.innerHTML =
            '<td>' + badge + '</td>' +
            '<td>' + (item.tinyOrderId || data.tiny_order_id || '-') + '</td>' +
            '<td>' + detail + '</td>';
        })
        .catch(function(err) {
          row.innerHTML =
            '<td><span class="badge bg-danger"><i class="fas fa-times"></i> Falha</span></td>' +
            '<td>' + (item.tinyOrderId || '-') + '</td>' +
            '<td>Falha de comunicação: ' + err.message + '</td>';
        })
        .finally(function() {
          index++;
          document.getElementById('runNowBulkProgressLabel').textContent =
            'Processando ' + index + ' de ' + items.length + '...';
          document.getElementById('runNowBulkProgressBar').style.width =
            Math.round((index / items.length) * 100) + '%';
          processNext();
        });
    }

    processNext();
  }

  document.addEventListener('DOMContentLoaded', function() {
    var modalEl = document.getElementById('runNowModal');
    if (!modalEl) return;

    modalEl.addEventListener('hidden.bs.modal', function() {
      document.getElementById('runNowBulkProgress').style.display = 'none';
      if (runNowShouldReloadOnClose) {
        location.reload();
      }
    });

    var copyBtn = document.getElementById('runNowCopyXmlBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var xmlText = document.getElementById('runNowXml').value;
        navigator.clipboard.writeText(xmlText).then(function() {
          copyBtn.innerHTML = '<i class="fas fa-check me-1"></i>Copiado!';
          setTimeout(function() {
            copyBtn.innerHTML = '<i class="fas fa-copy me-1"></i>Copiar';
          }, 2000);
        });
      });
    }

    function bindCopyButton(buttonId, sourceId) {
      var btn = document.getElementById(buttonId);
      if (!btn) return;
      btn.addEventListener('click', function() {
        var text = document.getElementById(sourceId).textContent;
        navigator.clipboard.writeText(text).then(function() {
          var original = btn.innerHTML;
          btn.innerHTML = '<i class="fas fa-check me-1"></i>Copiado!';
          setTimeout(function() {
            btn.innerHTML = original;
          }, 2000);
        });
      });
    }

    bindCopyButton('runNowCopyParamsBtn', 'runNowParams');
    bindCopyButton('runNowCopyRequisitionBtn', 'runNowRequisition');

    var downloadBtn = document.getElementById('runNowDownloadXmlBtn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function() {
        var xmlText = document.getElementById('runNowXml').value;
        var attemptId = document.getElementById('runNowId').textContent;
        var blob = new Blob([xmlText], { type: 'application/xml' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'attempt_' + attemptId + '.xml';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(link.href);
      });
    }
  });
</script>
