<div class="container-fluid py-4">
  <% title 'Emissão de Nota Fiscal no Tiny (B2B)' %>

  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <a href="<%= root_path %>" class="btn btn-dark me-2">
            <i class="fas fa-tachometer-alt me-1"></i> Dashboard
          </a>
          <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse" aria-expanded="false" aria-controls="filtersCollapse">
            <i class="fas fa-filter me-1"></i> Filtros
          </button>
          <%= button_to run_invoice_emition_b2b_dashboard_index_path, method: :post,
                        class: "btn btn-success #{'disabled' if @job_running}",
                        form_class: 'd-inline-block',
                        disabled: @job_running,
                        data: { turbo_confirm: @job_running ? nil : 'Isso irá processar toda a fila de emissão de notas fiscais B2B. Deseja continuar?' } do %>
            <i class="fas <%= @job_running ? 'fa-spinner fa-spin' : 'fa-play' %> me-1"></i>
            <%= @job_running ? 'Executando...' : 'Rodar Rotina Agora' %>
          <% end %>
          <button type="button" class="btn btn-warning" id="bulkRunBtn" disabled>
            <i class="fas fa-file-invoice me-1"></i> Emitir Selecionados (<span id="bulkRunCount">0</span>)
          </button>
          <button class="btn btn-outline-warning" type="button" data-bs-toggle="modal" data-bs-target="#updateInvoiceModal">
            <i class="fas fa-edit me-1"></i> Atualizar Nota Fiscal
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="updateInvoiceModal" tabindex="-1" aria-labelledby="updateInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content bg-dark border-secondary">
        <div class="modal-header border-secondary">
          <h5 class="modal-title text-white" id="updateInvoiceModalLabel">
            <i class="fas fa-edit me-2"></i>Atualizar ID da Nota Fiscal
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="<%= update_invoice_id_dashboard_index_path %>" method="post">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <div class="modal-body">
            <div class="mb-3">
              <label for="tiny_order_id" class="form-label text-white">ID do Pedido (Tiny Order ID)</label>
              <input type="number" class="form-control bg-dark text-white border-secondary" id="tiny_order_id" name="tiny_order_id" required placeholder="Ex: 911317520">
              <div class="form-text text-muted">Digite o ID do pedido no sistema Tiny</div>
            </div>
            <div class="mb-3">
              <label for="id_nota_fiscal" class="form-label text-white">ID da Nota Fiscal</label>
              <input type="number" class="form-control bg-dark text-white border-secondary" id="id_nota_fiscal" name="id_nota_fiscal" required placeholder="Ex: 123456">
              <div class="form-text text-muted">Digite o novo ID da nota fiscal</div>
            </div>
            <div class="alert alert-info border-0">
              <i class="fas fa-info-circle me-2"></i>
              <strong>Atenção:</strong> Esta ação irá atualizar o ID da nota fiscal em todos os attempts com status "success" para o pedido informado.
            </div>
          </div>
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-warning">
              <i class="fas fa-save me-1"></i> Atualizar Nota Fiscal
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="collapse mb-4" id="filtersCollapse">
    <div class="card bg-black border border-dark shadow">
      <div class="card-header bg-dark">
        <h5 class="text-white mb-0">
          <i class="fas fa-filter me-2"></i>Filtros
        </h5>
      </div>
      <div class="card-body">
        <form action="<%= invoice_emition_b2b_dashboard_index_path %>" method="get">
          <div class="row g-3">
            <div class="col-md-4">
              <label for="status" class="form-label text-white">Status</label>
              <select name="status" id="status" class="form-select bg-dark text-white border-secondary">
                <option value="">Todos</option>
                <option value="pending">Pendente</option>
                <option value="processing">Processando</option>
                <option value="success">Sucesso</option>
                <option value="error">Erro</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="period" class="form-label text-white">Período</label>
              <select name="period" id="period" class="form-select bg-dark text-white border-secondary">
                <option value="">Todo o período</option>
                <option value="today">Hoje</option>
                <option value="7">Últimos 7 dias</option>
                <option value="30">Últimos 30 dias</option>
                <option value="90">Últimos 90 dias</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="order_id" class="form-label text-white">ID do Pedido</label>
              <input type="text" name="order_id" id="order_id" class="form-control bg-dark text-white border-secondary" placeholder="Ex: 123456">
            </div>
            <div class="col-md-4">
              <label for="transportadora" class="form-label text-white">Transportadora</label>
              <select name="transportadora" id="transportadora" class="form-select bg-dark text-white border-secondary">
                <option value="" <%= 'selected' if @filter_transportadora.blank? %>>Todos</option>
                <option value="correios" <%= 'selected' if @filter_transportadora == 'correios' %>>Correios</option>
                <option value="outra" <%= 'selected' if @filter_transportadora == 'outra' %>>Outra Transportadora</option>
              </select>
            </div>
          </div>
          <div class="mt-3 text-end">
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-search me-1"></i> Aplicar Filtros
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-success border-0 mb-4">
        <div class="d-flex align-items-center">
          <% if within_schedule? %>
            <i class="fas fa-check-circle fa-2x me-3 text-success"></i>
            <div>
              <h5 class="mb-1">Fluxo B2B - Etapa 2: Emissão de Nota</h5>
              <p class="mb-0">
                <strong><%= @invoice_emition.count %> pedidos</strong> aguardando
                Criação no Correios → <strong><i class="fas fa-file-invoice text-success"></i> Emissão de Nota</strong> →
                Envio XML → Rastreamento - Sistema funcionando normalmente (Segunda a Sexta, 08:00 às 22:00)
              </p>
            </div>
          <% else %>
            <i class="fas fa-clock fa-2x me-3 text-warning"></i>
            <div>
              <h5 class="mb-1">Fluxo B2B - Etapa 2: Emissão de Nota</h5>
              <p class="mb-0">
                <strong><%= @invoice_emition.count %> pedidos</strong> aguardando
                Criação no Correios → <strong><i class="fas fa-file-invoice text-success"></i> Emissão de Nota</strong> →
                Envio XML → Rastreamento - Fora do horário de funcionamento (Retorna Segunda a Sexta, 08:00 às 22:00)
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-black border border-dark shadow">
        <div class="card-header bg-dark">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="text-white mb-0">
              <i class="fas fa-list me-2"></i>Fila de Emissão de Notas Fiscais (B2B)
            </h5>
            <div>
              <% if within_schedule? %>
                <span class="badge bg-success me-2">
                  <i class="fa-solid fa-spinner fa-spin"></i> Fila Ativa
                </span>
              <% else %>
                <span class="badge bg-danger me-2">
                  <i class="fas fa-pause"></i> Fila Pausada
                </span>
              <% end %>
              <span class="badge bg-success me-2">
                <i class="fas fa-file-invoice"></i> <%= @invoice_emition.count %> Na Fila de Notas
              </span>
              <span class="badge bg-primary">
                Emissão de Nota Fiscal no Tiny
              </span>
              <% if @filter_transportadora.present? %>
                <span class="badge bg-secondary">
                  Transportadora: <%= @filter_transportadora == 'outra' ? 'Outra Transportadora' : 'Correios' %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
        <div class="card-body">
          <% if @invoice_emition.present? %>
            <div class="table-responsive">
              <table class="table table-dark table-hover" id="invoiceTable">
                <thead>
                  <tr>
                    <th width="30" class="text-center">
                      <input type="checkbox" id="selectAllCheckbox" title="Selecionar todos nesta página">
                    </th>
                    <th width="50" class="text-center">
                      <i class="fas fa-cog"></i>
                    </th>
                    <th class="text-center">
                      <i class="fas fa-hashtag me-1"></i>
                      <%= Attempt.human_attribute_name :tiny_order_id %>
                    </th>
                    <th class="text-center">
                      <i class="fas fa-user me-1"></i>
                      Cliente
                    </th>
                    <th class="text-center">
                      <i class="fas fa-truck-moving me-1"></i>
                      Transportadora
                    </th>
                    <th class="text-center">
                      <i class="fas fa-mail-bulk me-1"></i>
                      <%= Attempt.human_attribute_name :order_correios_id %>
                    </th>
                    <th class="text-center">
                      <i class="fas fa-file-invoice me-1"></i>
                      <%= Attempt.human_attribute_name :id_nota_fiscal %>
                    </th>
                    <th class="text-center">
                      <i class="fas fa-tag me-1"></i>
                      <%= Attempt.human_attribute_name :kinds %>
                    </th>
                    <th class="text-center">
                      <i class="fas fa-info-circle me-1"></i>
                      <%= Attempt.human_attribute_name :status %>
                    </th>
                    <th class="text-center">
                      <i class="fas fa-code me-1"></i>
                      Status Code
                    </th>
                    <th class="text-center">
                      <i class="fas fa-exclamation-triangle me-1"></i>
                      <%= Attempt.human_attribute_name :error %>
                    </th>
                    <th class="text-center">
                      <i class="fas fa-clock me-1"></i>
                      <%= Attempt.human_attribute_name :created_at %>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <% @invoice_emition.each do |att| %>
                    <tr>
                      <td class="text-center">
                        <input type="checkbox" class="row-select-checkbox" data-id="<%= att.id %>" data-tiny-order-id="<%= att.tiny_order_id %>">
                      </td>
                      <td class="text-center">
                        <div class="row-actions">
                          <button class="btn btn-sm btn-warning"
                                  onclick="runQueueItemNow('<%= run_invoice_emition_b2b_now_dashboard_index_path %>', <%= att.id %>, 'Emitindo nota fiscal no Tiny (B2B)...')"
                                  title="Emitir esta nota fiscal agora">
                            <i class="fas fa-file-invoice"></i>
                          </button>
                          <%= link_to verify_attempts_attempts_path(tiny_order_id: att.tiny_order_id),
                              class: 'btn btn-sm btn-outline-info',
                              method: :post,
                              target: '_blank',
                              title: 'Verificar tentativas' do %>
                            <i class="fas fa-paperclip"></i>
                          <% end %>
                        </div>
                      </td>
                      <td class="text-center">
                        <div class="d-flex flex-column align-items-center">
                          <span class="fw-bold text-white"><%= att.tiny_order_id %></span>
                          <%= b2b_order_type_badge(@order_types[att.tiny_order_id.to_s]) %>
                          <%= address_correction_badge(@address_corrections[att.tiny_order_id.to_s]) %>
                          <% held = @address_corrections[att.tiny_order_id.to_s] %>
                          <% if held&.awaiting_tiny_fix? %>
                            <%= render 'dashboard/address_hold_actions', att: att, correction: held, return_to: 'invoice_emition_b2b' %>
                          <% end %>
                          <button class="btn btn-sm btn-primary mt-1"
                                  onclick="window.open('<%= ENV.fetch('TINY_SELLS_URL') %>#edit/<%= att.tiny_order_id %>', '_blank');"
                                  title="Ver no Tiny">
                            <i class="fas fa-external-link-alt me-1"></i>
                            Ver no Tiny
                          </button>
                        </div>
                      </td>
                      <%= render 'dashboard/customer_name_cell', att: att %>
                      <td class="text-center">
                        <% if att.is_transportadora %>
                          <span class="badge bg-warning text-dark"><i class="fas fa-truck-moving me-1"></i>Outra Transportadora</span>
                        <% else %>
                          <span class="badge bg-info text-dark"><i class="fas fa-truck me-1"></i>Correios</span>
                        <% end %>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-secondary fs-6"><i class="fas fa-truck me-1" title="Correios"></i><%= att.order_correios_id %></span>
                      </td>
                      <td class="text-center">
                        <% if att.id_nota_fiscal.present? %>
                          <span class="badge bg-success fs-6"><%= att.id_nota_fiscal %></span>
                        <% else %>
                          <span class="badge bg-secondary">-</span>
                        <% end %>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-info text-dark"><%= att.kinds %></span>
                      </td>
                      <td class="text-center">
                        <%
                          status_class = case att.status
                          when 'success' then 'bg-success'
                          when 'error' then 'bg-danger'
                          when 'processing' then 'bg-warning text-dark'
                          else 'bg-secondary'
                          end
                        %>
                        <span class="badge <%= status_class %>"><%= att.status %></span>
                      </td>
                      <td class="text-center">
                        <div class="d-flex flex-column align-items-center">
                          <span class="badge bg-dark"><%= att.status_code %></span>
                          <% if att.message.present? %>
                            <small class="text-muted mt-1"><%= truncate(att.message, length: 30) %></small>
                          <% end %>
                        </div>
                      </td>
                      <td class="text-center">
                        <% if att.error.present? %>
                          <span class="badge bg-danger"
                                title="<%= att.error %>"
                                data-bs-toggle="tooltip">
                            <i class="fas fa-exclamation-triangle"></i>
                            Erro
                          </span>
                        <% else %>
                          <span class="badge bg-secondary">-</span>
                        <% end %>
                      </td>
                      <td class="text-center">
                        <div class="d-flex flex-column align-items-center">
                          <span class="text-white"><%= att.created_at.strftime('%d/%m/%Y') %></span>
                          <small class="text-muted"><%= att.created_at.strftime('%H:%M') %></small>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
              <h5 class="text-white">Nenhum item na fila</h5>
              <p class="text-muted">Não há notas fiscais pendentes para emissão no momento.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'dashboard/run_now_modal' %>
</div>

<% content_for :styles do %>
<% end %>

<% content_for :scripts do %>
  <%= render 'dashboard/run_now_script' %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (document.getElementById('invoiceTable')) {
        $('#invoiceTable').DataTable({
          responsive: true,
          pageLength: 25,
          order: [[10, 'desc']],
          language: {
            url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
          },
          columnDefs: [
            { orderable: false, targets: [0, 1] },
            { className: "text-center", targets: "_all" }
          ]
        });
      }

      (function() {
        var selectedIds = new Set();
        var tinyOrderIdById = {};

        function updateBulkButton() {
          var btn = document.getElementById('bulkRunBtn');
          if (!btn) return;
          document.getElementById('bulkRunCount').textContent = selectedIds.size;
          btn.disabled = selectedIds.size === 0;
        }

        document.addEventListener('change', function(e) {
          if (e.target.classList && e.target.classList.contains('row-select-checkbox')) {
            var id = e.target.dataset.id;
            if (e.target.checked) {
              selectedIds.add(id);
              tinyOrderIdById[id] = e.target.dataset.tinyOrderId;
            } else {
              selectedIds.delete(id);
            }
            updateBulkButton();
          }

          if (e.target.id === 'selectAllCheckbox') {
            var checked = e.target.checked;
            document.querySelectorAll('.row-select-checkbox').forEach(function(cb) {
              cb.checked = checked;
              var id = cb.dataset.id;
              if (checked) {
                selectedIds.add(id);
                tinyOrderIdById[id] = cb.dataset.tinyOrderId;
              } else {
                selectedIds.delete(id);
              }
            });
            updateBulkButton();
          }
        });

        var bulkBtn = document.getElementById('bulkRunBtn');
        if (bulkBtn) {
          bulkBtn.addEventListener('click', function() {
            var items = Array.from(selectedIds).map(function(id) {
              return { id: id, tinyOrderId: tinyOrderIdById[id] };
            });
            runQueueItemsBulk('<%= run_invoice_emition_b2b_now_dashboard_index_path %>', items, 'Emitindo notas fiscais selecionadas (B2B)...');
          });
        }
      })();

      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });

      const cards = document.querySelectorAll('.card');
      cards.forEach((card, index) => {
        setTimeout(() => {
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, index * 100);
      });

      <% if within_schedule? %>
        setInterval(function() {
          if (document.visibilityState === 'visible' && !runNowIsBusy()) {
            location.reload();
          }
        }, 30000);
      <% else %>
        setInterval(function() {
          if (document.visibilityState === 'visible' && !runNowIsBusy()) {
            location.reload();
          }
        }, 300000);
      <% end %>
    });
  </script>
<% end %>
