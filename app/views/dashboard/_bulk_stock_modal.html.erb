<%# Modal "Consultar Estoque em Lote" das telas API Correios (Log03 e Log02).
    Controllers Stimulus: modal (abre/fecha), dropzone (arrastar a planilha) e bulk-stock (consulta e exportação).
    Local: b2b. %>
<% other_label = b2b ? 'Estoque B2C (Log03)' : 'Estoque B2B (Log02)' %>
<div class="modal fade" id="bulkStockModal" tabindex="-1" aria-labelledby="bulkStockModalLabel" aria-hidden="true"
     data-controller="modal dropzone bulk-stock"
     data-dropzone-accept-value="\.csv$"
     data-bulk-stock-b2b-value="<%= b2b %>"
     data-bulk-stock-stock-url-value="<%= stockend_dashboard_index_path %>"
     data-bulk-stock-stuck-url-value="<%= stuck_orders_dashboard_index_path %>"
     data-bulk-stock-other-label-value="<%= other_label %>"
     data-bulk-stock-export-filename-value="<%= b2b ? 'resultado_estoque_lote_b2b' : 'resultado_estoque_lote' %>"
     data-action="dragenter->dropzone#enter dragover->dropzone#over dragleave->dropzone#leave drop->dropzone#drop dropzone:dropped->bulk-stock#dropped dropzone:rejected->bulk-stock#rejected">
  <div class="modal-dialog modal-lg">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-white" id="bulkStockModalLabel">
          <i class="fas fa-file-csv me-2"></i>Consultar Estoque em Lote<%= ' (B2B)' if b2b %>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-action="modal#close" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <a href="/templates/planilha_modelo_estoque.csv" download class="btn btn-outline-light btn-sm">
            <i class="fas fa-download me-1"></i>Baixar planilha modelo
          </a>
          <div class="form-text text-muted mt-1">A planilha deve ter uma coluna chamada <strong>SKU</strong>, com um código por linha.</div>
        </div>

        <div class="mb-3 hc-dropzone">
          <div class="hc-dropzone-hint"><i class="fas fa-cloud-arrow-up"></i><span>Arraste a planilha .csv para cá (a consulta começa sozinha) ou escolha o arquivo.</span></div>
          <label for="bulk_stock_file" class="form-label text-white">Planilha (.csv)</label>
          <div class="input-group">
            <input type="file" class="form-control bg-dark text-white border-secondary" id="bulk_stock_file" accept=".csv"
                   data-dropzone-target="input" data-bulk-stock-target="file">
            <button class="btn btn-success" type="button" data-bulk-stock-target="button" data-action="bulk-stock#run">
              <i class="fas fa-search me-1"></i>Consultar
            </button>
          </div>
          <div class="alert alert-warning border-0 py-2 px-3 mt-2 mb-0 small" role="alert" data-bulk-stock-target="message" hidden></div>
        </div>

        <div class="mb-2" data-bulk-stock-target="progress" hidden>
          <div class="text-white-50 small mb-1" data-bulk-stock-target="progressText" aria-live="polite"></div>
          <div class="hc-progress"><span data-bulk-stock-target="progressBar"></span></div>
        </div>

        <div class="table-responsive" style="max-height: 360px; overflow-y: auto;">
          <table class="table table-dark table-sm table-striped mb-0">
            <thead>
              <tr>
                <th>SKU</th>
                <th>Estoque Disponível</th>
                <th><%= other_label %></th>
                <th>Reservado</th>
                <th>Pedidos Travados</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody data-bulk-stock-target="body"></tbody>
          </table>
        </div>
        <div class="form-text text-muted mt-2"><i class="fas fa-lock me-1"></i>"Pedidos Travados" são pedidos que a Tiny tentou criar no Correios e falharam por falta desse SKU no estoque.</div>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-success" data-bulk-stock-target="exportButton" data-action="bulk-stock#download" hidden disabled>
          <i class="fas fa-file-export me-1"></i>Exportar planilha
        </button>
        <button type="button" class="btn btn-secondary" data-action="modal#close">Fechar</button>
      </div>
    </div>
  </div>
</div>
