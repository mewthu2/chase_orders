<%# Pedidos feitos no Honey no Log02 (sem Tiny), filtrados pelas etapas. Locais: stages (etapas de B2bOrder::LOG_STAGES),
    title, meta, empty_text, review (true na tela de aprovação: mostra Aprovar/Ignorar) e show_correios (coluna do
    número no Correios, nas telas em que o pedido já foi criado lá). %>
<% review = local_assigns.fetch(:review, false) %>
<% show_correios = local_assigns.fetch(:show_correios, false) %>
<% tones = { 'review' => 'yellow', 'ignored' => 'gray', 'creation' => 'blue', 'invoice' => 'purple', 'tracking' => 'orange', 'shipped' => 'green', 'carrier' => 'blue', 'canceled' => 'red', 'completed' => 'green' } %>
<% stage_map = B2bOrder::LOG_STAGES.to_h { |k, (label, help)| [k, [label, tones[k], help]] } %>
<% kind_labels = { 'sale' => 'Atacado', 'stock_transfer' => 'Abastecimento', 'b2c_transfer' => 'Transferência B2B → B2C' } %>
<%# Filtro Tipo: B2B (atacado e abastecimento) ou B2C (transferência para o estoque do e-commerce), ou um tipo só. %>
<% kind_group = { 'sale' => 'b2b', 'stock_transfer' => 'b2b', 'b2c_transfer' => 'b2c' } %>
<% orders = B2bOrder.honey_flow.includes(:client, :transfer_location, :b2b_order_items).where('b2b_orders.created_at > ?', 6.months.ago).to_a
                    .select { |o| stages.include?(o.log_stage) } %>
<% last_attempts = Attempt.where(b2b_order_id: orders.map(&:id), kinds: Attempt::HONEY_KINDS).order(:id).group_by(&:b2b_order_id).transform_values(&:last) %>
<% notes = FiscalNote.latest_by_order(orders.map(&:id)) %>
<% remessas = FiscalNote.latest_by_order(orders.select(&:remessa_note?).map(&:id), role: 'remessa') %>
<%# Etapa de cada tipo de tentativa: o erro só aparece na linha enquanto o pedido está parado naquela etapa. %>
<% attempt_stage = { 'create_correios_order_honey' => 'creation', 'send_xml_honey' => 'invoice', 'get_tracking_honey' => 'tracking' } %>
<% honey_table = HoneyTable.new(params, id: 'honey', unit: 'pedidos', unit1: 'pedido', page_size: 8, sort: { k: :dt, dir: 1 },
     rows: orders.map { |o|
       last = last_attempts[o.id]
       failed = last && !last.success? && attempt_stage[last.kinds] == o.log_stage
       { id: o.id, record: o, n: "##{o.id}", pn: b2b_pn_cell(o, notes[o.id], remessa: remessas[o.id]), tipo: kind_labels[o.kind], grupo: [kind_group[o.kind], o.kind], destino: HoneyB2bLog.destination_name(o).presence || '—',
         dt: o.created_at, total: o.total.to_f, st: o.log_stage, correios: b2b_correios_number(o.correios_order_id), rastreio: o.tracking_code.presence || (o.log_stage == 'carrier' ? 'Transportadora' : '—'),
         ultima: last ? "#{last.success? ? 'OK' : 'Falhou'}: #{(last.error.presence || last.message.presence || '—').to_s.truncate(160)}" : '—',
         erro: (if failed
                  content_tag(:span, safe_join([content_tag(:i, '', class: 'fas fa-triangle-exclamation'),
                                                content_tag(:span, (last.error.presence || last.message.presence || 'Falhou sem mensagem').to_s.truncate(140))]),
                              class: 'hb-err', data: { tip: "Última tentativa: #{l(last.created_at, format: '%d/%m %H:%M')}" })
                else
                  content_tag(:span, '—', class: 'pg-dash')
                end) }
     },
     cols: [
       { k: :pn, label: 'Pedido', t: :html, nodetail: true, sub: :tipo },
       { k: :n, label: 'Número', t: :mono, main: true, hide: true },
       { k: :tipo, label: 'Tipo', hide: true },
       { k: :destino, label: 'Destino', cls: 'customer-name-cell' },
       { k: :correios, label: 'Nº no Correios', t: :html, hide: !show_correios },
       { k: :dt, label: 'Criado', t: :dt, sort: true },
       { k: :total, label: 'Total', t: :money },
       { k: :st, label: 'Etapa', t: :status, map: stage_map },
       { k: :erro, label: 'Erro da última tentativa', t: :html, nodetail: true },
       { k: :rastreio, label: 'Rastreio', t: :mono, hide: true },
       { k: :ultima, label: 'Última tentativa', hide: true }
     ],
     filters: [
       { id: :tipo, type: :select, label: 'Tipo de pedido', col: :grupo, all: 'B2B e B2C',
         options: [['b2b', 'B2B (atacado e abastecimento)'], ['sale', 'B2B · só atacado'], ['stock_transfer', 'B2B · só abastecimento'], ['b2c', 'B2C (transferência B2B → B2C)']],
         tip: 'B2B: pedidos de atacado e abastecimento das lojas. B2C: transferências do estoque B2B para o e-commerce.' }
     ]) %>
<%= hc_pg_table(honey_table, title: title, icon: 'fas fa-house-flag', meta: meta,
      empty: { title: 'Nenhum pedido do Honey aqui', text: empty_text },
      detail: { title: ->(r) { "Pedido #{r[:n]} (Honey)" }, note: 'A NF-e é emitida no Honey na etapa do XML.' },
      actions: ->(r) {
        order = r[:record]
        stage = r[:st]
        safe_join([
          (if review && screen_can?(:dashboard_correios_b2b, :approve)
             safe_join([
               (hc_row_action('fas fa-check', 'Aprovar', approve_honey_order_b2b_dashboard_index_path(id: order.id, review: params[:review]), method: :post) unless stage == 'creation'),
               (hc_row_action('fas fa-ban', 'Ignorar', ignore_honey_order_b2b_dashboard_index_path(id: order.id, review: params[:review]), danger: true, method: :post,
                              confirm: { title: "Ignorar o pedido ##{order.id}?", text: 'Ele não segue para o Correios e libera a reserva do estoque. Dá para aprovar depois.', ok: 'Ignorar' }) unless stage == 'ignored')
             ].compact)
           end),
          (if %w[creation invoice tracking].include?(stage) && screen_can?(:dashboard_correios_b2b, :execute)
             step = { 'creation' => 'Criar no Correios agora', 'invoice' => 'Emitir a NF-e e enviar o XML agora', 'tracking' => 'Buscar o rastreio agora' }[stage]
             hc_row_action('fas fa-play', step, run_honey_b2b_step_dashboard_index_path(id: order.id), method: :post,
                           confirm: (stage == 'invoice' ? { title: "Emitir a NF-e do pedido ##{order.id}?", text: 'O Honey gera a nota, autoriza na SEFAZ e manda o XML ao Correios.', ok: 'Emitir e enviar' } : nil))
           end),
          (if stage == 'invoice' && screen_can?(:dashboard_correios_b2b, :execute)
             hc_row_action('fas fa-flag-checkered', 'Concluir e tirar da fila', complete_honey_order_b2b_dashboard_index_path(id: order.id), method: :post,
                           confirm: { title: "Concluir o pedido ##{order.id}?", text: 'Conclua quando o pedido já tiver saído. O Honey não emite a NF-e nem envia o XML, e ele não entra na fila do rastreio.', ok: 'Concluir' })
           end)
        ].compact)
      }) %>
