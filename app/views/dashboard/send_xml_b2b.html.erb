<% title 'Envio de XML para os Correios (Log02)' %>
<% complete = ->(att) {
     next nil unless att.is_transportadora && screen_can?(:dashboard_correios_b2b, :execute)

     hc_row_action('fas fa-flag-checkered', 'Concluir (transportadora)', complete_send_xml_b2b_dashboard_index_path, method: :post,
                   params: { attempt_id: att.id }.merge(request.query_parameters.slice('transportadora', 'order_type').symbolize_keys),
                   confirm: { title: "Concluir o pedido #{att.tiny_order_id}?", text: 'Ele sai por outra transportadora: o Honey marca como Entregue no Tiny e tira da fila de XML.', ok: 'Concluir' })
   } %>
<%= render 'dashboard/attempt_queue', kind: :log02, action: :send_xml_b2b, perm: :dashboard_correios_b2b,
           title: 'Envio de XML para os Correios (Log02)', subtitle: 'A nota emitida vai para o Correios, que libera a etiqueta.', icon: 'fas fa-file-code',
           queue: @send_xml, errors: @last_errors, step: 'nota (XML)', order_types: @order_types, transport: true, extra_action: complete,
           run_path: run_send_xml_b2b_dashboard_index_path, run_now_path: run_send_xml_b2b_now_dashboard_index_path,
           done_label: 'Enviados hoje', done_help: 'XMLs que o Correios já recebeu hoje.', row_tip: 'Enviar este XML agora', row_icon: 'fas fa-paper-plane',
           run_msg: 'Enviando XML aos Correios (B2B)...', bulk_label: 'Enviar selecionados',
           runbox_title: 'Fila de envio de XML', runbox_text: 'Manda ao Correios o XML das notas de atacado já emitidas. O sistema roda sozinho; use Enviar agora se não puder esperar.',
           runbox_btn: 'Enviar fila agora', table_title: 'Fila de Envio de XML', table_meta: 'Pedidos de atacado com nota emitida que ainda não mandaram o XML ao Correios (últimos 30 dias).',
           empty_text: 'Não há XMLs pendentes de envio no momento.' %>

<div class="pg-blocks" style="margin-top: 16px">
  <%= render 'dashboard/honey_b2b_orders', stages: %w[invoice], title: 'Pedidos do Honey: NF-e e XML', meta: 'O Honey emite a NF-e, autoriza na SEFAZ e manda o XML ao Correios.', empty_text: 'Nenhum pedido do Honey esperando a nota.' %>
</div>
