<div class="container-fluid py-4">
  <% title 'Produtos Sem Estoque no Correios (B2B)' %>

  <div class="page-header">
    <div>
      <h1 class="page-title"><i class="fas fa-box-open me-2"></i>Produtos Sem Estoque no Correios (B2B)</h1>
      <p class="page-subtitle">
        <i class="fas fa-exclamation-triangle me-1"></i>
        Produtos informados que não existem no estoque do Correios
      </p>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-box-open me-1"></i><%= @stats[:total_products] %> produto(s) sem estoque
      </span>
      <a href="<%= root_path %>" class="btn btn-dark">
        <i class="fas fa-tachometer-alt me-1"></i> Dashboard
      </a>
      <a href="<%= order_correios_create_queue_b2b_dashboard_index_path %>" class="btn btn-primary">
        <i class="fas fa-plus-circle me-1"></i> Criação no Correios
      </a>
      <%= link_to order_correios_stock_errors_b2b_dashboard_index_path(format: :csv),
          class: 'btn-export',
          data: { turbo: false } do %>
        <i class="fas fa-file-csv me-1"></i> Baixar planilha
      <% end %>
    </div>
  </div>

  <div class="alert alert-danger border-0 mb-4">
    <div class="d-flex align-items-center">
      <i class="fas fa-exclamation-triangle fa-2x me-3 text-danger"></i>

      <div>
        <h5 class="mb-1">
          Produtos informados que não existem no estoque do Correios
        </h5>

        <p class="mb-0">
          Foram encontrados
          <strong><%= @stats[:total_attempts] %> attempt(s)</strong>,
          <strong><%= @stats[:total_orders] %> pedido(s)</strong> e
          <strong><%= @stats[:total_items] %> item(ns)</strong>
          com erro de estoque na criação do pedido no Correios (B2B).
        </p>
      </div>
    </div>
  </div>

  <div class="table-card mb-4">
    <div class="table-card-header">
      <h2 class="table-card-title">
        <i class="fas fa-cubes me-2"></i>
        Resumo por Produto
      </h2>
    </div>

    <% if @missing_stock_summary.present? %>
      <div class="table-responsive">
        <table class="orders-table" id="summaryTableB2b">
          <thead>
            <tr>
              <th class="text-center">Produto</th>
              <th class="text-center">Quantidade Necessária</th>
              <th class="text-center">Estoque Correios B2B</th>
              <th class="text-center">Estoque Correios B2C</th>
              <th class="text-center">Pedidos Afetados</th>
              <th class="text-center">Attempts</th>
            </tr>
          </thead>

          <tbody>
            <% @missing_stock_summary.each do |item| %>
              <tr>
                <td class="text-center">
                  <span class="badge bg-danger fs-6">
                    <%= item[:product_code] %>
                  </span>
                </td>

                <td class="text-center">
                  <span class="fw-bold text-warning">
                    <%= number_with_precision(
                      item[:total_quantity],
                      precision: item[:total_quantity] % 1 == 0 ? 0 : 2,
                      delimiter: '.',
                      separator: ','
                    ) %>
                  </span>
                </td>

                <td class="text-center item-stock-cell" data-sku="<%= item[:product_code] %>" data-b2b="1">
                  <i class="fas fa-spinner fa-spin text-muted-custom"></i>
                </td>
                <td class="text-center item-stock-cell" data-sku="<%= item[:product_code] %>" data-b2b="0">
                  <i class="fas fa-spinner fa-spin text-muted-custom"></i>
                </td>

                <td class="text-center">
                  <%= item[:orders_count] %>
                </td>

                <td class="text-center">
                  <%= item[:attempts_count] %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-check-circle fa-3x mb-3 d-block"></i>
        <h5>Nenhum produto sem estoque encontrado</h5>
        <p>Não existem attempts com erro de produto inexistente no estoque.</p>
      </div>
    <% end %>
  </div>

  <div class="table-card">
    <div class="table-card-header">
      <h2 class="table-card-title">
        <i class="fas fa-list me-2"></i>
        Pedidos com Produto Sem Estoque
      </h2>
      <div class="active-filters-row">
        <span class="filter-tag filter-tag--blue">
          <i class="fas fa-list"></i> <%= @stats[:total_items] %> item(ns)
        </span>
      </div>
    </div>

    <% if @missing_stock_items.present? %>
      <div class="table-responsive">
        <table class="orders-table" id="stockErrorsTableB2b">
          <thead>
            <tr>
              <th class="text-center">Ações</th>
              <th class="text-center">Produto</th>
              <th class="text-center">Qtd. Necessária</th>
              <th class="text-center">Pedido Tiny</th>
              <th class="text-center">Nota Fiscal Tiny</th>
              <th class="text-center">Pedido Ecommerce</th>
              <th class="text-center">Cliente</th>
              <th class="text-center">Data Pedido</th>
              <th class="text-center">Valor</th>
              <th class="text-center">Attempt</th>
              <th class="text-center">Última Atualização</th>
              <th class="text-center">Mensagem</th>
            </tr>
          </thead>

          <tbody>
            <% @missing_stock_items.each do |item| %>
              <tr>
                <td class="text-center">
                  <div class="row-actions">
                    <% if item[:tiny_order_id].present? %>
                      <%= link_to verify_attempts_attempts_path(
                            tiny_order_id: item[:tiny_order_id]
                          ),
                          class: 'btn btn-sm btn-outline-info',
                          method: :post,
                          target: '_blank',
                          title: 'Verificar tentativas' do %>
                        <i class="fas fa-paperclip"></i>
                      <% end %>

                      <button
                        type="button"
                        class="btn btn-sm btn-outline-info"
                        onclick="window.open('<%= ENV.fetch('TINY_SELLS_URL') %>#edit/<%= item[:tiny_order_id] %>', '_blank');"
                        title="Ver pedido no Tiny"
                      >
                        <i class="fas fa-external-link-alt"></i>
                      </button>
                    <% end %>
                  </div>
                </td>

                <td class="text-center">
                  <span class="badge bg-danger fs-6">
                    <%= item[:product_code] %>
                  </span>
                </td>

                <td class="text-center">
                  <span class="fw-bold text-warning">
                    <%= item[:quantity] %>
                  </span>
                </td>

                <td class="text-center">
                  <div class="d-flex flex-column align-items-center">
                    <% if item[:tiny_order_number].present? %>
                      <span class="fw-bold text-white">
                        #<%= item[:tiny_order_number] %>
                      </span>
                    <% end %>

                    <small class="text-muted">
                      ID: <%= item[:tiny_order_id].presence || '-' %>
                    </small>
                    <%= b2b_order_type_badge(@order_types[item[:tiny_order_id].to_s]) %>
                  </div>
                </td>

                <td class="text-center">
                  <span class="text-white">
                    <%= item[:id_nota_fiscal].presence || '-' %>
                  </span>
                </td>

                <td class="text-center">
                  <span class="text-white">
                    <%= item[:numero_ecommerce].presence || '-' %>
                  </span>
                </td>

                <td class="text-center">
                  <span
                    class="text-white"
                    title="<%= item[:customer_name] %>"
                  >
                    <%= truncate(item[:customer_name].to_s, length: 25) %>
                  </span>
                </td>

                <td class="text-center">
                  <span class="text-white">
                    <%= item[:data_pedido].presence || '-' %>
                  </span>
                </td>

                <td class="text-center">
                  <% if item[:valor].present? %>
                    <span class="badge bg-success fs-6">
                      R$
                      <%= number_with_precision(
                        item[:valor].to_f,
                        precision: 2,
                        delimiter: '.',
                        separator: ','
                      ) %>
                    </span>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>

                <td class="text-center">
                  <div class="d-flex flex-column align-items-center">
                    <span class="fw-bold text-white">
                      #<%= item[:attempt_id] %>
                    </span>

                    <span class="badge bg-warning text-dark mt-1">
                      <%= item[:status] %>
                    </span>
                  </div>
                </td>

                <td class="text-center">
                  <small class="text-muted">
                    <%= item[:updated_at].strftime('%d/%m/%Y %H:%M') %>
                  </small>
                </td>

                <td class="text-center">
                  <span
                    class="text-danger small"
                    title="<%= item[:message] %>"
                  >
                    <%= truncate(item[:message], length: 55) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-check-circle fa-3x mb-3 d-block"></i>
        <h5>Nenhum pedido com erro de estoque</h5>
        <p>Não há pedidos pendentes com produto inexistente no estoque do Correios.</p>
      </div>
    <% end %>
  </div>
</div>

<% content_for :styles do %>
<% end %>

<% content_for :scripts do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      function initializeDataTable(tableId, options = {}) {
        const table = document.getElementById(tableId);

        if (table && !$.fn.DataTable.isDataTable('#' + tableId)) {
          $('#' + tableId).DataTable({
            responsive: true,
            pageLength: 25,
            language: {
              url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
            },
            columnDefs: [
              {
                className: 'text-center',
                targets: '_all'
              }
            ],
            ...options
          });
        }
      }

      if (document.getElementById('summaryTableB2b')) {
        initializeDataTable('summaryTableB2b', {
          order: [[1, 'desc']],
          columnDefs: [
            {
              className: 'text-center',
              targets: '_all'
            }
          ]
        });
      }

      if (document.getElementById('stockErrorsTableB2b')) {
        initializeDataTable('stockErrorsTableB2b', {
          order: [[10, 'desc']],
          columnDefs: [
            {
              orderable: false,
              targets: [0]
            },
            {
              className: 'text-center',
              targets: '_all'
            }
          ]
        });
      }

      // Estoque Correios B2C e B2B: consulta um produto de cada vez, com uma pequena
      // pausa entre cada um, pra não travar a tela disparando tudo de uma vez.
      // A tela não recarrega inteira (são muitas requisições): só o estoque é
      // reconsultado, 60s depois de terminar a rodada anterior e com a aba visível.
      (function () {
        var STOCK_REFRESH_MS = 60000;

        // O DataTables tira do DOM as linhas de outras páginas; pega pela API.
        function stockCells() {
          if ($.fn.DataTable.isDataTable('#summaryTableB2b')) {
            return $($('#summaryTableB2b').DataTable().rows().nodes()).find('.item-stock-cell').get();
          }
          return Array.prototype.slice.call(document.querySelectorAll('.item-stock-cell'));
        }

        function runRound() {
          if (document.visibilityState !== 'visible') {
            setTimeout(runRound, STOCK_REFRESH_MS);
            return;
          }

          var queue = stockCells();

          function processNext() {
            var cell = queue.shift();
            if (!cell) { setTimeout(runRound, STOCK_REFRESH_MS); return; }

            var sku = cell.dataset.sku;
            if (!sku) { processNext(); return; }

            fetch('<%= stockend_dashboard_index_path %>?item_code=' + encodeURIComponent(sku) + (cell.dataset.b2b === '1' ? '&b2b=1' : ''))
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (data && data.disponivel !== undefined && data.disponivel !== null) {
                  cell.innerHTML = '<span class="fw-bold ' + (data.disponivel > 0 ? 'text-success' : 'text-danger') + '">' + data.disponivel + '</span>';
                } else {
                  cell.innerHTML = '<span class="text-muted-custom">-</span>';
                }
              })
              .catch(function () {
                // Numa atualização, mantém o último valor em vez de trocar por erro.
                if (cell.querySelector('.fa-spinner')) cell.innerHTML = '<span class="text-danger">erro</span>';
              })
              .finally(function () {
                setTimeout(processNext, 200);
              });
          }

          processNext();
        }

        runRound();
      })();

      const tooltipTriggerList = [].slice.call(
        document.querySelectorAll('[title]')
      );

      tooltipTriggerList.map(function(tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });
    });
  </script>
<% end %>
