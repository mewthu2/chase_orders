<% title 'Emissão de Nota Fiscal no Tiny' %>
<% header = capture do %>
  <% if screen_can?(:dashboard_correios, :edit) %>
    <button type="button" class="btn btn-secondary" data-pg-detail="invoiceUpdateForm"><i class="fas fa-pen-to-square"></i>Atualizar nota fiscal</button>
  <% end %>
<% end %>
<%= render 'dashboard/invoice_update_form' %>
<%= render 'dashboard/attempt_queue', kind: :log03, action: :invoice_emition, perm: :dashboard_correios, header: header,
           title: 'Emissão de Nota Fiscal no Tiny (Log03)', subtitle: 'O Tiny emite a nota dos pedidos já criados no Correios.', icon: 'fas fa-file-invoice',
           queue: @invoice_emition, errors: @queue_errors, corrections: @address_corrections, return_to: 'invoice_emition', step: 'nota',
           run_path: run_invoice_emition_dashboard_index_path, run_now_path: run_invoice_emition_now_dashboard_index_path,
           done_label: 'Emitidas hoje', done_help: 'Notas que o Tiny já devolveu hoje.', row_tip: 'Emitir esta nota agora', row_icon: 'fas fa-file-invoice',
           run_msg: 'Emitindo nota fiscal no Tiny...', bulk_label: 'Emitir selecionados',
           runbox_title: 'Fila de emissão de notas fiscais', runbox_text: 'Pede ao Tiny a nota dos pedidos já criados no Correios. O sistema roda sozinho; use Emitir agora se não puder esperar.',
           runbox_btn: 'Emitir fila agora', table_title: 'Fila de Emissão de Notas Fiscais', table_meta: 'Pedidos criados no Correios que ainda precisam de nota.',
           empty_text: 'Não há notas fiscais pendentes para emissão no momento.' %>
