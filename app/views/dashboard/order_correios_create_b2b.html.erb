<% title 'Pedidos p/ Aprovar (Log02)' %>
<% to_review = B2bOrder.honey_flow.where('created_at > ?', 6.months.ago).where(correios_order_id: nil, log_ignored: false).count { |o| o.log_stage == 'review' } %>

<%= hc_page_header 'Pedidos p/ Aprovar (Log02)', 'Decida quais pedidos do atacado seguem para o Correios.', icon: 'fas fa-clipboard-check' do %>
  <% if screen_can?(:dashboard_correios_b2b, :execute) %>
    <%= button_to run_create_correios_b2b_dashboard_index_path, method: :post, class: 'btn btn-export', disabled: @job_running,
                  form: { style: 'display: inline', data: { hc_confirm: (@job_running ? nil : { title: 'Rodar a rotina agora?', text: 'O sistema cria no Correios todos os pedidos já aprovados.', ok: 'Rodar agora', icon: 'fas fa-play' }.to_json) } } do %>
      <% if @job_running %><span class="spinner"></span>Executando…<% else %><i class="fas fa-play"></i>Rodar rotina agora<% end %>
    <% end %>
  <% end %>
<% end %>

<div class="callout pg-banner is-info"><i class="fas fa-circle-info"></i><div><strong>Nada anda sem a sua aprovação.</strong> Os pedidos feitos no Honey só seguem para criação, NF-e, XML e rastreio depois de aprovados aqui. Os ignorados nunca são processados.</div></div>

<div class="pg-blocks">
  <%= render 'dashboard/flow', kind: :log02, current: :order_correios_create_b2b, counts: { order_correios_create_b2b: to_review } %>
  <%= render 'dashboard/honey_b2b_orders', stages: %w[review ignored creation], review: true, title: 'Pedidos para aprovar',
             meta: 'Atacado, abastecimento e transferência B2C feitos no Honey. Aprovados, entram no Correios na próxima rodada.',
             empty_text: 'Quando alguém salvar um pedido de atacado, abastecimento ou transferência B2C, ele aparece aqui para você aprovar.' %>
</div>
