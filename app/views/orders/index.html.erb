<% content_for :title, "Pedidos Shopify" %>
<% brl = ->(v) { number_to_currency(v || 0, unit: 'R$ ', separator: ',', delimiter: '.') } %>
<% log03 = @locations.find { |l| l.slug == 'log+' } %>
<% map = ->(o) {
     c = o.customer
     codes = Array(o.discount_codes).compact_blank.map { |code| code.to_s.upcase }
     { id: o.id, record: o, num: o.shopify_order_id.presence || o.id, cliente: c&.full_name.presence || c&.email || '—', email: c&.email.presence || '—',
       fone: c&.phone.presence || c&.default_address_phone.presence || '—', loc: [[o.location&.name, o.location_id]].reject { |n, _| n.blank? },
       cupom: codes.first, cupons: codes.join(', ').presence || '—', pecas: o.order_items.sum { |i| i.quantity.to_i },
       desc: o.current_total_discounts.to_f, total: o.current_total_price.to_f, dt: o.shopify_creation_date || o.created_at, criado: o.created_at,
       cidade: [c&.default_address_city, c&.default_address_province_code].compact_blank.join('/').presence || '—',
       tags: o.tags.to_s.split(',').map(&:strip).compact_blank, tiny: o.tiny_order_id.presence&.to_s, shop: o.shopify_order_id, staff: o.staff_name.presence || '—' }
   } %>
<% search = ->(scope, text) {
     term = "%#{ActiveRecord::Base.sanitize_sql_like(text.strip.delete_prefix('#'))}%"
     scope.left_joins(:customer).where('orders.shopify_order_id LIKE :t OR orders.tiny_order_id LIKE :t OR customers.email LIKE :t OR customers.phone LIKE :t OR customers.first_name LIKE :t OR customers.last_name LIKE :t ' \
                                       "OR CONCAT_WS(' ', customers.first_name, customers.last_name) LIKE :t", t: term)
   } %>
<% with_coupon = ->(scope) { scope.where.not(discount_codes: nil).where("JSON_LENGTH(orders.discount_codes) > 0") } %>
<% table = HoneyQueryTable.new(params, scope: @scope, map: map, search: search, page_size: 8, unit: 'pedidos', unit1: 'pedido',
     attrs: { loc: :location_id }, filter_sql: { per: ->(scope, v) { scope.where('COALESCE(orders.shopify_creation_date, orders.created_at) >= ?', v.to_i.days.ago.beginning_of_day) } },
     sort_sql: { num: 'orders.id', total: 'orders.current_total_price', dt: 'COALESCE(orders.shopify_creation_date, orders.created_at)' },
     cols: [
       { k: :num, label: 'Pedido', t: :num, main: true, sort: true, nodetail: true },
       { k: :cliente, label: 'Cliente', t: :person, sub: :email },
       { k: :fone, label: 'Telefone' },
       { k: :email, label: 'E-mail', hide: true },
       { k: :loc, label: 'Localização', t: :loc },
       { k: :cupom, label: 'Cupom', t: :tag },
       { k: :cupons, label: 'Cupons usados', hide: true },
       { k: :pecas, label: 'Peças', t: :qty, hide: true },
       { k: :desc, label: 'Desconto', t: :money, hide: true },
       { k: :total, label: 'Total', t: :money, sort: true },
       { k: :dt, label: 'Data Shopify', t: :dt, sort: true },
       { k: :criado, label: 'Criado em', t: :dt, hide: true },
       { k: :cidade, label: 'Cidade/UF', hide: true },
       { k: :tags, label: 'Tags', t: :chips, hide: true },
       { k: :tiny, label: 'ID Tiny', t: :mono, hide: true, copy: true },
       { k: :shop, label: 'ID Shopify', t: :mono, hide: true, copy: true },
       { k: :staff, label: 'Atendida por', hide: true }
     ],
     filters: [
       { id: :q, type: :search, label: 'Buscar pedido', ph: 'Nº do pedido, cliente, e-mail ou telefone', tip: 'Procura pelo número do pedido, pelo nome, e-mail ou telefone da cliente e pelo ID do Shopify ou do Tiny.' },
       { id: :loja, type: :select, label: 'Localização', col: :loc, options: @locations.map { |l| [l.id.to_s, l.slug == 'log+' ? "#{l.name} (envio pelos Correios)" : l.name] }, all: 'Todas as localizações', tip: 'A loja do pedido. O Log03 reúne os pedidos online enviados pelos Correios.' },
       { id: :per, type: :select, label: 'Período', options: [['7', 'Últimos 7 dias'], ['15', 'Últimos 15 dias'], ['30', 'Últimos 30 dias']], all: 'Todo o período', tip: 'Filtra pela data em que o pedido foi feito no Shopify.' }
     ],
     kpis: [
       { label: 'Pedidos', icon: 'fas fa-shopping-cart', tone: 'blue', help: 'Todos os pedidos que vieram do Shopify.', value: ->(scope) { scope.except(:includes).count } },
       { label: 'Faturamento', icon: 'fas fa-sack-dollar', tone: 'green', help: 'Soma do total de todos os pedidos.', text: brl.call(Order.sum(:current_total_price)) },
       { label: 'Com cupom', icon: 'fas fa-ticket', tone: 'purple', help: 'Pedidos que usaram algum cupom.', col: :cp, val: 'sim', value: ->(scope) { with_coupon.call(scope.except(:includes)).count }, filter: with_coupon },
       { label: 'Pedidos do Log03', icon: 'fas fa-truck-fast', tone: 'orange', help: 'Online, enviados pelos Correios (B2C).', col: :loc, val: log03&.id.to_s }
     ].reject { |k| k[:col] == :loc && log03.nil? }) %>

<%= hc_page_header 'Pedidos Shopify', 'Consulte os pedidos da loja online e exporte para planilha.', icon: 'fas fa-shopping-cart' do %>
  <% if screen_can?(:orders, :export) %>
    <%= link_to export_orders_path(request.query_parameters.slice('loja', 'q').transform_keys { |k| { 'loja' => 'location_id', 'q' => 'search' }[k] }), class: 'btn btn-export', data: { turbo: false } do %><i class="fas fa-file-excel"></i>Exportar XLSX<% end %>
  <% end %>
<% end %>

<% if params[:customer_id].present? %>
  <div class="callout pg-banner is-info"><i class="fas fa-user"></i><div><strong>Pedidos de <%= @customer&.full_name.presence || @customer&.email || 'cliente não encontrada' %>.</strong> A lista mostra só os pedidos desta cliente. <%= link_to 'Ver todos os pedidos', hc_pg_url('customer_id' => nil) %></div></div>
<% end %>

<div class="pg-blocks">
  <%= hc_pg_kpis(table) %>
  <%= hc_pg_table(table, title: 'Lista de pedidos', icon: 'fas fa-shopping-cart', meta: 'Pedidos que chegam do Shopify. Abra um pedido para ver itens, cupom e os códigos.',
        empty: { title: 'Nenhum pedido encontrado', text: 'Tente ajustar os filtros ou limpar a busca.' },
        detail: { title: ->(r) { "Pedido ##{r[:num]}" }, note: 'Dados do pedido como vieram do Shopify e do Tiny. As tags trazem o código de rastreio.',
                  extra: ->(r) {
                    items = r[:record].order_items
                    next nil if items.empty?

                    content_tag(:section, content_tag(:h4, content_tag(:i, '', class: 'fas fa-box') + 'Itens do pedido') +
                      content_tag(:div, content_tag(:table, content_tag(:thead, content_tag(:tr, safe_join(%w[SKU Produto Qtde].map { |h| content_tag(:th, h) }))) +
                        content_tag(:tbody, safe_join(items.map { |i| content_tag(:tr, content_tag(:td, i.sku.presence || i.product&.sku || '—') + content_tag(:td, i.product&.shopify_product_name || '—') + content_tag(:td, i.quantity)) })),
                        class: 'orders-table pg-tbl pg-mini'), class: 'table-responsive'), class: 'help-sec')
                  } }) %>
</div>
