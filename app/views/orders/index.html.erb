<%
  active_period    = params[:period].presence
  active_date_from = params[:date_from].presence
  active_date_to   = params[:date_to].presence
  active_sort      = params[:sort].presence || "alphabetical"
  period_labels    = { "30" => "Últimos 30 dias", "60" => "Últimos 60 dias", "90" => "Últimos 90 dias" }

  has_filters = active_period.present? ||
                active_date_from.present? ||
                active_date_to.present? ||
                params[:coupon_search].present?

  top5 = @coupon_stats&.first(5) || []
  top5_max = top5.first&.last.to_f
  top5_max = 1.0 if top5_max == 0.0

  podium_colors = ["#E3B341", "#8B949E", "#CD7F32", "#58A6FF", "#3FB950"]
  podium_icons  = ["fa-trophy", "fa-medal", "fa-award", "fa-star", "fa-star"]
%>

<div class="orders-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-ticket-alt me-2"></i>Uso de Cupons
      </h1>
      <small class="page-subtitle">
        <i class="fas fa-clock me-1"></i>
        Atualizado em <%= Time.current.strftime('%d/%m/%Y às %H:%M') %>
      </small>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-tags me-1"></i><%= @total_unique_coupons %> cupom(ns) únicos
      </span>
      <span class="total-badge" style="background:#238636;">
        <i class="fas fa-shopping-bag me-1"></i><%= @total_with_coupon %> pedidos com cupom
      </span>
      <%= link_to coupon_usage_orders_path(request.query_parameters.merge("format" => "xlsx")),
                  class: "btn-export" do %>
        <i class="fas fa-file-excel me-2"></i>Exportar XLSX
      <% end %>
    </div>
  </div>

  <%# ===== PAINEL DE FILTROS ===== %>
  <div class="filters-panel">

    <%# --- Busca por cupom --- %>
    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-search me-1"></i>Buscar cupom
      </label>
      <%= form_with url: coupon_usage_orders_path, method: :get, local: true do |f| %>
        <%= hidden_field_tag :period,    params[:period]    if params[:period].present? && !active_date_from.present? %>
        <%= hidden_field_tag :date_from, params[:date_from] if params[:date_from].present? %>
        <%= hidden_field_tag :date_to,   params[:date_to]   if params[:date_to].present? %>
        <%= hidden_field_tag :sort,      params[:sort]      if params[:sort].present? %>
        <div class="search-row">
          <%= f.text_field :coupon_search,
                           value: params[:coupon_search],
                           class: "search-input",
                           placeholder: "Código do cupom..." %>
          <%= f.submit "Buscar", class: "btn-primary-sm" %>
          <% if has_filters %>
            <%= link_to coupon_usage_orders_path, class: "btn-clear" do %>
              <i class="fas fa-times me-1"></i>Limpar tudo
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="filter-divider"></div>

    <%# --- Período rápido --- %>
    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-calendar-alt me-1"></i>Período rápido
      </label>
      <div class="period-buttons">
        <% ["30", "60", "90"].each do |days| %>
          <% is_active = active_period == days && !active_date_from.present? %>
          <%= link_to coupon_usage_orders_path(
                        period:        days,
                        coupon_search: params[:coupon_search],
                        sort:          params[:sort]
                      ),
                      class: "btn-period #{is_active ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-history me-1"></i><%= period_labels[days] %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="filter-divider"></div>

    <%# --- Intervalo personalizado --- %>
    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-calendar-week me-1"></i>Intervalo personalizado
      </label>
      <%= form_with url: coupon_usage_orders_path, method: :get, local: true do |f| %>
        <%= hidden_field_tag :coupon_search, params[:coupon_search] if params[:coupon_search].present? %>
        <%= hidden_field_tag :sort,          params[:sort]          if params[:sort].present? %>
        <div class="date-range-row">
          <div class="date-field-wrap">
            <span class="date-label">De</span>
            <%= date_field_tag :date_from, params[:date_from], class: "date-input" %>
          </div>
          <div class="date-field-wrap">
            <span class="date-label">Até</span>
            <%= date_field_tag :date_to, params[:date_to], class: "date-input" %>
          </div>
          <button type="submit" class="btn-period <%= active_date_from.present? ? 'btn-period--active' : '' %>">
            <i class="fas fa-filter me-1"></i>Aplicar
          </button>
          <% if active_date_from.present? || active_date_to.present? %>
            <%= link_to coupon_usage_orders_path(coupon_search: params[:coupon_search], sort: params[:sort]),
                        class: "btn-remove-date" do %>
              <i class="fas fa-times me-1"></i>Remover datas
            <% end %>
            <span class="date-range-badge">
              <i class="fas fa-calendar-check me-1"></i>
              <%= active_date_from.present? ? Date.parse(active_date_from).strftime('%d/%m/%Y') : '...' %>
              &rarr;
              <%= active_date_to.present? ? Date.parse(active_date_to).strftime('%d/%m/%Y') : 'hoje' %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="filter-divider"></div>

    <%# --- Ordenação --- %>
    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-sort-amount-down me-1"></i>Ordenar por
      </label>
      <div class="period-buttons">
        <%= link_to coupon_usage_orders_path(
                      sort:          "alphabetical",
                      period:        params[:period],
                      date_from:     params[:date_from],
                      date_to:       params[:date_to],
                      coupon_search: params[:coupon_search]
                    ),
                    class: "btn-period #{active_sort == 'alphabetical' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-sort-alpha-down me-1"></i>A → Z
        <% end %>
        <%= link_to coupon_usage_orders_path(
                      sort:          "most_used",
                      period:        params[:period],
                      date_from:     params[:date_from],
                      date_to:       params[:date_to],
                      coupon_search: params[:coupon_search]
                    ),
                    class: "btn-period #{active_sort == 'most_used' ? 'btn-period--active' : ''}" do %>
          <i class="fas fa-fire me-1"></i>Mais usados
        <% end %>
      </div>
    </div>

  </div>

  <%# ===== TOP 5 MAIS VENDIDOS ===== %>
  <% if top5.any? %>
    <div class="top5-panel">
      <div class="top5-header">
        <span class="top5-title">
          <i class="fas fa-crown me-2" style="color:#E3B341;"></i>Top 5 Cupons Mais Usados
        </span>
        <% if active_period.present? && !active_date_from.present? %>
          <span class="filter-tag filter-tag--yellow">
            <i class="fas fa-history me-1"></i><%= period_labels[active_period] %>
          </span>
        <% end %>
        <% if active_date_from.present? || active_date_to.present? %>
          <span class="filter-tag filter-tag--yellow">
            <i class="fas fa-calendar me-1"></i>
            <%= active_date_from.present? ? Date.parse(active_date_from).strftime('%d/%m/%Y') : '...' %>
            &rarr;
            <%= active_date_to.present? ? Date.parse(active_date_to).strftime('%d/%m/%Y') : 'hoje' %>
          </span>
        <% end %>
      </div>
      <div class="top5-grid">
        <% top5.each_with_index do |(code, count), i| %>
          <%
            color   = podium_colors[i]
            icon    = podium_icons[i]
            bar_pct = (count.to_f / top5_max * 100).round(1)
            revenue = @coupon_revenue[code] || 0.0
          %>
          <div class="top5-card" style="--accent: <%= color %>;">
            <div class="top5-rank">
              <i class="fas <%= icon %>" style="color:<%= color %>;"></i>
              <span class="top5-rank-num" style="color:<%= color %>;">#<%= i + 1 %></span>
            </div>
            <div class="top5-code"><%= code %></div>
            <div class="top5-count">
              <span class="top5-count-num" style="color:<%= color %>;"><%= count %></span>
              <span class="top5-count-label">uso<%= count == 1 ? '' : 's' %></span>
            </div>
            <% if revenue > 0 %>
              <div class="top5-revenue">
                <i class="fas fa-dollar-sign me-1" style="color:#3FB950; font-size:0.7rem;"></i>
                R$ <%= number_with_delimiter(revenue.round(2), delimiter: '.', separator: ',') %>
              </div>
            <% end %>
            <div class="top5-bar-wrap">
              <div class="top5-bar" style="width:<%= bar_pct %>%; background:<%= color %>;"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ===== TABELA ===== %>
  <div class="table-card">

    <div class="table-card-header">
      <h5 class="table-card-title">
        <i class="fas fa-list me-2"></i>Lista de Cupons
        <% if active_sort == "most_used" %>
          <span class="sort-badge"><i class="fas fa-fire me-1"></i>Mais usados primeiro</span>
        <% else %>
          <span class="sort-badge sort-badge--gray"><i class="fas fa-sort-alpha-down me-1"></i>A → Z</span>
        <% end %>
      </h5>
      <div class="active-filters-row">
        <% if params[:coupon_search].present? %>
          <span class="filter-tag filter-tag--gray">
            <i class="fas fa-search me-1"></i>"<%= params[:coupon_search] %>"
          </span>
        <% end %>
        <% if active_period.present? && !active_date_from.present? %>
          <span class="filter-tag filter-tag--yellow">
            <i class="fas fa-history me-1"></i><%= period_labels[active_period] %>
          </span>
        <% end %>
        <% if active_date_from.present? || active_date_to.present? %>
          <span class="filter-tag filter-tag--yellow">
            <i class="fas fa-calendar me-1"></i>
            <%= active_date_from.present? ? Date.parse(active_date_from).strftime('%d/%m/%Y') : '...' %>
            &rarr;
            <%= active_date_to.present? ? Date.parse(active_date_to).strftime('%d/%m/%Y') : 'hoje' %>
          </span>
        <% end %>
      </div>
    </div>

    <% if @coupon_stats.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th style="width:3rem;">#</th>
              <th>Código do Cupom</th>
              <th style="text-align:center;">Nº de Usos</th>
              <th style="text-align:right;">Receita Gerada</th>
            </tr>
          </thead>
          <tbody>
            <% @coupon_stats.each_with_index do |(code, count), i| %>
              <%
                global_rank = (@current_page - 1) * @per_page + i + 1
                revenue     = @coupon_revenue[code] || 0.0
                is_top      = global_rank <= 3
                rank_color  = podium_colors[global_rank - 1] if global_rank <= 5
              %>
              <tr>
                <td>
                  <% if global_rank <= 5 %>
                    <span class="rank-badge" style="background:<%= podium_colors[global_rank - 1] %>1a; color:<%= podium_colors[global_rank - 1] %>; border-color:<%= podium_colors[global_rank - 1] %>40;">
                      <i class="fas <%= podium_icons[global_rank - 1] %> me-1" style="font-size:0.65rem;"></i>#<%= global_rank %>
                    </span>
                  <% else %>
                    <span class="text-muted-custom"><%= global_rank %></span>
                  <% end %>
                </td>
                <td>
                  <span class="coupon-code <%= is_top ? 'coupon-code--top' : '' %>">
                    <i class="fas fa-tag me-1" style="font-size:0.7rem; opacity:0.6;"></i><%= code %>
                  </span>
                </td>
                <td style="text-align:center;">
                  <span class="usage-count">
                    <% if active_sort == "most_used" && i == 0 && @current_page == 1 %>
                      <i class="fas fa-fire me-1" style="color:#E3B341; font-size:0.75rem;"></i>
                    <% end %>
                    <%= count %>
                  </span>
                </td>
                <td style="text-align:right;">
                  <% if revenue > 0 %>
                    <span class="revenue-value">
                      R$ <%= number_with_delimiter(revenue.round(2), delimiter: '.', separator: ',') %>
                    </span>
                  <% else %>
                    <span class="text-muted-custom">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% else %>
      <div class="empty-state">
        <i class="fas fa-ticket-alt fa-3x mb-3 d-block"></i>
        <h5>Nenhum cupom encontrado</h5>
        <p>Tente ajustar os filtros aplicados</p>
        <% if has_filters %>
          <%= link_to coupon_usage_orders_path, class: "btn-clear" do %>
            <i class="fas fa-times me-1"></i>Limpar filtros
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# PAGINAÇÃO %>
    <% if @total_pages > 1 %>
      <div class="pagination-footer">
        <div class="pagination-info">
          Mostrando
          <strong><%= [(@current_page - 1) * @per_page + 1, @total_unique_coupons].min %></strong>
          a
          <strong><%= [@current_page * @per_page, @total_unique_coupons].min %></strong>
          de
          <strong><%= @total_unique_coupons %></strong>
          cupons
        </div>

        <div class="pagination-controls">
          <% if @current_page > 1 %>
            <%= link_to coupon_usage_orders_path(request.query_parameters.merge("page" => @current_page - 1)),
                        class: "page-btn" do %>
              <i class="fas fa-chevron-left me-1"></i>Anterior
            <% end %>
          <% end %>

          <% window  = 2
             p_start = [@current_page - window, 1].max
             p_end   = [@current_page + window, @total_pages].min %>

          <% (p_start..p_end).each do |pnum| %>
            <% if pnum == @current_page %>
              <span class="page-btn page-btn--active"><%= pnum %></span>
            <% else %>
              <%= link_to pnum,
                          coupon_usage_orders_path(request.query_parameters.merge("page" => pnum)),
                          class: "page-btn" %>
            <% end %>
          <% end %>

          <% if @current_page < @total_pages %>
            <%= link_to coupon_usage_orders_path(request.query_parameters.merge("page" => @current_page + 1)),
                        class: "page-btn" do %>
              Próxima<i class="fas fa-chevron-right ms-1"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

</div>

<style>
/* =========================================
   COUPON USAGE — CSS
   ========================================= */

.orders-container {
  padding: 1.5rem;
  min-height: 100vh;
}

/* ---- Header ---- */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1rem;
}

.page-title {
  color: #e6edf3;
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0 0 0.2rem;
}

.page-subtitle {
  color: #8b949e;
  font-size: 0.8rem;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.total-badge {
  background: #1f6feb;
  color: #fff;
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 600;
}

.btn-export {
  background: #238636;
  color: #fff !important;
  border: none;
  padding: 0.45rem 1.1rem;
  border-radius: 8px;
  font-size: 0.84rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-export:hover {
  background: #2ea043;
  color: #fff !important;
}

/* ---- Filtros ---- */
.filters-panel {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1rem;
}

.filter-section { padding: 0.5rem 0; }

.filter-divider {
  border-top: 1px solid #21262d;
  margin: 0.75rem 0;
}

.filter-label {
  display: block;
  color: #8b949e;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 0.6rem;
}

.search-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
}

.search-input {
  flex: 1;
  min-width: 220px;
  background: #0d1117;
  border: 1px solid #30363d;
  color: #e6edf3;
  border-radius: 8px;
  padding: 0.45rem 0.9rem;
  font-size: 0.88rem;
  transition: border-color 0.2s;
}

.search-input:focus {
  outline: none;
  border-color: #1f6feb;
  box-shadow: 0 0 0 3px rgba(31,111,235,0.15);
}

.search-input::placeholder { color: #484f58; }

.btn-primary-sm {
  background: #1f6feb;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.45rem 1.1rem;
  font-size: 0.84rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-primary-sm:hover { background: #388bfd; }

.btn-clear {
  background: transparent;
  border: 1px solid #30363d;
  color: #8b949e !important;
  border-radius: 8px;
  padding: 0.45rem 0.9rem;
  font-size: 0.84rem;
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
}

.btn-clear:hover {
  border-color: #e57373;
  color: #e57373 !important;
}

.period-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.btn-period {
  background: transparent;
  border: 1px solid #30363d;
  color: #c9d1d9;
  border-radius: 8px;
  padding: 0.38rem 0.85rem;
  font-size: 0.82rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-period:hover {
  border-color: #e3b341;
  color: #e3b341;
}

.btn-period--active {
  background: #e3b341 !important;
  border-color: #e3b341 !important;
  color: #0d1117 !important;
  font-weight: 700;
}

.date-range-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
}

.date-field-wrap {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.date-label {
  color: #8b949e;
  font-size: 0.8rem;
  white-space: nowrap;
}

.date-input {
  background: #0d1117;
  border: 1px solid #30363d;
  color: #e6edf3;
  border-radius: 8px;
  padding: 0.38rem 0.7rem;
  font-size: 0.84rem;
  transition: border-color 0.2s;
}

.date-input:focus {
  outline: none;
  border-color: #1f6feb;
}

.btn-remove-date {
  background: transparent;
  border: 1px solid #e57373;
  color: #e57373 !important;
  border-radius: 8px;
  padding: 0.38rem 0.8rem;
  font-size: 0.82rem;
  text-decoration: none;
  transition: background 0.2s;
}

.btn-remove-date:hover { background: rgba(229,115,115,0.1); }

.date-range-badge {
  background: #e3b341;
  color: #0d1117;
  border-radius: 20px;
  padding: 0.3rem 0.85rem;
  font-size: 0.78rem;
  font-weight: 600;
}

/* ---- Top 5 ---- */
.top5-panel {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1rem;
}

.top5-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}

.top5-title {
  color: #e6edf3;
  font-size: 0.95rem;
  font-weight: 700;
  margin-right: auto;
}

.top5-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 0.75rem;
}

.top5-card {
  background: #0d1117;
  border: 1px solid #21262d;
  border-radius: 10px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  position: relative;
  overflow: hidden;
  transition: border-color 0.2s, transform 0.15s;
}

.top5-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}

.top5-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--accent);
  border-radius: 10px 10px 0 0;
}

.top5-rank {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.82rem;
}

.top5-rank-num {
  font-weight: 800;
  font-size: 0.9rem;
}

.top5-code {
  color: #e6edf3;
  font-weight: 700;
  font-size: 0.88rem;
  word-break: break-all;
  letter-spacing: 0.03em;
}

.top5-count {
  display: flex;
  align-items: baseline;
  gap: 0.3rem;
}

.top5-count-num {
  font-size: 1.5rem;
  font-weight: 800;
  line-height: 1;
}

.top5-count-label {
  color: #8b949e;
  font-size: 0.75rem;
}

.top5-revenue {
  color: #3FB950;
  font-size: 0.78rem;
  font-weight: 600;
}

.top5-bar-wrap {
  margin-top: 0.35rem;
  background: #21262d;
  border-radius: 4px;
  height: 5px;
  overflow: hidden;
}

.top5-bar {
  height: 100%;
  border-radius: 4px;
  transition: width 0.4s ease;
}

/* ---- Tabela ---- */
.table-card {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  overflow: hidden;
}

.table-card-header {
  background: #1c2128;
  border-bottom: 1px solid #21262d;
