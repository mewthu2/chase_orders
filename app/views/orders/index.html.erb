<%
  badge_colors = [
    { bg: "#0D6EFD", fg: "#fff" },
    { bg: "#198754", fg: "#fff" },
    { bg: "#DC3545", fg: "#fff" },
    { bg: "#FFC107", fg: "#000" },
    { bg: "#0DCAF0", fg: "#000" },
    { bg: "#6F42C1", fg: "#fff" },
    { bg: "#FD7E14", fg: "#fff" },
    { bg: "#20C997", fg: "#000" },
  ]

  location_index_map = {}
  @locations.each_with_index { |loc, i| location_index_map[loc.id] = i }

  active_period    = params[:period].presence
  active_date_from = params[:date_from].presence
  active_date_to   = params[:date_to].presence
  period_labels    = { "30" => "Últimos 30 dias", "60" => "Últimos 60 dias", "90" => "Últimos 90 dias" }

  has_filters = params[:search].present? ||
                params[:location_id].present? ||
                active_period.present? ||
                active_date_from.present? ||
                active_date_to.present?
%>

<div class="orders-container">

  <%# ===== HEADER ===== %>
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">
        <i class="fas fa-shopping-cart me-2"></i>Pedidos Shopify
      </h1>
      <small class="page-subtitle">
        <i class="fas fa-clock me-1"></i>
        Atualizado em <%= Time.current.strftime('%d/%m/%Y às %H:%M') %>
      </small>
    </div>
    <div class="header-actions">
      <span class="total-badge">
        <i class="fas fa-list me-1"></i><%= @total_orders %> pedido(s)
      </span>
      <%= link_to export_orders_path(request.query_parameters.except("page")),
                  class: "btn-export" do %>
        <i class="fas fa-file-excel me-2"></i>Exportar XLSX
      <% end %>
    </div>
  </div>

  <%# ===== PAINEL DE FILTROS ===== %>
  <div class="filters-panel">

    <%# --- Busca por texto --- %>
    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-search me-1"></i>Buscar pedido
      </label>
      <%= form_with url: orders_path, method: :get, local: true do |f| %>
        <%= hidden_field_tag :location_id, params[:location_id] if params[:location_id].present? %>
        <%= hidden_field_tag :period,      params[:period]      if params[:period].present? && !active_date_from.present? %>
        <%= hidden_field_tag :date_from,   params[:date_from]   if params[:date_from].present? %>
        <%= hidden_field_tag :date_to,     params[:date_to]     if params[:date_to].present? %>
        <div class="search-row">
          <%= f.text_field :search,
                           value: params[:search],
                           class: "search-input",
                           placeholder: "N. pedido, nome do cliente ou email..." %>
          <%= f.submit "Buscar", class: "btn-primary-sm" %>
          <% if has_filters %>
            <%= link_to orders_path, class: "btn-clear" do %>
              <i class="fas fa-times me-1"></i>Limpar tudo
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="filter-divider"></div>

    <%# --- Período rápido --- %>
    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-calendar-alt me-1"></i>Período rápido
      </label>
      <div class="period-buttons">
        <% ["30", "60", "90"].each do |days| %>
          <% is_active = active_period == days && !active_date_from.present? %>
          <%= link_to orders_path(
                        period:      days,
                        location_id: params[:location_id],
                        search:      params[:search]
                      ),
                      class: "btn-period #{is_active ? 'btn-period--active' : ''}" do %>
            <i class="fas fa-history me-1"></i><%= period_labels[days] %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="filter-divider"></div>

    <%# --- Intervalo personalizado --- %>
    <div class="filter-section">
      <label class="filter-label">
        <i class="fas fa-calendar-week me-1"></i>Intervalo personalizado
      </label>
      <%= form_with url: orders_path, method: :get, local: true do |f| %>
        <%= hidden_field_tag :location_id, params[:location_id] if params[:location_id].present? %>
        <%= hidden_field_tag :search,      params[:search]      if params[:search].present? %>
        <div class="date-range-row">
          <div class="date-field-wrap">
            <span class="date-label">De</span>
            <%= date_field_tag :date_from,
                               params[:date_from],
                               class: "date-input" %>
          </div>
          <div class="date-field-wrap">
            <span class="date-label">Até</span>
            <%= date_field_tag :date_to,
                               params[:date_to],
                               class: "date-input" %>
          </div>
          <button type="submit" class="btn-period <%= active_date_from.present? ? 'btn-period--active' : '' %>">
            <i class="fas fa-filter me-1"></i>Aplicar
          </button>
          <% if active_date_from.present? || active_date_to.present? %>
            <%= link_to orders_path(location_id: params[:location_id], search: params[:search]),
                        class: "btn-remove-date" do %>
              <i class="fas fa-times me-1"></i>Remover datas
            <% end %>
            <span class="date-range-badge">
              <i class="fas fa-calendar-check me-1"></i>
              <%= active_date_from.present? ? Date.parse(active_date_from).strftime('%d/%m/%Y') : '...' %>
              &rarr;
              <%= active_date_to.present? ? Date.parse(active_date_to).strftime('%d/%m/%Y') : 'hoje' %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>

  <%# ===== FILTRO POR LOCATION ===== %>
  <div class="location-panel">
    <span class="filter-label">
      <i class="fas fa-map-marker-alt me-1"></i>Location:
    </span>

    <%= link_to orders_path(
                  search:    params[:search],
                  period:    params[:period],
                  date_from: params[:date_from],
                  date_to:   params[:date_to]
                ),
                class: "btn-location #{params[:location_id].blank? ? 'btn-location--all-active' : 'btn-location--all'}" do %>
      <i class="fas fa-border-all me-1"></i>Todas
    <% end %>

    <% @locations.each_with_index do |location, i| %>
      <% color     = badge_colors[i % badge_colors.size]
         is_active = params[:location_id].to_s == location.id.to_s
         btn_style = is_active ?
           "background-color:#{color[:bg]}; color:#{color[:fg]}; border-color:#{color[:bg]}; font-weight:700;" :
           "background-color:transparent; color:#{color[:bg]}; border-color:#{color[:bg]};"
      %>
      <%= link_to orders_path(
                    location_id: location.id,
                    search:      params[:search],
                    period:      params[:period],
                    date_from:   params[:date_from],
                    date_to:     params[:date_to]
                  ),
                  class: "btn-location",
                  style: btn_style do %>
        <i class="fas fa-warehouse me-1"></i><%= location.name %>
      <% end %>
    <% end %>

    <% if params[:location_id].present?
         active_loc   = @locations.find { |l| l.id.to_s == params[:location_id] }
         active_idx   = location_index_map[active_loc&.id]
         active_color = badge_colors[active_idx % badge_colors.size] if active_idx
    %>
      <span class="location-active-badge"
            style="background-color:<%= active_color ? active_color[:bg] : '#0DCAF0' %>; color:<%= active_color ? active_color[:fg] : '#000' %>;">
        <i class="fas fa-filter me-1"></i><%= active_loc&.name %>
      </span>
    <% end %>
  </div>

  <%# ===== TABELA ===== %>
  <div class="table-card">

    <div class="table-card-header">
      <h5 class="table-card-title">
        <i class="fas fa-list me-2"></i>Lista de Pedidos
      </h5>
      <div class="active-filters-row">
        <% if params[:search].present? %>
          <span class="filter-tag filter-tag--gray">
            <i class="fas fa-search me-1"></i>"<%= params[:search] %>"
          </span>
        <% end %>
        <% if active_period.present? && !active_date_from.present? %>
          <span class="filter-tag filter-tag--yellow">
            <i class="fas fa-history me-1"></i><%= period_labels[active_period] %>
          </span>
        <% end %>
        <% if active_date_from.present? || active_date_to.present? %>
          <span class="filter-tag filter-tag--yellow">
            <i class="fas fa-calendar me-1"></i>
            <%= active_date_from.present? ? Date.parse(active_date_from).strftime('%d/%m/%Y') : '...' %>
            &rarr;
            <%= active_date_to.present? ? Date.parse(active_date_to).strftime('%d/%m/%Y') : 'hoje' %>
          </span>
        <% end %>
      </div>
    </div>

    <% if @orders.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <tr>
              <th>Pedido</th>
              <th>Cliente</th>
              <th>Email</th>
              <th>Telefone</th>
              <th>Localização</th>
              <th>Data Shopify</th>
              <th>Criado em</th>
            </tr>
          </thead>
          <tbody>
            <% @orders.each do |order| %>
              <%
                loc       = order.location
                loc_idx   = loc ? location_index_map[loc.id] : nil
                loc_color = loc_idx ? badge_colors[loc_idx % badge_colors.size] : nil
              %>
              <tr>
                <td class="order-id">#<%= order.shopify_order_id %></td>
                <td class="text-main">
                  <%= [order.customer&.first_name, order.customer&.last_name].compact.join(" ").presence || "—" %>
                </td>
                <td class="text-muted-custom">
                  <%= order.customer&.email.presence || "—" %>
                </td>
                <td class="text-muted-custom">
                  <%= order.customer&.phone.presence || "—" %>
                </td>
                <td>
                  <% if loc && loc_color %>
                    <span class="location-badge"
                          style="background-color:<%= loc_color[:bg] %>; color:<%= loc_color[:fg] %>;">
                      <i class="fas fa-warehouse me-1"></i><%= loc.name %>
                    </span>
                  <% else %>
                    <span class="location-badge location-badge--empty">
                      <i class="fas fa-question me-1"></i>Sem location
                    </span>
                  <% end %>
                </td>
                <td class="text-main">
                  <%= order.shopify_creation_date&.strftime('%d/%m/%Y %H:%M') || "—" %>
                </td>
                <td class="text-muted-custom">
                  <%= order.created_at.strftime('%d/%m/%Y %H:%M') %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% else %>
      <div class="empty-state">
        <i class="fas fa-search fa-3x mb-3 d-block"></i>
        <h5>Nenhum pedido encontrado</h5>
        <p>Tente ajustar os filtros aplicados</p>
        <% if has_filters %>
          <%= link_to orders_path, class: "btn-clear" do %>
            <i class="fas fa-times me-1"></i>Limpar filtros
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# PAGINAÇÃO %>
    <% if @total_pages > 1 %>
      <div class="pagination-footer">
        <div class="pagination-info">
          Mostrando
          <strong><%= [(@current_page - 1) * @per_page + 1, @total_orders].min %></strong>
          a
          <strong><%= [@current_page * @per_page, @total_orders].min %></strong>
          de
          <strong><%= @total_orders %></strong>
          pedidos
        </div>

        <div class="pagination-controls">
          <% if @current_page > 1 %>
            <%= link_to orders_path(request.query_parameters.merge("page" => @current_page - 1)),
                        class: "page-btn" do %>
              <i class="fas fa-chevron-left me-1"></i>Anterior
            <% end %>
          <% end %>

          <% window  = 2
             p_start = [@current_page - window, 1].max
             p_end   = [@current_page + window, @total_pages].min %>

          <% (p_start..p_end).each do |pnum| %>
            <% if pnum == @current_page %>
              <span class="page-btn page-btn--active"><%= pnum %></span>
            <% else %>
              <%= link_to pnum,
                          orders_path(request.query_parameters.merge("page" => pnum)),
                          class: "page-btn" %>
            <% end %>
          <% end %>

          <% if @current_page < @total_pages %>
            <%= link_to orders_path(request.query_parameters.merge("page" => @current_page + 1)),
                        class: "page-btn" do %>
              Próxima<i class="fas fa-chevron-right ms-1"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

</div>

<style>
/* =========================================
   ORDERS — CSS completo
   ========================================= */

.orders-container {
  padding: 1.5rem;
  min-height: 100vh;
}

/* ---- Header ---- */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1rem;
}

.page-title {
  color: #e6edf3;
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0 0 0.2rem;
}

.page-subtitle {
  color: #8b949e;
  font-size: 0.8rem;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.total-badge {
  background: #1f6feb;
  color: #fff;
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 600;
}

.btn-export {
  background: #238636;
  color: #fff !important;
  border: none;
  padding: 0.45rem 1.1rem;
  border-radius: 8px;
  font-size: 0.84rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-export:hover {
  background: #2ea043;
  color: #fff !important;
}

/* ---- Painel de filtros ---- */
.filters-panel {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1rem;
}

.filter-section {
  padding: 0.5rem 0;
}

.filter-divider {
  border-top: 1px solid #21262d;
  margin: 0.75rem 0;
}

.filter-label {
  display: block;
  color: #8b949e;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 0.6rem;
}

/* Busca */
.search-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
}

.search-input {
  flex: 1;
  min-width: 220px;
  background: #0d1117;
  border: 1px solid #30363d;
  color: #e6edf3;
  border-radius: 8px;
  padding: 0.45rem 0.9rem;
  font-size: 0.88rem;
  transition: border-color 0.2s;
}

.search-input:focus {
  outline: none;
  border-color: #1f6feb;
  box-shadow: 0 0 0 3px rgba(31,111,235,0.15);
}

.search-input::placeholder {
  color: #484f58;
}

.btn-primary-sm {
  background: #1f6feb;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 0.45rem 1.1rem;
  font-size: 0.84rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-primary-sm:hover {
  background: #388bfd;
}

.btn-clear {
  background: transparent;
  border: 1px solid #30363d;
  color: #8b949e !important;
  border-radius: 8px;
  padding: 0.45rem 0.9rem;
  font-size: 0.84rem;
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
}

.btn-clear:hover {
  border-color: #e57373;
  color: #e57373 !important;
}

/* Período rápido */
.period-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.btn-period {
  background: transparent;
  border: 1px solid #30363d;
  color: #c9d1d9;
  border-radius: 8px;
  padding: 0.38rem 0.85rem;
  font-size: 0.82rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-period:hover {
  border-color: #e3b341;
  color: #e3b341;
}

.btn-period--active {
  background: #e3b341 !important;
  border-color: #e3b341 !important;
  color: #0d1117 !important;
  font-weight: 700;
}

/* Intervalo de datas */
.date-range-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
}

.date-field-wrap {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.date-label {
  color: #8b949e;
  font-size: 0.8rem;
  white-space: nowrap;
}

.date-input {
  background: #0d1117;
  border: 1px solid #30363d;
  color: #e6edf3;
  border-radius: 8px;
  padding: 0.38rem 0.7rem;
  font-size: 0.84rem;
  transition: border-color 0.2s;
}

.date-input:focus {
  outline: none;
  border-color: #1f6feb;
}

.btn-remove-date {
  background: transparent;
  border: 1px solid #e57373;
  color: #e57373 !important;
  border-radius: 8px;
  padding: 0.38rem 0.8rem;
  font-size: 0.82rem;
  text-decoration: none;
  transition: background 0.2s;
}

.btn-remove-date:hover {
  background: rgba(229,115,115,0.1);
}

.date-range-badge {
  background: #e3b341;
  color: #0d1117;
  border-radius: 20px;
  padding: 0.3rem 0.85rem;
  font-size: 0.78rem;
  font-weight: 600;
}

/* ---- Location panel ---- */
.location-panel {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  padding: 1rem 1.5rem;
  margin-bottom: 1rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}

.location-panel .filter-label {
  margin: 0;
  margin-right: 0.25rem;
  white-space: nowrap;
}

.btn-location {
  border: 1px solid #30363d;
  border-radius: 20px;
  padding: 0.32rem 0.9rem;
  font-size: 0.8rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-location--all {
  background: transparent;
  color: #c9d1d9;
  border-color: #30363d;
}

.btn-location--all:hover {
  border-color: #8b949e;
  color: #e6edf3;
}

.btn-location--all-active {
  background: #e6edf3;
  color: #0d1117;
  border-color: #e6edf3;
  font-weight: 700;
}

.location-active-badge {
  margin-left: auto;
  border-radius: 20px;
  padding: 0.32rem 0.9rem;
  font-size: 0.78rem;
  font-weight: 700;
}

/* ---- Tabela ---- */
.table-card {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  overflow: hidden;
}

.table-card-header {
  background: #1c2128;
  border-bottom: 1px solid #21262d;
  padding: 0.9rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.table-card-title {
  color: #e6edf3;
  font-size: 1rem;
  font-weight: 600;
  margin: 0;
}

.active-filters-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.filter-tag {
  border-radius: 20px;
  padding: 0.25rem 0.75rem;
  font-size: 0.76rem;
  font-weight: 600;
}

.filter-tag--gray {
  background: #30363d;
  color: #8b949e;
}

.filter-tag--yellow {
  background: #e3b341;
  color: #0d1117;
}

.orders-table {
  width: 100%;
  border-collapse: collapse;
}

.orders-table thead tr {
  background: #1c2128;
}

.orders-table thead th {
  color: #8b949e;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.75rem 1.25rem;
  border-bottom: 1px solid #21262d;
  white-space: nowrap;
}

.orders-table tbody tr {
  border-bottom: 1px solid #21262d;
  transition: background 0.15s;
}

.orders-table tbody tr:hover {
  background: #1c2128;
}

.orders-table tbody td {
  padding: 0.75rem 1.25rem;
  vertical-align: middle;
}

.order-id {
  color: #58a6ff;
  font-weight: 700;
  font-size: 0.9rem;
}

.text-main {
  color: #e6edf3;
  font-size: 0.88rem;
}

.text-muted-custom {
  color: #8b949e;
  font-size: 0.85rem;
}

.location-badge {
  border-radius: 20px;
  padding: 0.28rem 0.75rem;
  font-size: 0.76rem;
  font-weight: 700;
  white-space: nowrap;
}

.location-badge--empty {
  background: #30363d;
  color: #8b949e;
}

/* ---- Empty state ---- */
.empty-state {
  text-align: center;
  padding: 3.5rem 1rem;
  color: #484f58;
}

.empty-state h5 {
  color: #8b949e;
  margin-bottom: 0.5rem;
}

.empty-state p {
  color: #484f58;
  font-size: 0.88rem;
  margin-bottom: 1rem;
}

/* ---- Paginação ---- */
.pagination-footer {
  background: #1c2128;
  border-top: 1px solid #21262d;
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.pagination-info {
  color: #8b949e;
  font-size: 0.82rem;
}

.pagination-info strong {
  color: #e6edf3;
}

.pagination-controls {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.page-btn {
  background: transparent;
  border: 1px solid #30363d;
  color: #c9d1d9 !important;
  border-radius: 8px;
  padding: 0.35rem 0.75rem;
  font-size: 0.82rem;
  text-decoration: none;
  transition: all 0.2s;
  cursor: pointer;
}

.page-btn:hover {
  border-color: #58a6ff;
  color: #58a6ff !important;
}

