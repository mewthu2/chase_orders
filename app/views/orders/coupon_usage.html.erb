<% content_for :title, "Uso de Cupons" %>
<% brl = ->(v) { number_to_currency(v || 0, unit: 'R$ ', separator: ',', delimiter: '.') } %>
<% counts = @all_coupon_counts %>
<% total_uses = counts.values.sum %>
<% ranked = counts.sort_by { |code, n| [-n, code] } %>
<% rows = ranked.each_with_index.map do |(code, uses), i|
     { id: code, pos: i + 1, code: code, usos: uses, rec: @coupon_revenue[code].to_f, desc: @coupon_discount[code].to_f,
       share: total_uses.positive? ? (uses * 100.0 / total_uses).round(1) : 0, parte: total_uses.positive? ? "#{(uses * 100.0 / total_uses).round(1).to_s.tr('.', ',')}% dos usos" : '—',
       dt: @coupon_last_use[code] }
   end %>
<% by_revenue = rows.sort_by { |r| -r[:rec] } %>
<% table = HoneyTable.new(params, rows: rows, unit: 'cupons', unit1: 'cupom', page_size: 8, sort: { k: :pos, dir: 1 },
     cols: [
       { k: :pos, label: '#', t: :num, plain: true, sort: true },
       { k: :code, label: 'Código do cupom', t: :mono, main: true, copy: true, sort: true, nodetail: true },
       { k: :usos, label: 'Usos', t: :qty, sort: true },
       { k: :rec, label: 'Receita líquida', t: :money, sort: true },
       { k: :desc, label: 'Desconto dado', t: :money, sort: true },
       { k: :share, label: 'Share', t: :progress, sort: true, nodetail: true },
       { k: :parte, label: 'Participação', hide: true },
       { k: :dt, label: 'Último uso', t: :dt, sort: true }
     ],
     filters: [{ id: :q, type: :search, label: 'Buscar cupom', ph: 'Ex.: BEMVINDA', cols: %i[code], tip: 'Procura pelo código do cupom.' }],
     kpis: [
       { label: 'Cupons no ranking', icon: 'fas fa-ticket', tone: 'purple', help: 'Códigos diferentes usados no período.', count: rows.size },
       { label: 'Pedidos com cupom', icon: 'fas fa-receipt', tone: 'blue', help: "De #{number_with_delimiter(@total_orders_global, delimiter: '.')} pedidos, contando todos os códigos.", count: @total_with_coupon },
       { label: 'Taxa de uso', icon: 'fas fa-percent', tone: 'green', help: 'Parte dos pedidos que usou algum cupom.', text: "#{@total_orders_global.to_i.positive? ? (@total_with_coupon * 100.0 / @total_orders_global).round : 0}%" },
       { label: 'Maior receita', icon: 'fas fa-sack-dollar', tone: 'orange', help: (by_revenue.first ? "#{by_revenue.first[:code]}, em #{by_revenue.first[:usos]} #{by_revenue.first[:usos] == 1 ? 'uso' : 'usos'}." : 'Nenhum cupom no período.'), text: brl.call(by_revenue.first&.dig(:rec)) }
     ]) %>

<%= hc_page_header 'Uso de Cupons', 'Veja quais cupons mais venderam no período.', icon: 'fas fa-ticket-alt' do %>
  <% if screen_can?(:orders, :export) %>
    <%= link_to coupon_usage_orders_path(request.query_parameters.merge(format: :xlsx)), class: 'btn btn-export', data: { turbo: false } do %><i class="fas fa-file-excel"></i>Exportar XLSX<% end %>
  <% end %>
<% end %>

<div class="callout pg-banner is-info"><i class="fas fa-circle-info"></i><div><strong>Como este ranking é montado.</strong> Entram só os cupons cujo código termina em 10, como BEMVINDA10. Frete grátis e os outros códigos ficam de fora do ranking, mas contam em "Pedidos com cupom".</div></div>

<div class="pg-blocks">
  <%= hc_pg_kpis(table) %>
  <% if rows.any? %>
    <div class="pg-split" style="--cols: 1fr 1fr">
      <div class="pg-split-a">
        <%= hc_pg_bars(title: 'Cupons mais usados', icon: 'fas fa-ranking-star', sub: 'Número de pedidos que usaram cada código.',
                       items: rows.first(6).map { |r| { label: r[:code], sub: "#{brl.call(r[:rec])} em vendas", value: r[:usos], tone: 'purple' } }) %>
      </div>
      <div class="pg-split-b">
        <%= hc_pg_bars(title: 'Cupons com maior receita', icon: 'fas fa-sack-dollar', sub: 'Soma do total dos pedidos que usaram o cupom.', fmt: :money,
                       items: by_revenue.first(6).map { |r| { label: r[:code], sub: "#{r[:usos]} #{r[:usos] == 1 ? 'uso' : 'usos'}", value: r[:rec], tone: 'green' } }) %>
      </div>
    </div>
  <% end %>
  <%= hc_pg_table(table, title: 'Ranking de cupons', icon: 'fas fa-ticket',
        meta: 'Do mais usado para o menos usado. Clique no cabeçalho para ordenar por receita ou por ordem alfabética. Abra um cupom para ver os números.',
        empty: { title: 'Nenhum cupom encontrado', text: 'Nenhum código que termine em 10 foi usado no período, ou a busca não achou nada.' },
        detail: { title: ->(r) { "Cupom #{r[:code]}" }, tip: 'Ver cupom', note: 'Entra neste ranking porque o código termina em 10 e não começa com FRETE.',
                  fields: [['Posição no ranking', :pos], ['Pedidos com este cupom', :usos]] }) %>
</div>
