<!DOCTYPE html>
<html lang="pt-BR"<% if current_user.present? && current_user.font_scale != 100 %> style="zoom: <%= current_user.font_scale %>%;"<% end %>>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} - Honey.Chase - Painel Administrativo" : 'Honey.Chase - Painel Administrativo' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="turbolinks-visit-control" content="reload">
    <%# Turbo Drive fica desligado (ver app/javascript/hotwire/boot.js); sem pré-carregar links ao passar o mouse. %>
    <meta name="turbo-prefetch" content="false">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%233aa3ea'/><stop offset='1' stop-color='%23075a99'/></linearGradient></defs><rect width='64' height='64' rx='16' fill='url(%23g)'/><text x='32' y='44' font-family='Arial' font-weight='800' font-size='34' text-anchor='middle' fill='white'>H</text></svg>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&family=JetBrains+Mono:wght@500;600&display=swap">
    <%= stylesheet_link_tag 'admin', media: 'all', 'data-turbo-track': 'reload'  %>
    <%= stylesheet_link_tag 'honey', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag "application", 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags 'hotwire' %>

     <!--  load popper.js  -->
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.10.2/dist/umd/popper.min.js"
      integrity="sha384-7+zCNj/IqJ95wo16oMtfsKbZ9ccEh31eOz1HGyDuCQ6wgnyJNSYdrPa03rtR1zdB"
      crossorigin="anonymous"
    ></script>

      <!--  load Bootstrap JS  -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js"
      integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13"
      crossorigin="anonymous"
    ></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <%= yield :styles %>
  </head>

  <%# Barra lateral recolhida e modo guiado ficam num cookie para a página já abrir do jeito escolhido. %>
  <body class="<%= "#{controller_name} #{action_name}" %> honey"
        data-sidebar="<%= cookies[:honey_sidebar] == 'collapsed' ? 'collapsed' : 'expanded' %>"
        data-guided="<%= cookies[:honey_guided] == 'off' ? 'off' : 'on' %>">
    <% if current_user.present? %>
      <div class="app app-enter" id="appView">
        <%= render 'layouts/partials/sidebar' %>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="main">
          <%= render 'layouts/partials/impersonation_banner' if impersonating? %>
          <%= render 'layouts/partials/header' %>
          <%= render 'layouts/partials/content' %>
          <%= render 'layouts/partials/footer' %>
        </div>
      </div>

      <%= render 'layouts/partials/layers' %>
    <% else %>
      <%= yield %>
    <% end %>

    <%= render 'layouts/partials/messages' %>

    <% if current_user.present? %>
      <%= javascript_include_tag 'honey_shell', defer: true %>
    <% end %>
    <%= yield :scripts %>
  </body>
</html>
