<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title><%= message.subject %></title>
    <%# Animações rodam no Apple Mail / iOS Mail; Gmail e Outlook ignoram e mostram a versão estática. %>
    <style>
      @keyframes shimmer { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
      @keyframes pop { 0%, 100% { transform: scale(1) rotate(0deg); } 30% { transform: scale(1.15) rotate(-8deg); } 60% { transform: scale(1) rotate(5deg); } }
      @keyframes beat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.3); } 30% { transform: scale(1); } 45% { transform: scale(1.2); } }
      @keyframes nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(4px); } }
      @media screen {
        .shimmer { background-size: 300% 300% !important; animation: shimmer 8s ease infinite; }
        .hero-emoji { display: inline-block; animation: pop 3s ease-in-out infinite; }
        .heart { display: inline-block; animation: beat 1.4s ease-in-out infinite; }
        .cta-arrow { display: inline-block; animation: nudge 1.2s ease-in-out infinite; }
        .cta:hover { opacity: .9; }
      }
      @media (prefers-reduced-motion: reduce) {
        .shimmer, .hero-emoji, .heart, .cta-arrow { animation: none !important; }
      }
      @media (max-width: 480px) {
        .px { padding-left: 18px !important; padding-right: 18px !important; }
        .hero-title { font-size: 20px !important; }
      }
    </style>
  </head>
  <% color = content_for?(:banner_color) ? yield(:banner_color) : '#1f6feb' %>
  <body style="margin:0;padding:0;background:#eef1f6;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2937;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;"><%= yield :preheader %></div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#eef1f6;">
      <tr>
        <td align="center" style="padding:28px 12px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 30px rgba(15,23,42,.08);">

            <tr>
              <td class="shimmer px" bgcolor="#0d1117" style="padding:22px 28px;background-color:#0d1117;background-image:linear-gradient(120deg,#0d1117 0%,#1f3a8a 45%,#8957e5 75%,#0d1117 100%);">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td><%= image_tag attachments['chase-logo.png'].url, alt: 'Chase', height: 44, style: 'display:block;height:44px;border:0;' %></td>
                    <td align="right">
                      <span style="display:inline-block;padding:5px 12px;border-radius:999px;background:rgba(255,255,255,.12);color:#e6edf3;font-size:12px;font-weight:600;letter-spacing:.4px;">🔐 Sua conta</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding:30px 28px 8px;border-top:5px solid <%= color %>;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="72" valign="middle">
                      <div style="width:60px;height:60px;line-height:60px;text-align:center;border-radius:18px;font-size:32px;background:<%= color %>1f;">
                        <span class="hero-emoji"><%= yield :hero_emoji %></span>
                      </div>
                    </td>
                    <td valign="middle">
                      <div class="hero-title" style="font-size:23px;font-weight:800;color:#111827;line-height:1.25;"><%= yield :hero_title %></div>
                      <div style="margin-top:4px;font-size:13px;color:#6b7280;"><%= @resource.email %></div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding:18px 28px 28px;font-size:15px;line-height:1.6;">
                <%= yield %>
              </td>
            </tr>

            <tr>
              <td class="shimmer" height="5" bgcolor="#1f6feb" style="height:5px;line-height:5px;font-size:0;background-color:#1f6feb;background-image:linear-gradient(90deg,#e3b341,#f85149,#8957e5,#1f6feb,#3fb950,#e3b341);">&nbsp;</td>
            </tr>
            <tr>
              <td class="px" bgcolor="#0d1117" style="padding:24px 28px;background-color:#0d1117;">
                <div style="padding:14px 16px;border-radius:12px;background:#161b22;border:1px solid #30363d;font-size:13px;line-height:1.55;color:#c9d1d9;">
                  <strong style="color:#e3b341;">🛡️ Segurança:</strong> a Chase nunca pede sua senha por e-mail, WhatsApp ou telefone.
                </div>
                <div style="margin:20px 0 0;text-align:center;font-size:14px;color:#e6edf3;font-weight:600;">Feito com <span class="heart">💛</span> pelo time Chase</div>
                <div style="margin:10px 0 0;text-align:center;font-size:11px;line-height:1.6;color:#6e7681;">
                  E-mail automático do ChaseOrders sobre a conta <strong style="color:#8b949e;"><%= @resource.email %></strong>.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
