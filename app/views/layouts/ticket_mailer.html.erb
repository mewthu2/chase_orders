<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title><%= message.subject %></title>
    <%# Animações rodam no Apple Mail / iOS Mail; Gmail e Outlook ignoram e mostram a versão estática. %>
    <style>
      @keyframes shimmer { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
      @keyframes pop { 0%, 100% { transform: scale(1) rotate(0deg); } 30% { transform: scale(1.15) rotate(-6deg); } 60% { transform: scale(1) rotate(4deg); } }
      @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(31,111,235,.45); } 70% { box-shadow: 0 0 0 12px rgba(31,111,235,0); } 100% { box-shadow: 0 0 0 0 rgba(31,111,235,0); } }
      @keyframes beat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.3); } 30% { transform: scale(1); } 45% { transform: scale(1.2); } }
      @keyframes wave { 0%, 60%, 100% { transform: rotate(0deg); } 10%, 30% { transform: rotate(14deg); } 20% { transform: rotate(-8deg); } 40% { transform: rotate(-4deg); } 50% { transform: rotate(10deg); } }
      @keyframes nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(4px); } }
      @media screen {
        .shimmer { background-size: 300% 300% !important; animation: shimmer 8s ease infinite; }
        .hero-emoji { display: inline-block; animation: pop 3s ease-in-out infinite; }
        .progress-step--current .dot { animation: pulse 2s ease-out infinite; }
        .heart { display: inline-block; animation: beat 1.4s ease-in-out infinite; }
        .wave { display: inline-block; transform-origin: 70% 70%; animation: wave 2.8s ease-in-out infinite; }
        .cta-arrow { display: inline-block; animation: nudge 1.2s ease-in-out infinite; }
        .chip:hover, .quick-link:hover { opacity: .85; }
      }
      @media (prefers-reduced-motion: reduce) {
        .shimmer, .hero-emoji, .progress-step--current .dot, .heart, .wave, .cta-arrow { animation: none !important; }
      }
      @media (max-width: 480px) {
        .px { padding-left: 18px !important; padding-right: 18px !important; }
        .hero-title { font-size: 20px !important; }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background:#eef1f6;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2937;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;"><%= yield :preheader %></div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#eef1f6;">
      <tr>
        <td align="center" style="padding:28px 12px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 30px rgba(15,23,42,.08);">

            <%# ── Cabeçalho com gradiente animado ───────────────────────── %>
            <tr>
              <td class="shimmer px" bgcolor="#0d1117" style="padding:22px 28px;background-color:#0d1117;background-image:linear-gradient(120deg,#0d1117 0%,#1f3a8a 45%,#8957e5 75%,#0d1117 100%);">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td><%= image_tag attachments['chase-logo.png'].url, alt: 'Chase', height: 44, style: 'display:block;height:44px;border:0;' %></td>
                    <td align="right">
                      <span style="display:inline-block;padding:5px 12px;border-radius:999px;background:rgba(255,255,255,.12);color:#e6edf3;font-size:12px;font-weight:600;letter-spacing:.4px;">🎟️ Central de Chamados</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <%# ── Destaque do evento ────────────────────────────────────── %>
            <tr>
              <td class="px" style="padding:30px 28px 8px;border-top:5px solid <%= @banner_color %>;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="72" valign="middle">
                      <div style="width:60px;height:60px;line-height:60px;text-align:center;border-radius:18px;font-size:32px;background:<%= @banner_color %>1f;">
                        <span class="hero-emoji"><%= @hero_emoji %></span>
                      </div>
                    </td>
                    <td valign="middle">
                      <div class="hero-title" style="font-size:23px;font-weight:800;color:#111827;line-height:1.25;"><%= @hero_title %></div>
                      <div style="margin-top:4px;font-size:13px;color:#6b7280;">
                        Chamado <strong style="color:<%= @banner_color %>;">#<%= @ticket.id %></strong> · <%= @ticket.ticket_responsability.name %>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding:22px 28px 6px;">
                <%= render 'ticket_mailer/progress', ticket: @ticket %>
              </td>
            </tr>

            <tr>
              <td class="px" style="padding:0 28px 28px;font-size:15px;line-height:1.6;">
                <%= yield %>
              </td>
            </tr>

            <%# ── Rodapé ────────────────────────────────────────────────── %>
            <tr>
              <td class="shimmer" height="5" bgcolor="#1f6feb" style="height:5px;line-height:5px;font-size:0;background-color:#1f6feb;background-image:linear-gradient(90deg,#e3b341,#f85149,#8957e5,#1f6feb,#3fb950,#e3b341);">&nbsp;</td>
            </tr>
            <tr>
              <td class="px" bgcolor="#0d1117" style="padding:26px 28px 26px;background-color:#0d1117;">
                <div style="font-size:11px;font-weight:700;color:#8b949e;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;">Quem está neste chamado</div>
                <div>
                  <% role_icons = { 'requester' => ['🙋', '#58a6ff'], 'responsible' => ['🛠️', '#3fb950'], 'follower' => ['👀', '#e3b341'] } %>
                  <% @ticket.participants.sort_by { |p| TicketParticipant.roles[p.role] }.each do |participant| %>
                    <% icon, color = role_icons.fetch(participant.role) %>
                    <span class="chip" style="display:inline-block;margin:0 6px 8px 0;padding:6px 12px;border-radius:999px;background:#161b22;border:1px solid <%= color %>55;color:#e6edf3;font-size:13px;white-space:nowrap;">
                      <%= icon %> <%= participant.user.name %><% if participant.user_id == @recipient.id %> <span style="color:<%= color %>;font-weight:700;">(você)</span><% end %>
                    </span>
                  <% end %>
                </div>

                <div style="margin:14px 0 0;padding:14px 16px;border-radius:12px;background:#161b22;border:1px solid #30363d;font-size:13px;line-height:1.55;color:#c9d1d9;">
                  <strong style="color:#e3b341;">💡 Dica:</strong> <%= @tip %>
                </div>

                <div style="margin:22px 0 0;text-align:center;">
                  <% [['🎫 Ver chamado', ticket_url(@ticket)], ['📋 Meus chamados', root_url], ['➕ Abrir novo chamado', new_ticket_url]].each_with_index do |(label, url), index| %>
                    <% if index.positive? %><span style="color:#30363d;padding:0 6px;">•</span><% end %>
                    <a class="quick-link" href="<%= url %>" style="color:#58a6ff;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap;"><%= label %></a>
                  <% end %>
                </div>

                <div style="margin:22px 0 0;text-align:center;font-size:14px;color:#e6edf3;font-weight:600;">Feito com <span class="heart">💛</span> pelo time Chase</div>
                <div style="margin:10px 0 0;text-align:center;font-size:11px;line-height:1.6;color:#6e7681;">
                  Você recebeu este e-mail porque é <strong style="color:#8b949e;"><%= @role_label %></strong> no chamado #<%= @ticket.id %>.<br>
                  Quer pausar esses avisos? Peça a um administrador do ChaseOrders.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
