<nav class="top-navigation">
  <div class="nav-carousel-container">
    <div class="nav-brand">
      <%= image_tag "admin/chase-logo.png", alt: "ChaseOrders", class: "nav-logo" %>
    </div>

    <div class="nav-carousel" id="navCarousel">
      <div class="nav-items">

        <div class="nav-item">
          <%= link_to root_path, class: "nav-link #{'active' if current_page?(root_path)}", title: "Home" do %>
            <i class="fas fa-home"></i>
            <span class="nav-text">Home</span>
          <% end %>
        </div>

        <div class="nav-item nav-group-collapsible">
          <div class="nav-group-header-collapsible" onclick="toggleUsuarios()">
            <div class="nav-group-title">
              <i class="fas fa-users"></i>
              <span class="nav-text">Usuários</span>
            </div>
            <i class="fas fa-chevron-right collapse-icon" id="usuariosIcon"></i>
          </div>
          <div class="nav-group-dropdown" id="usuariosDropdown">
            <div class="dropdown-content">
              <%= link_to edit_user_path(current_user), class: "dropdown-link #{'active' if current_page?(edit_user_path(current_user))}" do %>
                <i class="fas fa-user-edit"></i>
                <span>Meu Perfil</span>
              <% end %>
              <% if current_user&.admin? %>
                <%= link_to users_path, class: "dropdown-link #{'active' if controller_name == 'users'}" do %>
                  <i class="fas fa-users-cog"></i>
                  <span>Gerenciar Usuários</span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <% if current_user&.admin? || current_user&.profiles&.any?(&:marketing_profile?) %>
          <div class="nav-item nav-group-collapsible">
            <div class="nav-group-header-collapsible" onclick="toggleCRM()">
              <div class="nav-group-title">
                <i class="fas fa-user-tie"></i>
                <span class="nav-text">CRM</span>
              </div>
              <i class="fas fa-chevron-right collapse-icon" id="crmIcon"></i>
            </div>
            <div class="nav-group-dropdown" id="crmDropdown">
              <div class="dropdown-content">
                <%= link_to orders_path, class: "dropdown-link #{'active' if controller_name == 'orders' && action_name == 'index'}" do %>
                  <i class="fas fa-shopping-cart"></i>
                  <span>Pedidos</span>
                <% end %>
                <%= link_to customers_path, class: "dropdown-link #{'active' if controller_name == 'customers'}" do %>
                  <i class="fas fa-users"></i>
                  <span>Clientes</span>
                <% end %>
                <%= link_to coupon_usage_orders_path, class: "dropdown-link #{'active' if current_page?(coupon_usage_orders_path)}" do %>
                  <i class="fas fa-ticket-alt"></i>
                  <span>Uso de Cupons</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% if current_user&.admin? %>
          <div class="nav-item nav-group-collapsible">
            <div class="nav-group-header-collapsible" onclick="toggleCorreios()">
              <div class="nav-group-title">
                <i class="fas fa-mail-bulk"></i>
                <span class="nav-text">Correios</span>
              </div>
              <i class="fas fa-chevron-right collapse-icon" id="correiosIcon"></i>
            </div>
            <div class="nav-group-dropdown" id="correiosDropdown">
              <div class="dropdown-content">
                <%= link_to order_correios_tracking_dashboard_index_path, class: "dropdown-link #{'active' if current_page?(order_correios_tracking_dashboard_index_path)}" do %>
                  <i class="fas fa-route"></i>
                  <span>Acompanhamento</span>
                <% end %>

                <%= link_to order_correios_create_dashboard_index_path, class: "dropdown-link #{'active' if current_page?(order_correios_create_dashboard_index_path)}" do %>
                  <i class="fas fa-plus-circle"></i>
                  <span>Criação de Pedidos</span>
                <% end %>

                <%= link_to order_correios_stock_errors_dashboard_index_path, class: "dropdown-link #{'active' if current_page?(order_correios_stock_errors_dashboard_index_path)}" do %>
                  <i class="fas fa-box-open"></i>
                  <span>Produtos Sem Estoque</span>
                <% end %>

                <%= link_to invoice_emition_dashboard_index_path, class: "dropdown-link #{'active' if current_page?(invoice_emition_dashboard_index_path)}" do %>
                  <i class="fas fa-file-invoice"></i>
                  <span>Emissão de Notas</span>
                <% end %>

                <%= link_to send_xml_dashboard_index_path, class: "dropdown-link #{'active' if current_page?(send_xml_dashboard_index_path)}" do %>
                  <i class="fas fa-file-code"></i>
                  <span>Enviar XML</span>
                <% end %>

                <%= link_to push_tracking_dashboard_index_path, class: "dropdown-link #{'active' if current_page?(push_tracking_dashboard_index_path)}" do %>
                  <i class="fas fa-shipping-fast"></i>
                  <span>Rastreamento</span>
                <% end %>

                <%= link_to api_correios_dashboard_index_path, class: "dropdown-link #{'active' if current_page?(api_correios_dashboard_index_path)}" do %>
                  <i class="fas fa-cogs"></i>
                  <span>API Correios</span>
                <% end %>

                <%= link_to stock_syncs_path, class: "dropdown-link #{'active' if controller_name == 'stock_syncs'}" do %>
                  <i class="fas fa-sync-alt"></i>
                  <span>Sincronização Estoque</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% if current_user&.admin? %>
          <div class="nav-item nav-group-collapsible">
            <div class="nav-group-header-collapsible" onclick="togglePlannerOrders()">
              <div class="nav-group-title">
                <i class="fas fa-clipboard-list"></i>
                <span class="nav-text">Planejador</span>
              </div>
              <i class="fas fa-chevron-right collapse-icon" id="plannerOrdersIcon"></i>
            </div>
            <div class="nav-group-dropdown" id="plannerOrdersDropdown">
              <div class="dropdown-content">
                <%= link_to planner_orders_path, class: "dropdown-link #{'active' if controller_name == 'planner_orders' && action_name == 'index'}" do %>
                  <i class="fas fa-list"></i>
                  <span>Pedidos do Planejador</span>
                <% end %>
                <%= link_to new_planner_order_path, class: "dropdown-link #{'active' if controller_name == 'planner_orders' && action_name == 'new'}" do %>
                  <i class="fas fa-plus-circle"></i>
                  <span>Novo Pedido</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% unless current_user&.marketing_user? %>
          <div class="nav-item nav-group-collapsible">
            <div class="nav-group-header-collapsible" onclick="toggleProdutos()">
              <div class="nav-group-title">
                <i class="fas fa-box"></i>
                <span class="nav-text">Produtos</span>
              </div>
              <i class="fas fa-chevron-right collapse-icon" id="produtosIcon"></i>
            </div>
            <div class="nav-group-dropdown" id="produtosDropdown">
              <div class="dropdown-content">
                <%= link_to stock_corrections_path, class: "dropdown-link #{'active' if controller_name == 'stock_corrections'}" do %>
                  <i class="fas fa-warehouse"></i>
                  <span>Controle de Estoque</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="nav-user">
      <div class="user-info">
        <span class="user-name"><%= current_user.name %></span>
        <span class="user-role"><%= current_user.profile_name %></span>
      </div>
      <%= link_to destroy_user_session_path, method: :delete, class: 'logout-btn', data: { confirm: 'Tem certeza que deseja sair?' }, title: 'Sair' do %>
        <i class="fas fa-sign-out-alt"></i>
      <% end %>
    </div>
  </div>
</nav>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const carousel = document.getElementById("navCarousel")
  if (!carousel) return

  const activeItem = carousel.querySelector(".nav-link.active, .dropdown-link.active")
  if (activeItem) {
    setTimeout(() => {
      activeItem.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" })
    }, 100)
  }

  carousel.addEventListener("wheel", (e) => {
    if (e.deltaY !== 0) {
      e.preventDefault()
      carousel.scrollLeft += e.deltaY
    }
  })

  let isDown = false
  let startX
  let scrollLeft

  carousel.addEventListener("mousedown", (e) => {
    isDown = true
    startX = e.pageX - carousel.offsetLeft
    scrollLeft = carousel.scrollLeft
    carousel.style.cursor = "grabbing"
  })

  carousel.addEventListener("mouseleave", () => {
    isDown = false
    carousel.style.cursor = "grab"
  })

  carousel.addEventListener("mouseup", () => {
    isDown = false
    carousel.style.cursor = "grab"
  })

  carousel.addEventListener("mousemove", (e) => {
    if (!isDown) return

    e.preventDefault()

    const x = e.pageX - carousel.offsetLeft

    carousel.scrollLeft = scrollLeft - (x - startX) * 2
  })

  document.addEventListener("click", (e) => {
    const dropdowns = [
      { id: "crmDropdown",           header: '[onclick="toggleCRM()"]'           },
      { id: "correiosDropdown",      header: '[onclick="toggleCorreios()"]'       },
      { id: "usuariosDropdown",      header: '[onclick="toggleUsuarios()"]'       },
      { id: "plannerOrdersDropdown", header: '[onclick="togglePlannerOrders()"]'  },
      { id: "produtosDropdown",      header: '[onclick="toggleProdutos()"]'       },
      { id: "marketingDropdown",     header: '[onclick="toggleMarketing()"]'      },
      { id: "pdvDropdown",           header: '[onclick="togglePDV()"]'            },
    ]

    dropdowns.forEach(({ id, header }) => {
      const dropdown = document.getElementById(id)
      const headerEl = document.querySelector(header)

      if (dropdown && headerEl && !headerEl.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.remove("show")

        const icon = dropdown.previousElementSibling?.querySelector(".collapse-icon")

        if (icon) icon.classList.remove("rotated")
      }
    })
  })
})

function toggleDropdown(dropdownId, iconId, buttonSelector) {
  const dropdown = document.getElementById(dropdownId)
  const icon = document.getElementById(iconId)
  const button = document.querySelector(buttonSelector)

  document.querySelectorAll(".nav-group-dropdown.show").forEach((d) => {
    if (d !== dropdown) d.classList.remove("show")
  })

  document.querySelectorAll(".collapse-icon.rotated").forEach((i) => {
    if (i !== icon) i.classList.remove("rotated")
  })

  if (button && dropdown) {
    const rect = button.getBoundingClientRect()
    dropdown.style.left = rect.left + "px"
  }

  dropdown.classList.toggle("show")
  icon.classList.toggle("rotated")
}

function toggleCRM() {
  toggleDropdown("crmDropdown", "crmIcon", '[onclick="toggleCRM()"]')
}

function toggleCorreios() {
  toggleDropdown("correiosDropdown", "correiosIcon", '[onclick="toggleCorreios()"]')
}

function toggleUsuarios() {
  toggleDropdown("usuariosDropdown", "usuariosIcon", '[onclick="toggleUsuarios()"]')
}

function togglePlannerOrders() {
  toggleDropdown("plannerOrdersDropdown", "plannerOrdersIcon", '[onclick="togglePlannerOrders()"]')
}

function toggleProdutos() {
  toggleDropdown("produtosDropdown", "produtosIcon", '[onclick="toggleProdutos()"]')
}

function toggleMarketing() {
  toggleDropdown("marketingDropdown", "marketingIcon", '[onclick="toggleMarketing()"]')
}

function togglePDV() {
  toggleDropdown("pdvDropdown", "pdvIcon", '[onclick="togglePDV()"]')
}
</script>