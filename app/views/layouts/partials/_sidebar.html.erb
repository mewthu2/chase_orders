<script>
document.addEventListener("DOMContentLoaded", () => {
  const carousel = document.getElementById("navCarousel")
  if (!carousel) return

  const activeItem = carousel.querySelector(".nav-link.active, .dropdown-link.active")
  if (activeItem) {
    setTimeout(() => {
      activeItem.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" })
    }, 100)
  }

  carousel.addEventListener("wheel", (e) => {
    if (e.deltaY !== 0) {
      e.preventDefault()
      carousel.scrollLeft += e.deltaY
    }
  })

  let isDown = false
  let startX
  let scrollLeft

  carousel.addEventListener("mousedown", (e) => {
    isDown = true
    startX = e.pageX - carousel.offsetLeft
    scrollLeft = carousel.scrollLeft
    carousel.style.cursor = "grabbing"
  })

  carousel.addEventListener("mouseleave", () => {
    isDown = false
    carousel.style.cursor = "grab"
  })

  carousel.addEventListener("mouseup", () => {
    isDown = false
    carousel.style.cursor = "grab"
  })

  carousel.addEventListener("mousemove", (e) => {
    if (!isDown) return

    e.preventDefault()

    const x = e.pageX - carousel.offsetLeft

    carousel.scrollLeft = scrollLeft - (x - startX) * 2
  })

  document.addEventListener("click", (e) => {
    const dropdowns = [
      { id: "crmDropdown",           header: '[onclick="toggleCRM()"]'           },
      { id: "correiosDropdown",      header: '[onclick="toggleCorreios()"]'       },
      { id: "correiosB2bDropdown",   header: '[onclick="toggleCorreiosB2b()"]'    },
      { id: "usuariosDropdown",      header: '[onclick="toggleUsuarios()"]'       },
      { id: "chamadosDropdown",      header: '[onclick="toggleChamados()"]'       },
      { id: "pedidosB2bDropdown",    header: '[onclick="togglePedidosB2b()"]'     },
      { id: "plannerOrdersDropdown", header: '[onclick="togglePlannerOrders()"]'  },
      { id: "produtosDropdown",      header: '[onclick="toggleProdutos()"]'       },
      { id: "marketingDropdown",     header: '[onclick="toggleMarketing()"]'      },
      { id: "pdvDropdown",           header: '[onclick="togglePDV()"]'            },
    ]

    dropdowns.forEach(({ id, header }) => {
      const dropdown = document.getElementById(id)
      const headerEl = document.querySelector(header)

      if (dropdown && headerEl && !headerEl.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.remove("show")

        const icon = dropdown.previousElementSibling?.querySelector(".collapse-icon")

        if (icon) icon.classList.remove("rotated")
      }
    })
  })
})

function toggleDropdown(dropdownId, iconId, buttonSelector) {
  const dropdown = document.getElementById(dropdownId)
  const icon = document.getElementById(iconId)
  const button = document.querySelector(buttonSelector)

  document.querySelectorAll(".nav-group-dropdown.show").forEach((d) => {
    if (d !== dropdown) d.classList.remove("show")
  })

  document.querySelectorAll(".collapse-icon.rotated").forEach((i) => {
    if (i !== icon) i.classList.remove("rotated")
  })

  if (button && dropdown) positionDropdown(dropdown, button)

  dropdown.classList.toggle("show")
  icon.classList.toggle("rotated")
}

// Alinha o dropdown ao botão, mas sempre dentro da tela: se passar da borda direita, encosta
// nela; se não couber na largura, encolhe (o conteúdo vira uma coluna).
var DROPDOWN_GUTTER = 8

function positionDropdown(dropdown, button) {
  const viewport = document.documentElement.clientWidth
  dropdown.style.maxWidth = viewport - DROPDOWN_GUTTER * 2 + "px"
  dropdown.style.minWidth = Math.min(280, viewport - DROPDOWN_GUTTER * 2) + "px"

  const width = dropdown.offsetWidth
  const left = button.getBoundingClientRect().left
  const maxLeft = viewport - width - DROPDOWN_GUTTER
  dropdown.style.left = Math.max(DROPDOWN_GUTTER, Math.min(left, maxLeft)) + "px"
}

function repositionOpenDropdown() {
  const dropdown = document.querySelector(".nav-group-dropdown.show")
  const button = dropdown?.previousElementSibling
  if (dropdown && button) positionDropdown(dropdown, button)
}

window.addEventListener("resize", repositionOpenDropdown)
document.getElementById("navCarousel")?.addEventListener("scroll", repositionOpenDropdown)

function toggleCRM() {
  toggleDropdown("crmDropdown", "crmIcon", '[onclick="toggleCRM()"]')
}

