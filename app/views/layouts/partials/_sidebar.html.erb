<%# Menu por área do negócio (Navigation). Cada área tem a sua cor em --area; só aparece o que o perfil libera. %>
<aside class="sidebar" id="sidebar" aria-label="Menu principal" data-tour="sidebar">
  <div class="sb-header">
    <%= link_to root_path, class: 'sb-brand', title: 'Ir para o Início' do %>
      <%= image_tag 'admin/honey-chase-logo.webp', alt: 'HONEY.CHASE', width: 440, height: 48 %>
      <span class="sb-mark" aria-hidden="true">H<span>.</span></span>
    <% end %>
    <button class="icon-btn sb-collapse" id="sbCollapse" type="button" data-tip="Recolher menu" aria-label="Recolher menu"><i class="fas fa-angles-left"></i></button>
  </div>

  <button class="sb-search" id="sbSearch" type="button" data-tour="search" data-tip="Buscar tela ou ação (Ctrl + K)">
    <i class="fas fa-search"></i><span>Buscar tela ou ação…</span><kbd>Ctrl K</kbd>
  </button>

  <nav class="sb-nav" id="sbNav">
    <% nav_menu.each do |area| %>
      <%# Ao entrar, todas as áreas vêm recolhidas; só a da tela atual abre. %>
      <% area_open = nav_area_active?(area) %>
      <section class="sb-section<%= area_open ? ' has-active' : ' is-closed' %>" data-area="<%= area[:id] %>" style="<%= nav_area_style(area) %>">
        <button class="sb-section-title" type="button" aria-expanded="<%= area_open %>" data-tip="<%= area[:desc] %>">
          <span class="sb-area-ic"><i class="<%= area[:icon] %>"></i></span>
          <span class="sb-area-txt">
            <span class="sb-area-name"><%= area[:title] %></span>
            <span class="sb-area-desc"><%= area[:desc] %></span>
          </span>
          <i class="fas fa-chevron-down sb-area-chev"></i>
        </button>
        <div class="sb-section-body">
          <div class="sb-section-inner">
            <% area[:items].each do |item| %>
              <% if item[:type] == :group %>
                <% open = nav_group_active?(item) %>
                <div class="sb-group<%= ' is-open has-active' if open %>" data-group="<%= item[:id] %>">
                  <button class="sb-group-btn" type="button" aria-expanded="<%= open %>">
                    <i class="sb-ic <%= item[:icon] %>"></i>
                    <span class="sb-txt">
                      <span class="sb-label"><%= item[:label] %><% if item[:aka] %><i class="sb-aka" data-tip="Nome antigo: <%= item[:aka] %>"><%= item[:aka] %></i><% end %></span>
                      <span class="sb-desc"><%= item[:desc] %></span>
                    </span>
                    <%= nav_badge(item[:badge]) %>
                    <i class="fas fa-chevron-right sb-chev"></i>
                  </button>
                  <div class="sb-children">
                    <div class="sb-children-inner">
                      <div class="sb-children-list">
                        <% steps_open = false %>
                        <% item[:children].each_with_index do |child, index| %>
                          <% if child[:type] == :sub %>
                            <% if steps_open %></div><% steps_open = false %><% end %>
                            <div class="sb-sub"><%= child[:label] %></div>
                            <% if child[:steps] %><div class="sb-steps"><% steps_open = true %><% end %>
                          <% else %>
                            <%= link_to nav_path(child), class: "sb-link#{' is-active' if nav_active?(child)}", style: "--i: #{index}", aria: { current: (nav_active?(child) ? 'page' : nil) } do %>
                              <% if child[:step] %>
                                <span class="sb-step"><%= child[:step] %></span>
                              <% else %>
                                <i class="sb-ic <%= child[:icon] %>"></i>
                              <% end %>
                              <span class="sb-txt">
                                <span class="sb-label"><%= child[:label] %></span>
                                <span class="sb-desc"><%= child[:desc] %></span>
                              </span>
                              <%= nav_badge(child[:badge]) %>
                            <% end %>
                          <% end %>
                        <% end %>
                        <% if steps_open %></div><% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% else %>
                <%= link_to nav_path(item), class: "sb-link#{' is-active' if nav_active?(item)}", aria: { current: (nav_active?(item) ? 'page' : nil) }, data: { tip: item[:label] } do %>
                  <i class="sb-ic <%= item[:icon] %>"></i>
                  <span class="sb-txt">
                    <span class="sb-label"><%= item[:label] %></span>
                    <span class="sb-desc"><%= item[:desc] %></span>
                  </span>
                  <%= nav_badge(item[:badge]) %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </nav>

  <div class="sb-footer">
    <button class="sb-link sb-expand" id="sbExpand" type="button" data-tip="Abrir menu"><i class="sb-ic fas fa-angles-right"></i></button>
    <div class="sb-toggle-row" role="switch" tabindex="0" id="guidedToggle" aria-checked="<%= cookies[:honey_guided] != 'off' %>" data-tour="guided" data-tip="Mostra uma explicação curta embaixo de cada item do menu">
      <i class="sb-ic fas fa-graduation-cap"></i>
      <span class="sb-txt"><span class="sb-label">Modo guiado</span><small>Explica cada item do menu</small></span>
      <span class="switch"></span>
    </div>
    <button class="sb-link" type="button" id="openMap" data-tour="map" data-tip="Veja todas as telas do sistema, por área">
      <i class="sb-ic fas fa-map"></i><span class="sb-txt"><span class="sb-label">Mapa do sistema</span></span>
    </button>
    <%= link_to NavigationHelper::SUPPORT_WHATSAPP, class: 'sb-link', target: '_blank', rel: 'noopener', data: { tip: 'Fale com o suporte (Daniel) pelo WhatsApp' } do %>
      <i class="sb-ic fab fa-whatsapp"></i><span class="sb-txt"><span class="sb-label">Ajuda e suporte</span></span>
    <% end %>
    <div class="sb-version"><span>Honey.Chase · Versão 1.0</span><span>© <%= Date.current.year %></span></div>
  </div>
</aside>
