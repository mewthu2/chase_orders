<script>
document.addEventListener("DOMContentLoaded", () => {
  const carousel = document.getElementById("navCarousel")
  if (!carousel) return

  // Auto scroll to active item
  const activeItem = carousel.querySelector(".nav-link.active, .dropdown-link.active")
  if (activeItem) {
    setTimeout(() => {
      activeItem.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
        inline: "center",
      })
    }, 100)
  }

  // Mouse wheel horizontal scroll
  carousel.addEventListener("wheel", (e) => {
    if (e.deltaY !== 0) {
      e.preventDefault()
      carousel.scrollLeft += e.deltaY
    }
  })

  // Mouse drag scroll
  let isDown = false
  let startX
  let scrollLeft

  carousel.addEventListener("mousedown", (e) => {
    isDown = true
    startX = e.pageX - carousel.offsetLeft
    scrollLeft = carousel.scrollLeft
    carousel.style.cursor = "grabbing"
  })

  carousel.addEventListener("mouseleave", () => {
    isDown = false
    carousel.style.cursor = "grab"
  })

  carousel.addEventListener("mouseup", () => {
    isDown = false
    carousel.style.cursor = "grab"
  })

  carousel.addEventListener("mousemove", (e) => {
    if (!isDown) return
    e.preventDefault()
    const x = e.pageX - carousel.offsetLeft
    const walk = (x - startX) * 2
    carousel.scrollLeft = scrollLeft - walk
  })

  // Close dropdowns when clicking outside
  document.addEventListener("click", (e) => {
    const correiosDropdown = document.getElementById("correiosDropdown")
    const correiosHeader = document.querySelector('[onclick="toggleCorreios()"]')
    const usuariosDropdown = document.getElementById("usuariosDropdown")
    const usuariosHeader = document.querySelector('[onclick="toggleUsuarios()"]')
    const plannerOrdersDropdown = document.getElementById("plannerOrdersDropdown")
    const plannerOrdersHeader = document.querySelector('[onclick="togglePlannerOrders()"]')
    const produtosDropdown = document.getElementById("produtosDropdown")
    const produtosHeader = document.querySelector('[onclick="toggleProdutos()"]')
    const marketingDropdown = document.getElementById("marketingDropdown")
    const marketingHeader = document.querySelector('[onclick="toggleMarketing()"]')

    // Close Correios dropdown
    if (correiosDropdown && correiosHeader && !correiosHeader.contains(e.target) && !correiosDropdown.contains(e.target)) {
      correiosDropdown.classList.remove("show")
      document.getElementById("correiosIcon").classList.remove("rotated")
    }

    // Close Usuarios dropdown
    if (usuariosDropdown && usuariosHeader && !usuariosHeader.contains(e.target) && !usuariosDropdown.contains(e.target)) {
      usuariosDropdown.classList.remove("show")
      document.getElementById("usuariosIcon").classList.remove("rotated")
    }

    // Close PlannerOrders dropdown
    if (plannerOrdersDropdown && plannerOrdersHeader && !plannerOrdersHeader.contains(e.target) && !plannerOrdersDropdown.contains(e.target)) {
      plannerOrdersDropdown.classList.remove("show")
      document.getElementById("plannerOrdersIcon").classList.remove("rotated")
    }

    // Close Produtos dropdown
    if (produtosDropdown && produtosHeader && !produtosHeader.contains(e.target) && !produtosDropdown.contains(e.target)) {
      produtosDropdown.classList.remove("show")
      document.getElementById("produtosIcon").classList.remove("rotated")
    }

    // Close Marketing dropdown
    if (marketingDropdown && marketingHeader && !marketingHeader.contains(e.target) && !marketingDropdown.contains(e.target)) {
      marketingDropdown.classList.remove("show")
      document.getElementById("marketingIcon").classList.remove("rotated")
    }
  })
})

// Toggle Correios dropdown
function toggleCorreios() {
  const dropdown = document.getElementById("correiosDropdown")
  const icon = document.getElementById("correiosIcon")
  const usuariosDropdown = document.getElementById("usuariosDropdown")
  const usuariosIcon = document.getElementById("usuariosIcon")
  const plannerOrdersDropdown = document.getElementById("plannerOrdersDropdown")
  const plannerOrdersIcon = document.getElementById("plannerOrdersIcon")
  const produtosDropdown = document.getElementById("produtosDropdown")
  const produtosIcon = document.getElementById("produtosIcon")
  const marketingDropdown = document.getElementById("marketingDropdown")
  const marketingIcon = document.getElementById("marketingIcon")
  const button = document.querySelector('[onclick="toggleCorreios()"]')

  // Close other dropdowns if open
  if (usuariosDropdown && usuariosDropdown.classList.contains("show")) {
    usuariosDropdown.classList.remove("show")
    usuariosIcon.classList.remove("rotated")
  }
  if (plannerOrdersDropdown && plannerOrdersDropdown.classList.contains("show")) {
    plannerOrdersDropdown.classList.remove("show")
    plannerOrdersIcon.classList.remove("rotated")
  }
  if (produtosDropdown && produtosDropdown.classList.contains("show")) {
    produtosDropdown.classList.remove("show")
    produtosIcon.classList.remove("rotated")
  }
  if (marketingDropdown && marketingDropdown.classList.contains("show")) {
    marketingDropdown.classList.remove("show")
    marketingIcon.classList.remove("rotated")
  }

  // Position dropdown relative to button
  if (button && dropdown) {
    const rect = button.getBoundingClientRect()
    dropdown.style.left = rect.left + 'px'
  }

  dropdown.classList.toggle("show")
  icon.classList.toggle("rotated")
}

