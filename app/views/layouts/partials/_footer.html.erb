<%# Rodapé do painel no visual Honey: marca, atalhos, suporte e a sessão atual. %>
<footer class="hc-footer" aria-label="Rodapé">
  <span class="hc-footer-glow" aria-hidden="true"></span>
  <div class="hc-footer-inner">
    <div class="hc-footer-brand">
      <%= image_tag 'admin/honey-chase-logo.webp', alt: 'HONEY.CHASE', width: 440, height: 48 %>
      <p>Chamados, pedidos, envios e estoque da Chase, organizados por área.</p>
    </div>

    <nav class="hc-footer-col" aria-label="Atalhos">
      <h4>Atalhos</h4>
      <%= link_to root_path do %><i class="fas fa-inbox"></i>Meus chamados<% end %>
      <%= link_to edit_user_path(current_user) do %><i class="fas fa-user-edit"></i>Meu Perfil<% end %>
      <button type="button" data-act="map"><i class="fas fa-map"></i>Mapa do sistema</button>
      <button type="button" data-act="search"><i class="fas fa-search"></i>Buscar tela <kbd>Ctrl K</kbd></button>
    </nav>

    <div class="hc-footer-col">
      <h4>Suporte e ajuda</h4>
      <%= link_to NavigationHelper::SUPPORT_WHATSAPP, class: 'hc-footer-card is-whatsapp', target: '_blank', rel: 'noopener' do %>
        <i class="fab fa-whatsapp"></i><span><b>WhatsApp</b><small>Ajuda e suporte · chame o Daniel</small></span><i class="fas fa-arrow-right go"></i>
      <% end %>
      <%= link_to 'https://chasebrasil.com', class: 'hc-footer-card', target: '_blank', rel: 'noopener' do %>
        <i class="fas fa-globe"></i><span><b>Site oficial</b><small>chasebrasil.com</small></span><i class="fas fa-arrow-right go"></i>
      <% end %>
    </div>

    <div class="hc-footer-col">
      <h4>Sessão atual</h4>
      <div class="hc-footer-session">
        <span class="avatar"><%= user_initials(current_user) %></span>
        <span><b><%= current_user.name %></b><small><%= current_user.profiles.map(&:name).join(', ').presence || 'Usuário' %></small></span>
      </div>
      <button type="button" class="hc-footer-help" data-act="help"><i class="fas fa-circle-question"></i>Ajuda desta tela <kbd>?</kbd></button>
    </div>
  </div>
  <div class="hc-footer-bottom">
    <span>© <%= Date.current.year %> Chase Brasil · Honey.Chase. Todos os direitos reservados.</span>
    <span class="hc-footer-version"><i class="fas fa-code-branch"></i>Versão 1.0</span>
  </div>
</footer>
