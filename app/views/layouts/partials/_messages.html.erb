<%# Avisos (flash) em forma de toast, no canto inferior direito. Erros ficam até a pessoa fechar. %>
<%
  toast_types = {
    'success' => ['success', 'fas fa-check', 'Pronto'],
    'danger'  => ['danger', 'fas fa-exclamation', 'Atenção'],
    'warning' => ['warning', 'fas fa-exclamation-triangle', 'Aviso'],
    'info'    => ['info', 'fas fa-info', 'Informação']
  }
  type_for = lambda do |name|
    case name.to_s
    when 'notice', 'success' then 'success'
    when 'error', 'alert' then 'danger'
    when 'warning' then 'warning'
    else 'info'
    end
  end
%>
<div class="flash-messages-container" id="toasts" aria-live="polite">
  <% if defined?(object) && object && object.errors.any? %>
    <div class="toast toast--danger alert alert-danger is-sticky" role="alert">
      <span class="t-ic"><i class="fas fa-times"></i></span>
      <div class="t-body">
        <b>Erro de validação</b>
        <ul><% object.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
      <button type="button" class="icon-btn close-x" data-toast-close aria-label="Fechar"><i class="fas fa-times"></i></button>
    </div>
  <% end %>

  <% flash.each do |name, msg| %>
    <% type, icon, heading = toast_types[type_for.call(name)] %>
    <% if msg.is_a?(String) %>
      <div class="toast toast--<%= type %> alert alert-<%= type %><%= ' is-sticky' if type == 'danger' %>" role="<%= type == 'danger' ? 'alert' : 'status' %>">
        <span class="t-ic"><i class="<%= icon %>"></i></span>
        <div class="t-body">
          <b><%= heading %></b>
          <span id="flash_<%= name %>"><%= msg.html_safe %></span>
        </div>
        <button type="button" class="icon-btn close-x" data-toast-close aria-label="Fechar"><i class="fas fa-times"></i></button>
        <% unless type == 'danger' %><span class="bar"></span><% end %>
      </div>
    <% elsif msg.is_a?(Array) && msg.any? %>
      <div class="toast toast--danger alert alert-danger is-sticky" role="alert">
        <span class="t-ic"><i class="fas fa-list"></i></span>
        <div class="t-body">
          <b>Vários erros</b>
          <ul><% msg.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
        <button type="button" class="icon-btn close-x" data-toast-close aria-label="Fechar"><i class="fas fa-times"></i></button>
      </div>
    <% end %>
    <% flash.discard(name) %>
  <% end %>
</div>

<script>
(() => {
  const leave = (toast) => {
    if (!toast || toast.classList.contains('is-leaving')) return;
    toast.classList.add('is-leaving');
    setTimeout(() => toast.remove(), 320);
  };
  document.querySelectorAll('#toasts .toast').forEach((toast) => {
    toast.querySelector('[data-toast-close]')?.addEventListener('click', () => leave(toast));
    if (toast.classList.contains('is-sticky')) return;
    // A barra de tempo pausa com o mouse em cima; ao terminar, o aviso sai.
    toast.querySelector('.bar')?.addEventListener('animationend', () => leave(toast));
  });
})();
</script>
