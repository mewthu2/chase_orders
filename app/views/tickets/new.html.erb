<% content_for :title, "Abrir Chamado" %>

<%= hc_page_header 'Abrir Chamado', 'Os responsáveis da área escolhida recebem um e-mail na hora', icon: 'fas fa-ticket-alt' %>
<div>
  <% if @responsabilities.empty? %>
    <div class="table-card">
      <div class="ticket-empty pg-empty">
        <i class="fas fa-lock" style="font-size: 32px; color: var(--text-3)"></i>
        <% only_me = @sector_responsabilities.select { |r| r.users.select(&:active?) == [current_user] } %>
        <% if only_me.any? %>
          <p>
            <%= only_me.map(&:name).to_sentence %> só
            <%= only_me.one? ? 'tem' : 'têm' %> você como responsável, então não há quem atender o chamado.
            <%= current_user.admin? ? 'Adicione outra pessoa' : 'Peça a um administrador para adicionar outra pessoa' %> em Chamados → Responsabilidades.
          </p>
        <% elsif current_user.admin? || current_user.visible_ticket_sector_ids.any? %>
          <p>Nenhuma responsabilidade ativa com responsável cadastrada<%= ' nos seus setores' unless current_user.admin? %>. Cadastre em Chamados → Responsabilidades.</p>
        <% else %>
          <p>Seu perfil não tem nenhum setor liberado para abrir chamados. Peça a um administrador para liberar em Perfis e Permissões.</p>
        <% end %>
      </div>
    </div>
  <% else %>
  <%= form_with model: @ticket, local: true, multipart: true, class: 'panel pg-card pg-inline', id: 'pgForm' do |form| %>
    <h3><i class="fas fa-plus"></i>Abrir Chamado</h3>
    <p class="pg-p" style="margin-bottom: 14px">Os responsáveis da área escolhida recebem um e-mail na hora.</p>
    <%= render 'tickets/form_fields', form: form, prefix: 'pageTicket' %>
    <div class="pg-inline-foot">
      <%= link_to 'Cancelar', root_path, class: 'btn btn-ghost' %>
      <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i>Abrir Chamado</button>
    </div>
  <% end %>
  <% end %>
</div>
