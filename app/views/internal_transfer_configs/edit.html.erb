<% content_for :title, "Configurações das Transferências" %>

<%= hc_page_header 'Configurações das Transferências', 'Quem aprova as transferências entre lojas e como sai a nota fiscal de cada remessa', icon: 'fas fa-sliders-h' do %>
  <%= link_to internal_transfers_path, class: 'btn btn-secondary' do %><i class="fas fa-arrow-left"></i>Voltar<% end %>
<% end %>

<div class="pg-blocks">
  <div class="pg-split" style="--cols: 1.3fr 1fr">
    <div class="pg-split-a">
      <%= form_with url: internal_transfer_config_path, method: :patch, local: true, class: 'panel pg-card pg-inline', id: 'pgForm' do %>
        <h3><i class="fas fa-file-invoice"></i>Nota fiscal</h3>
        <p class="pg-p" style="margin-bottom: 14px">A empresa da loja de origem emite a NF-e de transferência para a empresa da loja de destino. Escolha a loja de cada empresa e a natureza da nota.</p>
        <div class="pg-fields">
          <% @companies.each do |company| %>
            <% chosen_location = params.dig(:companies, company.id.to_s, :location_id) || company.location&.id %>
            <% chosen_nature = params.dig(:companies, company.id.to_s, :internal_transfer_nature_id) || company.internal_transfer_nature_id %>
            <% default_nature = OperationNature.default_for(company, :transfer) %>
            <% fitting = @transfer_natures.select { |n| n.compatible_with?(company) } %>
            <div class="pg-fsec">
              <%= company.trade_name.presence || company.legal_name %> · CNPJ <%= company.cnpj_formatted %> · <%= company.city %>/<%= company.state %>
              <%= hc_status(company.environment_label, company.producao? ? 'green' : 'yellow',
                            tip: company.producao? ? 'As notas saem com valor fiscal.' : 'As notas saem em homologação, sem valor fiscal. Troque em Empresas.') %>
              <% unless company.active? %><%= hc_status('Inativa', 'gray', tip: 'Empresa inativa não emite nota.') %><% end %>
            </div>
            <div class="form-group pg-fg pg-w2">
              <label class="field-label" for="company_<%= company.id %>_location_id">Loja desta empresa</label>
              <%= select_tag "companies[#{company.id}][location_id]", options_for_select(@locations.map { |l| [l.name, l.id] }, chosen_location),
                             include_blank: 'Nenhuma loja', id: "company_#{company.id}_location_id", class: 'field-input' %>
            </div>
            <div class="form-group pg-fg pg-w2">
              <label class="field-label" for="company_<%= company.id %>_nature_id">Natureza da transferência</label>
              <%= select_tag "companies[#{company.id}][internal_transfer_nature_id]",
                             options_for_select(fitting.map { |n| ["#{n.description} · CFOP #{n.cfop}", n.id] }, chosen_nature),
                             include_blank: default_nature ? "Padrão da empresa (#{default_nature.description})" : 'Padrão da empresa (nenhuma vinculada)',
                             id: "company_#{company.id}_nature_id", class: 'field-input' %>
            </div>
          <% end %>
          <% if @companies.empty? %>
            <div class="pg-fnote"><i class="fas fa-circle-info"></i><span>Nenhuma empresa cadastrada. Cadastre em <%= link_to 'Empresas', companies_path %>.</span></div>
          <% else %>
            <div class="pg-fnote"><i class="fas fa-circle-info"></i><span>Lojas da mesma empresa não têm nota entre si. Só aparecem as naturezas de transferência que servem para o regime de cada empresa; ao salvar, a natureza fica vinculada a ela. Certificado, ambiente e numeração ficam em <%= link_to 'Empresas', companies_path %>.</span></div>
          <% end %>

          <div class="pg-fsec" style="margin-top: 10px"><i class="fas fa-user-check"></i> Aprovadores: quem pode aprovar</div>
          <div class="form-group pg-fg">
            <div class="select-wrap pg-search"><input type="text" id="approverSearch" class="field-input" placeholder="Filtrar por nome…" autocomplete="off"></div>
          </div>
          <%= hidden_field_tag 'approver_ids[]', '', id: nil %>
          <% @users.each do |user| %>
            <div class="form-group pg-fg pg-w2" data-approver-name="<%= user.name.to_s.downcase %>">
              <label class="form-check">
                <%= check_box_tag 'approver_ids[]', user.id, @approver_ids.include?(user.id), id: "approver_#{user.id}", class: 'form-check-input' %>
                <span><%= user.name %></span>
                <% if user.admin? %><span class="info-dot" tabindex="0" data-tip="Administrador. Aprova sempre, mesmo sem estar marcado.">i</span><% end %>
              </label>
            </div>
          <% end %>
          <div class="pg-fnote"><i class="fas fa-circle-info"></i><span>Qualquer um dos marcados pode aprovar ou reprovar. Se ninguém for marcado, só os administradores aprovam.</span></div>
        </div>
        <div class="pg-inline-foot">
          <%= link_to 'Cancelar', internal_transfers_path, class: 'btn btn-ghost' %>
          <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i>Salvar</button>
        </div>
      <% end %>
    </div>
    <div class="pg-split-b">
      <div class="panel pg-card pg-howto">
        <h3><i class="fas fa-list-ol"></i>Como a aprovação funciona</h3>
        <ol>
          <% ['A loja de destino <b>pede</b> as peças.', 'Um dos aprovadores marcados <b>aprova ou reprova</b>.',
              'Só depois de aprovada, cada loja de origem <b>reserva</b> a sua parte. Isso tira as peças do estoque dela no Shopify.',
              'A loja de origem <b>envia</b> e informa o rastreio.', 'A loja de destino <b>recebe</b> e as peças entram no estoque dela.'].each_with_index do |text, i| %>
            <li style="--i: <%= i %>"><span class="n"><%= i + 1 %></span><span><%= text.html_safe %></span></li>
          <% end %>
        </ol>
      </div>
      <div class="callout pg-banner is-info"><i class="fas fa-circle-info"></i><div><strong>Administradores sempre aprovam.</strong> Mesmo sem estar marcado na lista, quem é administrador pode aprovar ou reprovar qualquer transferência.</div></div>
    </div>
  </div>
</div>

<script>
  document.getElementById('approverSearch').addEventListener('input', function (e) {
    var q = e.target.value.trim().toLowerCase();
    document.querySelectorAll('[data-approver-name]').forEach(function (row) {
      row.style.display = row.dataset.approverName.indexOf(q) === -1 ? 'none' : '';
    });
  });
</script>
