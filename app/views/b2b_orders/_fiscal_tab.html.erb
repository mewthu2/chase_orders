<%# Aba Nota fiscal da edição do pedido B2B: uma vaga de homologação e uma de produção (como a Transferência Interna). %>
<% setting = B2bSetting.current %>
<% company = setting.issuer(@b2b_order) %>
<% nature = setting.nature_for(@b2b_order) %>
<% all_notes = FiscalNote.where(b2b_order_id: @b2b_order.id).to_a %>
<% notes = all_notes.reject(&:remessa?) %>
<% recipient = HoneyB2bLog.destination_name(@b2b_order) %>
<% recipient_doc = @b2b_order.sale? ? @b2b_order.client&.cnpj_formatted : (@b2b_order.stock_transfer? ? @b2b_order.transfer_location&.registration : B2bTinyService::B2C_TRANSFER_RECIPIENT[:cpf_cnpj]) %>
<% units = @b2b_order.b2b_order_items.sum { |i| i.quantity.to_i } %>
<% config_name, config_path, config_perm = if @b2b_order.sale? then ['Configuração do atacado', edit_b2b_setting_path, :b2b_orders]
                                           elsif @b2b_order.stock_transfer? then ['Configurações do Abastecimento', stock_transfer_settings_path, :store_supply]
                                           else ['Configurações da Transferência B2C', b2c_transfer_settings_path, :b2b_transfers]
                                           end %>
<%
  blocker =
    if company.nil? then "Escolha a empresa emissora em #{config_name}."
    elsif nature.nil? then "Escolha a natureza de #{@b2b_order.sale? ? 'venda' : 'transferência'} em #{config_name}."
    elsif !company.ready_to_issue? then "A empresa #{company.selection_label} não está ativa ou está sem certificado digital válido."
    elsif @b2b_order.b2b_order_items.empty? then 'Salve os itens do pedido na aba Pedido para emitir a nota.'
    elsif @b2b_order.cancelado? then 'Este pedido foi cancelado.'
    end
%>
<div class="callout it-fiscal-intro">
  <i class="fas fa-circle-info"></i>
  <div>
    O pedido tem a <strong>própria nota</strong>, emitida no Honey direto na SEFAZ (<%= nature ? "natureza #{nature.description}" : "natureza em #{config_name}" %>; <%= link_to 'trocar', config_path if screen_can?(config_perm, :edit) %>).
    Dá para ter uma nota de <strong>homologação</strong> (teste, sem valor fiscal) e uma de <strong>produção</strong>; excluindo a nota, dá para emitir outra.
    No Log02, a etapa do XML usa a nota de produção autorizada (ou emite uma) e manda o XML ao Correios.
  </div>
</div>

<div class="it-fiscal-list stagger">
  <section class="it-fiscal-card">
    <header class="it-fiscal-card__head">
      <span class="transfer-note__route">
        <span><small>Emitente</small> <strong><%= company ? (company.trade_name.presence || company.legal_name) : '—' %></strong><%= " · #{company.cnpj_formatted}" if company %></span>
        <i class="fas fa-arrow-right"></i>
        <span><small>Destinatário</small> <strong><%= recipient.presence || '—' %></strong><%= " · #{recipient_doc}" if recipient_doc.present? %></span>
      </span>
      <span class="it-fiscal-card__meta"><i class="fas fa-cubes"></i><%= pluralize(units, 'unidade', plural: 'unidades') %> · <%= B2bOrder::LOG_STAGES.dig(@b2b_order.log_stage, 0).to_s.downcase %></span>
    </header>

    <% if blocker && notes.empty? %>
      <div class="callout is-warn mb-0"><i class="fas fa-building-circle-exclamation"></i><div>
        <%= blocker %>
        <% if blocker.include?(config_name) && screen_can?(config_perm, :edit) %><%= link_to "Abrir #{config_name}", config_path %><% end %>
      </div></div>
    <% else %>
      <%= render 'b2b_orders/fiscal_slots', order: @b2b_order, notes: notes, company: company, blocker: blocker %>
    <% end %>
  </section>

  <% if @b2b_order.stock_transfer? %>
    <%# Nota de remessa: uma nota a mais do abastecimento (ex.: 5905 para o depósito do Correios). A de cima continua sendo a do Correios. %>
    <% r_company = setting.remessa_issuer %>
    <% r_nature = setting.remessa_nature %>
    <% r_data = @b2b_order.remessa_recipient_data %>
    <% r_custom = @b2b_order.remessa_recipient.present? %>
    <% r_blocker = if r_company.nil? then 'Escolha a empresa da nota de remessa em Abastecimento Lojas → Configurações.'
                   elsif r_nature.nil? then 'Escolha a natureza da nota de remessa em Abastecimento Lojas → Configurações.'
                   elsif !r_company.ready_to_issue? then "A empresa #{r_company.selection_label} não está ativa ou está sem certificado digital válido."
                   elsif @b2b_order.b2b_order_items.empty? then 'Salve os itens do pedido na aba Pedido para emitir a nota.'
                   elsif @b2b_order.cancelado? then 'Este pedido foi cancelado.'
                   end %>
    <% r_notes = all_notes.select(&:remessa?) %>
    <section class="it-fiscal-card rr-card" id="remessaNote">
      <header class="it-fiscal-card__head">
        <span class="transfer-note__route">
          <span><small>Nota de remessa</small> <strong><%= r_company ? (r_company.trade_name.presence || r_company.legal_name) : '—' %></strong></span>
          <i class="fas fa-arrow-right"></i>
          <span><small>Destinatário</small> <strong><%= r_data['name'].presence || '—' %></strong><%= " · #{r_data['document']}" if r_data['document'].present? %></span>
        </span>
        <span class="it-fiscal-card__meta"><i class="fas fa-warehouse"></i><%= r_nature ? r_nature.description : 'natureza não escolhida' %></span>
      </header>
      <% if r_blocker && r_notes.empty? %>
        <div class="callout is-warn mb-0"><i class="fas fa-building-circle-exclamation"></i><div>
          <%= r_blocker %>
          <% if r_blocker.include?('Configurações') && screen_can?(:store_supply, :edit) %><%= link_to 'Abrir Configurações do Abastecimento', stock_transfer_settings_path %><% end %>
        </div></div>
      <% else %>
        <%= render 'b2b_orders/fiscal_slots', order: @b2b_order, notes: r_notes, company: r_company, blocker: r_blocker, role: 'remessa' %>
      <% end %>

      <% r_editable = screen_can?(:store_supply, :edit) && !@b2b_order.cancelado? %>
      <details class="rr-recipient" <%= 'open' if r_custom %>>
        <summary>
          <i class="fas fa-location-dot"></i><b>Destinatário da remessa</b>
          <span class="text-muted-custom"><%= r_custom ? 'trocado só neste pedido' : 'o padrão das configurações' %> · <%= [r_data['street'], r_data['number']].compact_blank.join(', ') %> · <%= [r_data['city'], r_data['state']].compact_blank.join('/') %></span>
        </summary>
        <%= form_with url: remessa_recipient_b2b_order_fiscal_notes_path(b2b_order_id: @b2b_order.id), method: :patch, local: true, class: 'rr-form' do %>
          <%= render 'b2b_orders/remessa_recipient_fields', scope: 'remessa_recipient', data: r_data, disabled: !r_editable %>
          <% if r_editable %>
            <div class="pg-inline-foot">
              <% if r_custom %>
                <button type="submit" name="reset" value="1" class="btn btn-ghost" formnovalidate><i class="fas fa-rotate-left"></i>Voltar ao padrão</button>
              <% end %>
              <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i>Salvar só para este pedido</button>
            </div>
          <% end %>
        <% end %>
      </details>
    </section>
  <% end %>

  <%# Dados da nota: editáveis até a nota de produção ser autorizada (rejeitada ou excluída libera de novo). %>
  <% lock = @b2b_order.nf_details_lock %>
  <% editable = lock.nil? && screen_can?(B2bOrdersController::KIND_SCREENS.fetch(@b2b_order.kind), :edit) && !@b2b_order.cancelado? %>
  <% default_carrier = @b2b_order.carrier %>
  <section class="it-fiscal-card nf-details">
    <header class="it-fiscal-card__head">
      <span class="transfer-note__route"><span><i class="fas fa-pen-to-square"></i> <strong>Dados da nota</strong></span></span>
      <span class="it-fiscal-card__meta">
        <% if lock %><i class="fas fa-lock"></i>NF-e nº <%= lock.number %> <%= lock.status_label.downcase %>: não muda mais
        <% else %><i class="fas fa-unlock"></i>Valem para a próxima emissão (aqui ou no Log02)<% end %>
      </span>
    </header>
    <%= form_with model: @b2b_order, url: details_b2b_order_fiscal_notes_path(b2b_order_id: @b2b_order.id), method: :patch, local: true, class: 'nf-details__form' do |f| %>
      <fieldset <%= 'disabled' unless editable %>>
        <div class="pg-fields">
          <div class="form-group pg-fg pg-w2">
            <label class="field-label" for="b2b_order_nf_carrier_id">Transportadora</label>
            <%= f.select :nf_carrier_id, Carrier.where(active: true).or(Carrier.where(id: [@b2b_order.nf_carrier_id, default_carrier&.id].compact)).order(:name).map { |c| ["#{c.name} · #{c.registration}", c.id] },
                         { include_blank: default_carrier ? "A do pedido (#{default_carrier.name})" : 'Sem transportadora' }, class: 'field-input' %>
          </div>
          <div class="form-group pg-fg pg-w2">
            <label class="field-label" for="b2b_order_nf_freight_mode">Modalidade do frete</label>
            <%= f.select :nf_freight_mode, B2bOrder::NF_FREIGHT_MODES.map { |k, label| ["#{k} - #{label}", k] },
                         { include_blank: 'Automática (remetente com transportadora ou frete; senão, sem frete)' }, class: 'field-input' %>
          </div>
          <div class="form-group pg-fg" style="grid-column: 1 / -1">
            <label class="field-label" for="b2b_order_nf_additional_info">Informações complementares</label>
            <%= f.text_area :nf_additional_info, rows: 4, maxlength: 4000, class: 'field-input',
                            placeholder: "Em branco, a nota usa o texto da natureza#{" (#{nature.description})" if nature}." %>
          </div>
        </div>
        <% if editable %>
          <div class="pg-inline-foot">
            <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i>Salvar dados da nota</button>
          </div>
        <% end %>
      </fieldset>
    <% end %>
  </section>
</div>
