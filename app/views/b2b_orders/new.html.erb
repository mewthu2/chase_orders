<% copy = b2b_screen_copy(order_kind) %>
<% content_for :title, copy[:new_title] %>
<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon "fas fa-#{copy[:icon]}" %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title"><%= copy[:new_title] %></h1>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
      <%= link_to orders_path_for, class: "btn-back" do %><i class="fas fa-arrow-left me-1"></i>Voltar<% end %>
    </div>
  </div>
  <%= render 'form' %>
</div>
