<%= form_with model: @b2b_order, url: order_form_url(@b2b_order), local: true, id: 'b2bOrderForm' do |form| %>
  <%= hidden_field_tag :catalog_order_id, params[:catalog_order_id] if params[:catalog_order_id].present? %>
  <% if @b2b_order.errors.any? %>
    <div class="form-error-box">
      <i class="fas fa-exclamation-triangle me-2"></i>
      <ul class="mb-0 mt-1"><% @b2b_order.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-section">
    <div class="form-section-header"><h5 class="form-section-title"><i class="fas fa-tag me-2"></i>Dados do Pedido</h5></div>
    <div class="form-section-body">
      <div class="form-grid mb-3">
        <% if @b2b_order.persisted? && @b2b_order.tiny_order? %>
          <div class="form-col-6">
            <label class="field-label">Status</label>
            <%= form.select :status, B2bOrder::STATUS_LABELS.map { |key, label| [label, key] }, { selected: @b2b_order.status }, { class: 'field-input' } %>
            <% if @b2b_order.tiny_reference_id.blank? %>
              <span class="text-muted-custom d-block mt-1"><i class="fas fa-info-circle me-1"></i>O pedido anda no Log02 pela aprovação, criação no Correios, NF-e e rastreio.</span>
            <% end %>
          </div>
        <% end %>
        <div class="form-col-6">
          <label class="field-label">Número</label>
          <%= text_field_tag :number, (@b2b_order.persisted? ? @b2b_order.id : 'Gerado automaticamente'), class: 'field-input', readonly: true, disabled: true %>
        </div>
      </div>

      <div class="form-grid">
        <% if @b2b_order.sale? %>
        <div class="form-col-6" id="clientSection">
          <label class="field-label">Cliente</label>
          <input type="text" id="clientSearchInput" class="field-input" placeholder="Buscar cliente do Honey por nome/CNPJ..." value="<%= @b2b_order.client&.display_name %>">
          <div id="clientSearchResults" class="list-group mt-2"></div>
          <span class="text-muted-custom d-block mt-1"><i class="fas fa-info-circle me-1"></i>Só clientes cadastrados no Honey. <%= link_to 'Cadastrar cliente', new_client_path, target: '_blank' %></span>
          <%= form.hidden_field :client_id, id: 'clientIdField' %>
        </div>

        <div class="form-col-6">
          <label class="field-label">Vendedor</label>
          <%= form.text_field :salesperson_name, class: 'field-input', placeholder: 'Nome do vendedor' %>
        </div>

        <% elsif @b2b_order.stock_transfer? %>
        <div class="form-col-6" id="transferLocationSection">
          <label class="field-label">Local de Destino</label>
          <%= form.collection_select :transfer_location_id, TransferLocation.active.order(:name), :id, :name, { include_blank: 'Selecione...' }, { class: 'field-input' } %>
          <span class="text-muted-custom d-block mt-1"><i class="fas fa-info-circle me-1"></i>Depois de aprovado no Log02, o Honey cria o pedido no Correios e emite a NF-e de transferência.</span>
        </div>
        <% by_carrier = @b2b_order.carrier_id.present? %>
        <div class="form-col-6" id="stockDeliverySection">
          <label class="field-label">Entrega</label>
          <div class="d-flex gap-3 flex-wrap">
            <label class="form-check"><input type="radio" name="stock_delivery" value="hand" class="form-check-input" <%= 'checked' unless by_carrier %>><span><i class="fas fa-hand-holding me-1"></i>SEDEX · Mão Própria</span></label>
            <label class="form-check"><input type="radio" name="stock_delivery" value="carrier" class="form-check-input" <%= 'checked' if by_carrier %>><span><i class="fas fa-truck-moving me-1"></i>Transportadora</span></label>
          </div>
          <span class="text-muted-custom d-block mt-1" id="stockDeliveryHandHint" style="<%= 'display: none;' if by_carrier %>">SEDEX: nos Correios B2B o pedido é criado com o serviço adicional 002 (mão própria).</span>
          <div id="stockCarrierSection" class="mt-2" style="<%= 'display: none;' unless by_carrier %>">
            <%= form.collection_select :carrier_id, Carrier.active.order(:name), :id, :name, { include_blank: 'Selecione a transportadora...' }, { class: 'field-input', id: 'stockCarrierSelect', required: by_carrier, disabled: !by_carrier } %>
            <span class="text-muted-custom d-block mt-1"><i class="fas fa-info-circle me-1"></i>Nos Correios B2B entra como transportadora (74926), com o CNPJ dela na nota. <%= link_to 'Cadastrar transportadora', new_carrier_path, target: '_blank' %></span>
          </div>
          <%# Mão própria: o campo vai vazio (sem transportadora). Desabilitado o select, este é o valor enviado. %>
          <input type="hidden" name="b2b_order[carrier_id]" value="" id="stockCarrierBlank" <%= 'disabled' if by_carrier %>>
        </div>
        <div class="form-col-6">
          <label class="field-label">Responsável pelo Recebimento <span class="text-muted-custom" id="receiverOptionalHint" style="<%= 'display: none;' unless by_carrier %>">(opcional com transportadora)</span></label>
          <%= form.hidden_field :receiver_name, id: 'receiverNameField' %>
          <div id="receiverNamesList">
            <% receiver_names = @b2b_order.receiver_name.to_s.split(',').map(&:strip).reject(&:blank?).presence || [''] %>
            <% receiver_names.each_with_index do |name, i| %>
            <div class="d-flex gap-2 mb-2 receiver-name-row">
              <input type="text" class="field-input receiver-name-input" value="<%= name %>" placeholder="Nome de quem vai receber na loja" maxlength="60" <%= 'required' if i.zero? && @b2b_order.tiny_reference_id.blank? %>>
              <button type="button" class="btn-back receiver-name-remove" title="Remover"><i class="fas fa-times"></i></button>
            </div>
            <% end %>
          </div>
          <button type="button" class="btn-back" id="addReceiverNameButton"><i class="fas fa-plus me-1"></i>Adicionar pessoa</button>
          <span class="text-muted-custom d-block mt-1"><i class="fas fa-info-circle me-1"></i>Vão como destinatário nos Correios (separados por vírgula): com mão própria, só essas pessoas podem receber.</span>
        </div>
        <% else %>
        <% recipient = B2bTinyService::B2C_TRANSFER_RECIPIENT %>
        <div class="form-col-6" id="b2cDestinationSection">
          <label class="field-label">Destino</label>
          <div class="text-main"><%= recipient[:nome] %></div>
          <span class="text-muted-custom d-block mt-1">CNPJ <%= recipient[:cpf_cnpj] %> · <%= recipient[:endereco] %>, <%= recipient[:numero] %> <%= recipient[:complemento] %> · <%= recipient[:cidade] %>/<%= recipient[:uf] %></span>
          <span class="text-muted-custom d-block mt-1"><i class="fas fa-info-circle me-1"></i>Depois de aprovada no Log02, o Honey cria no Correios (como transportadora, dentro do galpão do Log) e emite a NF-e de transferência.</span>
        </div>
        <div class="form-col-6">
          <label class="field-label">Entrega</label>
          <span class="hand-delivery-badge"><i class="fas fa-truck-moving"></i>Transportadora</span>
          <span class="text-muted-custom d-block mt-1">Sem mão própria: nos Correios B2B o pedido entra como outra transportadora (dentro do galpão do Log).</span>
        </div>
        <% end %>

        <% if @b2b_order.sale? %>
        <% mode = @b2b_order.pickup? ? 'pickup' : (@b2b_order.freight_service.present? ? 'sedex' : (@b2b_order.carrier_id.present? ? 'carrier' : '')) %>
        <div class="form-col-6" id="saleShippingSection">
          <label class="field-label">Forma de Envio</label>
          <select id="shippingModeSelect" class="field-input" required>
            <option value="" <%= 'selected' if mode.blank? %>>Selecione...</option>
            <option value="sedex" <%= 'selected' if mode == 'sedex' %>>Correios Log</option>
            <option value="carrier" <%= 'selected' if mode == 'carrier' %>>Transportadora</option>
            <option value="pickup" <%= 'selected' if mode == 'pickup' %>>Retirada</option>
          </select>
          <%# Correios Log vai como SEDEX; transportadora, pelo cadastro dela (CNPJ no Correios e na NF-e); retirada, sem frete. %>
          <%= form.hidden_field :freight_service, id: 'freightServiceField', value: (mode == 'sedex' ? B2bOrder::SALE_FREIGHT_SERVICES.first : '') %>
          <%= form.hidden_field :pickup, id: 'pickupField', value: mode == 'pickup' %>
          <input type="hidden" name="b2b_order[carrier_id]" value="" id="saleCarrierBlank" <%= 'disabled' if mode == 'carrier' %>>
          <span class="text-muted-custom d-block mt-1" id="pickupHint" style="<%= 'display: none;' unless mode == 'pickup' %>"><i class="fas fa-info-circle me-1"></i>O cliente busca no galpão do Log: sem frete. No Correios entra como transportadora com o CNPJ do próprio cliente.</span>
        </div>

        <div class="form-col-6" id="carrierSection" style="<%= 'display: none;' unless mode == 'carrier' %>">
          <label class="field-label">Transportadora</label>
          <%= form.collection_select :carrier_id, Carrier.active.order(:name), :id, :name, { include_blank: 'Selecione...' }, { class: 'field-input', id: 'saleCarrierSelect', disabled: mode != 'carrier', required: mode == 'carrier' } %>
          <span class="text-muted-custom d-block mt-1"><i class="fas fa-info-circle me-1"></i>No Correios entra como transportadora (74926), com o CNPJ do cadastro. <%= link_to 'Cadastrar transportadora', new_carrier_path, target: '_blank' %></span>
        </div>

        <div class="form-col-6 freight-field" id="freightChoiceSection" data-rates="<%= B2bFreightRate.table.to_json %>" style="<%= 'display: none;' if mode == 'pickup' %>">
          <label class="field-label">Frete</label>
          <%= form.select :fixed_freight, [['Frete da tabela (pelo valor do pedido)', true], ['Outro valor', false]], {}, { class: 'field-input', id: 'fixedFreightSelect' } %>
          <span class="text-muted-custom d-block mt-1">O frete da tabela muda sozinho com o valor do pedido<%= ' (' if screen_can?(:b2b_orders, :view) %><%= link_to('ver a tabela', b2b_freight_rates_path, target: '_blank') if screen_can?(:b2b_orders, :view) %><%= ')' if screen_can?(:b2b_orders, :view) %>; em "Outro valor", ajuste só neste pedido.</span>
        </div>

        <div class="form-col-6 freight-field" style="<%= 'display: none;' if mode == 'pickup' %>">
          <label class="field-label">Valor do frete (R$)</label>
          <%= form.number_field :freight_value, step: 0.01, min: 0, class: 'field-input', id: 'freightValueField', placeholder: '0,00' %>
          <span class="text-muted-custom d-block mt-1">Vai como valor do frete do pedido.</span>
        </div>

        <div class="form-col-6">
          <label class="field-label">Forma de pagamento</label>
          <%= form.select :payment_method, B2bOrder::PAYMENT_METHODS.map { |key, label| [label, key] }, { include_blank: 'Selecione...' },
                          { class: 'field-input', required: @b2b_order.tiny_reference_id.blank?, id: 'paymentMethodSelect' } %>
        </div>

        <% installments_on = B2bOrder::INSTALLMENT_METHODS.include?(@b2b_order.payment_method) %>
        <div class="form-col-12" id="installmentsSection" data-methods="<%= B2bOrder::INSTALLMENT_METHODS.join(' ') %>" data-order-date="<%= (@b2b_order.created_at || Time.current).to_date.iso8601 %>" style="<%= 'display: none;' unless installments_on %>">
          <div class="form-grid">
            <div class="form-col-6">
              <label class="field-label">Parcelas</label>
              <select id="installmentsCountSelect" class="field-input">
                <% (1..B2bOrder::MAX_INSTALLMENTS).each do |n| %>
                  <option value="<%= n %>" <%= 'selected' if @b2b_order.installment_days.size == n %>><%= n %>x</option>
                <% end %>
              </select>
              <span class="text-muted-custom d-block mt-1">Preenche a condição com vencimentos de 30 em 30 dias; dá para editar os dias.</span>
            </div>
            <div class="form-col-6">
              <label class="field-label">Condição de pagamento (dias)</label>
              <%= form.text_field :payment_terms, class: 'field-input', id: 'paymentTermsField', placeholder: '30 60 90', disabled: !installments_on %>
              <span class="text-muted-custom d-block mt-1">Os dias de cada vencimento, contados da data do pedido (ex.: 30 60 90).</span>
            </div>
          </div>
          <div class="installments-preview" id="installmentsPreview" aria-live="polite"></div>
        </div>
        <% end %>

        <% if @b2b_order.sale? %>
        <div class="form-col-12 form-check">
          <%= form.check_box :different_shipping_address, id: 'differentShippingAddressCheck' %>
          <label class="form-check-label text-main" for="differentShippingAddressCheck">O endereço de entrega do cliente é diferente do endereço de cobrança</label>
        </div>
        <% end %>
      </div>

      <% if @b2b_order.sale? %>
      <div id="shippingAddressSection" class="form-grid mt-2" style="<%= @b2b_order.different_shipping_address? ? '' : 'display: none;' %>">
        <div class="form-col-6">
          <label class="field-label">Rua</label>
          <%= form.text_field :shipping_street, class: 'field-input' %>
        </div>
        <div class="form-col-6">
          <label class="field-label">Número</label>
          <%= form.text_field :shipping_number, class: 'field-input' %>
        </div>
        <div class="form-col-6">
          <label class="field-label">Complemento</label>
          <%= form.text_field :shipping_complement, class: 'field-input' %>
        </div>
        <div class="form-col-6">
          <label class="field-label">Bairro</label>
          <%= form.text_field :shipping_neighbourhood, class: 'field-input' %>
        </div>
        <div class="form-col-6">
          <label class="field-label">Cidade</label>
          <%= form.text_field :shipping_city, class: 'field-input' %>
        </div>
        <div class="form-col-6">
          <label class="field-label">UF</label>
          <%= form.text_field :shipping_state, class: 'field-input' %>
        </div>
        <div class="form-col-6">
          <label class="field-label">CEP</label>
          <%= form.text_field :shipping_zip, class: 'field-input' %>
        </div>
      </div>
      <% end %>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-header"><h5 class="form-section-title"><i class="fas fa-boxes me-2"></i>Itens</h5></div>
    <div class="form-section-body">
      <% if @b2b_order.stock_transfer? %>
      <div class="form-hint-box">
        <i class="fas fa-info-circle"></i>
        <div>O estoque disponível para o abastecimento das lojas sai do Correios B2B.</div>
      </div>
      <% end %>
      <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
        <button type="button" class="btn-export" data-bs-toggle="modal" data-bs-target="#productPickerModal">
          <i class="fas fa-plus me-1"></i>Adicionar Produtos
        </button>
        <input type="file" id="csvUploadInput" accept=".csv" class="field-input" style="max-width: 300px;">
        <a href="/templates/planilha_modelo_itens_b2b.csv" download class="btn-back">
          <i class="fas fa-download me-1"></i>Baixar planilha modelo
        </a>
        <button type="button" id="refreshStockButton" class="btn-back">
          <i class="fas fa-sync me-1"></i>Atualizar estoque
        </button>
      </div>

      <%= render 'stock_reservations/freshness', refresh: StockReservationRefresh.for(:b2b) %>

      <table class="orders-table" id="itemsTable" data-enforce-stock="<%= @b2b_order.tiny_reference_id.blank? && !@b2b_order.cancelado? %>">
        <thead>
          <tr><th></th><th>SKU</th><th>Nome</th><th>Qtd</th><th>Preço</th><th>Estoque · Reservado · Disponível</th><th></th></tr>
        </thead>
        <tbody id="itemsTableBody">
          <% @b2b_order.b2b_order_items.each_with_index do |item, index| %>
            <tr>
              <td class="item-photo-cell" data-sku="<%= item.sku %>">
                <% if item.product&.image_url.present? %>
                  <img src="<%= item.product.image_url %>" class="rounded border border-secondary" style="width: 40px; height: 40px; object-fit: cover;" loading="lazy">
                <% else %>
                  <span class="rounded border border-secondary d-flex align-items-center justify-content-center text-muted-custom" style="width: 40px; height: 40px;"><i class="fas fa-image"></i></span>
                <% end %>
              </td>
              <td>
                <%= hidden_field_tag "b2b_order[b2b_order_items_attributes][#{index}][id]", item.id %>
                <%= text_field_tag "b2b_order[b2b_order_items_attributes][#{index}][sku]", item.sku, class: 'field-input', readonly: true %>
              </td>
              <td><%= text_field_tag "b2b_order[b2b_order_items_attributes][#{index}][name]", item.name, class: 'field-input', readonly: true %></td>
              <td><%= number_field_tag "b2b_order[b2b_order_items_attributes][#{index}][quantity]", item.quantity, class: 'field-input' %></td>
              <td><%= number_field_tag "b2b_order[b2b_order_items_attributes][#{index}][price]", item.price, step: 0.01, class: 'field-input' %></td>
              <td class="item-stock-cell" data-sku="<%= item.sku %>">-</td>
              <td><button type="button" class="action-btn action-btn--danger remove-item-row"><i class="fas fa-trash"></i></button></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div id="stockEnforcementNotice" class="stock-enforcement-notice d-none" role="status"></div>
      <span class="text-muted-custom d-block mt-2"><i class="fas fa-info-circle me-1"></i>Disponível = estoque do Log02 − itens reservados (pedidos do Honey e da fila antiga do Tiny). Não dá para adicionar item sem disponível nem pedir acima dele.</span>
    </div>
  </div>

  <div class="modal fade" id="productPickerModal" tabindex="-1" aria-labelledby="productPickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content" style="background: #161b22; border: 1px solid #21262d; color: #e6edf3;">
        <div class="modal-header" style="border-bottom: 1px solid #21262d;">
          <h5 class="modal-title" id="productPickerModalLabel" style="color: #e6edf3;">Selecionar Produtos</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
        </div>
        <div class="modal-body">
          <input type="text" id="productPickerSearchInput" class="field-input" placeholder="Buscar por nome ou SKU (ex: signature black)..." autocomplete="off">

          <div id="productPickerResults" class="mt-3">
            <div class="text-muted-custom text-center py-4">Digite algo pra buscar produtos.</div>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid #21262d;">
          <span class="text-muted-custom me-auto" id="productPickerSelectedCount">0 variantes selecionadas</span>
          <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn-export" id="productPickerAddButton" disabled>Adicionar</button>
        </div>
      </div>
    </div>
  </div>

  <% if @b2b_order.sale? %>
  <div class="form-section" id="orderSummarySection">
    <div class="form-section-header"><h5 class="form-section-title"><i class="fas fa-receipt me-2"></i>Resumo e desconto</h5></div>
    <div class="form-section-body">
      <div class="form-grid">
        <div class="form-col-6">
          <label class="field-label">Desconto do pedido</label>
          <div class="d-flex gap-2">
            <%= form.number_field :order_discount, step: 0.01, min: 0, class: 'field-input', id: 'orderDiscountField' %>
            <%= form.select :order_discount_type, B2bOrder::DISCOUNT_TYPES.map { |key, label| [label, key] }, {}, { class: 'field-input', id: 'orderDiscountTypeField', style: 'max-width: 90px' } %>
          </div>
          <span class="text-muted-custom d-block mt-1">Desconto livre sobre o total dos itens, em reais ou porcentagem. Entra na NF-e rateado pelos itens.</span>
        </div>
        <div class="form-col-6">
          <div class="order-summary" id="orderSummary">
            <div class="d-flex justify-content-between"><span class="text-muted-custom">Itens</span><span id="summaryItems">R$ 0,00</span></div>
            <div class="d-flex justify-content-between"><span class="text-muted-custom">Desconto</span><span id="summaryDiscount">- R$ 0,00</span></div>
            <div class="d-flex justify-content-between"><span class="text-muted-custom">Frete</span><span id="summaryFreight">R$ 0,00</span></div>
            <div class="d-flex justify-content-between mt-1"><strong>Total</strong><strong id="summaryTotal">R$ 0,00</strong></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% end %>

  <div class="form-section">
    <div class="form-section-body">
      <label class="field-label">Observações</label>
      <%= form.text_area :notes, class: 'field-input', rows: 3 %>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn-submit">Salvar</button>
  </div>
<% end %>

<% content_for :scripts do %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var itemIndex = <%= @b2b_order.b2b_order_items.size %>;
  var stockCache = {}; // sku -> quantity, preenchido pela busca do modal e reaproveitado na tabela

  // A lista de preço é fixa por tela: atacado = padrão, transferência = transferência.
  var PRICE_LIST = '<%= @b2b_order.sale? ? 'standard' : 'transfer' %>';
  function currentPriceList() {
    return PRICE_LIST;
  }
  // Preço inicial do item (editável): atacado = varejo com o desconto configurado (Seamless ou demais), abastecimento = 80% do varejo, transferência B2C = 70% do custo.
  var ORDER_KIND = '<%= @b2b_order.kind %>';
  function defaultPrice(product, suggestedPrice) {
    if (ORDER_KIND === 'b2c_transfer') return product.b2c_transfer_price || 0;
    if (currentPriceList() === 'transfer') return Math.round((product.retail_price || 0) * 80) / 100;
    return suggestedPrice || 0;
  }

  // Responsáveis pelo recebimento: um campo por pessoa, salvos juntos separados por vírgula.
  // Abastecimento: SEDEX com mão própria (sem transportadora, responsável obrigatório) ou transportadora.
  var stockDelivery = document.getElementById('stockDeliverySection');
  if (stockDelivery) {
    var applyStockDelivery = function () {
      var checked = stockDelivery.querySelector('input[name="stock_delivery"]:checked');
      var byCarrier = !!checked && checked.value === 'carrier';
      var select = document.getElementById('stockCarrierSelect');
      document.getElementById('stockCarrierSection').style.display = byCarrier ? '' : 'none';
      document.getElementById('stockDeliveryHandHint').style.display = byCarrier ? 'none' : '';
      document.getElementById('receiverOptionalHint').style.display = byCarrier ? '' : 'none';
      select.disabled = !byCarrier;
      select.required = byCarrier;
      document.getElementById('stockCarrierBlank').disabled = byCarrier;
      var firstReceiver = document.querySelector('#receiverNamesList .receiver-name-input');
      if (firstReceiver && <%= @b2b_order.tiny_reference_id.blank? %>) firstReceiver.required = !byCarrier;
    };
    stockDelivery.addEventListener('change', applyStockDelivery);
    applyStockDelivery();
  }

  // Frete da tabela: o valor sai da faixa do valor do pedido (produtos com o desconto) e acompanha as mudanças.
  // Em "Outro valor" o campo fica livre para ajustar só neste pedido.
  var fixedSelect = document.getElementById('fixedFreightSelect');
  var freightRates = fixedSelect ? JSON.parse(document.getElementById('freightChoiceSection').dataset.rates || '[]') : [];
  var freightForAmount = function (amount) {
    if (!freightRates.length) return 0;
    var rate = freightRates[0];
    freightRates.forEach(function (r) { if (r[0] <= amount + 0.0001) rate = r; });
    return rate[2];
  };
  var orderAmount = 0;
  var applyTableFreight = function () {
    if (!fixedSelect || fixedSelect.value !== 'true') return false;
    var field = document.getElementById('freightValueField');
    if (document.getElementById('pickupField').value === 'true') return false;
    var value = freightForAmount(orderAmount).toFixed(2);
    if (field.value === value) return false;
    field.value = value;
    return true;
  };
  if (fixedSelect) {
    var freightField = document.getElementById('freightValueField');
    var syncFreightLock = function () { freightField.readOnly = fixedSelect.value === 'true'; };
    fixedSelect.addEventListener('change', function () {
      syncFreightLock();
      applyTableFreight();
      freightField.dispatchEvent(new Event('input', { bubbles: true }));
    });
    syncFreightLock();
  }

  // Parcelamento (boleto e cartão): condição em dias ("30 60 90") e prévia das parcelas com o total do pedido.
  var installments = document.getElementById('installmentsSection');
  var installmentsTotal = 0;
  function renderInstallments() {
    if (!installments) return;
    var preview = document.getElementById('installmentsPreview');
    var days = document.getElementById('paymentTermsField').value.split(/[\s,;\/]+/).filter(Boolean).map(Number).filter(function (d) { return !isNaN(d); });
    if (!days.length || installments.style.display === 'none') { preview.innerHTML = ''; return; }
    var base = new Date(installments.dataset.orderDate + 'T12:00:00');
    var cents = Math.round(installmentsTotal * 100);
    var each = Math.floor(cents / days.length);
    preview.innerHTML = days.map(function (d, i) {
      var date = new Date(base); date.setDate(date.getDate() + d);
      var value = (i === days.length - 1 ? cents - each * (days.length - 1) : each) / 100;
      return '<div class="installment-chip" style="--i:' + i + '"><span>' + (i + 1) + 'ª · ' + d + ' dias</span><strong>' +
        date.toLocaleDateString('pt-BR') + '</strong><span>R$ ' + value.toFixed(2).replace('.', ',') + '</span></div>';
    }).join('');
  }
  if (installments) {
    var methodSelect = document.getElementById('paymentMethodSelect');
    var termsField = document.getElementById('paymentTermsField');
    var countSelect = document.getElementById('installmentsCountSelect');
    var fillTerms = function (n) {
      var days = [];
      for (var i = 1; i <= n; i++) days.push(30 * i);
      termsField.value = days.join(' ');
    };
    var applyMethod = function () {
      var on = installments.dataset.methods.split(' ').indexOf(methodSelect.value) !== -1;
      installments.style.display = on ? '' : 'none';
      termsField.disabled = !on;
      if (on && !termsField.value.trim()) fillTerms(parseInt(countSelect.value, 10) || 1);
      renderInstallments();
    };
    methodSelect.addEventListener('change', applyMethod);
    countSelect.addEventListener('change', function () { fillTerms(parseInt(countSelect.value, 10)); renderInstallments(); });
    termsField.addEventListener('input', renderInstallments);
    applyMethod();
  }

  // Resumo do atacado: itens, desconto livre (R$ ou %), frete e total, atualizados a cada mudança.
  var summary = document.getElementById('orderSummary');
  if (summary) {
    var brl = function (v) { return 'R$ ' + v.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
    var num = function (el) { return el ? (parseFloat(String(el.value).replace(',', '.')) || 0) : 0; };
    var updateSummary = function () {
      var items = 0;
      document.querySelectorAll('#itemsTableBody tr').forEach(function (row) {
        var qty = num(row.querySelector('input[name$="[quantity]"]'));
        var price = num(row.querySelector('input[name$="[price]"]'));
        var itemDiscount = num(row.querySelector('input[name$="[discount]"]'));
        items += Math.max(price - itemDiscount, 0) * qty;
      });
      var value = num(document.getElementById('orderDiscountField'));
      var percent = document.getElementById('orderDiscountTypeField').value === 'percent';
      var discount = Math.min(percent ? items * value / 100 : value, items);
      orderAmount = items - discount;
      applyTableFreight();
      var freight = num(document.getElementById('freightValueField'));
      document.getElementById('summaryItems').textContent = brl(items);
      document.getElementById('summaryDiscount').textContent = '- ' + brl(discount);
      document.getElementById('summaryFreight').textContent = brl(freight);
      document.getElementById('summaryTotal').textContent = brl(items - discount + freight);
      installmentsTotal = items - discount + freight;
      renderInstallments();
    };
    document.getElementById('b2bOrderForm').addEventListener('input', updateSummary);
    document.getElementById('b2bOrderForm').addEventListener('change', updateSummary);
    new MutationObserver(updateSummary).observe(document.getElementById('itemsTableBody'), { childList: true });
    updateSummary();
  }

  var receiverList = document.getElementById('receiverNamesList');
  if (receiverList) {
    var receiverField = document.getElementById('receiverNameField');
    var syncReceiverNames = function () {
      var names = Array.prototype.map.call(receiverList.querySelectorAll('.receiver-name-input'), function (input) {
        return input.value.replace(/,/g, ' ').trim();
      }).filter(function (name) { return name; });
      receiverField.value = names.join(', ');
    };
    var updateRemoveButtons = function () {
      var rows = receiverList.querySelectorAll('.receiver-name-row');
      rows.forEach(function (row) { row.querySelector('.receiver-name-remove').style.visibility = rows.length > 1 ? '' : 'hidden'; });
    };
    document.getElementById('addReceiverNameButton').addEventListener('click', function () {
      var row = receiverList.querySelector('.receiver-name-row').cloneNode(true);
      var input = row.querySelector('.receiver-name-input');
      input.value = '';
      input.required = false;
      receiverList.appendChild(row);
      updateRemoveButtons();
      input.focus();
    });
    receiverList.addEventListener('click', function (e) {
      var button = e.target.closest('.receiver-name-remove');
      if (!button || receiverList.querySelectorAll('.receiver-name-row').length < 2) return;
      var wasRequired = button.closest('.receiver-name-row').querySelector('.receiver-name-input').required;
      button.closest('.receiver-name-row').remove();
      if (wasRequired) receiverList.querySelector('.receiver-name-input').required = true;
      updateRemoveButtons();
      syncReceiverNames();
    });
    receiverList.addEventListener('input', syncReceiverNames);
    document.getElementById('b2bOrderForm').addEventListener('submit', syncReceiverNames);
    updateRemoveButtons();
  }

  var addrCheck = document.getElementById('differentShippingAddressCheck');
  var addrSection = document.getElementById('shippingAddressSection');
  if (addrCheck) addrCheck.addEventListener('change', function () {
    addrSection.style.display = addrCheck.checked ? '' : 'none';
  });

  // Atacado: SEDEX (Correios Log) ou transportadora do cadastro. Sem Tiny: a escolha vai direto no pedido.
  var shippingMode = document.getElementById('shippingModeSelect');
  if (shippingMode) {
    var applyShippingMode = function () {
      var mode = shippingMode.value;
      var carrierSelect = document.getElementById('saleCarrierSelect');
      document.getElementById('carrierSection').style.display = mode === 'carrier' ? '' : 'none';
      carrierSelect.disabled = mode !== 'carrier';
      carrierSelect.required = mode === 'carrier';
      document.getElementById('saleCarrierBlank').disabled = mode === 'carrier';
      document.getElementById('freightServiceField').value = mode === 'sedex' ? '<%= B2bOrder::SALE_FREIGHT_SERVICES.first %>' : '';
      // Retirada: sem frete (some o bloco do frete e o valor vai zerado).
      var pickup = mode === 'pickup';
      document.getElementById('pickupField').value = pickup ? 'true' : 'false';
      document.getElementById('pickupHint').style.display = pickup ? '' : 'none';
      document.querySelectorAll('.freight-field').forEach(function (el) { el.style.display = pickup ? 'none' : ''; });
      var freightInput = document.getElementById('freightValueField');
      if (pickup) freightInput.value = '0.00';
      else applyTableFreight();
      freightInput.dispatchEvent(new Event('input', { bubbles: true }));
    };
    shippingMode.addEventListener('change', applyShippingMode);
    applyShippingMode();
  }

  // Cliente via AJAX (só clientes do Honey)
  var clientTimeout;
  // Cada busca tem uma "geração": se uma nova busca for feita (ou um cliente
  // for selecionado) antes da resposta chegar, a resposta antiga é descartada
  // em vez de sobrescrever a caixa de resultados já limpa/selecionada.
  var clientSearchGeneration = 0;
  var clientSearchInput = document.getElementById('clientSearchInput');
  if (clientSearchInput) clientSearchInput.addEventListener('input', function (e) {
    clearTimeout(clientTimeout);
    var myGeneration = ++clientSearchGeneration;
    var q = e.target.value;
    var box = document.getElementById('clientSearchResults');

    if (!q) { box.innerHTML = ''; return; }

    box.innerHTML = '<div class="list-group-item"><i class="fas fa-spinner fa-spin me-2"></i>Buscando no Honey...</div>';

    clientTimeout = setTimeout(function () {
      fetch('<%= search_client_b2b_orders_path %>?query=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (myGeneration !== clientSearchGeneration) return;
          box.innerHTML = '';
          var clients = data.clients || [];

          clients.forEach(function (c) {
            var item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';

            var label = document.createElement('span');
            label.textContent = c.name + (c.registration ? ' - ' + c.registration : '');
            item.appendChild(label);

            var badge = document.createElement('span');
            badge.className = c.source === 'honey' ? 'badge bg-success' : 'badge bg-warning text-dark';
            badge.textContent = c.source === 'honey' ? 'Honey' : 'Tiny';
            item.appendChild(badge);

            item.addEventListener('click', function () {
              if (c.source === 'honey') {
                selectClient(c.client_id, c.name);
                box.innerHTML = '';
                return;
              }

              item.disabled = true;
              label.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Cadastrando no Honey...';

              fetch('<%= import_client_b2b_orders_path %>', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify({
                  name: c.name, registration: c.registration, street: c.street, number: c.number,
                  neighbourhood: c.neighbourhood, city: c.city, state: c.state, zip: c.zip,
                  email: c.email, phone: c.phone
                })
              })
                .then(function (r) { return r.json(); })
                .then(function (result) {
                  if (result.success) {
                    selectClient(result.client.id, result.client.display_name);
                    box.innerHTML = '';
                  } else {
                    alert('Erro ao cadastrar cliente no Honey: ' + (result.errors || []).join(', '));
                  }
                });
            });

            box.appendChild(item);
          });

          if (clients.length === 0) {
            var emptyState = document.createElement('div');
            emptyState.className = 'list-group-item';
            emptyState.innerHTML = 'Nenhum cliente encontrado no Honey. ' +
              '<a href="<%= new_client_path %>" target="_blank">Cadastrar novo cliente</a>';
            box.appendChild(emptyState);
          }
        });
    }, 300);
  });

  function selectClient(id, name) {
    clientSearchGeneration++;
    document.getElementById('clientIdField').value = id;
    document.getElementById('clientSearchInput').value = name;
  }

  function photoCellHtml(sku, imageUrl) {
    if (imageUrl) {
      return '<td class="item-photo-cell" data-sku="' + (sku || '') + '">' +
        '<img src="' + imageUrl + '" class="rounded border border-secondary" style="width: 40px; height: 40px; object-fit: cover;" loading="lazy"></td>';
    }
    return '<td class="item-photo-cell" data-sku="' + (sku || '') + '">' +
      '<span class="rounded border border-secondary d-flex align-items-center justify-content-center text-muted-custom" style="width: 40px; height: 40px;"><i class="fas fa-image"></i></span></td>';
  }

  function addItemRow(sku, name, quantity, price, imageUrl) {
    var tbody = document.getElementById('itemsTableBody');
    var row = document.createElement('tr');
    row.innerHTML =
      photoCellHtml(sku, imageUrl) +
      '<td><input type="text" class="field-input" name="b2b_order[b2b_order_items_attributes][' + itemIndex + '][sku]" value="' + (sku || '') + '" readonly></td>' +
      '<td><input type="text" class="field-input" name="b2b_order[b2b_order_items_attributes][' + itemIndex + '][name]" value="' + (name || '') + '" readonly></td>' +
      '<td><input type="number" class="field-input" name="b2b_order[b2b_order_items_attributes][' + itemIndex + '][quantity]" value="' + (quantity || 1) + '"></td>' +
      '<td><input type="number" step="0.01" class="field-input" name="b2b_order[b2b_order_items_attributes][' + itemIndex + '][price]" value="' + (price || 0) + '"></td>' +
      '<td class="item-stock-cell" data-sku="' + (sku || '') + '" data-new-row="true">-</td>' +
      '<td><button type="button" class="action-btn action-btn--danger remove-item-row"><i class="fas fa-trash"></i></button></td>';
    tbody.appendChild(row);
    itemIndex++;
    if (!imageUrl) queueImageFetch(row.querySelector('.item-photo-cell'));
    queueStockFetch(row.querySelector('.item-stock-cell'));
  }

  document.getElementById('itemsTableBody').addEventListener('click', function (e) {
    var btn = e.target.closest('.remove-item-row');
    if (btn) btn.closest('tr').remove();
  });

  // Fila sequencial: consulta o estoque um item de cada vez, com uma pequena
  // pausa entre cada um, pra não travar a tela disparando tudo de uma vez
  // quando o pedido tem muitos itens.
  function makeQueue(processFn, delayMs) {
    var queue = [];
    var running = false;

    function runNext() {
      var cell = queue.shift();
      if (!cell) { running = false; return; }

      processFn(cell).finally(function () { setTimeout(runNext, delayMs); });
    }

    return function (cell) {
      queue.push(cell);
      if (!running) { running = true; runNext(); }
    };
  }

  var enforceStock = document.getElementById('itemsTable').dataset.enforceStock === 'true';
  // Na edição, o estoque desconta a reserva dos outros pedidos da fila, não a deste.
  var stockUrl = '<%= raw "#{product_stock_b2b_orders_path}?#{"b2b_order_id=#{@b2b_order.id}&" if @b2b_order.persisted?}sku=" %>';
  var reservationsUrl = <%= raw (current_user.can_access_screen?('stock_reservations_b2b') ? b2b_stock_reservations_path.to_json : 'null') %>;

  function blocksSku(data) {
    return enforceStock && data && data.status !== 'error';
  }

  // Aviso animado listando o que o bloqueio mudou (linhas removidas / quantidades reduzidas).
  var noticeLines = [];
  var noticeTimer;
  function notifyStockChange(message) {
    var box = document.getElementById('stockEnforcementNotice');
    noticeLines.push(message);
    box.innerHTML = '<i class="fas fa-lock me-2"></i><div>' + noticeLines.map(function (l) { return '<div>' + l + '</div>'; }).join('') + '</div>';
    box.classList.remove('d-none');
    box.classList.remove('stock-enforcement-notice--in');
    void box.offsetWidth; // reinicia a animação
    box.classList.add('stock-enforcement-notice--in');
    clearTimeout(noticeTimer);
    noticeTimer = setTimeout(function () { noticeLines = []; box.classList.add('d-none'); }, 12000);
  }

  function reservedText(data) {
    return data.reserved > 0 ? ' · ' + data.reserved + ' reservados na fila' : '';
  }

  // Pinta "estoque − reservado = disponível" e destaca a linha se a quantidade passar do disponível.
  function paintStockCell(cell) {
    var data = stockCache[cell.dataset.sku];
    if (!data) return;
    var row = cell.closest('tr');
    if (data.status === 'error') {
      cell.innerHTML = '<span class="text-muted-custom" title="Não foi possível consultar o estoque agora; o item não é bloqueado.">Correios sem resposta</span>';
      row.classList.remove('item-row--short');
      return;
    }
    var qtyInput = row.querySelector('input[name$="[quantity]"]');
    var requested = qtyInput ? parseInt(qtyInput.value, 10) || 0 : 0;
    if (qtyInput && blocksSku(data)) qtyInput.max = Math.max(data.quantity, 0);
    var short = requested > data.quantity;
    var reserved = data.reserved > 0 && reservationsUrl
      ? '<a href="' + reservationsUrl + '?sku=' + encodeURIComponent(cell.dataset.sku) + '" class="stock-breakdown__reserved" target="_blank">' + data.reserved + '</a>'
      : '<span class="stock-breakdown__reserved">' + data.reserved + '</span>';
    cell.innerHTML =
      '<span class="stock-breakdown">' +
        '<span>' + data.stock + '</span><span class="stock-breakdown__op">−</span>' + reserved +
        '<span class="stock-breakdown__op">=</span><strong class="stock-breakdown__available stock-breakdown__available--' + data.status + '">' + data.quantity + '</strong>' +
      '</span>' +
      (short ? '<span class="stock-breakdown__alert"><i class="fas fa-lock me-1"></i>faltam ' + (requested - data.quantity) + reservedText(data) + '</span>' : '');
    row.classList.toggle('item-row--short', short);
  }

  // Linha recém-adicionada (seletor/planilha): some se não há disponível; quantidade cai para o disponível.
  function enforceNewRow(cell) {
    var data = stockCache[cell.dataset.sku];
    if (!blocksSku(data)) return;
    var row = cell.closest('tr');
    var qtyInput = row.querySelector('input[name$="[quantity]"]');
    var requested = qtyInput ? parseInt(qtyInput.value, 10) || 0 : 0;
    if (data.quantity <= 0) {
      row.classList.add('item-row--leaving');
      setTimeout(function () { row.remove(); }, 350);
      notifyStockChange('<strong>' + cell.dataset.sku + '</strong> não foi adicionado: 0 disponível' + reservedText(data) + '.');
    } else if (requested > data.quantity) {
      qtyInput.value = data.quantity;
      paintStockCell(cell);
      notifyStockChange('<strong>' + cell.dataset.sku + '</strong>: quantidade reduzida de ' + requested + ' para ' + data.quantity + ' (disponível' + reservedText(data) + ').');
    }
  }

  function loadStock(sku) {
    if (Object.prototype.hasOwnProperty.call(stockCache, sku)) return Promise.resolve(stockCache[sku]);
    return fetch(stockUrl + encodeURIComponent(sku))
      .then(function (r) { return r.json(); })
      .then(function (data) {
        stockCache[sku] = { quantity: data.quantity, stock: data.stock, reserved: data.reserved, status: data.status };
        return stockCache[sku];
      });
  }

  var queueStockFetch = makeQueue(function (cell) {
    var sku = cell.dataset.sku;
    if (!sku) return Promise.resolve();

    return loadStock(sku)
      .then(function () {
        paintStockCell(cell);
        if (cell.dataset.newRow === 'true') enforceNewRow(cell);
      })
      .catch(function () { cell.textContent = 'erro'; });
  }, 200);

  // Digitar acima do disponível volta para o máximo.
  document.getElementById('itemsTableBody').addEventListener('input', function (e) {
    if (!e.target.matches('input[name$="[quantity]"]')) return;
    var cell = e.target.closest('tr').querySelector('.item-stock-cell');
    if (!cell) return;
    var data = stockCache[cell.dataset.sku];
    var typed = parseInt(e.target.value, 10) || 0;
    if (blocksSku(data) && typed > data.quantity && data.quantity > 0) {
      e.target.value = data.quantity;
      notifyStockChange('<strong>' + cell.dataset.sku + '</strong>: máximo disponível é ' + data.quantity + reservedText(data) + '.');
    }
    paintStockCell(cell);
  });

  // Verifica o estoque da tabela de itens apenas uma vez, ao carregar a tela.
  // Itens adicionados depois (planilha, modal) têm o estoque consultado na
  // hora, pela mesma fila com pausa, para o bloqueio por disponível.
  function checkAllItemsStock(force) {
    var cells = Array.prototype.slice.call(document.querySelectorAll('.item-stock-cell'));
    if (force) cells.forEach(function (cell) { delete stockCache[cell.dataset.sku]; });
    cells.forEach(queueStockFetch);
  }

  checkAllItemsStock(false);

  document.getElementById('refreshStockButton').addEventListener('click', function () {
    checkAllItemsStock(true);
  });

  var queueImageFetch = makeQueue(function (cell) {
    var sku = cell.dataset.sku;
    if (!sku || cell.querySelector('img')) return Promise.resolve();

    return fetch('<%= search_product_b2b_orders_path %>?query=' + encodeURIComponent(sku))
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var matched = (data.products || []).find(function (p) { return p.sku.toUpperCase() === sku.toUpperCase(); });
        if (matched && matched.image_url) {
          cell.innerHTML = '<img src="' + matched.image_url + '" class="rounded border border-secondary" style="width: 40px; height: 40px; object-fit: cover;" loading="lazy">';
        }
      })
      .catch(function () {});
  }, 200);

  document.querySelectorAll('.item-photo-cell').forEach(queueImageFetch);

  // Upload de planilha (tempo real)
  document.getElementById('csvUploadInput').addEventListener('change', function (e) {
    var file = e.target.files[0];
    if (!file) return;
    var formData = new FormData();
    formData.append('file', file);
    fetch('<%= parse_items_spreadsheet_b2b_orders_path %>', { method: 'POST', body: formData, headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) { alert(data.message); return; }
        data.items.forEach(function (item) {
          var price = defaultPrice(item, item.suggested_price);
          addItemRow(item.sku, item.name, item.quantity, price, item.image_url);
        });
      });
  });

  // ===== Modal "Selecionar Produtos" (estilo Shopify) =====
  var pickerSelected = {}; // sku -> { sku, name, price, image_url }
  function renderPickerStock(cell, cached) {
    var cb = cell.closest('tr').querySelector('.picker-variant-cb');
    var blocked = blocksSku(cached) && cached.quantity <= 0;
    if (cb) {
      cb.disabled = blocked;
      if (blocked) cb.checked = false;
    }
    cell.closest('tr').classList.toggle('picker-variant--blocked', blocked);
    if (cached.status === 'error') {
      cell.innerHTML = '<span class="text-muted-custom">-</span>';
    } else if (cached.quantity > 0) {
      cell.innerHTML = '<span>' + cached.quantity + '</span>' + (cached.reserved > 0 ? '<small class="d-block text-muted-custom">' + cached.reserved + ' reservados</small>' : '');
    } else {
      cell.innerHTML = '<span class="text-warning"><i class="fas fa-lock me-1"></i>0 disponível</span>' + (cached.reserved > 0 ? '<small class="d-block text-muted-custom">' + cached.reserved + ' reservados na fila</small>' : '');
    }
  }


  // Dispara a consulta de estoque de todas as variantes em paralelo (sem fila
  // com atraso — é só um punhado de resultados de uma busca no modal). Cada
  // chamada tem uma "geração": se uma nova busca for feita antes da resposta
  // chegar, a resposta antiga é descartada em vez de atualizar a tela.
  var pickerStockGeneration = 0;

  function fetchPickerStock(cells) {
    var myGeneration = ++pickerStockGeneration;

    cells.forEach(function (cell) {
      var sku = cell.dataset.sku;

      if (Object.prototype.hasOwnProperty.call(stockCache, sku)) {
        renderPickerStock(cell, stockCache[sku]);
        return;
      }

      fetch(stockUrl + encodeURIComponent(sku))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          stockCache[sku] = { quantity: data.quantity, stock: data.stock, reserved: data.reserved, status: data.status };
          if (myGeneration !== pickerStockGeneration) return; // busca já foi trocada, ignora
          renderPickerStock(cell, stockCache[sku]);
        })
        .catch(function () {
          var cb = cell.closest('tr').querySelector('.picker-variant-cb');
          if (cb) cb.disabled = false;
          if (myGeneration !== pickerStockGeneration) return;
          cell.innerHTML = '<span class="text-danger">-</span>';
        });
    });
  }

  function updatePickerFooter() {
    var count = Object.keys(pickerSelected).length;
    document.getElementById('productPickerSelectedCount').textContent = count + ' variante' + (count === 1 ? '' : 's') + ' selecionada' + (count === 1 ? '' : 's');
    document.getElementById('productPickerAddButton').disabled = count === 0;
  }

  function renderPickerResults(products) {
    var box = document.getElementById('productPickerResults');
    box.innerHTML = '';

    if (products.length === 0) {
      box.innerHTML = '<div class="text-muted-custom text-center py-4">Nenhum produto encontrado.</div>';
      return;
    }

    var table = document.createElement('table');
    table.className = 'orders-table';
    table.innerHTML = '<thead><tr><th></th><th>Produto</th><th class="text-center">Disponível</th><th class="text-center">Preço</th></tr></thead>';
    var tbody = document.createElement('tbody');
    table.appendChild(tbody);

    products.forEach(function (product) {
      var variantSkus = product.variants.map(function (v) { return v.sku; });

      var productRow = document.createElement('tr');
      var productCb = document.createElement('input');
      productCb.type = 'checkbox';
      productCb.className = 'form-check-input';

      var productCbCell = document.createElement('td');
      productCbCell.appendChild(productCb);
      productRow.appendChild(productCbCell);

      var nameCell = document.createElement('td');
      nameCell.className = 'd-flex align-items-center gap-2';
      if (product.image_url) {
        nameCell.innerHTML = '<img src="' + product.image_url + '" class="rounded border border-secondary" style="width: 36px; height: 36px; object-fit: cover;" loading="lazy">';
      } else {
        nameCell.innerHTML = '<span class="rounded border border-secondary d-flex align-items-center justify-content-center text-muted-custom" style="width: 36px; height: 36px;"><i class="fas fa-image"></i></span>';
      }
      var nameSpan = document.createElement('span');
      nameSpan.textContent = product.name;
      nameSpan.className = 'fw-bold';
      nameCell.appendChild(nameSpan);
      productRow.appendChild(nameCell);
      productRow.appendChild(document.createElement('td'));
      productRow.appendChild(document.createElement('td'));
      tbody.appendChild(productRow);

      var variantCheckboxes = [];

      function setVariantSelected(cb, variant) {
        if (cb.checked) {
          pickerSelected[variant.sku] = {
            sku: variant.sku,
            name: product.name + ' - ' + variant.option,
            price: defaultPrice(variant, variant.price),
            image_url: product.image_url
          };
        } else {
          delete pickerSelected[variant.sku];
        }
      }

      product.variants.forEach(function (variant) {
        var row = document.createElement('tr');

        var cbCell = document.createElement('td');
        cbCell.style.paddingLeft = '2rem';
        var cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'form-check-input picker-variant-cb';
        cb.disabled = enforceStock;
        cb.addEventListener('change', function () {
          setVariantSelected(cb, variant);
          var enabled = variantCheckboxes.filter(function (c) { return !c.disabled; });
          productCb.checked = enabled.length > 0 && enabled.every(function (c) { return c.checked; });
          updatePickerFooter();
        });
        variantCheckboxes.push(cb);
        cbCell.appendChild(cb);
        row.appendChild(cbCell);

        var optionCell = document.createElement('td');
        optionCell.textContent = variant.option;
        optionCell.style.paddingLeft = '2rem';
        row.appendChild(optionCell);

        var stockCell = document.createElement('td');
        stockCell.className = 'text-center item-picker-stock-cell';
        stockCell.dataset.sku = variant.sku;
        stockCell.innerHTML = '<i class="fas fa-spinner fa-spin text-muted-custom"></i>';
        row.appendChild(stockCell);

        var priceCell = document.createElement('td');
        priceCell.className = 'text-center';
        priceCell.textContent = variant.price ? 'R$ ' + Number(variant.price).toFixed(2) : '-';
        row.appendChild(priceCell);

        tbody.appendChild(row);
      });

      productCb.addEventListener('change', function () {
        variantCheckboxes.forEach(function (cb, idx) {
          if (cb.disabled) return;
          cb.checked = productCb.checked;
          setVariantSelected(cb, product.variants[idx]);
        });
        updatePickerFooter();
      });
    });

    box.appendChild(table);
    fetchPickerStock(Array.prototype.slice.call(document.querySelectorAll('.item-picker-stock-cell')));
  }

  var pickerSearchTimeout;
  document.getElementById('productPickerSearchInput').addEventListener('input', function (e) {
    clearTimeout(pickerSearchTimeout);
    pickerStockGeneration++; // invalida qualquer resposta de estoque que ainda esteja a caminho
    var q = e.target.value.trim();
    var box = document.getElementById('productPickerResults');

    if (!q) { box.innerHTML = '<div class="text-muted-custom text-center py-4">Digite algo pra buscar produtos.</div>'; return; }

    box.innerHTML = '<div class="text-muted-custom text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Buscando...</div>';

    pickerSearchTimeout = setTimeout(function () {
      fetch('<%= product_picker_b2b_orders_path %>?query=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (data) { renderPickerResults(data.products || []); });
    }, 350);
  });

  document.getElementById('productPickerAddButton').addEventListener('click', function () {
    Object.values(pickerSelected).forEach(function (item) {
      addItemRow(item.sku, item.name, 1, item.price, item.image_url);
    });
    pickerSelected = {};
    updatePickerFooter();
    document.getElementById('productPickerSearchInput').value = '';
    document.getElementById('productPickerResults').innerHTML = '<div class="text-muted-custom text-center py-4">Digite algo pra buscar produtos.</div>';
    var modalEl = document.getElementById('productPickerModal');
    var modalInstance = bootstrap.Modal.getInstance(modalEl);
    if (modalInstance) modalInstance.hide();
  });
});
</script>
<% end %>
