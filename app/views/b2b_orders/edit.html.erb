<% copy = b2b_screen_copy(order_kind) %>
<% content_for :title, copy[:edit_title] %>
<div class="users-container">
  <div class="page-header">
    <div class="header-left has-icon">
      <%= hc_page_icon "fas fa-#{copy[:icon]}" %>
      <div>
        <%= hc_page_eyebrow %>
        <h1 class="page-title"><%= copy[:edit_title] %></h1>
        <p class="page-subtitle">#<%= @b2b_order.id %></p>
      </div>
    </div>
    <div class="header-actions">
      <%= hc_help_button %>
      <% if @b2b_order.tiny_order? && @b2b_order.tiny_reference_id.present? %>
        <%= button_to cancel_in_tiny_order_path_for(@b2b_order), method: :post, class: "btn-back",
                      form: { data: { turbo_confirm: "Cancelar o pedido nº #{@b2b_order.tiny_reference_number.presence || @b2b_order.tiny_reference_id} no Tiny e liberar este pedido para reenvio? O pedido continuará no Tiny com situação Cancelado (você pode excluí-lo por lá)." } } do %>
          <i class="fas fa-ban me-1"></i>Cancelar no Tiny
        <% end %>
      <% end %>
      <% if order_deletable?(@b2b_order) %>
        <%= button_to order_path_for(@b2b_order), method: :delete, class: "btn-back",
                      form: { data: { turbo_confirm: b2b_delete_confirm(@b2b_order) } } do %>
          <i class="fas fa-trash me-1"></i>Excluir
        <% end %>
      <% end %>
      <% unless @b2b_order.stock_transfer? %>
        <%= link_to romaneio_order_path_for(@b2b_order), class: "btn-back", data: { turbo: false } do %><i class="fas fa-file-pdf me-1"></i>Romaneio<% end %>
      <% end %>
      <% if current_user.can_access_screen?('fiscal_notes') && @b2b_order.sale? %>
        <%= link_to new_fiscal_note_path(b2b_order_id: @b2b_order.id), class: "btn-export" do %><i class="fas fa-file-invoice me-2"></i>Gerar nota fiscal<% end %>
      <% end %>
      <%= link_to orders_path_for, class: "btn-back" do %><i class="fas fa-arrow-left me-1"></i>Voltar<% end %>
    </div>
  </div>
  <% @tab = params[:tab] == 'nota' ? 'nota' : 'pedido' %>
  <% authorized_notes = FiscalNote.where(b2b_order_id: @b2b_order.id).autorizada.count %>
  <div class="scope-tabs it-tabs" role="tablist">
    <span class="scope-indicator"></span>
    <%= link_to url_for(tab: 'pedido'), class: "scope-tab#{' is-active' if @tab == 'pedido'}", role: 'tab', 'aria-selected': @tab == 'pedido', data: { it_tab: 'pedido' } do %><i class="fas fa-box-open"></i>Pedido<% end %>
    <%= link_to url_for(tab: 'nota'), class: "scope-tab#{' is-active' if @tab == 'nota'}", role: 'tab', 'aria-selected': @tab == 'nota', data: { it_tab: 'nota' } do %>
      <i class="fas fa-file-invoice"></i>Nota fiscal<% if authorized_notes.positive? %><span class="count"><%= authorized_notes %></span><% end %>
    <% end %>
  </div>

  <div data-it-panel="pedido" <%= 'hidden' unless @tab == 'pedido' %>>
    <%= render 'form' %>
  </div>
  <div data-it-panel="nota" <%= 'hidden' unless @tab == 'nota' %>>
    <%= render 'fiscal_tab' %>
  </div>
</div>

<% content_for :scripts do %>
<script>
// Abas Pedido / Nota fiscal: troca sem recarregar (o formulário não perde o que foi digitado) e guarda a aba na URL.
document.addEventListener('DOMContentLoaded', function () {
  var tabs = document.querySelector('.it-tabs');
  if (!tabs) return;
  var indicator = tabs.querySelector('.scope-indicator');
  function place(tab) { indicator.style.left = tab.offsetLeft + 'px'; indicator.style.width = tab.offsetWidth + 'px'; }
  var active = tabs.querySelector('.scope-tab.is-active');
  if (active) place(active);
  tabs.querySelectorAll('[data-it-tab]').forEach(function (tab) {
    tab.addEventListener('click', function (event) {
      event.preventDefault();
      var key = tab.dataset.itTab;
      tabs.querySelectorAll('[data-it-tab]').forEach(function (other) {
        var on = other === tab;
        other.classList.toggle('is-active', on);
        other.setAttribute('aria-selected', on);
      });
      document.querySelectorAll('[data-it-panel]').forEach(function (panel) { panel.hidden = panel.dataset.itPanel !== key; });
      place(tab);
      var url = new URL(window.location.href);
      url.searchParams.set('tab', key);
      window.history.replaceState(null, '', url);
    });
  });
});
</script>
<% end %>
