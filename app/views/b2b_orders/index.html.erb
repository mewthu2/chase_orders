<%# Pedidos de Atacado (venda), Abastecimento Lojas (stock_transfer) e Transferência B2B → B2C: a mesma lista, no padrão do protótipo. %>
<% kind = order_kind %>
<% sale = kind == 'sale' %>
<% supply = kind == 'stock_transfer' %>
<% statuses = {
     'aberto' => ['Aberto', 'gray', 'Salvo no Honey, esperando a aprovação em Log02 › Pedidos p/ Aprovar.'],
     'aprovado' => ['Aprovado', 'blue', 'Aprovado no Log02: entra no Correios na próxima rodada da criação.'],
     'preparando_envio' => ['Preparando envio', 'purple', 'Já está no Correios, aguardando a NF-e e o despacho.'],
     'faturado' => ['Faturado', 'yellow', 'NF-e emitida e XML enviado ao Correios; esperando o rastreio.'],
     'pronto_para_envio' => ['Pronto para envio', 'orange', 'Embalado, esperando a coleta.'],
     'enviado' => ['Enviado', 'green', 'Já saiu para entrega.'],
     'nao_entregue' => ['Não entregue', 'red', 'A transportadora não conseguiu entregar. Fale com o cliente.'],
     'dados_incompletos' => ['Dados incompletos', 'red', 'Pedido antigo que o Tiny não aceitou. Veja o motivo no histórico.'],
     'cancelado' => ['Cancelado', 'gray', 'Cancelado.']
   } %>
<% screen = { 'sale' => { title: 'Pedidos de Atacado', subtitle: 'Vendas para lojistas, do Honey até o Correios, sem o Tiny.', icon: 'fas fa-handshake', perm: :b2b_orders,
                          unit: %w[pedidos pedido], list: 'Lista de pedidos de atacado', list_icon: 'fas fa-file-invoice-dollar', new_label: 'Novo pedido',
                          meta: 'Vendas para lojistas, do mais novo para o mais antigo. Use as abas para ver uma situação de cada vez.',
                          empty: ['Nenhum pedido de atacado ainda', 'Cadastre a primeira venda para um lojista. Ela fica como Aberto até ser aprovada no Log02.'],
                          banner: ['Tudo pelo Honey', 'O pedido salvo reserva o estoque do Log02 e espera a aprovação em Log02 › Pedidos p/ Aprovar. Depois o Honey cria no Correios, emite a NF-e, manda o XML e acompanha o rastreio. Nada vai para o Tiny.'] },
              'stock_transfer' => { title: 'Abastecimento Lojas', subtitle: 'Reposição das lojas com o estoque do Log02.', icon: 'fas fa-dolly', perm: :store_supply,
                                    unit: %w[abastecimentos abastecimento], list: 'Lista de abastecimentos', list_icon: 'fas fa-dolly', new_label: 'Novo abastecimento',
                                    meta: 'Embaixo de cada loja aparece quem recebe a mercadoria. Com mão própria, só essa pessoa pode receber; com transportadora, aparece o nome dela.',
                                    empty: ['Nenhum abastecimento encontrado', 'Quando uma loja precisar de reposição, crie um abastecimento: os produtos saem do estoque do Log02.'],
                                    banner: ['O estoque sai do Log02', 'Os produtos saem do estoque do Log02 (antes Correios B2B) e seguem por SEDEX mão própria ou pela transportadora escolhida. Depois de aprovado no Log02, o Honey cria no Correios e emite a NF-e de transferência; nada vai para o Tiny.'] },
              'b2c_transfer' => { title: 'Transferência B2B → B2C', subtitle: 'Peças do estoque de atacado para a filial da loja online.', icon: 'fas fa-random', perm: :b2b_transfers,
                                  unit: %w[transferências transferência], list: 'Lista de transferências', list_icon: 'fas fa-random', new_label: 'Nova transferência',
                                  meta: 'Cada transferência leva peças do estoque de atacado para a filial B2C, com nota e marcador de transferência.',
                                  empty: ['Nenhuma transferência encontrada', 'Quando a loja online precisar de peças do estoque de atacado, crie uma transferência para a filial B2C.'],
                                  banner: ['Destino fixo: filial B2C', "Toda transferência vai para a filial da loja online (CNPJ #{B2bTinyService::B2C_TRANSFER_RECIPIENT[:cpf_cnpj]}). Depois de aprovada no Log02, o Honey cria no Correios e emite a NF-e de transferência; nada vai para o Tiny."] } }[kind] %>
<% content_for :title, screen[:title] %>
<% perm = screen[:perm] %>
<% map = ->(order) {
     items = order.b2b_order_items
     { id: order.id, record: order, n: order.id, dia: order.created_at.to_date, dt: order.created_at, cliente: b2b_order_destination(order).presence || '—',
       cidade: [order.client&.city, order.client&.state].compact.join(' / ').presence, cnpj: order.client&.cnpj_formatted.presence || '—', total: order.total,
       tiny: [order.tiny_reference_number.presence || order.tiny_reference_id.presence, (tiny_order_url(order) if order.tiny_reference_id.present?), 'Ver no Tiny'], track: order.tracking_code.presence || '—', st: order.status,
       pecas: items.sum { |i| i.quantity.to_i }, vend: order.salesperson_name.presence || '—', serv: (order.sale? ? order.shipping_label : order.freight_service).presence || '—',
       transp: order.carrier&.name.presence || order.carrier_name.presence || '—',
       entrega: order.stock_transfer? ? (order.hand_delivery? ? 'SEDEX · Mão Própria' : "Transportadora · #{order.carrier&.name}") : nil, fretepg: { 'shipper' => 'Remetente', 'recipient' => 'Destinatário' }[order.freight_paid_by] || '—',
       fretev: order.freight_value ? number_to_currency(order.freight_value, unit: 'R$ ', separator: ',', delimiter: '.') : '—', obs: order.notes.presence || '—',
       erro: order.error_message, loc: [[order.transfer_location&.name, order.transfer_location_id]].reject { |n, _| n.blank? }, receb: order.receiver_name.presence || '—',
       por: order.user&.name, dest: b2b_order_destination(order), log: order.honey_flow? ? B2bOrder::LOG_STAGES.dig(order.log_stage, 0) : 'No Tiny (antigo)', pag: order.payment_description || '—',
       desc: order.discount_amount.positive? ? number_to_currency(order.discount_amount, unit: 'R$ ', separator: ',', delimiter: '.') : '—' }
   } %>
<% search = ->(scope, text) {
     q = "%#{ActiveRecord::Base.sanitize_sql_like(text.to_s.strip.delete_prefix('#'))}%"
     scope.left_joins(:client, :transfer_location)
          .where('clients.responsible_name LIKE :q OR clients.business_name LIKE :q OR b2b_orders.tiny_reference_number LIKE :q OR b2b_orders.tracking_code LIKE :q ' \
                 'OR b2b_orders.receiver_name LIKE :q OR transfer_locations.name LIKE :q OR b2b_orders.id = :id', q: q, id: text.to_s.delete('#').to_i)
   } %>
<% common = { scope: @scope, map: map, search: search, attrs: { st: :status, dt: :created_at, loc: :transfer_location_id },
              sort_sql: { n: 'b2b_orders.id', dt: 'b2b_orders.created_at' }, page_size: 8, unit: screen[:unit][0], unit1: screen[:unit][1], sort: { k: :n, dir: -1 } } %>
<% table = if sale
     HoneyQueryTable.new(params, **common,
       tabs: { col: :st, param: :status, items: [['', 'Todos']] + statuses.map { |k, v| [k, v[0]] } },
       cols: [
         { k: :n, label: 'Nº', t: :num, main: true, sort: true, sub: :dia },
         { k: :dia, label: 'Data', t: :d, hide: true, nodetail: true },
         { k: :dt, label: 'Data', t: :dt, hide: true },
         { k: :cliente, label: 'Cliente', sub: :cidade },
         { k: :cidade, label: 'Cidade / UF', hide: true, nodetail: true },
         { k: :cnpj, label: 'CNPJ/CPF', t: :mono, cls: 'due' },
         { k: :total, label: 'Total', t: :money },
         { k: :tiny, label: 'Nº pedido', t: :link, sub: :track },
         { k: :track, label: 'Rastreamento', t: :mono, hide: true },
         { k: :st, label: 'Status', t: :status, map: statuses },
         { k: :log, label: 'Etapa no Log02', t: :tag },
         { k: :pecas, label: 'Peças', t: :qty, hide: true },
         { k: :vend, label: 'Vendedor(a)', hide: true },
         { k: :serv, label: 'Serviço de frete', hide: true },
         { k: :transp, label: 'Transportadora', hide: true },
         { k: :fretepg, label: 'Frete por conta de', hide: true },
         { k: :fretev, label: 'Valor do frete (R$)', hide: true },
         { k: :pag, label: 'Forma de pagamento', hide: true },
         { k: :desc, label: 'Desconto do pedido', hide: true },
         { k: :obs, label: 'Observações', hide: true }
       ],
       filters: [{ id: :q, type: :search, label: 'Buscar pedido', ph: 'Pesquise por cliente ou número...', tip: 'Procura pelo nome do cliente, pelo número do pedido no Honey ou pelo número do pedido no Tiny. Pode digitar só um pedaço.' }],
       kpis: [
         { label: 'Abertos', icon: 'fas fa-pen-to-square', tone: 'yellow', help: 'Salvos só no Honey. Falta enviar ao Tiny.', col: :st, vals: ['aberto'] },
         { label: 'Em andamento', icon: 'fas fa-box-open', tone: 'blue', help: 'Já no Tiny, a caminho da expedição.', col: :st, vals: %w[aprovado preparando_envio faturado pronto_para_envio] },
         { label: 'Enviados', icon: 'fas fa-truck-fast', tone: 'green', help: 'Já saíram para entrega.', col: :st, vals: ['enviado'] },
         { label: 'Com problema', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'Dados incompletos ou não entregues.', col: :st, vals: %w[nao_entregue dados_incompletos] }
       ])
   elsif supply
     HoneyQueryTable.new(params, **common,
       cols: [
         { k: :n, label: 'Nº', t: :num, main: true, sort: true },
         { k: :dt, label: 'Data', t: :dt, sort: true },
         { k: :loc, label: 'Destino', t: :loc, sub: :receb },
         { k: :pecas, label: 'Peças', t: :qty, unit: 'un' },
         { k: :total, label: 'Total', t: :money },
         { k: :tiny, label: 'Nº Tiny', t: :link },
         { k: :st, label: 'Status', t: :status, map: statuses },
         { k: :log, label: 'Etapa no Log02', t: :tag },
         { k: :entrega, label: 'Entrega', t: :tag },
         { k: :receb, label: 'Quem recebe na loja', hide: true },
         { k: :track, label: 'Rastreamento', t: :mono, hide: true },
         { k: :por, label: 'Criado por', hide: true },
         { k: :obs, label: 'Observações', hide: true }
       ],
       filters: [
         { id: :q, type: :search, label: 'Buscar', ph: 'Nº, nota, loja ou quem recebe', tip: 'Procura pelo número do pedido, pelo número do Tiny, pela loja de destino ou pelo nome de quem recebe.' },
         { id: :loja, type: :select, label: 'Loja de destino', col: :loc, options: @filter_locations.map { |l| [l.id.to_s, l.name] }, all: 'Todas as lojas' },
         { id: :st, type: :select, label: 'Status', col: :st, all: 'Todos os status', tip: 'Em que ponto está o abastecimento, do Tiny até a chegada na loja.' },
         { id: :per, type: :period, label: 'Período', col: :dt }
       ],
       kpis: [
         { label: 'Preparando envio', icon: 'fas fa-box-open', tone: 'purple', help: 'Já no Tiny, sendo separados no Log02.', col: :st, val: 'preparando_envio' },
         { label: 'Prontos para coleta', icon: 'fas fa-dolly', tone: 'orange', help: 'Com nota emitida, esperando os Correios.', col: :st, vals: %w[faturado pronto_para_envio] },
         { label: 'Enviados', icon: 'fas fa-truck-fast', tone: 'green', help: 'Já saíram para as lojas.', col: :st, val: 'enviado' },
         { label: 'Com problema', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'Pedem uma ação sua. Abra para ver o motivo.', col: :st, vals: %w[dados_incompletos nao_entregue] }
       ])
   else
     HoneyQueryTable.new(params, **common,
       cols: [
         { k: :n, label: 'Nº', t: :num, main: true, sort: true },
         { k: :dt, label: 'Data', t: :dt, sort: true },
         { k: :pecas, label: 'Peças', t: :qty, unit: 'un' },
         { k: :total, label: 'Total', t: :money },
         { k: :tiny, label: 'Nº Tiny', t: :link },
         { k: :st, label: 'Status', t: :status, map: statuses },
         { k: :log, label: 'Etapa no Log02', t: :tag },
         { k: :por, label: 'Criado por', t: :person },
         { k: :dest, label: 'Destino', hide: true },
         { k: :obs, label: 'Observações', hide: true }
       ],
       filters: [
         { id: :q, type: :search, label: 'Buscar', ph: 'Nº, nº Tiny ou nota', tip: 'Procura pelo número da transferência ou pelo número do Tiny.' },
         { id: :st, type: :select, label: 'Status', col: :st, all: 'Todos os status', tip: 'Em que ponto está a transferência, do Tiny até a chegada na filial B2C.' },
         { id: :per, type: :period, label: 'Período', col: :dt }
       ],
       kpis: [
         { label: 'Em preparo', icon: 'fas fa-box-open', tone: 'purple', help: 'No Tiny, com nota, saindo do galpão.', col: :st, vals: %w[preparando_envio faturado pronto_para_envio] },
         { label: 'Enviadas', icon: 'fas fa-truck-fast', tone: 'green', help: 'Já chegaram à filial B2C.', col: :st, val: 'enviado' },
         { label: 'Para reenviar ao Tiny', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'Deram erro ou foram canceladas no Tiny.', col: :st, vals: %w[dados_incompletos aberto] }
       ])
   end %>
<% items_section = ->(r) {
     items = r[:record].b2b_order_items
     next nil if items.empty?

     rows_html = safe_join(items.map do |i|
       content_tag(:tr, content_tag(:td, i.sku, data: { label: 'SKU' }) + content_tag(:td, i.name.presence || '—', data: { label: 'Produto' }) +
                        content_tag(:td, i.quantity, data: { label: 'Qtde' }) + content_tag(:td, number_to_currency(i.line_total, unit: 'R$ ', separator: ',', delimiter: '.'), data: { label: 'Subtotal' }))
     end)
     content_tag(:section, content_tag(:h4, content_tag(:i, '', class: 'fas fa-box') + 'Itens do pedido') +
       content_tag(:div, content_tag(:table, content_tag(:thead, content_tag(:tr, safe_join(%w[SKU Produto Qtde Subtotal].map { |h| content_tag(:th, h) }))) + content_tag(:tbody, rows_html), class: 'orders-table pg-tbl pg-mini'), class: 'table-responsive'), class: 'help-sec')
   } %>

<%= hc_page_header screen[:title], screen[:subtitle], icon: screen[:icon] do %>
  <% if screen_can?(perm, :create) %>
    <%= link_to new_order_path_for, class: 'btn btn-export' do %><i class="fas fa-plus"></i><%= screen[:new_label] %><% end %>
  <% end %>
  <% if sale && screen_can?(:b2b_orders, :edit) %>
    <%= link_to edit_b2b_setting_path, class: 'btn btn-secondary' do %><i class="fas fa-sliders-h"></i>Configuração do atacado<% end %>
  <% end %>
  <% if sale && screen_can?(:clients, :create) %>
    <%= link_to new_client_path, class: 'btn btn-secondary' do %><i class="fas fa-address-book"></i>Cadastrar novo cliente<% end %>
  <% end %>
<% end %>

<div class="callout pg-banner is-info"><i class="fas fa-circle-info"></i><div><strong><%= screen[:banner][0] %>.</strong> <%= screen[:banner][1] %></div></div>

<div class="pg-blocks">
  <%= hc_pg_kpis(table) %>
  <%= hc_pg_table(table, title: screen[:list], icon: screen[:list_icon], meta: screen[:meta],
        empty: { title: screen[:empty][0], text: screen[:empty][1],
                 cta: (link_to(safe_join([content_tag(:i, '', class: 'fas fa-plus'), screen[:new_label]]), new_order_path_for, class: 'btn btn-export') if screen_can?(perm, :create)) },
        detail: { title: ->(r) { "#{sale ? 'Pedido' : (supply ? 'Abastecimento' : 'Transferência')} ##{r[:n]}" },
                  note: (sale ? 'Valores e peças são os do Honey. Depois que o pedido vai para o Tiny, o Honey só acompanha a situação.'
                              : supply ? 'Sai do estoque do Log02. Por SEDEX mão própria, só quem está em "Quem recebe na loja" consegue retirar na entrega; por transportadora, vai pela que está em "Entrega".'
                                       : 'Não usa SEDEX mão própria: o pedido segue como transportadora, dentro do galpão do Log.'),
                  extra: ->(r) { safe_join([(content_tag(:div, content_tag(:i, '', class: 'fas fa-triangle-exclamation') + content_tag(:span, "Mensagem do Tiny: #{r[:erro]}"), class: 'pg-fnote is-warn') if r[:erro].present?), items_section.call(r)].compact) } },
        actions: ->(r) {
          order = r[:record]
          safe_join([
            (hc_row_action('fas fa-pencil-alt', sale ? 'Editar' : 'Corrigir itens', edit_order_path_for(order)) if screen_can?(perm, :edit)),
            (hc_row_action('fas fa-file-pdf', sale ? 'Romaneio' : 'Baixar romaneio (PDF)', romaneio_order_path_for(order)) unless order.stock_transfer?),
            (hc_row_action('fas fa-file-invoice', 'Nota fiscal', edit_order_path_for(order, tab: 'nota')) if screen_can?(perm, :edit)),
            (hc_row_action('fas fa-ban', 'Cancelar no Tiny', cancel_in_tiny_order_path_for(order), danger: true, method: :post,
                           confirm: { title: "Cancelar o pedido ##{order.id} no Tiny?", text: "O pedido fica liberado para reenvio e volta para Aberto. O pedido continua no Tiny com situação Cancelado (você pode excluí-lo por lá).", ok: 'Cancelar no Tiny' }) if order.tiny_order? && order.tiny_reference_id.present? && screen_can?(perm, :execute)),
            (if order_deletable?(order)
               (hc_row_action('fas fa-trash', 'Excluir', order_path_for(order), danger: true, method: :delete, confirm: { title: "Excluir o pedido ##{order.id}?", text: b2b_delete_confirm(order).sub(/\AExcluir o pedido #\d+\? /, ''), ok: 'Excluir pedido' }) if screen_can?(perm, :destroy))
             elsif @order_ids_with_active_note.include?(order.id)
               content_tag(:span, content_tag(:i, '', class: 'fas fa-lock'), class: 'action-btn', data: { tip: 'Tem nota fiscal: não dá para excluir' }, 'aria-label': 'Tem nota fiscal')
             end)
          ].compact)
        }) %>
</div>
