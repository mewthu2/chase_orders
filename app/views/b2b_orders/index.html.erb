<% copy = b2b_screen_copy(order_kind) %>
<% transfers = order_kind != 'sale' %>
<% show_status = order_kind != 'b2c_transfer' %>
<% content_for :title, copy[:title] %>

<div class="users-container">
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title"><i class="fas fa-<%= copy[:icon] %> me-2"></i><%= copy[:title] %></h1>
      <p class="page-subtitle"><%= copy[:subtitle] %></p>
    </div>
    <div class="header-actions">
      <span class="total-badge"><i class="fas fa-list me-1"></i><%= @b2b_orders.size %> pedido(s)</span>
      <%= link_to new_order_path_for, class: "btn-export" do %><i class="fas fa-plus me-2"></i><%= copy[:new_button] %><% end %>
    </div>
  </div>

  <% if order_kind == 'stock_transfer' %>
  <div class="form-hint-box mx-3 mt-3">
    <i class="fas fa-info-circle"></i>
    <div>
      <strong>Atenção:</strong> o estoque utilizado no abastecimento das lojas sai do Correios B2B.
    </div>
  </div>
  <% end %>

  <div class="table-card">
    <div class="table-card-header"><h5 class="table-card-title"><i class="fas fa-list me-2"></i><%= copy[:list_title] %></h5></div>

    <% unless transfers %>
    <%= form_with url: orders_path_for, method: :get, local: true, class: "d-flex gap-2 flex-wrap px-3 pb-3" do %>
      <input type="text" name="q" value="<%= params[:q] %>" class="field-input" placeholder="Pesquise por cliente ou número..." style="max-width: 320px;">
      <input type="hidden" name="status" value="<%= params[:status] %>">
      <button type="submit" class="btn-back"><i class="fas fa-search me-1"></i>Buscar</button>
    <% end %>

    <div class="status-tabs px-3 pb-3" id="statusTabsRow">
      <%= link_to b2b_orders_path(q: params[:q]), class: "status-tab #{'status-tab--active' if params[:status].blank?}", data: { status_key: '' } do %>
        Todos <span class="status-tab-count"><%= @status_counts.values.sum %></span>
      <% end %>
      <% B2bOrder::STATUS_LABELS.each_key do |status_key| %>
        <%= link_to b2b_orders_path(q: params[:q], status: status_key), class: "status-tab #{'status-tab--active' if params[:status] == status_key}", data: { status_key: status_key } do %>
          <%= B2bOrder::STATUS_LABELS[status_key] %> <span class="status-tab-count"><%= @status_counts[status_key] || 0 %></span>
        <% end %>
      <% end %>
      <div class="status-tab-more-wrapper" id="statusTabMoreWrapper" style="display: none;">
        <button type="button" class="status-tab status-tab--more" id="moreStatusesToggle">mais <i class="fas fa-caret-down ms-1"></i></button>
        <div class="status-tab-dropdown" id="statusTabDropdown"></div>
      </div>
    </div>

    <% end %>

    <% if @b2b_orders.any? %>
      <div class="table-responsive">
        <table class="orders-table">
          <thead>
            <% if transfers %>
            <tr>
              <th>Nº</th>
              <th>Data</th>
              <th>Destino</th>
              <th class="text-end">Total</th>
              <th>Nº Tiny</th>
              <% if show_status %><th class="text-center">Status</th><% end %>
              <th class="text-end">Ações</th>
            </tr>
            <% else %>
            <tr>
              <th>Nº</th>
              <th>Data</th>
              <th>Cliente</th>
              <th>CNPJ/CPF</th>
              <th class="text-end">Total</th>
              <th>Nº pedido</th>
              <th>Rastreamento</th>
              <th class="text-center">Status</th>
              <th class="text-end">Ações</th>
            </tr>
            <% end %>
          </thead>
          <tbody>
            <% @b2b_orders.each do |order| %>
              <tr>
                <td class="text-main">#<%= order.id %></td>
                <td class="text-muted-custom"><%= order.created_at.strftime('%d/%m/%Y') %></td>
                <td class="text-muted-custom"><%= b2b_order_destination(order) %></td>
                <% unless transfers %><td class="text-muted-custom"><%= order.client&.cnpj_formatted %></td><% end %>
                <td class="text-end"><%= number_to_currency(order.total, unit: 'R$', separator: ',', delimiter: '.', format: '%u %n') %></td>
                <td class="text-muted-custom">
                  <%= order.tiny_reference_number.presence || '-' %>
                  <% if order.tiny_reference_id.present? %>
                    <%= link_to tiny_order_url(order), target: '_blank', title: 'Ver no Tiny', class: 'ms-1' do %><i class="fas fa-external-link-alt"></i><% end %>
                  <% end %>
                </td>
                <% unless transfers %><td class="text-muted-custom"><%= order.tracking_code.presence || '-' %></td><% end %>
                <% if show_status %>
                <td class="text-center">
                  <span class="status-pill status-pill--<%= order.status %>"><%= B2bOrder::STATUS_LABELS[order.status] %></span>
                </td>
                <% end %>
                <td class="text-end">
                  <div class="table-actions">
                    <%= link_to edit_order_path_for(order), class: "action-btn action-btn--edit" do %><i class="fas fa-pencil-alt"></i><% end %>
                    <% unless order.stock_transfer? %>
                      <%= link_to romaneio_order_path_for(order), class: "action-btn action-btn--edit", title: 'Baixar romaneio (PDF)', data: { turbo: false } do %><i class="fas fa-file-pdf"></i><% end %>
                    <% end %>
                    <% if order.stock_transfer? && order.tiny_order? && order.tiny_reference_id.present? %>
                      <%= link_to danfe_stock_transfer_path(order), class: "action-btn action-btn--edit", title: 'Baixar DANFE (PDF)', data: { turbo: false } do %><i class="fas fa-file-invoice"></i><% end %>
                      <button type="button" class="action-btn action-btn--edit" title="Enviar nota por e-mail" data-bs-toggle="modal" data-bs-target="#sendDanfeModal"
                              data-send-url="<%= send_danfe_stock_transfer_path(order) %>" data-order-label="<%= "Abastecimento ##{order.id}#{" · #{order.transfer_location.name}" if order.transfer_location}" %>">
                        <i class="fas fa-envelope"></i>
                      </button>
                    <% end %>
                    <% if current_user.can_access_screen?('fiscal_notes') && order.sale? %>
                      <%= link_to new_fiscal_note_path(b2b_order_id: order.id), class: "action-btn action-btn--edit", title: 'Gerar nota fiscal' do %><i class="fas fa-file-invoice"></i><% end %>
                    <% end %>
                    <% if order.tiny_order? && order.tiny_reference_id.present? %>
                      <%= button_to cancel_in_tiny_order_path_for(order), method: :post, class: "action-btn action-btn--danger", title: 'Cancelar no Tiny e liberar reenvio',
                                    form: { data: { turbo_confirm: "Cancelar o pedido nº #{order.tiny_reference_number.presence || order.tiny_reference_id} no Tiny e liberar este pedido para reenvio? O pedido continuará no Tiny com situação Cancelado (você pode excluí-lo por lá)." } } do %>
                        <i class="fas fa-ban"></i>
                      <% end %>
                    <% end %>
                    <% if order_deletable?(order) %>
                      <%= button_to order_path_for(order), method: :delete, class: "action-btn action-btn--danger", title: 'Excluir pedido',
                                    form: { data: { turbo_confirm: b2b_delete_confirm(order) } } do %>
                        <i class="fas fa-trash"></i>
                      <% end %>
                    <% end %>
                    <% if order.resendable? %>
                      <%= button_to transmit_order_path_for(order), method: :post, class: "action-btn action-btn--edit", title: 'Enviar ao Tiny', form: { data: { turbo_confirm: 'Enviar este pedido para o Tiny? Ele entra como Preparando Envio.' } } do %>
                        <i class="fas fa-paper-plane"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fas fa-handshake fa-3x mb-3 d-block"></i>
        <h5><%= copy[:empty] %></h5>
        <%= link_to new_order_path_for, class: "btn-export" do %><i class="fas fa-plus me-1"></i><%= copy[:new_button] %><% end %>
      </div>
    <% end %>
  </div>
</div>

<% if order_kind == 'stock_transfer' %>
<div class="modal fade" id="sendDanfeModal" tabindex="-1" aria-labelledby="sendDanfeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-white">
      <%= form_with url: '#', method: :post, local: true, id: 'sendDanfeForm', data: { turbo: false } do %>
        <div class="modal-header">
          <h5 class="modal-title" id="sendDanfeModalLabel"><i class="fas fa-envelope me-2"></i>Enviar nota por e-mail</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted-custom mb-3" id="sendDanfeOrderLabel"></p>
          <label for="sendDanfeEmails" class="field-label">Para qual e-mail?</label>
          <input type="text" name="emails" id="sendDanfeEmails" class="form-control" required autocomplete="email" placeholder="loja@exemplo.com, gerente@exemplo.com">
          <small class="text-muted-custom d-block mt-2">Vários e-mails podem ser separados por vírgula. O DANFE vai em PDF, em anexo.</small>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn-export"><i class="fas fa-paper-plane me-2"></i>Enviar nota</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% content_for :scripts do %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var modal = document.getElementById('sendDanfeModal');
  var form = document.getElementById('sendDanfeForm');
  var input = document.getElementById('sendDanfeEmails');
  var key = 'stockTransfers.lastDanfeEmails';

  modal.addEventListener('show.bs.modal', function (event) {
    var button = event.relatedTarget;
    form.action = button.getAttribute('data-send-url');
    document.getElementById('sendDanfeOrderLabel').textContent = button.getAttribute('data-order-label');
    try { input.value = localStorage.getItem(key) || ''; } catch (e) { input.value = ''; }
  });
  modal.addEventListener('shown.bs.modal', function () { input.focus(); });
  form.addEventListener('submit', function () {
    try { localStorage.setItem(key, input.value); } catch (e) {}
  });
});
</script>
<% end %>
<% end %>

<% unless transfers %>
<% content_for :scripts do %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var row = document.getElementById('statusTabsRow');
  var moreWrapper = document.getElementById('statusTabMoreWrapper');
  var moreToggle = document.getElementById('moreStatusesToggle');
  var moreDropdown = document.getElementById('statusTabDropdown');
  var tabs = Array.prototype.slice.call(row.querySelectorAll('.status-tab[data-status-key]'));

  function recalcStatusTabs() {
    moreDropdown.classList.remove('status-tab-dropdown--open');
    tabs.forEach(function (tab) { row.insertBefore(tab, moreWrapper); });
    moreDropdown.innerHTML = '';
    moreWrapper.style.display = 'none';

    var rowWidth = row.clientWidth;
    var totalWidth = tabs.reduce(function (sum, tab) { return sum + tab.offsetWidth + 8; }, 0);
    if (totalWidth <= rowWidth) return;

    moreWrapper.style.display = '';
    var budget = rowWidth - moreWrapper.offsetWidth - 8;
    var usedWidth = 0;

    tabs.forEach(function (tab) {
      var tabWidth = tab.offsetWidth + 8;
      if (usedWidth + tabWidth <= budget) {
        usedWidth += tabWidth;
      } else {
        moreDropdown.appendChild(tab);
      }
    });
  }

  function debounce(fn, wait) {
    var timeout;
    return function () {
      clearTimeout(timeout);
      timeout = setTimeout(fn, wait);
    };
  }

  moreToggle.addEventListener('click', function (e) {
    e.stopPropagation();
    moreDropdown.classList.toggle('status-tab-dropdown--open');
  });
  document.addEventListener('click', function (e) {
    if (!moreWrapper.contains(e.target)) moreDropdown.classList.remove('status-tab-dropdown--open');
  });

  window.addEventListener('resize', debounce(recalcStatusTabs, 150));
  recalcStatusTabs();
});
</script>
<% end %>
<% end %>
