<%# Pedidos de Atacado (venda), Abastecimento Lojas (stock_transfer) e Transferências B2B ⇄ B2C: a mesma lista, no padrão do protótipo. %>
<% kind = order_kind %>
<% sale = kind == 'sale' %>
<% supply = kind == 'stock_transfer' %>
<% statuses = {
     'aberto' => ['Aberto', 'gray', 'Salvo no Honey, esperando a aprovação em Log02 › Pedidos p/ Aprovar.'],
     'aprovado' => ['Aprovado', 'blue', 'Aprovado no Log02: entra no Correios na próxima rodada da criação.'],
     'preparando_envio' => ['Preparando envio', 'purple', 'Já está no Correios, aguardando a NF-e e o despacho.'],
     'faturado' => ['Faturado', 'yellow', 'NF-e emitida e XML enviado ao Correios; esperando o rastreio.'],
     'pronto_para_envio' => ['Pronto para envio', 'orange', 'Embalado, esperando a coleta.'],
     'enviado' => ['Enviado', 'green', 'Já saiu para entrega.'],
     'nao_entregue' => ['Não entregue', 'red', 'A transportadora não conseguiu entregar. Fale com o cliente.'],
     'dados_incompletos' => ['Dados incompletos', 'red', 'Pedido com dados faltando. Veja o motivo no histórico.'],
     'cancelado' => ['Cancelado', 'gray', 'Cancelado.']
   } %>
<% if kind == 'b2c_transfer'
     statuses['aberto'] = ['Aberto', 'gray', 'B2B → B2C: esperando a aprovação em Log02 › Pedidos p/ Aprovar. B2C → B2B: esperando as duas notas.']
     statuses['faturado'] = ['Faturado', 'yellow', 'B2B → B2C: XML enviado ao Correios, esperando o rastreio. B2C → B2B: as duas notas de produção autorizadas.']
     statuses['enviado'] = ['Concluída', 'green', 'B2B → B2C: saiu para a filial B2C ou foi concluída à mão pelo Concluir da lista.']
   end %>
<% screen = { 'sale' => { title: 'Pedidos de Atacado', subtitle: 'Vendas para lojistas, do Honey até o Correios.', icon: 'fas fa-handshake', perm: :b2b_orders,
                          unit: %w[pedidos pedido], list: 'Lista de pedidos de atacado', list_icon: 'fas fa-file-invoice-dollar', new_label: 'Novo pedido',
                          meta: 'Vendas para lojistas, do mais novo para o mais antigo. Use as abas para ver uma situação de cada vez.',
                          empty: ['Nenhum pedido de atacado ainda', 'Cadastre a primeira venda para um lojista. Ela fica como Aberto até ser aprovada no Log02.'],
                          banner: ['Tudo pelo Honey', 'O pedido salvo reserva o estoque do Log02 e espera a aprovação em Log02 › Pedidos p/ Aprovar. Depois o Honey cria no Correios, emite a NF-e, manda o XML e acompanha o rastreio.'] },
              'stock_transfer' => { title: 'Abastecimento Lojas', subtitle: 'Reposição das lojas com o estoque do Log02.', icon: 'fas fa-dolly', perm: :store_supply,
                                    unit: %w[abastecimentos abastecimento], list: 'Lista de abastecimentos', list_icon: 'fas fa-dolly', new_label: 'Novo abastecimento',
                                    meta: 'Embaixo de cada loja aparece quem recebe a mercadoria. Com mão própria, só essa pessoa pode receber; por SEDEX normal, qualquer pessoa no endereço; com transportadora, aparece o nome dela.',
                                    empty: ['Nenhum abastecimento encontrado', 'Quando uma loja precisar de reposição, crie um abastecimento: os produtos saem do estoque do Log02.'],
                                    banner: ['O estoque sai do Log02', 'Os produtos saem do estoque do Log02 (antes Correios B2B) e seguem por SEDEX mão própria, SEDEX normal ou pela transportadora escolhida. Depois de aprovado no Log02, o Honey cria no Correios e emite a NF-e de transferência.'] },
              'b2c_transfer' => { title: 'Transferências B2B ⇄ B2C', subtitle: 'Peças entre o estoque de atacado e a filial da loja online, nos dois sentidos.', icon: 'fas fa-random', perm: :b2b_transfers,
                                  unit: %w[transferências transferência], list: 'Lista de transferências', list_icon: 'fas fa-random', new_label: 'Nova B2B → B2C',
                                  meta: 'Cada transferência mostra o sentido: B2B → B2C segue pelo Log02; B2C → B2B só gera as notas.',
                                  empty: ['Nenhuma transferência encontrada', 'Crie uma transferência quando precisar mover peças entre o estoque de atacado e a filial B2C.'],
                                  banner: ['Dois sentidos', "B2B → B2C vai para a filial da loja online (CNPJ #{B2bTinyService::B2C_TRANSFER_RECIPIENT[:cpf_cnpj]}): depois de aprovada no Log02, o Honey cria no Correios e emite a NF-e. B2C → B2B não vai ao Correios: reserva o estoque B2C até a nota de transferência e a de remessa saírem."] } }[kind] %>
<% content_for :title, screen[:title] %>
<% perm = screen[:perm] %>
<%# Pedidos de venda e Transferência B2C: ao lado do número, P abre o pedido e N abre a nota (cor pela situação da nota). %>
<%# O número de cada nota fica dentro do quadrado do N; na Transferência B2B ⇄ B2C, o N.r é a nota de remessa. %>
<% pn_cell = ->(order) { b2b_pn_cell(order, @latest_notes&.dig(order.id), remessa: @latest_remessas&.dig(order.id)) } %>
<% map = ->(order) {
     items = order.b2b_order_items
     { id: order.id, record: order, n: order.id, dia: order.created_at.to_date, dt: order.created_at, cliente: b2b_order_destination(order).presence || '—',
       cidade: [order.client&.city, order.client&.state].compact.join(' / ').presence, cnpj: order.client&.cnpj_formatted.presence || '—', total: order.total,
       total_frete: order.grand_total, frete_sub: (order.freight_value.to_d.positive? ? "com #{number_to_currency(order.freight_value, unit: 'R$', separator: ',', delimiter: '.')} de frete" : 'sem frete'),
       track: order.tracking_code.presence || (order.honey_flow? && order.log_stage == 'carrier' ? 'Transportadora' : '—'), st: order.status,
       pecas: items.sum { |i| i.quantity.to_i }, vend: order.consultant_label ? safe_join([order.consultant_label, (hc_status('cadastro pendente', 'yellow', tip: 'Nome digitado sem cadastro: o financeiro cadastra ou vincula em Financeiro › Consultores.') if order.consultant_pending?)].compact, ' ') : '—', serv: (order.sale? ? order.shipping_label : order.freight_service).presence || '—',
       transp: order.carrier&.name.presence || order.carrier_name.presence || '—',
       entrega: order.stock_transfer? ? order.stock_delivery_label : nil, fretepg: { 'shipper' => 'Remetente', 'recipient' => 'Destinatário' }[order.freight_paid_by] || '—',
       fretev: order.freight_value ? number_to_currency(order.freight_value, unit: 'R$ ', separator: ',', delimiter: '.') : '—', obs: order.notes.presence || '—',
       erro: order.error_message, loc: [[order.transfer_location&.name, order.transfer_location_id]].reject { |n, _| n.blank? }, receb: order.receiver_name.presence || '—',
       por: order.user&.name, dest: b2b_order_destination(order), log: B2bOrder::LOG_STAGES.dig(order.log_stage, 0), pag: order.payment_description || '—',
       desc: order.discount_amount.positive? ? number_to_currency(order.discount_amount, unit: 'R$ ', separator: ',', delimiter: '.') : '—',
       sentido: (B2bOrder::DIRECTION_LABELS[order.transfer_direction] if order.b2c_transfer?),
       pn: (pn_cell.call(order) if order.sale? || order.b2c_transfer?) }
   } %>
<% search = ->(scope, text) {
     q = "%#{ActiveRecord::Base.sanitize_sql_like(text.to_s.strip.delete_prefix('#'))}%"
     scope.left_joins(:client, :transfer_location)
          .where('clients.responsible_name LIKE :q OR clients.business_name LIKE :q OR b2b_orders.salesperson_name LIKE :q OR b2b_orders.tracking_code LIKE :q ' \
                 'OR b2b_orders.receiver_name LIKE :q OR transfer_locations.name LIKE :q OR b2b_orders.id = :id', q: q, id: text.to_s.delete('#').to_i)
   } %>
<% common = { scope: @scope, map: map, search: search, attrs: { st: :status, dt: :created_at, loc: :transfer_location_id, sentido: :transfer_direction },
              sort_sql: { n: 'b2b_orders.id', pn: 'b2b_orders.id', dt: 'b2b_orders.created_at' }, page_size: 8, unit: screen[:unit][0], unit1: screen[:unit][1], sort: { k: :n, dir: -1 } } %>
<% table = if sale
     HoneyQueryTable.new(params, **common,
       tabs: { col: :st, param: :status, items: [['', 'Todos']] + statuses.map { |k, v| [k, v[0]] } },
       cols: [
         { k: :pn, label: 'Nº', t: :html, sort: true, nodetail: true, sub: :dia },
         { k: :n, label: 'Número', t: :num, main: true, hide: true },
         { k: :dia, label: 'Data', t: :d, hide: true, nodetail: true },
         { k: :dt, label: 'Data', t: :dt, hide: true },
         { k: :cliente, label: 'Cliente', sub: :cidade },
         { k: :cidade, label: 'Cidade / UF', hide: true, nodetail: true },
         { k: :cnpj, label: 'CNPJ/CPF', t: :mono, cls: 'due' },
         { k: :total_frete, label: 'Total com frete', t: :money, sub: :frete_sub },
         { k: :frete_sub, label: 'Frete', hide: true, nodetail: true },
         { k: :total, label: 'Total dos produtos', t: :money, hide: true },
         { k: :pag, label: 'Pagamento' },
         { k: :vend, label: 'Consultor', t: :html, sub: :por },
         { k: :track, label: 'Rastreamento', t: :mono },
         { k: :por, label: 'Vendedor', hide: true },
         { k: :st, label: 'Status', t: :status, map: statuses },
         { k: :log, label: 'Etapa no Log02', t: :tag },
         { k: :pecas, label: 'Peças', t: :qty, hide: true },
         { k: :serv, label: 'Serviço de frete', hide: true },
         { k: :transp, label: 'Transportadora', hide: true },
         { k: :fretepg, label: 'Frete por conta de', hide: true },
         { k: :fretev, label: 'Valor do frete (R$)', hide: true },
         { k: :desc, label: 'Desconto do pedido', hide: true },
         { k: :obs, label: 'Observações', hide: true }
       ],
       filters: [{ id: :q, type: :search, label: 'Buscar pedido', ph: 'Pesquise por cliente ou número...', tip: 'Procura pelo nome do cliente, pelo número do pedido, pelo consultor ou pelo rastreio. Pode digitar só um pedaço.' }],
       kpis: [
         { label: 'Abertos', icon: 'fas fa-pen-to-square', tone: 'yellow', help: 'Salvos, esperando a aprovação no Log02.', col: :st, vals: ['aberto'] },
         { label: 'Em andamento', icon: 'fas fa-box-open', tone: 'blue', help: 'Aprovados, a caminho da expedição.', col: :st, vals: %w[aprovado preparando_envio faturado pronto_para_envio] },
         { label: 'Enviados', icon: 'fas fa-truck-fast', tone: 'green', help: 'Já saíram para entrega.', col: :st, vals: ['enviado'] },
         { label: 'Com problema', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'Dados incompletos ou não entregues.', col: :st, vals: %w[nao_entregue dados_incompletos] }
       ])
   elsif supply
     HoneyQueryTable.new(params, **common,
       cols: [
         { k: :n, label: 'Nº', t: :num, main: true, sort: true },
         { k: :dt, label: 'Data', t: :dt, sort: true },
         { k: :loc, label: 'Destino', t: :loc, sub: :receb },
         { k: :pecas, label: 'Peças', t: :qty, unit: 'un' },
         { k: :total, label: 'Total', t: :money },
         { k: :st, label: 'Status', t: :status, map: statuses },
         { k: :log, label: 'Etapa no Log02', t: :tag },
         { k: :entrega, label: 'Entrega', t: :tag },
         { k: :receb, label: 'Quem recebe na loja', hide: true },
         { k: :track, label: 'Rastreamento', t: :mono, hide: true },
         { k: :por, label: 'Criado por', hide: true },
         { k: :obs, label: 'Observações', hide: true }
       ],
       filters: [
         { id: :q, type: :search, label: 'Buscar', ph: 'Nº, nota, loja ou quem recebe', tip: 'Procura pelo número do pedido, pela loja de destino ou pelo nome de quem recebe.' },
         { id: :loja, type: :select, label: 'Loja de destino', col: :loc, options: @filter_locations.map { |l| [l.id.to_s, l.name] }, all: 'Todas as lojas' },
         { id: :st, type: :select, label: 'Status', col: :st, all: 'Todos os status', tip: 'Em que ponto está o abastecimento, da aprovação até a chegada na loja.' },
         { id: :per, type: :period, label: 'Período', col: :dt }
       ],
       kpis: [
         { label: 'Preparando envio', icon: 'fas fa-box-open', tone: 'purple', help: 'Sendo separados no Log02.', col: :st, val: 'preparando_envio' },
         { label: 'Prontos para coleta', icon: 'fas fa-dolly', tone: 'orange', help: 'Com nota emitida, esperando os Correios.', col: :st, vals: %w[faturado pronto_para_envio] },
         { label: 'Enviados', icon: 'fas fa-truck-fast', tone: 'green', help: 'Já saíram para as lojas.', col: :st, val: 'enviado' },
         { label: 'Com problema', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'Pedem uma ação sua. Abra para ver o motivo.', col: :st, vals: %w[dados_incompletos nao_entregue] }
       ])
   else
     HoneyQueryTable.new(params, **common,
       cols: [
         { k: :pn, label: 'Nº', t: :html, sort: true, nodetail: true },
         { k: :n, label: 'Número', t: :num, main: true, hide: true },
         { k: :dt, label: 'Data', t: :dt, sort: true },
         { k: :sentido, label: 'Sentido', t: :tag },
         { k: :pecas, label: 'Peças', t: :qty, unit: 'un' },
         { k: :total, label: 'Total', t: :money },
         { k: :st, label: 'Status', t: :status, map: statuses },
         { k: :log, label: 'Etapa', t: :tag },
         { k: :por, label: 'Criado por', t: :person },
         { k: :dest, label: 'Destino', hide: true },
         { k: :obs, label: 'Observações', hide: true }
       ],
       filters: [
         { id: :q, type: :search, label: 'Buscar', ph: 'Nº ou rastreio', tip: 'Procura pelo número da transferência ou pelo código de rastreio.' },
         { id: :sentido, type: :select, label: 'Sentido', col: :sentido, options: B2bOrder::DIRECTION_LABELS.to_a, all: 'Os dois sentidos' },
         { id: :st, type: :select, label: 'Status', col: :st, all: 'Todos os status', tip: 'Em que ponto está a transferência.' },
         { id: :per, type: :period, label: 'Período', col: :dt }
       ],
       kpis: [
         { label: 'Aguardando aprovação', icon: 'fas fa-user-clock', tone: 'yellow', help: 'B2B → B2C esperando a aprovação no Log02 e B2C → B2B esperando as notas.', col: :st, val: 'aberto' },
         { label: 'Em preparo', icon: 'fas fa-box-open', tone: 'purple', help: 'No Correios, com a nota sendo emitida ou já faturadas, saindo do galpão.', col: :st, vals: %w[aprovado preparando_envio faturado pronto_para_envio] },
         { label: 'Concluídas', icon: 'fas fa-flag-checkered', tone: 'green', help: 'Já saíram para a filial de destino ou foram concluídas à mão.', col: :st, val: 'enviado' },
         { label: 'Com problema', icon: 'fas fa-triangle-exclamation', tone: 'red', help: 'Pedem uma ação sua. Abra para ver o motivo.', col: :st, vals: %w[dados_incompletos nao_entregue] }
       ])
   end %>
<% items_section = ->(r) {
     items = r[:record].b2b_order_items
     next nil if items.empty?

     rows_html = safe_join(items.map do |i|
       content_tag(:tr, content_tag(:td, i.sku, data: { label: 'SKU' }) + content_tag(:td, i.name.presence || '—', data: { label: 'Produto' }) +
                        content_tag(:td, i.quantity, data: { label: 'Qtde' }) + content_tag(:td, number_to_currency(i.line_total, unit: 'R$ ', separator: ',', delimiter: '.'), data: { label: 'Subtotal' }))
     end)
     content_tag(:section, content_tag(:h4, content_tag(:i, '', class: 'fas fa-box') + 'Itens do pedido') +
       content_tag(:div, content_tag(:table, content_tag(:thead, content_tag(:tr, safe_join(%w[SKU Produto Qtde Subtotal].map { |h| content_tag(:th, h) }))) + content_tag(:tbody, rows_html), class: 'orders-table pg-tbl pg-mini'), class: 'table-responsive'), class: 'help-sec')
   } %>

<%= hc_page_header screen[:title], screen[:subtitle], icon: screen[:icon] do %>
  <% if screen_can?(perm, :create) %>
    <%= link_to new_order_path_for, class: 'btn btn-export' do %><i class="fas fa-plus"></i><%= screen[:new_label] %><% end %>
    <% if kind == 'b2c_transfer' %>
      <%= link_to new_b2c_transfer_path(direction: 'b2c_to_b2b'), class: 'btn btn-export' do %><i class="fas fa-plus"></i>Nova B2C → B2B<% end %>
    <% end %>
  <% end %>
  <% if !sale && screen_can?(perm, :edit) %>
    <%= link_to send("#{kind}_settings_path"), class: 'btn btn-secondary' do %><i class="fas fa-sliders-h"></i>Configurações<% end %>
  <% end %>
  <% if sale && screen_can?(:b2b_orders, :edit) %>
    <%= link_to edit_b2b_setting_path, class: 'btn btn-secondary' do %><i class="fas fa-sliders-h"></i>Configuração do atacado<% end %>
  <% end %>
  <% if sale && screen_can?(:clients, :create) %>
    <%= link_to new_client_path, class: 'btn btn-secondary' do %><i class="fas fa-address-book"></i>Cadastrar novo cliente<% end %>
  <% end %>
<% end %>

<div class="callout pg-banner is-info"><i class="fas fa-circle-info"></i><div><strong><%= screen[:banner][0] %>.</strong> <%= screen[:banner][1] %></div></div>

<div class="pg-blocks">
  <%= hc_pg_kpis(table) %>
  <%= hc_pg_table(table, title: screen[:list], icon: screen[:list_icon], meta: screen[:meta],
        empty: { title: screen[:empty][0], text: screen[:empty][1],
                 cta: (link_to(safe_join([content_tag(:i, '', class: 'fas fa-plus'), screen[:new_label]]), new_order_path_for, class: 'btn btn-export') if screen_can?(perm, :create)) },
        detail: { title: ->(r) { "#{sale ? 'Pedido' : (supply ? 'Abastecimento' : 'Transferência')} ##{r[:n]}" },
                  note: (sale ? 'Pagamento, consultor e comissão: veja em Financeiro.'
                              : supply ? 'Sai do estoque do Log02. Por SEDEX mão própria, só quem está em "Quem recebe na loja" consegue retirar na entrega; por SEDEX normal, qualquer pessoa no endereço recebe; por transportadora, vai pela que está em "Entrega".'
                                       : 'B2B → B2C segue como transportadora, dentro do galpão do Log. B2C → B2B não vai ao Correios: só gera as duas notas.'),
                  extra: ->(r) { safe_join([(content_tag(:div, content_tag(:i, '', class: 'fas fa-triangle-exclamation') + content_tag(:span, "#{'Mensagem'}: #{r[:erro]}"), class: 'pg-fnote is-warn') if r[:erro].present?), items_section.call(r)].compact) } },
        actions: ->(r) {
          order = r[:record]
          safe_join([
            (hc_row_action('fas fa-pencil-alt', sale ? 'Editar' : 'Corrigir itens', edit_order_path_for(order)) if screen_can?(perm, :edit) && !order.b2c_transfer?),
            (hc_row_action('fas fa-flag-checkered', 'Concluir', complete_b2c_transfer_path(order), method: :post,
                           confirm: { title: "Concluir a transferência ##{order.id}?", text: 'Ela fica como Concluída e sai das filas do Log02 (XML e rastreio). Use quando a mercadoria já chegou à filial B2C.', ok: 'Concluir' }) if order.completable? && screen_can?(perm, :edit)),
            (hc_row_action('fas fa-file-pdf', sale ? 'Romaneio' : 'Baixar romaneio (PDF)', romaneio_order_path_for(order)) unless order.stock_transfer?),
            (hc_row_action('fas fa-file-invoice', 'Nota fiscal', edit_order_path_for(order, tab: 'nota')) if screen_can?(perm, :edit) && !order.b2c_transfer?),
            (if order_deletable?(order)
               (hc_row_action('fas fa-trash', 'Excluir', order_path_for(order), danger: true, method: :delete, confirm: { title: "Excluir o pedido ##{order.id}?", text: b2b_delete_confirm(order).sub(/\AExcluir o pedido #\d+\? /, ''), ok: 'Excluir pedido' }) if screen_can?(perm, :destroy))
             elsif @order_ids_with_active_note.include?(order.id)
               content_tag(:span, content_tag(:i, '', class: 'fas fa-lock'), class: 'action-btn', data: { tip: 'Tem nota fiscal: não dá para excluir' }, 'aria-label': 'Tem nota fiscal')
             end)
          ].compact)
        }) %>
</div>
