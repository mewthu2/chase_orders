<% content_for :title, "Pedido PDV ##{@order_pdv.id}" %>

<% content_for :styles do %>
<% end %>

<div style="padding: 24px 20px;">

  <%# ── Callout: Pedido Incompleto ──────────────────────────────────────────── %>
  <% if @order_pdv.status == 'incomplete' %>
    <div class="gh-callout gh-callout-yellow">
      <i class="fas fa-exclamation-triangle" style="color: var(--gh-yellow); font-size: 1rem;"></i>
      <div>
        <div style="font-weight: 600; color: var(--gh-yellow); margin-bottom: 4px;">Pedido incompleto</div>
        <div style="color: var(--gh-muted); line-height: 1.5;">
          Este pedido foi salvo sem forma de pagamento ou endereço. Para finalizar, concluir a venda ou adicionar mais produtos,
          <strong><%= link_to "acesse a edição do pedido", edit_order_pdv_path(@order_pdv), style: "color: var(--gh-yellow);" %></strong>.
          Pedidos incompletos não podem ser integrados ao Tiny.
        </div>
      </div>
    </div>
  <% end %>

  <%# ── Callout: Tiny integrado ─────────────────────────────────────────────── %>
  <% if @order_pdv.respond_to?(:tiny_order_id) && @order_pdv.tiny_order_id.present? %>
    <div class="gh-callout gh-callout-blue">
      <i class="fas fa-plug" style="color: var(--gh-blue); font-size: 1rem;"></i>
      <div>
        <div style="font-weight: 600; color: #58a6ff; margin-bottom: 4px;">Integrado ao Tiny</div>
        <div style="color: var(--gh-muted);">
          Pedido Tiny: <strong style="color: var(--gh-text);">#<%= @order_pdv.tiny_order_id %></strong>
          <% if @order_pdv.respond_to?(:tiny_status) && @order_pdv.tiny_status.present? %>
            &mdash; Status: <strong style="color: var(--gh-text);"><%= @order_pdv.tiny_status.humanize %></strong>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── Header ──────────────────────────────────────────────────────────────── %>
  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; flex-wrap: wrap;">
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
        <h1 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--gh-text);">
          Pedido PDV <span style="color: var(--gh-muted);">#<%= @order_pdv.id %></span>
        </h1>
        <%
          badge_class = case @order_pdv.status
          when 'integrated'  then 'gh-badge-green'
          when 'error'       then 'gh-badge-red'
          when 'paid'        then 'gh-badge-paid'
          when 'incomplete'  then 'gh-badge-yellow'
          else                    'gh-badge-muted'
          end
          badge_icon = case @order_pdv.status
          when 'integrated'  then 'check-circle'
          when 'error'       then 'times-circle'
          when 'paid'        then 'check-double'
          when 'incomplete'  then 'exclamation-circle'
          else                    'clock'
          end
          badge_text = case @order_pdv.status
          when 'incomplete' then 'Incompleto'
          when 'paid'       then 'Pago'
          else @order_pdv.respond_to?(:integration_status_text) ? @order_pdv.integration_status_text : @order_pdv.status.humanize
          end
        %>
        <span class="gh-badge <%= badge_class %>">
          <i class="fas fa-<%= badge_icon %>"></i><%= badge_text %>
        </span>
      </div>
      <div style="font-size: 0.78rem; color: var(--gh-muted);">
        <i class="fas fa-calendar-alt" style="margin-right: 4px;"></i>
        Criado em <%= @order_pdv.created_at.strftime('%d/%m/%Y às %H:%M') %>
        por <strong style="color: var(--gh-text);"><%= @order_pdv.user&.name %></strong>
      </div>
    </div>

    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
      <%= link_to order_pdvs_path, class: "gh-btn gh-btn-sm" do %>
        <i class="fas fa-arrow-left"></i> Voltar
      <% end %>
      <%= link_to edit_order_pdv_path(@order_pdv), class: "gh-btn gh-btn-sm gh-btn-yellow" do %>
        <i class="fas fa-pencil-alt"></i> Editar
      <% end %>
      <% if @order_pdv.respond_to?(:tiny_order_id) && @order_pdv.tiny_order_id.blank? && @order_pdv.status != 'incomplete' %>
        <button class="gh-btn gh-btn-sm gh-btn-blue" id="btn-integrate-tiny" onclick="integrateTiny()">
          <i class="fas fa-plug"></i> Integrar Tiny
        </button>
      <% end %>
      <% if @order_pdv.respond_to?(:tiny_order_id) && @order_pdv.tiny_order_id.present? && @order_pdv.status != 'paid' %>
        <button class="gh-btn gh-btn-sm gh-btn-green" id="btn-mark-paid" onclick="markAsPaid()">
          <i class="fas fa-check-circle"></i> Marcar como Pago
        </button>
      <% end %>
    </div>
  </div>

  <%# ── Stats ───────────────────────────────────────────────────────────────── %>
  <div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
    <div class="stat-card">
      <div class="stat-value" style="color: #3fb950;"><%= @order_pdv.formatted_total %></div>
      <div class="stat-label">Total do Pedido</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= @items.count %></div>
      <div class="stat-label">Produtos</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color: #58a6ff;"><%= @order_pdv.payment_method&.humanize || '—' %></div>
      <div class="stat-label">Pagamento</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= @order_pdv.user&.name&.split(' ')&.first %></div>
      <div class="stat-label">Vendedor</div>
    </div>
  </div>

  <%# ── Layout 2 colunas ────────────────────────────────────────────────────── %>
  <div style="display: grid; grid-template-columns: 1fr 340px; gap: 16px; align-items: start;">

    <%# ── Coluna esquerda ───────────────────────────────────────────────────── %>
    <div>

      <%# Itens do pedido %>
      <div class="gh-card">
        <div class="gh-card-header">
          <span class="gh-card-title">
            <i class="fas fa-shopping-bag"></i>
            Itens do Pedido
          </span>
          <span class="gh-badge gh-badge-muted"><%= @items.count %> produtos</span>
        </div>
        <div class="gh-card-body">
          <% @items.each do |item| %>
            <% item_image = item.image_url.presence || (item.respond_to?(:product) && item.product.present? ? ShopifyIntegrationService.get_product_image_from_shopify(item.product) : nil) rescue nil %>
            <div class="item-row">
              <div class="item-thumb">
                <% if item_image.present? %>
                  <img src="<%= item_image %>" alt="<%= item.product_name %>">
                <% else %>
                  <i class="fas fa-image" style="color: var(--gh-muted); font-size: 1rem;"></i>
                <% end %>
              </div>
              <div style="flex: 1; min-width: 0;">
                <div style="font-size: 0.8125rem; font-weight: 600; color: var(--gh-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= item.product_name %>
                </div>
                <div style="font-size: 0.75rem; color: var(--gh-muted); margin-top: 2px;">
                  SKU: <%= item.sku %>
                </div>
              </div>
              <div style="text-align: right; flex-shrink: 0;">
                <div style="font-size: 0.875rem; font-weight: 700; color: #3fb950;"><%= item.formatted_total %></div>
                <div style="font-size: 0.72rem; color: var(--gh-muted); margin-top: 2px;">
                  <%= item.quantity %>x <%= item.formatted_price %>
                </div>
              </div>
            </div>
          <% end %>

          <%# Totais %>
          <div style="margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--gh-border);">
            <div class="total-row">
              <span style="color: var(--gh-muted);">Subtotal</span>
              <span style="color: var(--gh-text);"><%= @order_pdv.formatted_subtotal %></span>
            </div>
            <% if @order_pdv.discount_amount.to_f > 0 %>
              <div class="total-row">
                <span style="color: var(--gh-muted);">Desconto
                  <% if @order_pdv.discount_reason.present? %>
                    <small style="font-size:0.7rem;">(<%=  @order_pdv.discount_reason %>)</small>
                  <% end %>
                </span>
                <span style="color: var(--gh-yellow);">- <%= @order_pdv.formatted_discount %></span>
              </div>
            <% end %>
            <div class="total-row final">
              <span style="color: var(--gh-text);">Total</span>
              <span style="color: #3fb950; font-size: 1.1rem;"><%= @order_pdv.formatted_total %></span>
            </div>
          </div>
        </div>
      </div>

      <%# Dados do cliente %>
      <div class="gh-card">
        <div class="gh-card-header">
          <span class="gh-card-title">
            <i class="fas fa-user"></i>
            Dados do Cliente
          </span>
        </div>
        <div class="gh-card-body">
          <% if @order_pdv.respond_to?(:client) && @order_pdv.client.present? %>
            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
              <div style="flex: 1; min-width: 180px;">
                <div class="info-row">
                  <span class="info-label">Responsável</span>
                  <span class="info-value"><%= @order_pdv.client.responsible_name %></span>
                </div>
                <% if @order_pdv.client.business_name.present? %>
                  <div class="info-row">
                    <span class="info-label">Razão Social</span>
                    <span class="info-value"><%= @order_pdv.client.business_name %></span>
                  </div>
                <% end %>
                <% if @order_pdv.client.registration.present? %>
                  <div class="info-row">
                    <span class="info-label">CNPJ</span>
                    <span class="info-value" style="font-family: monospace;"><%= @order_pdv.client.cnpj_formatted %></span>
                  </div>
                <% end %>
                <% if @order_pdv.client.phone.present? %>
                  <div class="info-row">
                    <span class="info-label">Telefone</span>
                    <span class="info-value"><%= @order_pdv.client.phone %></span>
                  </div>
                <% end %>
                <% if @order_pdv.client.email.present? %>
                  <div class="info-row">
                    <span class="info-label">E-mail</span>
                    <span class="info-value"><%= @order_pdv.client.email %></span>
                  </div>
                <% end %>
              </div>
            </div>
          <% else %>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px;">
              <div>
                <div class="info-row">
                  <span class="info-label">Nome</span>
                  <span class="info-value"><%= @order_pdv.customer_name.presence || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="info-label">E-mail</span>
                  <span class="info-value"><%= @order_pdv.customer_email.presence || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="info-label">Telefone</span>
                  <span class="info-value"><%= @order_pdv.customer_phone.presence || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="info-label">CPF</span>
                  <span class="info-value"><%= @order_pdv.customer_cpf.presence || '—' %></span>
                </div>
              </div>
              <div>
                <div class="info-row">
                  <span class="info-label">Endereço</span>
                  <span class="info-value"><%= @order_pdv.address1.presence || '—' %></span>
                </div>
                <% if @order_pdv.address2.present? %>
                  <div class="info-row">
                    <span class="info-label">Complemento</span>
                    <span class="info-value"><%= @order_pdv.address2 %></span>
                  </div>
                <% end %>
                <div class="info-row">
                  <span class="info-label">Cidade / UF</span>
                  <span class="info-value"><%= [@order_pdv.city, @order_pdv.state].select(&:present?).join(' / ').presence || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="info-label">CEP</span>
                  <span class="info-value"><%= @order_pdv.zip.presence || '—' %></span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Notas %>
      <% if @order_pdv.order_note.present? || @order_pdv.notes.present? %>
        <div class="gh-card">
          <div class="gh-card-header">
            <span class="gh-card-title"><i class="fas fa-sticky-note"></i> Observações</span>
          </div>
          <div class="gh-card-body" style="font-size: 0.8125rem; color: var(--gh-muted); line-height: 1.6;">
            <% if @order_pdv.order_note.present? %>
              <div style="margin-bottom: 8px;"><strong style="color: var(--gh-text);">Nota do pedido:</strong> <%= @order_pdv.order_note %></div>
            <% end %>
            <% if @order_pdv.notes.present? %>
              <div><strong style="color: var(--gh-text);">Observações:</strong> <%= simple_format(@order_pdv.notes) %></div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>

    <%# ── Coluna direita ─────────────────────────────────────────────────────── %>
    <div>

      <%# Ações rápidas %>
      <div class="gh-card">
        <div class="gh-card-header">
          <span class="gh-card-title"><i class="fas fa-bolt"></i> Ações</span>
        </div>
        <div class="gh-card-body" style="display: flex; flex-direction: column; gap: 8px;">

          <%= link_to edit_order_pdv_path(@order_pdv), class: "gh-btn", style: "justify-content: center;" do %>
            <i class="fas fa-pencil-alt"></i> Editar pedido
          <% end %>

          <% if @order_pdv.status == 'incomplete' %>
            <%= link_to edit_order_pdv_path(@order_pdv), class: "gh-btn gh-btn-yellow", style: "justify-content: center;" do %>
              <i class="fas fa-cart-plus"></i> Concluir / Adicionar produtos
            <% end %>
          <% end %>

          <% if @order_pdv.respond_to?(:tiny_order_id) && @order_pdv.tiny_order_id.blank? && @order_pdv.status != 'incomplete' %>
            <button class="gh-btn gh-btn-blue" id="btn-integrate-tiny-side" onclick="integrateTiny()" style="justify-content: center;">
              <i class="fas fa-plug"></i> Integrar ao Tiny
            </button>
          <% end %>

          <% if @order_pdv.respond_to?(:tiny_order_id) && @order_pdv.tiny_order_id.present? && @order_pdv.status != 'paid' %>
            <button class="gh-btn gh-btn-green" id="btn-mark-paid-side" onclick="markAsPaid()" style="justify-content: center;">
              <i class="fas fa-check-circle"></i> Marcar como Pago
            </button>
          <% end %>

          <% if @order_pdv.respond_to?(:can_retry_integration?) && @order_pdv.can_retry_integration? %>
            <button class="gh-btn" id="btn-integrate-shopify" onclick="integrateShopify()" style="justify-content: center;">
              <i class="fas fa-sync"></i> Integrar Shopify
            </button>
          <% end %>

          <hr style="border-color: var(--gh-border); margin: 4px 0;">

          <%= link_to order_pdvs_path, class: "gh-btn", style: "justify-content: center;" do %>
            <i class="fas fa-arrow-left"></i> Voltar à lista
          <% end %>
        </div>
      </div>

      <%# Detalhes da venda %>
      <div class="gh-card">
        <div class="gh-card-header">
          <span class="gh-card-title"><i class="fas fa-info-circle"></i> Detalhes</span>
        </div>
        <div class="gh-card-body">
          <div class="info-row">
            <span class="info-label">Status</span>
            <span class="info-value">
              <span class="gh-badge <%= badge_class %>">
                <i class="fas fa-<%= badge_icon %>"></i><%= badge_text %>
              </span>
            </span>
          </div>
          <div class="info-row">
            <span class="info-label">Loja</span>
            <span class="info-value">
              <% store_label = @order_pdv.store_type == 'online' ? 'Online Store' : @order_pdv.store_type&.humanize %>
              <span class="gh-badge gh-badge-muted"><%= store_label %></span>
            </span>
          </div>
          <div class="info-row">
            <span class="info-label">Pagamento</span>
            <span class="info-value"><%= @order_pdv.payment_method&.humanize || '—' %></span>
          </div>
          <div class="info-row">
            <span class="info-label">Vendedor</span>
            <span class="info-value"><%= @order_pdv.user&.name %></span>
          </div>
          <div class="info-row">
            <span class="info-label">Criado em</span>
            <span class="info-value"><%= @order_pdv.created_at.strftime('%d/%m/%Y %H:%M') %></span>
          </div>
          <div class="info-row">
            <span class="info-label">Atualizado</span>
            <span class="info-value"><%= @order_pdv.updated_at.strftime('%d/%m/%Y %H:%M') %></span>
          </div>
          <% if @order_pdv.respond_to?(:tiny_order_id) && @order_pdv.tiny_order_id.present? %>
            <div class="info-row">
              <span class="info-label">Tiny ID</span>
              <span class="info-value" style="font-family: monospace;">#<%= @order_pdv.tiny_order_id %></span>
            </div>
          <% end %>
          <% if @order_pdv.respond_to?(:tiny_status) && @order_pdv.tiny_status.present? %>
            <div class="info-row">
              <span class="info-label">Status Tiny</span>
              <span class="info-value"><%= @order_pdv.tiny_status.humanize %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# Parcelas %>
      <% if @order_pdv.order_parcels.present? && @order_pdv.order_parcels.any? %>
        <div class="gh-card">
          <div class="gh-card-header">
            <span class="gh-card-title"><i class="fas fa-money-bill-wave"></i> Parcelas</span>
            <span class="gh-badge gh-badge-muted"><%= @order_pdv.order_parcels.count %></span>
          </div>
          <div class="gh-card-body">
            <% @order_pdv.order_parcels.each_with_index do |parcel, i| %>
              <div class="parcel-row">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span style="color: var(--gh-muted); font-size: 0.72rem; min-width: 18px;">#<%= i + 1 %></span>
                  <span style="color: var(--gh-text);">
                    <%= parcel.payment_method&.humanize %>
                  </span>
                  <% if parcel.notes.present? %>
                    <span style="color: var(--gh-muted); font-size: 0.72rem;">(<%= parcel.notes %>)</span>
                  <% end %>
                </div>
                <span style="font-weight: 700; color: #3fb950;">
                  R$ <%= sprintf('%.2f', parcel.amount).gsub('.', ',') %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Shopify %>
      <% if @order_pdv.integrated? && @order_pdv.shopify_order_id.present? %>
        <div class="gh-card">
          <div class="gh-card-header">
            <span class="gh-card-title"><i class="fas fa-store"></i> Shopify</span>
            <span class="gh-badge gh-badge-green"><i class="fas fa-check"></i> Integrado</span>
          </div>
          <div class="gh-card-body">
            <div class="info-row">
              <span class="info-label">Pedido</span>
              <span class="info-value"><%= @order_pdv.shopify_order_number %></span>
            </div>
            <div class="info-row">
              <span class="info-label">ID</span>
              <span class="info-value" style="font-family: monospace;"><%= @order_pdv.shopify_order_id %></span>
            </div>
            <div class="info-row" style="border-bottom: none;">
              <span class="info-label">Integrado em</span>
              <span class="info-value"><%= @order_pdv.integrated_at&.strftime('%d/%m/%Y %H:%M') %></span>
            </div>
            <div style="margin-top: 12px;">
              <a href="https://chasebrasil.myshopify.com/admin/orders/<%= @order_pdv.shopify_order_id %>"
                 target="_blank" class="gh-btn gh-btn-sm gh-btn-blue" style="width: 100%; justify-content: center;">
                <i class="fas fa-external-link-alt"></i> Ver no Shopify
              </a>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>

</div>

<%# Toast container %>
<div id="show-toast-container" style="position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;"></div>

<script>
function showToast(message, type = 'success') {
  const color = type === 'success' ? '#238636' : '#da3633';
  const icon  = type === 'success' ? 'check-circle' : 'times-circle';
  const el    = document.createElement('div');
  el.innerHTML = `<i class="fas fa-${icon}" style="margin-right:8px;"></i>${message}`;
  Object.assign(el.style, {
    background: '#161b22',
    border: `1px solid ${color}`,
    borderLeft: `4px solid ${color}`,
    color: '#e6edf3',
    padding: '11px 16px',
    borderRadius: '6px',
    fontSize: '0.8125rem',
    boxShadow: '0 4px 16px rgba(0,0,0,0.4)',
    maxWidth: '340px',
    animation: 'fadeIn 0.2s ease'
  });
  document.getElementById('show-toast-container').appendChild(el);
  setTimeout(() => el.remove(), 5000);
}

function integrateTiny() {
  ['btn-integrate-tiny', 'btn-integrate-tiny-side'].forEach(id => {
    const b = document.getElementById(id);
    if (b) { b.disabled = true; b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Integrando...'; }
  });

  fetch('<%= integrate_tiny_order_pdv_path(@order_pdv) %>', {
    method: 'POST',
    headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content, 'Accept': 'application/json' }
  })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        showToast(data.message, 'success');
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast(data.message || 'Erro ao integrar.', 'error');
        ['btn-integrate-tiny', 'btn-integrate-tiny-side'].forEach(id => {
          const b = document.getElementById(id);
          if (b) { b.disabled = false; b.innerHTML = '<i class="fas fa-plug"></i> Integrar ao Tiny'; }
        });
      }
    });
}

function markAsPaid() {
  if (!confirm('Marcar este pedido como PAGO e aprovar no Tiny?')) return;
  ['btn-mark-paid', 'btn-mark-paid-side'].forEach(id => {
    const b = document.getElementById(id);
    if (b) { b.disabled = true; b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processando...'; }
  });

  fetch('<%= mark_as_paid_order_pdv_path(@order_pdv) %>', {
    method: 'PATCH',
    headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content, 'Accept': 'application/json' }
  })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        showToast(data.message, 'success');
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast(data.message || 'Erro.', 'error');
        ['btn-mark-paid', 'btn-mark-paid-side'].forEach(id => {
          const b = document.getElementById(id);
          if (b) { b.disabled = false; b.innerHTML = '<i class="fas fa-check-circle"></i> Marcar como Pago'; }
        });
      }
    });
}

function integrateShopify() {
  if (!confirm('Confirma a integração com o Shopify?')) return;
  const btn = document.getElementById('btn-integrate-shopify');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Integrando...'; }

  fetch('<%= integrate_order_pdv_path(@order_pdv) %>', {
    method: 'POST',
    headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
  })
    .then(r => { if (r.ok) location.reload(); else throw new Error(); })
    .catch(() => {
      showToast('Erro ao integrar com Shopify.', 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-sync"></i> Integrar Shopify'; }
    });
}
</script>
