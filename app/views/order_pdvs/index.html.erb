<% content_for :title, "Pedidos PDV" %>

<% content_for :styles do %>
<style>
  :root {
    --gh-bg:        #0d1117;
    --gh-surface:   #161b22;
    --gh-border:    #21262d;
    --gh-border-hi: #30363d;
    --gh-text:      #e6edf3;
    --gh-muted:     #8b949e;
    --gh-blue:      #1f6feb;
    --gh-green:     #238636;
    --gh-red:       #da3633;
    --gh-yellow:    #d29922;
    --gh-purple:    #8957e5;
  }

  body { background-color: var(--gh-bg) !important; color: var(--gh-text); }

  /* Surface cards */
  .gh-card {
    background: var(--gh-surface);
    border: 1px solid var(--gh-border);
    border-radius: 6px;
  }
  .gh-card-header {
    background: var(--gh-surface);
    border-bottom: 1px solid var(--gh-border);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .gh-card-body { padding: 16px; }

  /* Stat cards */
  .stat-card {
    background: var(--gh-surface);
    border: 1px solid var(--gh-border);
    border-radius: 6px;
    padding: 16px;
    transition: border-color 0.15s ease;
  }
  .stat-card:hover { border-color: var(--gh-border-hi); }
  .stat-card .stat-value { font-size: 1.75rem; font-weight: 700; line-height: 1; }
  .stat-card .stat-label { font-size: 0.75rem; color: var(--gh-muted); margin-top: 4px; }

  /* Table */
  .gh-table { width: 100%; border-collapse: collapse; }
  .gh-table th {
    background: var(--gh-surface);
    color: var(--gh-muted);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 10px 16px;
    border-bottom: 1px solid var(--gh-border);
    white-space: nowrap;
  }
  .gh-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--gh-border);
    vertical-align: middle;
    color: var(--gh-text);
    font-size: 0.875rem;
  }
  .gh-table tbody tr:hover { background: rgba(177,186,196,0.04); }
  .gh-table tbody tr:last-child td { border-bottom: none; }

  /* Badges */
  .gh-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.72rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .gh-badge-pending  { background: rgba(210,153,34,0.15);  color: var(--gh-yellow); border: 1px solid rgba(210,153,34,0.4); }
  .gh-badge-success  { background: rgba(35,134,54,0.15);   color: #3fb950;          border: 1px solid rgba(35,134,54,0.4); }
  .gh-badge-error    { background: rgba(218,54,51,0.15);   color: #f85149;          border: 1px solid rgba(218,54,51,0.4); }
  .gh-badge-info     { background: rgba(31,111,235,0.15);  color: #58a6ff;          border: 1px solid rgba(31,111,235,0.4); }
  .gh-badge-neutral  { background: rgba(139,148,158,0.15); color: var(--gh-muted);  border: 1px solid rgba(139,148,158,0.3); }
        .gh-badge-paid     { background: rgba(35,134,54,0.25);   color: #3fb950;          border: 1px solid rgba(35,134,54,0.6); }
        .gh-badge-warning  { background: rgba(210,153,34,0.2);   color: #d29922;          border: 1px solid rgba(210,153,34,0.5); }

  /* Inputs */
  .gh-input, .gh-select {
    background: var(--gh-surface) !important;
    border: 1px solid var(--gh-border-hi) !important;
    border-radius: 6px;
    color: var(--gh-text) !important;
    font-size: 0.875rem;
    padding: 6px 12px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .gh-input:focus, .gh-select:focus {
    border-color: var(--gh-blue) !important;
    box-shadow: 0 0 0 3px rgba(31,111,235,0.15) !important;
    outline: none;
  }
  .gh-select option { background: var(--gh-surface); color: var(--gh-text); }

  /* Buttons */
  .gh-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 16px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--gh-border-hi);
    background: var(--gh-surface);
    color: var(--gh-text);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }
  .gh-btn:hover { background: #21262d; border-color: #8b949e; color: var(--gh-text); }
  .gh-btn-primary { background: var(--gh-blue); border-color: var(--gh-blue); color: #fff; }
  .gh-btn-primary:hover { background: #388bfd; border-color: #388bfd; color: #fff; }
  .gh-btn-success { background: var(--gh-green); border-color: var(--gh-green); color: #fff; }
  .gh-btn-success:hover { background: #2ea043; border-color: #2ea043; color: #fff; }
  .gh-btn-sm { padding: 3px 10px; font-size: 0.78rem; }
  .gh-btn-icon { padding: 4px 8px; }

  /* Spinner */
  .gh-spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Empty state */
  .gh-empty { text-align: center; padding: 64px 16px; color: var(--gh-muted); }
  .gh-empty i { font-size: 2.5rem; display: block; margin-bottom: 12px; opacity: 0.4; }

  /* Flash */
  .gh-flash { padding: 12px 16px; border-radius: 6px; font-size: 0.875rem; margin-bottom: 16px; }
  .gh-flash-success { background: rgba(35,134,54,0.15); border: 1px solid rgba(35,134,54,0.4); color: #3fb950; }
  .gh-flash-error   { background: rgba(218,54,51,0.15);  border: 1px solid rgba(218,54,51,0.4);  color: #f85149; }

  /* Amount highlight */
  .amount { color: #3fb950; font-weight: 600; font-variant-numeric: tabular-nums; }
</style>
<% end %>

<div style="padding: 24px 20px;">

  <%# Flash %>
  <% flash.each do |type, msg| %>
    <div class="gh-flash gh-flash-<%= type == 'notice' ? 'success' : 'error' %>">
      <i class="fas fa-<%= type == 'notice' ? 'check-circle' : 'exclamation-circle' %> me-2"></i><%= msg %>
    </div>
  <% end %>

  <%# ── Page header ──────────────────────────────────────────────────────── %>
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h4 style="color: var(--gh-text); font-weight: 600; margin: 0;">Pedidos PDV</h4>
      <p style="color: var(--gh-muted); font-size: 0.875rem; margin: 2px 0 0;">
        <%= l(Date.current, format: '%A, %d de %B de %Y').capitalize %>
      </p>
    </div>
    <%= link_to pos_path, class: "gh-btn gh-btn-success" do %>
      <i class="fas fa-plus"></i> Nova Venda
    <% end %>
  </div>

  <%# ── Stats ───────────────────────────────────────────────────────────── %>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card" style="border-left: 3px solid var(--gh-yellow);">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span style="color: var(--gh-muted); font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Pendentes</span>
          <i class="fas fa-hourglass-half" style="color: var(--gh-yellow); font-size: 0.85rem;"></i>
        </div>
        <div class="stat-value" style="color: var(--gh-yellow);"><%= @status_counts[:pending] %></div>
        <div class="stat-label">Aguardando</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card" style="border-left: 3px solid #3fb950;">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span style="color: var(--gh-muted); font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Integrados</span>
          <i class="fas fa-check-circle" style="color: #3fb950; font-size: 0.85rem;"></i>
        </div>
        <div class="stat-value" style="color: #3fb950;"><%= @status_counts[:integrated] %></div>
        <div class="stat-label">Enviados</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card" style="border-left: 3px solid #f85149;">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span style="color: var(--gh-muted); font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Com Erro</span>
          <i class="fas fa-exclamation-triangle" style="color: #f85149; font-size: 0.85rem;"></i>
        </div>
        <div class="stat-value" style="color: #f85149;"><%= @status_counts[:error] %></div>
        <div class="stat-label">Falha na integração</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card" style="border-left: 3px solid #58a6ff;">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span style="color: var(--gh-muted); font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Total</span>
          <i class="fas fa-chart-pie" style="color: #58a6ff; font-size: 0.85rem;"></i>
        </div>
        <div class="stat-value" style="color: #58a6ff;"><%= @status_counts[:all] %></div>
        <div class="stat-label">Registrados</div>
      </div>
    </div>
  </div>

  <%# ── Filters ──────────────────────────────────────────────────────────── %>
  <div class="gh-card mb-4">
    <div class="gh-card-body">
      <%= form_with url: order_pdvs_path, method: :get, local: true do |f| %>
        <div class="d-flex flex-wrap gap-2 align-items-end">
          <div>
            <label style="color: var(--gh-muted); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Status</label>
            <%= f.select :status,
                options_for_select([
                  ['Todos', ''],
                  ['Pendentes', 'pending'],
                  ['Integrados', 'integrated'],
                  ['Com Erro', 'error'],
                  ['Pago', 'paid']
                ], params[:status]),
                {},
                { class: "gh-select form-select", style: "min-width: 160px;" } %>
          </div>
          <div>
            <label style="color: var(--gh-muted); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">Por página</label>
            <%= f.select :per_page,
                options_for_select([['20', '20'], ['50', '50'], ['100', '100']], params[:per_page]),
                {},
                { class: "gh-select form-select", style: "min-width: 100px;" } %>
          </div>
          <div class="d-flex gap-2">
            <%= f.submit "Filtrar", class: "gh-btn gh-btn-primary" %>
            <%= link_to "Limpar", order_pdvs_path, class: "gh-btn" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Table ───────────────────────────────────────────────────────────── %>
  <div class="gh-card">
    <div class="gh-card-header">
      <span style="color: var(--gh-text); font-weight: 600; font-size: 0.875rem;">
        <i class="fas fa-list me-2" style="color: var(--gh-muted);"></i>Lista de Pedidos
      </span>
      <span style="color: var(--gh-muted); font-size: 0.78rem;"><%= @order_pdvs.total_count rescue @order_pdvs.count %> pedidos</span>
    </div>

    <div style="overflow-x: auto;">
      <table class="gh-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Data</th>
            <th>Cliente</th>
            <th>Vendedor</th>
            <th>Itens</th>
            <th>Total</th>
            <th>Status</th>
            <th>Tiny</th>
            <th style="text-align: right;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @order_pdvs.any? %>
            <% @order_pdvs.each do |order| %>
              <tr>
                <td>
                  <span style="color: var(--gh-muted); font-size: 0.78rem; font-variant-numeric: tabular-nums;">#<%= order.id %></span>
                </td>
                <td>
                  <div style="font-size: 0.875rem;"><%= order.created_at.strftime('%d/%m/%Y') %></div>
                  <div style="color: var(--gh-muted); font-size: 0.75rem;"><%= order.created_at.strftime('%H:%M') %></div>
                </td>
                <td>
                  <% name = order.respond_to?(:client) && order.client.present? ? order.client.display_name : order.customer_name %>
                  <div style="font-size: 0.875rem;"><%= name.presence || '—' %></div>
                  <% if order.customer_email.present? %>
                    <div style="color: var(--gh-muted); font-size: 0.75rem;"><%= order.customer_email %></div>
                  <% end %>
                </td>
                <td>
                  <span class="gh-badge gh-badge-neutral"><%= order.user.name rescue '—' %></span>
                </td>
                <td>
                  <span class="gh-badge gh-badge-info"><%= order.order_pdv_items.size %> itens</span>
                </td>
                <td>
                  <span class="amount"><%= order.formatted_total %></span>
                </td>
                <td>
                  <%
                    badge_class = case order.status
                    when 'integrated'  then 'gh-badge-success'
                    when 'error'       then 'gh-badge-error'
                    when 'paid'        then 'gh-badge-paid'
                    when 'incomplete'  then 'gh-badge-warning'
                    else                    'gh-badge-pending'
                    end
                    badge_icon = case order.status
                    when 'integrated'  then 'check-circle'
                    when 'error'       then 'times-circle'
                    when 'paid'        then 'check-double'
                    when 'incomplete'  then 'exclamation-circle'
                    else                    'clock'
                    end
                    badge_text = case order.status
                    when 'incomplete' then 'Incompleto'
                    else order.respond_to?(:integration_status_text) ? order.integration_status_text : order.status.humanize
                    end
                  %>
                  <span class="gh-badge <%= badge_class %>">
                    <i class="fas fa-<%= badge_icon %>"></i> <%= badge_text %>
                  </span>
                </td>
                <td>
                  <% if order.respond_to?(:tiny_order_id) && order.tiny_order_id.present? %>
                    <span class="gh-badge gh-badge-success">
                      <i class="fas fa-check"></i> #<%= order.tiny_order_id %>
                    </span>
                  <% else %>
                    <span style="color: var(--gh-muted); font-size: 0.78rem;">—</span>
                  <% end %>
                </td>
                <td>
                  <div class="d-flex gap-1 justify-content-end">
                    <%= link_to order_pdv_path(order), class: "gh-btn gh-btn-sm gh-btn-icon", title: "Ver" do %>
                      <i class="fas fa-eye" style="font-size: 0.75rem;"></i>
                    <% end %>
                    <%= link_to generate_pdf_order_pdv_path(order, format: :pdf), class: "gh-btn gh-btn-sm gh-btn-icon", title: "Gerar PDF" do %>
                      <i class="fas fa-file-pdf" style="font-size: 0.75rem; color: #da3633;"></i>
                    <% end %>
                    <%= link_to edit_order_pdv_path(order), class: "gh-btn gh-btn-sm gh-btn-icon", title: "Editar" do %>
                      <i class="fas fa-pencil-alt" style="font-size: 0.75rem;"></i>
                    <% end %>
                    <% if order.status != 'paid' && order.respond_to?(:tiny_order_id) && order.tiny_order_id.present? %>
                      <button onclick="markAsPaid(<%= order.id %>, this)"
                              class="gh-btn gh-btn-sm gh-btn-icon"
                              title="Marcar como Pago (Tiny #<%= order.tiny_order_id %>)"
                              style="color: #3fb950;">
                        <i class="fas fa-check-circle" style="font-size: 0.75rem;"></i>
                      </button>
                    <% end %>
                    <% if order.respond_to?(:can_retry_integration?) && order.can_retry_integration? %>
                      <button onclick="integrateOrder(<%= order.id %>)"
                              class="gh-btn gh-btn-sm gh-btn-icon"
                              title="Integrar Shopify"
                              data-order-id="<%= order.id %>">
                        <i class="fas fa-sync" style="font-size: 0.75rem;"></i>
                      </button>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9">
                <div class="gh-empty">
                  <i class="fas fa-receipt"></i>
                  <p style="font-size: 0.95rem; margin: 0 0 8px;">Nenhum pedido encontrado</p>
                  <small>Os pedidos criados no PDV aparecerão aqui.</small><br>
                  <%= link_to pos_path, class: "gh-btn gh-btn-success mt-3" do %>
                    <i class="fas fa-plus"></i> Criar Primeira Venda
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# Paginação manual (sem gem) %>
  <% if @order_pdvs.respond_to?(:current_page) && @order_pdvs.respond_to?(:total_pages) && @order_pdvs.total_pages > 1 %>
    <nav class="mt-4" aria-label="Paginação">
      <ul class="pagination justify-content-center" style="gap:4px;">
        <% if @order_pdvs.current_page > 1 %>
          <li>
            <%= link_to order_pdvs_path(request.query_parameters.merge(page: @order_pdvs.current_page - 1)),
                class: "btn btn-sm",
                style: "background:#161b22;border:1px solid #21262d;color:#8b949e;border-radius:6px;padding:6px 14px;" do %>
              &laquo; Anterior
            <% end %>
          </li>
        <% end %>

        <% ([1, @order_pdvs.current_page - 2].max..[@order_pdvs.total_pages, @order_pdvs.current_page + 2].min).each do |page| %>
          <li>
            <%= link_to order_pdvs_path(request.query_parameters.merge(page: page)),
                class: "btn btn-sm",
                style: "background:#{page == @order_pdvs.current_page ? '#1f6feb' : '#161b22'};border:1px solid #21262d;color:#e6edf3;border-radius:6px;padding:6px 12px;" do %>
              <%= page %>
            <% end %>
          </li>
        <% end %>

        <% if @order_pdvs.current_page < @order_pdvs.total_pages %>
          <li>
            <%= link_to order_pdvs_path(request.query_parameters.merge(page: @order_pdvs.current_page + 1)),
                class: "btn btn-sm",
                style: "background:#161b22;border:1px solid #21262d;color:#8b949e;border-radius:6px;padding:6px 14px;" do %>
              Próximo &raquo;
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>
  <% end %>

</div>

<script>
function integrateOrder(orderId) {
  if (!confirm('Confirma a integração deste pedido com o Shopify?')) return;

  const button = document.querySelector(`button[data-order-id="${orderId}"]`);
  const icon   = button.querySelector('i');
  icon.className = 'gh-spinner';
  button.disabled = true;

  fetch(`/order_pdvs/${orderId}/integrate`, {
    method: 'POST',
    headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
  })
    .then(r => {
      if (r.ok) location.reload();
      else throw new Error('Erro na integração');
    })
    .catch(() => {
      showIndexToast('Erro ao integrar pedido. Tente novamente.', 'error');
      icon.className = 'fas fa-sync';
      button.disabled = false;
    });
}

function markAsPaid(orderId, btn) {
  if (!confirm('Marcar este pedido como PAGO?')) return;

  const icon = btn.querySelector('i');
  icon.className = 'fas fa-spinner fa-spin';
  btn.disabled = true;

  fetch(`/order_pdvs/${orderId}/mark_as_paid`, {
    method: 'PATCH',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
      'Accept': 'application/json'
    }
  })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        showIndexToast(data.message, 'success');
        setTimeout(() => location.reload(), 1000);
      } else {
        showIndexToast(data.message || 'Erro ao marcar como pago.', 'error');
        icon.className = 'fas fa-check-circle';
        btn.disabled = false;
      }
    })
    .catch(() => {
      showIndexToast('Erro de comunicação.', 'error');
      icon.className = 'fas fa-check-circle';
      btn.disabled = false;
    });
}

function showIndexToast(message, type = 'success') {
  const color   = type === 'success' ? '#238636' : '#da3633';
  const icon    = type === 'success' ? 'check-circle' : 'times-circle';
  const toast   = document.createElement('div');
  toast.innerHTML = `<i class="fas fa-${icon}" style="margin-right:8px;"></i>${message}`;
  Object.assign(toast.style, {
    position: 'fixed', bottom: '24px', right: '24px', zIndex: '9999',
    background: '#161b22', border: `1px solid ${color}`,
    borderLeft: `4px solid ${color}`, color: '#e6edf3',
    padding: '12px 18px', borderRadius: '8px',
    fontSize: '0.875rem', boxShadow: '0 4px 16px rgba(0,0,0,0.4)',
    maxWidth: '360px', animation: 'fadeInUp 0.2s ease'
  });
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 4000);
}
</script>
