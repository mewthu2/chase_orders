<% content_for :title, 'Atendimento WhatsApp' %>
<% content_for :styles do %><%= stylesheet_link_tag 'whatsapp_support' %><% end %>
<% content_for :scripts do %><%= javascript_include_tag 'whatsapp_support', defer: true %><% end %>
<%= hc_page_header 'Atendimento WhatsApp', 'Conversas da sua equipe, em um só lugar.', icon: 'fab fa-whatsapp' do %>
  <% if current_user.can_access_screen?('whatsapp_manage') %>
    <%= link_to whatsapp_connections_path, class: 'btn btn-secondary' do %><i class="fas fa-mobile-screen-button"></i>Números conectados<% end %>
  <% end %>
  <button type="button" class="btn btn-export" id="wa-new"><i class="fas fa-comment-medical"></i>Nova conversa</button>
<% end %>
<section class="wa-app wa-chat-app" id="wa-inbox" data-wa-theme="dark" aria-label="Atendimento WhatsApp">
  <div class="wa-notice" id="wa-error" role="status" hidden></div>
  <nav class="wa-number-tabs" id="wa-number-tabs" role="tablist" aria-label="Números conectados">
    <% manage = Whatsapp::Connection.administrable_by?(current_user) %>
    <% agents = Whatsapp::Automation.where(enabled: true, connection_id: @connections.map(&:id)).index_by(&:connection_id) %>
    <% @connections.each do |c| %>
      <% agent = agents[c.id] %>
      <div class="wa-number-tab-wrap">
        <button type="button" role="tab" class="wa-number-tab" data-id="<%= c.id %>" aria-selected="false">
          <span class="wa-number-dot<%= ' is-on' if c.connected? %>" title="<%= c.connected? ? 'Conectado' : 'Desconectado' %>"></span>
          <span class="wa-number-name"><i class="fab fa-whatsapp"></i><%= c.name %></span>
          <small><%= c.phone.presence || 'sem telefone' %></small>
          <span class="wa-number-count" hidden></span>
        </button>
        <% label = agent ? "#{agent.name}: #{agent.auto? ? 'respondendo sozinho' : 'sugerindo respostas'}" : 'Sem agente ligado' %>
        <% classes = "wa-number-agent #{agent ? (agent.auto? ? 'is-auto' : 'is-approve') : 'is-off'}" %>
        <% if manage %>
          <%= link_to (agent ? whatsapp_automation_path(agent) : whatsapp_automations_path), class: classes, title: "#{label}. Clique para configurar." do %><i class="fas fa-robot"></i><span><%= agent ? (agent.auto? ? 'Sozinho' : 'Sugerindo') : 'Sem agente' %></span><% end %>
        <% else %>
          <span class="<%= classes %>" title="<%= label %>"><i class="fas fa-robot"></i><span><%= agent ? (agent.auto? ? 'Sozinho' : 'Sugerindo') : 'Sem agente' %></span></span>
        <% end %>
      </div>
    <% end %>
    <% if @connections.empty? %><span class="wa-number-none">Nenhum número liberado para você. Peça acesso à administração.</span><% end %>
  </nav>
  <div class="wa-workspace">
    <aside class="wa-inbox-list" aria-label="Lista de conversas">
      <header class="wa-side-head">
        <h2>Conversas</h2>
        <div class="wa-side-tools">
          <button type="button" class="wa-icon-btn" id="wa-theme-toggle" title="Usar tema claro" aria-label="Usar tema claro"><i class="fas fa-sun"></i></button>
          <button type="button" class="wa-icon-btn" id="wa-new-side" title="Nova conversa" aria-label="Nova conversa"><i class="fas fa-comment-medical"></i></button>
        </div>
      </header>
      <div class="wa-side-search">
        <div class="wa-search-box"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><label class="visually-hidden" for="wa-search">Buscar nome ou telefone</label><input id="wa-search" class="form-control" placeholder="Pesquisar nome ou telefone" type="search"></div>
        <input type="hidden" id="wa-number" value="">
        <div class="wa-filters">
          <select id="wa-state" class="form-select wa-chip-select" aria-label="Situação"><option value="open">Em aberto</option><option value="pending">Pendentes</option><option value="responding">Respondendo</option><option value="closed">Finalizadas</option><option value="">Todas</option></select>
          <label class="wa-chip"><input id="wa-unread" type="checkbox"> Não lidas</label>
          <label class="wa-chip wa-chip-group" title="Grupos ficam fora da lista; marque para ver só os grupos"><input id="wa-groups" type="checkbox"> <i class="fas fa-users"></i> Grupos</label>
          <label class="wa-chip"><input id="wa-mine" type="checkbox"> Minhas</label>
          <label class="wa-chip wa-chip-human"><input id="wa-human" type="checkbox"> <i class="fas fa-robot"></i> Precisa de você</label>
        </div>
      </div>
      <div id="wa-threads" class="wa-threads" aria-live="polite"></div>
      <button id="wa-more-conversations" class="wa-more" type="button" hidden>Mais conversas</button>
    </aside>
    <main class="wa-chat" aria-label="Conversa selecionada">
      <div id="wa-empty" class="wa-empty">
        <div class="wa-empty-art"><i class="fab fa-whatsapp" aria-hidden="true"></i></div>
        <h2>Honey para WhatsApp</h2>
        <p>Selecione uma conversa à esquerda para começar o atendimento,<br>ou abra uma nova conversa com um cliente.</p>
        <small><i class="fas fa-lock" aria-hidden="true"></i> As mensagens ficam registradas no Honey para toda a equipe.</small>
      </div>
      <div id="wa-selected" hidden>
        <header class="wa-chat-header">
          <button id="wa-back" class="wa-icon-btn wa-mobile" type="button" aria-label="Voltar"><i class="fas fa-arrow-left"></i></button>
          <span class="wa-avatar" id="wa-contact-avatar" aria-hidden="true"></span>
          <div class="wa-chat-title"><strong id="wa-contact-name"></strong><small id="wa-company-number"></small><small id="wa-owner"></small></div>
          <button id="wa-contact-toggle" class="wa-icon-btn" type="button" aria-expanded="false" title="Dados do contato" aria-label="Dados do contato"><i class="fas fa-address-card"></i></button>
        </header>
        <div class="wa-actions"><button id="wa-take" class="wa-pill" type="button"><i class="fas fa-hand"></i> Assumir</button><select id="wa-assignee" class="form-select form-select-sm" aria-label="Transferir para"><option value="">Transferir para…</option></select><button id="wa-transfer" class="wa-pill" type="button"><i class="fas fa-right-left"></i> Transferir</button><button id="wa-mode" class="wa-pill wa-mode" type="button" aria-pressed="false" hidden><i class="fas fa-comments"></i> Modo conversa</button><button id="wa-close" class="wa-pill" type="button">Finalizar</button></div>
        <div class="wa-history" id="wa-history" role="log" aria-label="Histórico de mensagens"><button id="wa-older" class="wa-older" type="button" hidden>Carregar anteriores</button><div id="wa-messages"></div></div>
        <div id="wa-agent" class="wa-agent" aria-live="polite" hidden></div>
        <button id="wa-new-indicator" class="wa-new-indicator" type="button" hidden aria-label="Novas mensagens"><i class="fas fa-chevron-down"></i></button>
        <form id="wa-compose" class="wa-compose">
          <div class="wa-file-chip" id="wa-file-chip"><i class="fas fa-paperclip" aria-hidden="true"></i><span id="wa-file-name"></span><button id="wa-clear-file" class="wa-icon-btn" type="button" hidden title="Remover arquivo" aria-label="Remover arquivo"><i class="fas fa-xmark"></i></button></div>
          <div class="wa-compose-row">
            <label class="wa-icon-btn" title="Anexar (até 10 MB)"><i class="fas fa-paperclip" aria-hidden="true"></i><span class="visually-hidden">Anexar</span><input id="wa-file" type="file" class="visually-hidden" accept="image/jpeg,image/png,image/webp,application/pdf,text/plain,audio/*,video/mp4,video/quicktime,video/3gpp"></label>
            <label for="wa-text" class="visually-hidden">Mensagem</label><textarea id="wa-text" class="form-control" rows="1" maxlength="10000" placeholder="Digite uma mensagem"></textarea>
            <button id="wa-record" type="button" class="wa-icon-btn" title="Gravar áudio" aria-label="Gravar áudio"><i class="fas fa-microphone"></i></button>
            <button type="submit" id="wa-send" class="wa-send" title="Enviar" aria-label="Enviar"><i class="fas fa-paper-plane"></i></button>
          </div>
          <small>Arquivos de até 10 MB. Entrega e leitura aparecem somente quando confirmadas pelo WhatsApp.</small>
        </form>
      </div>
    </main>
    <aside class="wa-contact" id="wa-contact-panel" aria-label="Dados do contato" hidden>
      <header class="wa-contact-head"><button id="wa-contact-hide" class="wa-icon-btn" type="button" aria-label="Fechar"><i class="fas fa-xmark"></i></button><h2>Dados do contato</h2></header>
      <div class="wa-contact-card"><span class="wa-avatar wa-avatar-lg" id="wa-contact-avatar-lg" aria-hidden="true"></span><p id="wa-contact-phone"></p></div>
      <div class="wa-contact-section" id="wa-linked"></div>
      <div class="wa-contact-section" id="wa-customer-picker" hidden><label for="wa-customer-search">Vincular ao cadastro do Honey</label><div class="wa-search-box"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input id="wa-customer-search" class="form-control" placeholder="Nome ou telefone"></div><button id="wa-customer-find" class="wa-pill" type="button">Buscar</button><div id="wa-customer-results"></div><small>Escolha o cadastro correto. Nenhum cliente será mesclado automaticamente.</small></div>
    </aside>
  </div>
  <dialog id="wa-viewer" class="wa-viewer" aria-label="Visualizar arquivo"><header class="wa-viewer-bar"><span id="wa-viewer-name"></span><a id="wa-viewer-download" class="wa-icon-btn" title="Baixar"><i class="fas fa-download" aria-hidden="true"></i><span class="visually-hidden">Baixar</span></a><button type="button" id="wa-viewer-close" class="wa-icon-btn" title="Fechar (Esc)"><i class="fas fa-xmark" aria-hidden="true"></i><span class="visually-hidden">Fechar</span></button></header><div id="wa-viewer-stage" class="wa-viewer-stage"></div></dialog>
  <dialog id="wa-new-dialog"><form id="wa-start"><h2>Nova conversa</h2><label for="wa-start-number">Enviar pelo número</label><select id="wa-start-number" class="form-select" required><option value="">Escolha um número</option></select><label for="wa-start-phone">Telefone do cliente</label><input id="wa-start-phone" class="form-control" type="tel" placeholder="+55 11 99999-9999" required><div class="wa-dialog-actions"><button type="button" id="wa-cancel-new" class="wa-pill">Cancelar</button><button class="wa-send-btn">Abrir conversa</button></div></form></dialog>
</section>
